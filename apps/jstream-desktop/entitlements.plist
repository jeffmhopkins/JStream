<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's entitlements, used only when scripts/mac/bundle-app.sh signs
  with a Developer ID (ADR-0141 §3): the camera and microphone, which the hardened runtime
  otherwise refuses. Not sandboxed. An ad-hoc signed build needs none.
  Docs: apps/jstream-desktop/README.md#design
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
