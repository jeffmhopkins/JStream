<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The macOS app's usage strings, which the camera, microphone and system audio recording
  prompts require (ADR-0063 §11). Tauri's context macro embeds this file, with the
  product name added, in the binary's __TEXT,__info_plist section, so a bare `jstream`
  has them; scripts/mac/bundle-app.sh copies it into JStream.app's Contents and adds the
  bundle keys. The same strings as the daemon's Info.plist.
  Docs: apps/jstream-desktop/README.md#design
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.jstream.desktop</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>JStream records the microphones and audio inputs you add to a scene.</string>
	<key>NSCameraUsageDescription</key>
	<string>JStream shows the cameras you add to a scene.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>JStream records desktop and application audio you add to a scene.</string>
</dict>
</plist>
