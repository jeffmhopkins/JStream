  {
    "name": "effects_many",
    "about": "one text placed 30 times, each with a drop shadow and an outline on the item",
    "edits": [
      {
        "type": "source.create",
        "source_id": "ef_t",
        "name": "ef_t",
        "kind": {
          "type": "builtin",
          "kind": "text"
        },
        "settings": {
          "text": "FX",
          "size": 48
        }
      },
      {
        "each": {
          "count": 30,
          "cols": 6
        },
        "edits": [
          {
            "type": "item.add",
            "scene_id": "effects_many",
            "item_id": "efi_{i}",
            "source_id": "ef_t",
            "geometry": "$cell"
          },
          {
            "type": "filter.add",
            "owner": {
              "type": "item",
              "item_id": "efi_{i}"
            },
            "chain": "video",
            "filter_id": "ds",
            "kind": "drop_shadow"
          },
          {
            "type": "filter.add",
            "owner": {
              "type": "item",
              "item_id": "efi_{i}"
            },
            "chain": "video",
            "filter_id": "ol",
            "kind": "outline"
          }
        ]
      }
    ]
  },
