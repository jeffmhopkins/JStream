---
source: crates/jstream-mcp/src/tests.rs
---
{
  "tools": [
    {
      "description": "Applies one or more edits atomically, as one undo step: either all of them apply or none does, and the state `rev` goes up by exactly one. The edits are those the `item`, `output`, `scene`, `source` tools take as `op`. Actions and queries can't be batched. Pass `expected_rev` to apply only if nobody changed the state since you read it, and `idempotency_key` to make a retry safe. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "Crop": {
            "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
            "properties": {
              "bottom": {
                "description": "Pixels cut from the bottom edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "left": {
                "description": "Pixels cut from the left edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "right": {
                "description": "Pixels cut from the right edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "top": {
                "description": "Pixels cut from the top edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "type": "object"
          },
          "Edit": {
            "description": "A change to the collection state: undoable, batchable and atomic.\n\nSerialized with an internal `type` tag holding the command name (`noun.verb`,\nR-API-002). Every variant documents its inverse. The engine (`jstream-graph`)\ncomputes the inverse from the state *before* the edit, so the protocol has to be\nclosed under inversion: every inverse must itself be a sequence of edits, and it is.\n\nPositions are indexes: scenes in display order (0 is first), items in stacking order\nwithin their scene (0 is the bottom).",
            "oneOf": [
              {
                "description": "Creates an empty scene. Inverse: `scene.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The new scene's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "scene.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to rename."
                  },
                  "type": {
                    "const": "scene.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source shows it or any source's settings refer\nto it: delete those sources, or clear those references, first (in the same batch\nif needed). Inverse: `scene.create`, then `scene.reorder` to its old\ndisplay position (unless it was last), then each deleted item's `item.remove`\ninverse, from bottom to top.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to delete."
                  },
                  "type": {
                    "const": "scene.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The new item's ID, chosen by the client. Rejected if it exists."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to add to."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source the item shows."
                  },
                  "transform": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemTransform"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Initial transform. Omitted means [`ItemTransform::IDENTITY`]."
                  },
                  "type": {
                    "const": "item.add",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Removes an item from its scene. The source itself stays. Inverse: `item.add` with\nthe removed item's scene, ID, source and transform, then `item.reorder` to its old\nstacking position (unless it was on top), `item.set_crop` if it was cropped, and\n`item.set_visible` if it was hidden.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to remove."
                  },
                  "type": {
                    "const": "item.remove",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's transform. Inverse: `item.set_transform` with the previous one.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "transform": {
                    "$ref": "#/$defs/ItemTransform",
                    "description": "The new transform."
                  },
                  "type": {
                    "const": "item.set_transform",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "transform"
                ],
                "type": "object"
              },
              {
                "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to show or hide."
                  },
                  "type": {
                    "const": "item.set_visible",
                    "type": "string"
                  },
                  "visible": {
                    "description": "Whether the item is drawn. Items are visible when added.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "visible"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "type": {
                    "const": "item.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
                "properties": {
                  "crop": {
                    "$ref": "#/$defs/Crop",
                    "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to crop."
                  },
                  "type": {
                    "const": "item.set_crop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "crop"
                ],
                "type": "object"
              },
              {
                "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. Inverse: `source.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/SourceKind",
                    "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "settings": {
                    "$ref": "#/$defs/Settings",
                    "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The new source's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "source.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to rename."
                  },
                  "type": {
                    "const": "source.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
                "properties": {
                  "patch": {
                    "$ref": "#/$defs/Settings",
                    "description": "Parameter ID to new value, or `null` for the default."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_settings",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "patch"
                ],
                "type": "object"
              },
              {
                "description": "Copies a source under a new ID: a separate instance with the same kind and\nsettings, which changes independently from then on. Placing the *same* source again\nis `item.add` with its existing `source_id`. Inverse: `source.delete` of the copy.",
                "properties": {
                  "name": {
                    "description": "The copy's display name.",
                    "type": "string"
                  },
                  "new_source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The copy's ID, chosen by the client. Rejected if it exists."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to copy."
                  },
                  "type": {
                    "const": "source.duplicate",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "new_source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's settings refer to it: remove those items, or clear those\nreferences, first (in the same batch if needed). Inverse: `source.create` with its\nname, kind and settings.",
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to delete."
                  },
                  "type": {
                    "const": "source.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move."
                  },
                  "type": {
                    "const": "scene.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/OutputKind",
                    "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The new output's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "output.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept.\nInverse: `output.set_target` with the previous target.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The new target, validated as in `output.create`."
                  },
                  "type": {
                    "const": "output.set_target",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key stays in the credential store, so undoing the delete restores a\nworking output; `output.clear_key` removes it. Inverse: `output.create` with its\nkind.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to delete."
                  },
                  "type": {
                    "const": "output.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              }
            ]
          },
          "Finite32": {
            "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
            "format": "float",
            "type": "number"
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "ItemId": {
            "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
            "type": "string"
          },
          "ItemTransform": {
            "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec2",
                "description": "Top-left corner, in pixels of the scene's canvas."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "description": "Clockwise rotation, in degrees."
              },
              "scale": {
                "$ref": "#/$defs/Vec2",
                "description": "Scale factors; 1.0 is the source's native size."
              }
            },
            "required": [
              "position",
              "scale",
              "rotation_deg"
            ],
            "type": "object"
          },
          "OutputId": {
            "description": "An output (RTMP(S), recording, virtual camera).",
            "type": "string"
          },
          "OutputKind": {
            "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL and recording to a file are configurable so far. The\nvirtual camera and the YouTube-bound target of the data model come later as new\nvariants.",
            "oneOf": [
              {
                "description": "A stream sent over RTMP or RTMPS.",
                "properties": {
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The ingest server it publishes to."
                  },
                  "type": {
                    "const": "rtmp",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "A recording to a file on the engine's machine.",
                "properties": {
                  "container": {
                    "$ref": "#/$defs/RecordContainer",
                    "description": "The file format."
                  },
                  "path": {
                    "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists. The engine rejects, with `invalid_argument`, an empty or\nrelative path (absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one with control\ncharacters or a `..` segment, and one that ends in a separator or names no\nfile. `output.start` also fails when the path is not absolute on the\nengine's own machine.",
                    "type": "string"
                  },
                  "type": {
                    "const": "record",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "container"
                ],
                "type": "object"
              }
            ]
          },
          "RecordContainer": {
            "description": "The file format a recording is written in. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "mp4",
                "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
                "type": "string"
              }
            ]
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "RtmpTarget": {
            "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Any RTMP(S) ingest server, named by its server URL.",
                "properties": {
                  "type": {
                    "const": "generic",
                    "type": "string"
                  },
                  "url": {
                    "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "type": "object"
              }
            ]
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "Settings": {
            "additionalProperties": true,
            "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
            "type": "object"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "SourceKind": {
            "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
            "oneOf": [
              {
                "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene shown."
                  },
                  "type": {
                    "const": "scene",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
                "properties": {
                  "kind": {
                    "description": "The kind's ID, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "builtin",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind"
                ],
                "type": "object"
              }
            ]
          },
          "Vec2": {
            "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
            "properties": {
              "x": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal component."
              },
              "y": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical component."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "edits": {
            "description": "The edits, in order. An empty list is rejected with `empty_batch`.",
            "items": {
              "$ref": "#/$defs/Edit"
            },
            "minItems": 1,
            "type": "array"
          },
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          }
        },
        "required": [
          "edits"
        ],
        "type": "object"
      },
      "name": "batch"
    },
    {
      "description": "Returns the full JSON Schema of the JStream control protocol: every command, query, result, event and error code. Use it for details the other tools' schemas leave out.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object"
      },
      "name": "describe_api"
    },
    {
      "description": "Returns the engine's events after the cursor `after`, oldest first, without waiting: `state.changed` (the state `rev` moved; `client_id` and `request_id` say whose batch did it) and `output.state_changed`, from every client, yours included, and `events.dropped` (the server dropped `count` events because this session fell behind; re-read the state). The once-a-second `stats.tick` is not in `events`: each read returns the newest one as `stats` (running drop totals). Each comes with a `seq`, a sequence number of this MCP server, starting at 1 when your first call opened the session. Pass the returned `next` as `after` to read on; omit `after` (or pass 0) to read from the oldest kept. At most 100 events come back at once; `more` says others are waiting. The server keeps the last 1000: `dropped` counts events after your cursor that were discarded before you read them, so re-read the state if it is not 0. `ended` means the session is gone and no more events will come.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "The `next` of your previous read; 0 or omitted for the oldest kept event.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "events"
    },
    {
      "description": "Runs one `item` operation: set `op.type` to one of `item.add` (edit), `item.remove` (edit), `item.set_transform` (edit), `item.set_visible` (edit), `item.reorder` (edit), `item.set_crop` (edit), `item.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "Crop": {
            "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
            "properties": {
              "bottom": {
                "description": "Pixels cut from the bottom edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "left": {
                "description": "Pixels cut from the left edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "right": {
                "description": "Pixels cut from the right edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "top": {
                "description": "Pixels cut from the top edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "type": "object"
          },
          "Finite32": {
            "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
            "format": "float",
            "type": "number"
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "ItemId": {
            "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
            "type": "string"
          },
          "ItemTransform": {
            "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec2",
                "description": "Top-left corner, in pixels of the scene's canvas."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "description": "Clockwise rotation, in degrees."
              },
              "scale": {
                "$ref": "#/$defs/Vec2",
                "description": "Scale factors; 1.0 is the source's native size."
              }
            },
            "required": [
              "position",
              "scale",
              "rotation_deg"
            ],
            "type": "object"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "Vec2": {
            "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
            "properties": {
              "x": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal component."
              },
              "y": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical component."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `item` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The new item's ID, chosen by the client. Rejected if it exists."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to add to."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source the item shows."
                  },
                  "transform": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemTransform"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Initial transform. Omitted means [`ItemTransform::IDENTITY`]."
                  },
                  "type": {
                    "const": "item.add",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Removes an item from its scene. The source itself stays. Inverse: `item.add` with\nthe removed item's scene, ID, source and transform, then `item.reorder` to its old\nstacking position (unless it was on top), `item.set_crop` if it was cropped, and\n`item.set_visible` if it was hidden.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to remove."
                  },
                  "type": {
                    "const": "item.remove",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's transform. Inverse: `item.set_transform` with the previous one.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "transform": {
                    "$ref": "#/$defs/ItemTransform",
                    "description": "The new transform."
                  },
                  "type": {
                    "const": "item.set_transform",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "transform"
                ],
                "type": "object"
              },
              {
                "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to show or hide."
                  },
                  "type": {
                    "const": "item.set_visible",
                    "type": "string"
                  },
                  "visible": {
                    "description": "Whether the item is drawn. Items are visible when added.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "visible"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "type": {
                    "const": "item.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
                "properties": {
                  "crop": {
                    "$ref": "#/$defs/Crop",
                    "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to crop."
                  },
                  "type": {
                    "const": "item.set_crop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "crop"
                ],
                "type": "object"
              },
              {
                "description": "Lists one scene's items, in stacking order (the first is at the bottom). Fails with\n`not_found` if the scene doesn't exist.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene whose items to list."
                  },
                  "type": {
                    "const": "item.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "item"
    },
    {
      "description": "Runs one `kind` operation: set `op.type` to one of `kind.list` (query), `kind.describe` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `kind` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Lists every kind the engine can create, ordered by ID. Kinds are not collection\nstate, so the result carries no `rev`.",
                "properties": {
                  "type": {
                    "const": "kind.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "One kind's full descriptor, and a JSON Schema of its settings generated from it.\nFails with `invalid_argument` on `kind_id` if the engine has no such kind.",
                "properties": {
                  "kind_id": {
                    "description": "The kind to describe, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "kind.describe",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "kind"
    },
    {
      "description": "Runs one `output` operation: set `op.type` to one of `output.create` (edit), `output.set_target` (edit), `output.delete` (edit), `output.start` (action), `output.stop` (action), `output.set_key` (action), `output.clear_key` (action), `output.status` (query), `output.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. An action has side effects and is never undone; the answer only says it was accepted. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "OutputId": {
            "description": "An output (RTMP(S), recording, virtual camera).",
            "type": "string"
          },
          "OutputKind": {
            "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL and recording to a file are configurable so far. The\nvirtual camera and the YouTube-bound target of the data model come later as new\nvariants.",
            "oneOf": [
              {
                "description": "A stream sent over RTMP or RTMPS.",
                "properties": {
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The ingest server it publishes to."
                  },
                  "type": {
                    "const": "rtmp",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "A recording to a file on the engine's machine.",
                "properties": {
                  "container": {
                    "$ref": "#/$defs/RecordContainer",
                    "description": "The file format."
                  },
                  "path": {
                    "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists. The engine rejects, with `invalid_argument`, an empty or\nrelative path (absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one with control\ncharacters or a `..` segment, and one that ends in a separator or names no\nfile. `output.start` also fails when the path is not absolute on the\nengine's own machine.",
                    "type": "string"
                  },
                  "type": {
                    "const": "record",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "container"
                ],
                "type": "object"
              }
            ]
          },
          "RecordContainer": {
            "description": "The file format a recording is written in. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "mp4",
                "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
                "type": "string"
              }
            ]
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "RtmpTarget": {
            "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Any RTMP(S) ingest server, named by its server URL.",
                "properties": {
                  "type": {
                    "const": "generic",
                    "type": "string"
                  },
                  "url": {
                    "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "type": "object"
              }
            ]
          },
          "SecretString": {
            "description": "A secret string, such as a stream key, sent by a client to the engine.\n\nOn the wire it is a plain JSON string. In Rust it never prints: its `Debug` is\n`\"***\"`, it has no `Display`, and the only way to read it is [`expose`](Self::expose).\nA value that is not a string fails to parse with a message that doesn't repeat it.\nThe engine never sends one back (R-SEC-001).",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `output` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/OutputKind",
                    "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The new output's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "output.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept.\nInverse: `output.set_target` with the previous target.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The new target, validated as in `output.create`."
                  },
                  "type": {
                    "const": "output.set_target",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key stays in the credential store, so undoing the delete restores a\nworking output; `output.clear_key` removes it. Inverse: `output.create` with its\nkind.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to delete."
                  },
                  "type": {
                    "const": "output.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Starts an output (stream, recording or virtual camera).",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to start."
                  },
                  "type": {
                    "const": "output.start",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Stops an output.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to stop."
                  },
                  "type": {
                    "const": "output.stop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Stores an output's stream key in the OS credential store (R-SEC-001), replacing\nany key it had. Write-only: the key never comes back in a response, event, error,\n`state.get` or log, and `output.status` reports only `key_set`. An action, not an\nedit: the key is not collection state, so it is never undone. A running output\nuses the new key from its next `output.start`. Fails with `not_found` for an\noutput not in the collection, `invalid_argument` (field `key`) for an empty key,\none over 1024 bytes or one with whitespace or control characters, and\n`action_failed` when the engine has no credential store or the store refuses.",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/SecretString",
                    "description": "The stream key, as the streaming service shows it."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output whose key to set."
                  },
                  "type": {
                    "const": "output.set_key",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "key"
                ],
                "type": "object"
              },
              {
                "description": "Removes an output's stream key from the credential store. Succeeds when there is\nnone, and for an output that is no longer in the collection, so a client can clear\nthe key of an output it deleted. Fails with `action_failed` when the engine has no\ncredential store or the store refuses.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output whose key to remove."
                  },
                  "type": {
                    "const": "output.clear_key",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Reports an output's current state, and whether its stream key is set. Fails with\n`not_found` for an output the engine doesn't know.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to report on."
                  },
                  "type": {
                    "const": "output.status",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's outputs, ordered by ID, with what each is and where it\nsends. Outputs have no display order of their own.",
                "properties": {
                  "type": {
                    "const": "output.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "output"
    },
    {
      "description": "Runs one `scene` operation: set `op.type` to one of `scene.create` (edit), `scene.rename` (edit), `scene.delete` (edit), `scene.reorder` (edit), `scene.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `scene` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Creates an empty scene. Inverse: `scene.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The new scene's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "scene.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to rename."
                  },
                  "type": {
                    "const": "scene.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source shows it or any source's settings refer\nto it: delete those sources, or clear those references, first (in the same batch\nif needed). Inverse: `scene.create`, then `scene.reorder` to its old\ndisplay position (unless it was last), then each deleted item's `item.remove`\ninverse, from bottom to top.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to delete."
                  },
                  "type": {
                    "const": "scene.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move."
                  },
                  "type": {
                    "const": "scene.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's scenes, in display order.",
                "properties": {
                  "type": {
                    "const": "scene.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "scene"
    },
    {
      "description": "Runs one `source` operation: set `op.type` to one of `source.create` (edit), `source.rename` (edit), `source.set_settings` (edit), `source.duplicate` (edit), `source.delete` (edit), `source.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "Settings": {
            "additionalProperties": true,
            "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
            "type": "object"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "SourceKind": {
            "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
            "oneOf": [
              {
                "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene shown."
                  },
                  "type": {
                    "const": "scene",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
                "properties": {
                  "kind": {
                    "description": "The kind's ID, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "builtin",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind"
                ],
                "type": "object"
              }
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `source` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. Inverse: `source.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/SourceKind",
                    "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "settings": {
                    "$ref": "#/$defs/Settings",
                    "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The new source's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "source.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to rename."
                  },
                  "type": {
                    "const": "source.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
                "properties": {
                  "patch": {
                    "$ref": "#/$defs/Settings",
                    "description": "Parameter ID to new value, or `null` for the default."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_settings",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "patch"
                ],
                "type": "object"
              },
              {
                "description": "Copies a source under a new ID: a separate instance with the same kind and\nsettings, which changes independently from then on. Placing the *same* source again\nis `item.add` with its existing `source_id`. Inverse: `source.delete` of the copy.",
                "properties": {
                  "name": {
                    "description": "The copy's display name.",
                    "type": "string"
                  },
                  "new_source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The copy's ID, chosen by the client. Rejected if it exists."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to copy."
                  },
                  "type": {
                    "const": "source.duplicate",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "new_source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's settings refer to it: remove those items, or clear those\nreferences, first (in the same batch if needed). Inverse: `source.create` with its\nname, kind and settings.",
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to delete."
                  },
                  "type": {
                    "const": "source.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's sources, ordered by ID. Sources have no display order of\ntheir own.",
                "properties": {
                  "type": {
                    "const": "source.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "source"
    },
    {
      "description": "Runs one `state` operation: set `op.type` to one of `state.get` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `state` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Reads the whole collection state (every source, every scene with its items, and\nevery output) at one revision: what a client reads on connecting, after a `state.changed` it\ndidn't cause, or before an edit it sends with `expected_rev`.",
                "properties": {
                  "type": {
                    "const": "state.get",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "state"
    },
    {
      "description": "Runs one `video` operation: set `op.type` to one of `video.snapshot` (query). A query only reads. A `video.snapshot` result leads with the PNG as an image content block; its JSON `png` field only names that block. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `video` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "The current program mix, as a PNG.\n\nThe result's `png` is standard base64 with padding and no line breaks. `width`\nand `height` are that image's size in pixels; the longest side is at most 1280.\n`rev` is the collection revision of the layout the image shows. Source pixels are\nruntime state and can change without a new `rev`.",
                "properties": {
                  "type": {
                    "const": "video.snapshot",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "video"
    }
  ]
}
