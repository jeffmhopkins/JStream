---
source: crates/jstream-mcp/src/tests.rs
---
{
  "tools": [
    {
      "description": "Applies one or more edits atomically, as one undo step: either all of them apply or none does, and the state `rev` goes up by exactly one. The edits are those the `canvas`, `encoder`, `folder`, `item`, `label`, `output`, `scene`, `source` tools take as `op`. Actions and queries can't be batched. Pass `expected_rev` to apply only if nobody changed the state since you read it, and `idempotency_key` to make a retry safe. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "AudioCodec": {
            "description": "An audio codec. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "aac",
                "description": "AAC-LC.",
                "type": "string"
              }
            ]
          },
          "AudioEncoding": {
            "description": "How the audio is encoded.",
            "properties": {
              "codec": {
                "$ref": "#/$defs/AudioCodec",
                "description": "The codec."
              },
              "kbps": {
                "description": "The bit rate, in kilobits per second: 32..=320, else `invalid_argument`.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "codec",
              "kbps"
            ],
            "type": "object"
          },
          "Crop": {
            "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
            "properties": {
              "bottom": {
                "description": "Pixels cut from the bottom edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "left": {
                "description": "Pixels cut from the left edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "right": {
                "description": "Pixels cut from the right edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "top": {
                "description": "Pixels cut from the top edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "type": "object"
          },
          "Edit": {
            "description": "A change to the collection state: undoable, batchable and atomic.\n\nSerialized with an internal `type` tag holding the command name (`noun.verb`,\nR-API-002). Every variant documents its inverse. The engine (`jstream-graph`)\ncomputes the inverse from the state *before* the edit, so the protocol has to be\nclosed under inversion: every inverse must itself be a sequence of edits, and it is.\n\nPositions are indexes: scenes in display order (0 is first), items in stacking order\nwithin their scene (0 is the bottom).",
            "oneOf": [
              {
                "description": "Creates an empty scene. Inverse: `scene.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "role": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneRole"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "What the scene is for (ADR-0024 §1). Omitted means `scene`."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The new scene's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "scene.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to rename."
                  },
                  "type": {
                    "const": "scene.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes what a scene is for (ADR-0024 §1): a `scene`, or a `group` placed in\nother scenes through a `scene` source. The role changes no engine behaviour: a\ngroup renders, nests and can be placed more than once like any scene, and clients\nhide groups from the scene list. Inverse: `scene.set_role` with the previous role.",
                "properties": {
                  "role": {
                    "$ref": "#/$defs/SceneRole",
                    "description": "Its new role."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to change."
                  },
                  "type": {
                    "const": "scene.set_role",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "role"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source shows it or any source's settings refer\nto it: delete those sources, or clear those references, first (in the same batch\nif needed). Inverse: `scene.create` with its role (omitted for `scene`), then\n`scene.reorder` to its old display position (unless it was last), `scene.set_folder`\nand `scene.set_meta` if it had a folder or metadata, then each deleted item's\n`item.remove` inverse, from bottom to top.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to delete."
                  },
                  "type": {
                    "const": "scene.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.\n\nThe item's placement is `geometry` when that is sent, else a legacy placement:\n`transform`, or [`ItemTransform::IDENTITY`] when both are omitted (ADR-0022).\nSending both is `invalid_argument`.",
                "properties": {
                  "geometry": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemGeometry"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The initial placement as a box on the canvas, checked like\n`item.set_geometry`'s."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The new item's ID, chosen by the client. Rejected if it exists."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to add to."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source the item shows."
                  },
                  "transform": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemTransform"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `geometry`. The\ninitial legacy placement, with its 0.3 meaning."
                  },
                  "type": {
                    "const": "item.add",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Removes an item from its scene. The source itself stays. Inverse: `item.add` with\nthe removed item's scene, ID and source, and its placement in the field matching\nits form (`transform` or `geometry`), then `item.reorder` to its old stacking\nposition (unless it was on top), `item.set_crop` if it was cropped, and\n`item.set_visible` if it was hidden.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to remove."
                  },
                  "type": {
                    "const": "item.remove",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to a stacking position in another scene, keeping its ID, source,\nplacement, crop and visibility (ADR-0024 §1). Grouping is a batch that creates a\ngroup scene, places it, and moves the selected items into it. Rejected with\n`invalid_argument` if the move would make a scene contain itself (field\n`scene_id`, naming the cycle) or if the index is out of range. Inverse:\n`item.move` back to its previous scene and index.",
                "properties": {
                  "index": {
                    "description": "Its position in that scene after the move, counted from the bottom (0). Must\nbe at most the number of items already in that scene (less than it for the\nitem's own scene), else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move it to. Its own scene is allowed, and then the move is an\n`item.reorder`."
                  },
                  "type": {
                    "const": "item.move",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `item.set_geometry`.\nReplaces an item's placement with a legacy one, which keeps its 0.3 meaning.\nInverse: the previous placement, as `item.set_transform` if it was legacy and\n`item.set_geometry` if it was a geometry.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "transform": {
                    "$ref": "#/$defs/ItemTransform",
                    "description": "The new transform."
                  },
                  "type": {
                    "const": "item.set_transform",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "transform"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's placement with a box on the canvas (ADR-0022). A size that is\nnot greater than zero, a `perspective_px` that is not greater than zero, and any\nnon-neutral `tilt_deg`, `turn_deg`, `depth_px` or `perspective_px` (the\ncompositor does not draw 3D yet) are `invalid_argument`. Inverse: the previous\nplacement, as `item.set_geometry` if it was a geometry and `item.set_transform`\nif it was legacy.",
                "properties": {
                  "geometry": {
                    "$ref": "#/$defs/ItemGeometry",
                    "description": "The new geometry."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to place."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "type": {
                    "const": "item.set_geometry",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "geometry"
                ],
                "type": "object"
              },
              {
                "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to show or hide."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change, as every placement edit\ntakes it (ADR-0024 §2). Omitted, or the item's own scene, changes the item.\nAny other scene is `invalid_argument` until keyframe scenes exist, when naming\na keyframe scene of the item's scene will write that scene's override."
                  },
                  "type": {
                    "const": "item.set_visible",
                    "type": "string"
                  },
                  "visible": {
                    "description": "Whether the item is drawn. Items are visible when added.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "visible"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "type": {
                    "const": "item.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Changes which source an item places, keeping the item's ID, transform, crop,\nvisibility and stacking position (ADR-0023). It switches an item between a\nreference and a clone: `source.duplicate` then `item.set_source` to the copy makes\na clone, and `item.set_source` back to the copy's `duplicated_from` (then\n`source.delete` of the copy if nothing else places it) makes it a reference again.\nRejected with `not_found` if the item or the source doesn't exist, and with\n`invalid_argument` naming the cycle if the scene would then contain itself,\ndirectly or through other scenes. Inverse: `item.set_source` with the previous\nsource.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to change."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source it places from now on."
                  },
                  "type": {
                    "const": "item.set_source",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
                "properties": {
                  "crop": {
                    "$ref": "#/$defs/Crop",
                    "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to crop."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "type": {
                    "const": "item.set_crop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "crop"
                ],
                "type": "object"
              },
              {
                "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. Inverse: `source.delete`.",
                "properties": {
                  "duplicated_from": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SourceId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The source this one was copied from, as `source.duplicate` records it. A plain\nlink: it may name a source that no longer exists (`source.delete`'s inverse\nrestores it that way), and is reported only while that source exists. It must\nnot name the new source itself, else `invalid_argument`. Omitted means none."
                  },
                  "kind": {
                    "$ref": "#/$defs/SourceKind",
                    "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "settings": {
                    "$ref": "#/$defs/Settings",
                    "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The new source's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "source.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to rename."
                  },
                  "type": {
                    "const": "source.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
                "properties": {
                  "patch": {
                    "$ref": "#/$defs/Settings",
                    "description": "Parameter ID to new value, or `null` for the default."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_settings",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "patch"
                ],
                "type": "object"
              },
              {
                "description": "Copies a source under a new ID: a separate instance with the same kind and\nsettings, labels and favourite flag, which changes independently from then on.\nThe copy's `duplicated_from` names the source it was copied from. Placing the *same* source again is `item.add`\nwith its existing `source_id`. Inverse: `source.delete` of the copy.",
                "properties": {
                  "name": {
                    "description": "The copy's display name.",
                    "type": "string"
                  },
                  "new_source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The copy's ID, chosen by the client. Rejected if it exists."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to copy."
                  },
                  "type": {
                    "const": "source.duplicate",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "new_source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's settings refer to it: remove those items, or clear those\nreferences, first (in the same batch if needed). Deleting a source that others were\ncopied from is allowed: their `duplicated_from` then reads as absent. Inverse:\n`source.create` with its name, kind, settings and `duplicated_from`, then\n`source.set_meta` if it carried labels or was a favourite.",
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to delete."
                  },
                  "type": {
                    "const": "source.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move."
                  },
                  "type": {
                    "const": "scene.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/OutputKind",
                    "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The new output's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "output.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept.\nInverse: `output.set_target` with the previous target.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The new target, validated as in `output.create`."
                  },
                  "type": {
                    "const": "output.set_target",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "Changes the canvas: every scene's coordinate space, in whole pixels (ADR-0022).\nItems keep their canvas-pixel placements; nothing moves or resizes. Zero, or a\nside over the engine's maximum (at least 7680, both ways), is `invalid_argument`.\nInverse: `canvas.set_size` with the previous size.",
                "properties": {
                  "height": {
                    "description": "Canvas height in pixels.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "canvas.set_size",
                    "type": "string"
                  },
                  "width": {
                    "description": "Canvas width in pixels.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "width",
                  "height"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key stays in the credential store, so undoing the delete restores a\nworking output; `output.clear_key` removes it. Inverse: `output.create` with its\nkind.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to delete."
                  },
                  "type": {
                    "const": "output.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Chooses the encoder profile an output uses, or the engine's default. A running\noutput keeps its encoder session; the profile applies from its next\n`output.start`. Inverse: `output.set_encoder` with the previous profile.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "profile_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/EncoderProfileId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The profile, which must exist, else `not_found`. Absent or `null` means the\nengine's default."
                  },
                  "type": {
                    "const": "output.set_encoder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Adds an encoder profile. Inverse: `encoder.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "profile": {
                    "$ref": "#/$defs/EncoderProfile",
                    "description": "The encoding. Out-of-range values, and codecs or rate controls the engine\ndoesn't know, are rejected with `invalid_argument`."
                  },
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The new profile's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "encoder.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id",
                  "name",
                  "profile"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an encoder profile's name and encoding. Running outputs keep their\nencoder sessions; the new encoding applies from each output's next\n`output.start`. Inverse: `encoder.update` with the previous name and encoding.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "profile": {
                    "$ref": "#/$defs/EncoderProfile",
                    "description": "The new encoding, validated as in `encoder.create`."
                  },
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The profile to change."
                  },
                  "type": {
                    "const": "encoder.update",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id",
                  "name",
                  "profile"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an encoder profile. Rejected with `invalid_argument` while an output\nuses it: point those outputs elsewhere with `output.set_encoder` first (in the\nsame batch if needed). Inverse: `encoder.create` with its name and encoding.",
                "properties": {
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The profile to delete."
                  },
                  "type": {
                    "const": "encoder.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id"
                ],
                "type": "object"
              },
              {
                "description": "Adds a folder to the scene list, last in folder order (ADR-0024 §3). Folders\norganise only: they change no rendering, switching or nesting. Inverse:\n`folder.delete`.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The new folder's ID, chosen by the client. Rejected if it exists."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The folder it sits in, which must exist, else `not_found`. Omitted means top\nlevel."
                  },
                  "type": {
                    "const": "folder.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a folder. Inverse: `folder.rename` back to the previous name.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to rename."
                  },
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "folder.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Moves a folder into another folder, or to the top level. A parent that would put\nthe folder inside itself is `invalid_argument` (field `parent`), and a parent that\ndoesn't exist `not_found`. Inverse: `folder.set_parent` with the previous parent.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to move."
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Its new parent. Absent or `null` means top level."
                  },
                  "type": {
                    "const": "folder.set_parent",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a folder to another position in folder order. The folders in one parent\nshow in that order. Inverse: `folder.reorder` back to its previous index.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to move."
                  },
                  "index": {
                    "description": "The new position, counted from the first folder (0). Must be less than the\nnumber of folders, else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "folder.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an empty folder. Rejected with `invalid_argument` while a scene or another\nfolder sits in it, listing them as `blockers`: move them out first, or send the\nbatch `delete.plan` returns, which moves them up to the folder's parent. Inverse:\n`folder.create` with its name and parent, then `folder.reorder` to its old\nposition (unless it was last).",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to delete."
                  },
                  "type": {
                    "const": "folder.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id"
                ],
                "type": "object"
              },
              {
                "description": "Puts a scene in a folder, or takes it out of one. The scene keeps its position in\nthe flat display order. Inverse: `scene.set_folder` with the previous folder.",
                "properties": {
                  "folder_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The folder, which must exist, else `not_found`. Absent or `null` means none."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to file."
                  },
                  "type": {
                    "const": "scene.set_folder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a scene's organisation metadata: its icon, colour, favourite flag and\nwhether a multiview shows it. Every field left out takes its default. An icon\nthat is empty or longer than 64 bytes, or a colour that isn't\n`#rrggbb`, is `invalid_argument`. Inverse: `scene.set_meta` with the previous\nmetadata.",
                "properties": {
                  "color": {
                    "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "favourite": {
                    "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
                    "type": "boolean"
                  },
                  "icon": {
                    "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to change."
                  },
                  "show_in_multiview": {
                    "description": "Whether a multiview shows it. Omitted for `true`, the default.",
                    "type": "boolean"
                  },
                  "type": {
                    "const": "scene.set_meta",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Adds a label, last in label order (ADR-0024 §4). Rejected with `invalid_argument`\nfor an empty name, a colour that isn't `#rrggbb`, or an icon checked as\n`scene.set_meta`'s. Inverse: `label.delete`.",
                "properties": {
                  "color": {
                    "description": "Its colour, sRGB as `#rrggbb`.",
                    "type": "string"
                  },
                  "icon": {
                    "description": "An icon name from the UI's icon set. Omitted means none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The new label's ID, chosen by the client. Rejected if it exists."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "label.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "name",
                  "color"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a label's name, colour and icon, validated as in `label.create`. Every\nsource carrying it shows the change. Inverse: `label.update` with the previous\nvalues.",
                "properties": {
                  "color": {
                    "description": "The new colour.",
                    "type": "string"
                  },
                  "icon": {
                    "description": "The new icon. Omitted means none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to change."
                  },
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "label.update",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "name",
                  "color"
                ],
                "type": "object"
              },
              {
                "description": "Moves a label to another position in label order. Inverse: `label.reorder` back\nto its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first label (0). Must be less than the\nnumber of labels, else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to move."
                  },
                  "type": {
                    "const": "label.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a label. Rejected with `invalid_argument` while a source carries it,\nlisting them as `blockers`: take it off those sources first, or send the batch\n`delete.plan` returns. Inverse: `label.create` with its name, colour and icon,\nthen `label.reorder` to its old position (unless it was last).",
                "properties": {
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to delete."
                  },
                  "type": {
                    "const": "label.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a source's organisation metadata: the labels it carries and its\nfavourite flag. Every field left out takes its default, so `labels` omitted\nremoves them all. A label that doesn't exist is `not_found`, and one listed twice\n`invalid_argument`; the engine stores them ordered by ID. Inverse:\n`source.set_meta` with the previous metadata.",
                "properties": {
                  "favourite": {
                    "description": "Whether it is a favourite. Omitted for `false`.",
                    "type": "boolean"
                  },
                  "labels": {
                    "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
                    "items": {
                      "$ref": "#/$defs/LabelId"
                    },
                    "type": "array"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_meta",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              }
            ]
          },
          "EncoderProfile": {
            "description": "How an output's video and audio are encoded.\n\nAn output with no profile uses the engine's default, [`EncoderProfile::DEFAULT`]:\nH.264 at a constant 2500 kbit/s with a keyframe every 2 s on the software encoder,\nand AAC at 160 kbit/s.",
            "properties": {
              "audio": {
                "$ref": "#/$defs/AudioEncoding",
                "description": "The audio encoding."
              },
              "video": {
                "$ref": "#/$defs/VideoEncoding",
                "description": "The video encoding."
              }
            },
            "required": [
              "video",
              "audio"
            ],
            "type": "object"
          },
          "EncoderProfileId": {
            "description": "An encoder profile in the collection.",
            "type": "string"
          },
          "Finite32": {
            "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
            "format": "float",
            "type": "number"
          },
          "FitMode": {
            "description": "How the cropped source fills the item's box.\n\nThe three values are the complete set. A new one is a string-enum addition.",
            "oneOf": [
              {
                "const": "stretch",
                "description": "Fill the box exactly, ignoring the source's aspect ratio.",
                "type": "string"
              },
              {
                "const": "fit",
                "description": "The largest rectangle of the source's aspect ratio that fits inside the box,\ncentred. The rest of the box stays transparent.",
                "type": "string"
              },
              {
                "const": "fill",
                "description": "The smallest rectangle of the source's aspect ratio that covers the box,\ncentred. The part outside the box is clipped by the compositor.",
                "type": "string"
              }
            ]
          },
          "FolderId": {
            "description": "A folder of the scene list (ADR-0024 §3). Folders organise only.",
            "type": "string"
          },
          "HardwarePreference": {
            "description": "Whether a video encoder runs on the GPU's encoder block. Serialized as a snake_case\nstring. Hardware encoders limit how many sessions run at once, per GPU vendor and\ndriver; the engine doesn't guess that limit, and `output.status` reports the\nhardware sessions in use.",
            "oneOf": [
              {
                "const": "prefer",
                "description": "Hardware if there is one, else software.",
                "type": "string"
              },
              {
                "const": "require",
                "description": "Hardware only: `output.start` fails when there is none.",
                "type": "string"
              },
              {
                "const": "avoid",
                "description": "Software only.",
                "type": "string"
              }
            ]
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "ItemGeometry": {
            "description": "Where a scene item sits on the canvas: its box, the fit of the source inside that\nbox, and the 3D placement ADR-0022 defines.\n\n`center`, `size` and `rotation_deg` alone define the box, so selection handles need\nno source size. The 3D fields default to neutral (no tilt, turn or depth, and no\nperspective). The formula below still evaluates a non-neutral value; drawing it is\nthe compositor's M3 work, and until then the engine rejects it. [`Self::is_neutral_3d`]\nis that check. A negative `size` is rejected, not read as a flip.\n\nEvery number is a [`Finite32`]. On the wire, omitted `fit_mode` and angles mean the\ndefaults below, and omitted `perspective_px` means orthographic.",
            "properties": {
              "center": {
                "$ref": "#/$defs/Vec2",
                "description": "Centre of the box, in canvas pixels."
              },
              "depth_px": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Offset along the viewing axis, in pixels. Positive is toward the viewer.\nDefault 0."
              },
              "fit_mode": {
                "$ref": "#/$defs/FitMode",
                "default": "fit",
                "description": "How the cropped source fills the box. Default [`FitMode::Fit`]."
              },
              "perspective_px": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Finite32"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Distance from the viewer to the canvas plane, for this item only. Absent means\northographic. When present it must be greater than zero."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Clockwise rotation in the canvas plane, in degrees, about [`Self::center`].\nDefault 0."
              },
              "size": {
                "$ref": "#/$defs/Size",
                "description": "Width and height of the box, in canvas pixels. Each must be greater than zero."
              },
              "tilt_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Rotation about the box's horizontal axis through the centre, in degrees.\nPositive moves the top edge away from the viewer. Default 0."
              },
              "turn_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Rotation about the box's vertical axis through the centre, in degrees.\nPositive moves the right edge away from the viewer. Default 0."
              }
            },
            "required": [
              "center",
              "size"
            ],
            "type": "object"
          },
          "ItemId": {
            "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
            "type": "string"
          },
          "ItemTransform": {
            "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n**Deprecated** since 0.11 (ADR-0022) and removed in 1.0, with `item.set_transform`,\n`item.add`'s `transform` and `ItemInfo.transform`. Until then it keeps the meaning\nbelow.\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec2",
                "description": "Top-left corner, in pixels of the scene's canvas."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "description": "Clockwise rotation, in degrees."
              },
              "scale": {
                "$ref": "#/$defs/Vec2",
                "description": "Scale factors; 1.0 is the source's native size."
              }
            },
            "required": [
              "position",
              "scale",
              "rotation_deg"
            ],
            "type": "object"
          },
          "LabelId": {
            "description": "A label that sources carry (ADR-0024 §4).",
            "type": "string"
          },
          "OutputId": {
            "description": "An output (RTMP(S), recording, virtual camera).",
            "type": "string"
          },
          "OutputKind": {
            "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL, recording to a file and the virtual camera are\nconfigurable so far. The YouTube-bound target of the data model comes later as a new\nvariant.",
            "oneOf": [
              {
                "description": "A stream sent over RTMP or RTMPS.",
                "properties": {
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The ingest server it publishes to."
                  },
                  "type": {
                    "const": "rtmp",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "A recording to a file on the engine's machine.",
                "properties": {
                  "container": {
                    "$ref": "#/$defs/RecordContainer",
                    "description": "The file format."
                  },
                  "path": {
                    "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists. The engine rejects, with `invalid_argument`, an empty or\nrelative path (absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one with control\ncharacters or a `..` segment, and one that ends in a separator or names no\nfile. `output.start` also fails when the path is not absolute on the\nengine's own machine.",
                    "type": "string"
                  },
                  "type": {
                    "const": "record",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "container"
                ],
                "type": "object"
              },
              {
                "description": "The virtual camera: the program video, offered to other apps on the engine's\nmachine as a webcam. Video only: it has no audio, no target and no stream key.\nIt runs at the canvas size the collection has when it starts, at 30 fps.\n`output.start` fails with `action_failed` when the engine has no virtual camera,\nwhen the camera is not registered on the machine, or when it can't offer that\nsize (the Windows camera offers only 1920×1080, the default canvas).",
                "properties": {
                  "type": {
                    "const": "virtual_cam",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RateControl": {
            "description": "How a video encoder spends bits. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Constant bit rate, as RTMP ingest expects.",
                "properties": {
                  "kbps": {
                    "description": "The target, in kilobits per second.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "cbr",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kbps"
                ],
                "type": "object"
              },
              {
                "description": "Variable bit rate with a peak, for a recording.",
                "properties": {
                  "kbps": {
                    "description": "The average target, in kilobits per second.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "max_kbps": {
                    "description": "The peak, in kilobits per second; at least `kbps`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "vbr",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kbps",
                  "max_kbps"
                ],
                "type": "object"
              }
            ]
          },
          "RecordContainer": {
            "description": "The file format a recording is written in. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "mp4",
                "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
                "type": "string"
              }
            ]
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "RtmpTarget": {
            "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Any RTMP(S) ingest server, named by its server URL.",
                "properties": {
                  "type": {
                    "const": "generic",
                    "type": "string"
                  },
                  "url": {
                    "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "type": "object"
              }
            ]
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "SceneRole": {
            "description": "What a scene is for (ADR-0024 §1). It changes no engine behaviour; it tells clients,\nagents and switchers how to show the scene.",
            "oneOf": [
              {
                "const": "scene",
                "description": "A scene of its own, listed in the scene list. Scenes are created with this role\nunless `scene.create` names another.",
                "type": "string"
              },
              {
                "const": "group",
                "description": "A group: a scene placed in other scenes to hold items together. Clients hide it\nfrom the scene list and show it under the items that place it.",
                "type": "string"
              }
            ]
          },
          "Settings": {
            "additionalProperties": true,
            "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
            "type": "object"
          },
          "Size": {
            "description": "A width and height, in canvas pixels.\n\nBoth components are [`Finite32`]. A non-positive component is rejected by\n[`ItemGeometry::validate`], not stored as a flip.",
            "properties": {
              "height": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical extent. Must be greater than zero for a placement to be valid."
              },
              "width": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal extent. Must be greater than zero for a placement to be valid."
              }
            },
            "required": [
              "width",
              "height"
            ],
            "type": "object"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "SourceKind": {
            "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
            "oneOf": [
              {
                "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene shown."
                  },
                  "type": {
                    "const": "scene",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
                "properties": {
                  "kind": {
                    "description": "The kind's ID, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "builtin",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind"
                ],
                "type": "object"
              }
            ]
          },
          "Vec2": {
            "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
            "properties": {
              "x": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal component."
              },
              "y": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical component."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          },
          "VideoCodec": {
            "description": "A video codec. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "h264",
                "description": "H.264 (AVC).",
                "type": "string"
              }
            ]
          },
          "VideoEncoding": {
            "description": "How the video is encoded.",
            "properties": {
              "codec": {
                "$ref": "#/$defs/VideoCodec",
                "description": "The codec."
              },
              "hardware": {
                "$ref": "#/$defs/HardwarePreference",
                "default": "avoid",
                "description": "Whether to use a hardware encoder. Omitted means `avoid`."
              },
              "keyframe_interval_s": {
                "description": "Seconds from one keyframe to the next, 1..=10, else `invalid_argument`. Most\nstreaming services ask for 2.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "rate_control": {
                "$ref": "#/$defs/RateControl",
                "description": "How the encoder spends bits. Rejected with `invalid_argument` outside\n100..=100000 kbit/s, or, for `vbr`, with a peak below the average or above\n200000 kbit/s."
              }
            },
            "required": [
              "codec",
              "rate_control",
              "keyframe_interval_s"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "edits": {
            "description": "The edits, in order. An empty list is rejected with `empty_batch`.",
            "items": {
              "$ref": "#/$defs/Edit"
            },
            "minItems": 1,
            "type": "array"
          },
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          }
        },
        "required": [
          "edits"
        ],
        "type": "object"
      },
      "name": "batch"
    },
    {
      "description": "Runs one `canvas` operation: set `op.type` to one of `canvas.set_size` (edit). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `canvas` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Changes the canvas: every scene's coordinate space, in whole pixels (ADR-0022).\nItems keep their canvas-pixel placements; nothing moves or resizes. Zero, or a\nside over the engine's maximum (at least 7680, both ways), is `invalid_argument`.\nInverse: `canvas.set_size` with the previous size.",
                "properties": {
                  "height": {
                    "description": "Canvas height in pixels.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "canvas.set_size",
                    "type": "string"
                  },
                  "width": {
                    "description": "Canvas width in pixels.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "type",
                  "width",
                  "height"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "canvas"
    },
    {
      "description": "Runs one `delete` operation: set `op.type` to one of `delete.plan` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "DeleteTarget": {
            "description": "What a `delete.plan` deletes: a scene, a source, a folder or a label.",
            "oneOf": [
              {
                "description": "A scene.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to delete."
                  },
                  "type": {
                    "const": "scene",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "A source.",
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to delete."
                  },
                  "type": {
                    "const": "source",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "A folder. The plan moves the scenes and folders in it up to its parent (to the\ntop level for a top-level folder), then deletes it.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to delete."
                  },
                  "type": {
                    "const": "folder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id"
                ],
                "type": "object"
              },
              {
                "description": "A label. The plan takes it off every source that carries it, then deletes it.",
                "properties": {
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to delete."
                  },
                  "type": {
                    "const": "label",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id"
                ],
                "type": "object"
              }
            ]
          },
          "FolderId": {
            "description": "A folder of the scene list (ADR-0024 §3). Folders organise only.",
            "type": "string"
          },
          "LabelId": {
            "description": "A label that sources carry (ADR-0024 §4).",
            "type": "string"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `delete` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "The batch that deletes a scene, source, folder or label together with everything\nthat refers to it, which `scene.delete`, `source.delete`, `folder.delete` and\n`label.delete` alone refuse (their `invalid_argument` lists those `blockers`). The\nplan removes the items that place a deleted source, deletes the `scene` sources\nthat show a deleted scene (and their items), and sets settings references to the\ntarget to `null`, keeping the sources that hold them. For a folder it moves what\nsits in it up to the folder's parent; for a label it takes the label off the\nsources carrying it.\nThe client shows it, then sends its `edits` as an ordinary batch with\n`expected_rev` set to the result's `rev`; undo is that batch's inverse. Fails with\n`not_found` if the target doesn't exist.",
                "properties": {
                  "target": {
                    "$ref": "#/$defs/DeleteTarget",
                    "description": "What to delete."
                  },
                  "type": {
                    "const": "delete.plan",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "target"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "delete"
    },
    {
      "description": "Returns the full JSON Schema of the JStream control protocol: every command, query, result, event and error code. Use it for details the other tools' schemas leave out.",
      "inputSchema": {
        "additionalProperties": false,
        "type": "object"
      },
      "name": "describe_api"
    },
    {
      "description": "Runs one `encoder` operation: set `op.type` to one of `encoder.create` (edit), `encoder.update` (edit), `encoder.delete` (edit), `encoder.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "AudioCodec": {
            "description": "An audio codec. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "aac",
                "description": "AAC-LC.",
                "type": "string"
              }
            ]
          },
          "AudioEncoding": {
            "description": "How the audio is encoded.",
            "properties": {
              "codec": {
                "$ref": "#/$defs/AudioCodec",
                "description": "The codec."
              },
              "kbps": {
                "description": "The bit rate, in kilobits per second: 32..=320, else `invalid_argument`.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "codec",
              "kbps"
            ],
            "type": "object"
          },
          "EncoderProfile": {
            "description": "How an output's video and audio are encoded.\n\nAn output with no profile uses the engine's default, [`EncoderProfile::DEFAULT`]:\nH.264 at a constant 2500 kbit/s with a keyframe every 2 s on the software encoder,\nand AAC at 160 kbit/s.",
            "properties": {
              "audio": {
                "$ref": "#/$defs/AudioEncoding",
                "description": "The audio encoding."
              },
              "video": {
                "$ref": "#/$defs/VideoEncoding",
                "description": "The video encoding."
              }
            },
            "required": [
              "video",
              "audio"
            ],
            "type": "object"
          },
          "EncoderProfileId": {
            "description": "An encoder profile in the collection.",
            "type": "string"
          },
          "HardwarePreference": {
            "description": "Whether a video encoder runs on the GPU's encoder block. Serialized as a snake_case\nstring. Hardware encoders limit how many sessions run at once, per GPU vendor and\ndriver; the engine doesn't guess that limit, and `output.status` reports the\nhardware sessions in use.",
            "oneOf": [
              {
                "const": "prefer",
                "description": "Hardware if there is one, else software.",
                "type": "string"
              },
              {
                "const": "require",
                "description": "Hardware only: `output.start` fails when there is none.",
                "type": "string"
              },
              {
                "const": "avoid",
                "description": "Software only.",
                "type": "string"
              }
            ]
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "RateControl": {
            "description": "How a video encoder spends bits. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Constant bit rate, as RTMP ingest expects.",
                "properties": {
                  "kbps": {
                    "description": "The target, in kilobits per second.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "cbr",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kbps"
                ],
                "type": "object"
              },
              {
                "description": "Variable bit rate with a peak, for a recording.",
                "properties": {
                  "kbps": {
                    "description": "The average target, in kilobits per second.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "max_kbps": {
                    "description": "The peak, in kilobits per second; at least `kbps`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "vbr",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kbps",
                  "max_kbps"
                ],
                "type": "object"
              }
            ]
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "VideoCodec": {
            "description": "A video codec. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "h264",
                "description": "H.264 (AVC).",
                "type": "string"
              }
            ]
          },
          "VideoEncoding": {
            "description": "How the video is encoded.",
            "properties": {
              "codec": {
                "$ref": "#/$defs/VideoCodec",
                "description": "The codec."
              },
              "hardware": {
                "$ref": "#/$defs/HardwarePreference",
                "default": "avoid",
                "description": "Whether to use a hardware encoder. Omitted means `avoid`."
              },
              "keyframe_interval_s": {
                "description": "Seconds from one keyframe to the next, 1..=10, else `invalid_argument`. Most\nstreaming services ask for 2.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "rate_control": {
                "$ref": "#/$defs/RateControl",
                "description": "How the encoder spends bits. Rejected with `invalid_argument` outside\n100..=100000 kbit/s, or, for `vbr`, with a peak below the average or above\n200000 kbit/s."
              }
            },
            "required": [
              "codec",
              "rate_control",
              "keyframe_interval_s"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `encoder` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds an encoder profile. Inverse: `encoder.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "profile": {
                    "$ref": "#/$defs/EncoderProfile",
                    "description": "The encoding. Out-of-range values, and codecs or rate controls the engine\ndoesn't know, are rejected with `invalid_argument`."
                  },
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The new profile's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "encoder.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id",
                  "name",
                  "profile"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an encoder profile's name and encoding. Running outputs keep their\nencoder sessions; the new encoding applies from each output's next\n`output.start`. Inverse: `encoder.update` with the previous name and encoding.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "profile": {
                    "$ref": "#/$defs/EncoderProfile",
                    "description": "The new encoding, validated as in `encoder.create`."
                  },
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The profile to change."
                  },
                  "type": {
                    "const": "encoder.update",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id",
                  "name",
                  "profile"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an encoder profile. Rejected with `invalid_argument` while an output\nuses it: point those outputs elsewhere with `output.set_encoder` first (in the\nsame batch if needed). Inverse: `encoder.create` with its name and encoding.",
                "properties": {
                  "profile_id": {
                    "$ref": "#/$defs/EncoderProfileId",
                    "description": "The profile to delete."
                  },
                  "type": {
                    "const": "encoder.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "profile_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's encoder profiles, ordered by ID.",
                "properties": {
                  "type": {
                    "const": "encoder.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "encoder"
    },
    {
      "description": "Returns the engine's events after the cursor `after`, oldest first, without waiting: `state.changed` (the state `rev` moved; `client_id` and `request_id` say whose batch did it), `studio.changed` (another scene went on program) and `output.state_changed`, from every client, yours included, and `events.dropped` (the server dropped `count` events because this session fell behind; re-read the state). The once-a-second `stats.tick` is not in `events`: each read returns the newest one as `stats` (running drop totals). Each comes with a `seq`, a sequence number of this MCP server, starting at 1 when your first call opened the session. Pass the returned `next` as `after` to read on; omit `after` (or pass 0) to read from the oldest kept. At most 100 events come back at once; `more` says others are waiting. The server keeps the last 1000: `dropped` counts events after your cursor that were discarded before you read them, so re-read the state if it is not 0. `ended` means the session is gone and no more events will come.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "The `next` of your previous read; 0 or omitted for the oldest kept event.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "events"
    },
    {
      "description": "Runs one `folder` operation: set `op.type` to one of `folder.create` (edit), `folder.rename` (edit), `folder.set_parent` (edit), `folder.reorder` (edit), `folder.delete` (edit). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "FolderId": {
            "description": "A folder of the scene list (ADR-0024 §3). Folders organise only.",
            "type": "string"
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `folder` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds a folder to the scene list, last in folder order (ADR-0024 §3). Folders\norganise only: they change no rendering, switching or nesting. Inverse:\n`folder.delete`.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The new folder's ID, chosen by the client. Rejected if it exists."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The folder it sits in, which must exist, else `not_found`. Omitted means top\nlevel."
                  },
                  "type": {
                    "const": "folder.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a folder. Inverse: `folder.rename` back to the previous name.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to rename."
                  },
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "folder.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Moves a folder into another folder, or to the top level. A parent that would put\nthe folder inside itself is `invalid_argument` (field `parent`), and a parent that\ndoesn't exist `not_found`. Inverse: `folder.set_parent` with the previous parent.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to move."
                  },
                  "parent": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Its new parent. Absent or `null` means top level."
                  },
                  "type": {
                    "const": "folder.set_parent",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a folder to another position in folder order. The folders in one parent\nshow in that order. Inverse: `folder.reorder` back to its previous index.",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to move."
                  },
                  "index": {
                    "description": "The new position, counted from the first folder (0). Must be less than the\nnumber of folders, else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "folder.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an empty folder. Rejected with `invalid_argument` while a scene or another\nfolder sits in it, listing them as `blockers`: move them out first, or send the\nbatch `delete.plan` returns, which moves them up to the folder's parent. Inverse:\n`folder.create` with its name and parent, then `folder.reorder` to its old\nposition (unless it was last).",
                "properties": {
                  "folder_id": {
                    "$ref": "#/$defs/FolderId",
                    "description": "The folder to delete."
                  },
                  "type": {
                    "const": "folder.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "folder_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "folder"
    },
    {
      "description": "Runs one `history` operation: set `op.type` to one of `history.undo` (history call), `history.redo` (history call). Undo and redo apply to this session's own edits only, never another client's: each raises the state `rev` by one, and is refused with `undo_conflict` when another client has since changed what the step touched (the step is then dropped), or `history_empty` when there is nothing to undo or redo. They accept `expected_rev` and `idempotency_key`. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `history` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Undoes the client's most recent step that is not undone yet: applies its inverse\nand moves it to the redo stack. Fails with `history_empty` when there is none, and\nwith `undo_conflict` when another client has since changed what the step touched.",
                "properties": {
                  "type": {
                    "const": "history.undo",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "Applies the client's most recently undone step again and moves it back to the\nundo stack. The client's next batch clears what can be redone.",
                "properties": {
                  "type": {
                    "const": "history.redo",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "history"
    },
    {
      "description": "Runs one `item` operation: set `op.type` to one of `item.add` (edit), `item.remove` (edit), `item.move` (edit), `item.set_transform` (edit), `item.set_geometry` (edit), `item.set_visible` (edit), `item.reorder` (edit), `item.set_source` (edit), `item.set_crop` (edit), `item.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "Crop": {
            "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
            "properties": {
              "bottom": {
                "description": "Pixels cut from the bottom edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "left": {
                "description": "Pixels cut from the left edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "right": {
                "description": "Pixels cut from the right edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "top": {
                "description": "Pixels cut from the top edge.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "type": "object"
          },
          "Finite32": {
            "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
            "format": "float",
            "type": "number"
          },
          "FitMode": {
            "description": "How the cropped source fills the item's box.\n\nThe three values are the complete set. A new one is a string-enum addition.",
            "oneOf": [
              {
                "const": "stretch",
                "description": "Fill the box exactly, ignoring the source's aspect ratio.",
                "type": "string"
              },
              {
                "const": "fit",
                "description": "The largest rectangle of the source's aspect ratio that fits inside the box,\ncentred. The rest of the box stays transparent.",
                "type": "string"
              },
              {
                "const": "fill",
                "description": "The smallest rectangle of the source's aspect ratio that covers the box,\ncentred. The part outside the box is clipped by the compositor.",
                "type": "string"
              }
            ]
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "ItemGeometry": {
            "description": "Where a scene item sits on the canvas: its box, the fit of the source inside that\nbox, and the 3D placement ADR-0022 defines.\n\n`center`, `size` and `rotation_deg` alone define the box, so selection handles need\nno source size. The 3D fields default to neutral (no tilt, turn or depth, and no\nperspective). The formula below still evaluates a non-neutral value; drawing it is\nthe compositor's M3 work, and until then the engine rejects it. [`Self::is_neutral_3d`]\nis that check. A negative `size` is rejected, not read as a flip.\n\nEvery number is a [`Finite32`]. On the wire, omitted `fit_mode` and angles mean the\ndefaults below, and omitted `perspective_px` means orthographic.",
            "properties": {
              "center": {
                "$ref": "#/$defs/Vec2",
                "description": "Centre of the box, in canvas pixels."
              },
              "depth_px": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Offset along the viewing axis, in pixels. Positive is toward the viewer.\nDefault 0."
              },
              "fit_mode": {
                "$ref": "#/$defs/FitMode",
                "default": "fit",
                "description": "How the cropped source fills the box. Default [`FitMode::Fit`]."
              },
              "perspective_px": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Finite32"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Distance from the viewer to the canvas plane, for this item only. Absent means\northographic. When present it must be greater than zero."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Clockwise rotation in the canvas plane, in degrees, about [`Self::center`].\nDefault 0."
              },
              "size": {
                "$ref": "#/$defs/Size",
                "description": "Width and height of the box, in canvas pixels. Each must be greater than zero."
              },
              "tilt_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Rotation about the box's horizontal axis through the centre, in degrees.\nPositive moves the top edge away from the viewer. Default 0."
              },
              "turn_deg": {
                "$ref": "#/$defs/Finite32",
                "default": 0.0,
                "description": "Rotation about the box's vertical axis through the centre, in degrees.\nPositive moves the right edge away from the viewer. Default 0."
              }
            },
            "required": [
              "center",
              "size"
            ],
            "type": "object"
          },
          "ItemId": {
            "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
            "type": "string"
          },
          "ItemTransform": {
            "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n**Deprecated** since 0.11 (ADR-0022) and removed in 1.0, with `item.set_transform`,\n`item.add`'s `transform` and `ItemInfo.transform`. Until then it keeps the meaning\nbelow.\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
            "properties": {
              "position": {
                "$ref": "#/$defs/Vec2",
                "description": "Top-left corner, in pixels of the scene's canvas."
              },
              "rotation_deg": {
                "$ref": "#/$defs/Finite32",
                "description": "Clockwise rotation, in degrees."
              },
              "scale": {
                "$ref": "#/$defs/Vec2",
                "description": "Scale factors; 1.0 is the source's native size."
              }
            },
            "required": [
              "position",
              "scale",
              "rotation_deg"
            ],
            "type": "object"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "Size": {
            "description": "A width and height, in canvas pixels.\n\nBoth components are [`Finite32`]. A non-positive component is rejected by\n[`ItemGeometry::validate`], not stored as a flip.",
            "properties": {
              "height": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical extent. Must be greater than zero for a placement to be valid."
              },
              "width": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal extent. Must be greater than zero for a placement to be valid."
              }
            },
            "required": [
              "width",
              "height"
            ],
            "type": "object"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "Vec2": {
            "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
            "properties": {
              "x": {
                "$ref": "#/$defs/Finite32",
                "description": "Horizontal component."
              },
              "y": {
                "$ref": "#/$defs/Finite32",
                "description": "Vertical component."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `item` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.\n\nThe item's placement is `geometry` when that is sent, else a legacy placement:\n`transform`, or [`ItemTransform::IDENTITY`] when both are omitted (ADR-0022).\nSending both is `invalid_argument`.",
                "properties": {
                  "geometry": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemGeometry"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The initial placement as a box on the canvas, checked like\n`item.set_geometry`'s."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The new item's ID, chosen by the client. Rejected if it exists."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to add to."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source the item shows."
                  },
                  "transform": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/ItemTransform"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `geometry`. The\ninitial legacy placement, with its 0.3 meaning."
                  },
                  "type": {
                    "const": "item.add",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Removes an item from its scene. The source itself stays. Inverse: `item.add` with\nthe removed item's scene, ID and source, and its placement in the field matching\nits form (`transform` or `geometry`), then `item.reorder` to its old stacking\nposition (unless it was on top), `item.set_crop` if it was cropped, and\n`item.set_visible` if it was hidden.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to remove."
                  },
                  "type": {
                    "const": "item.remove",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to a stacking position in another scene, keeping its ID, source,\nplacement, crop and visibility (ADR-0024 §1). Grouping is a batch that creates a\ngroup scene, places it, and moves the selected items into it. Rejected with\n`invalid_argument` if the move would make a scene contain itself (field\n`scene_id`, naming the cycle) or if the index is out of range. Inverse:\n`item.move` back to its previous scene and index.",
                "properties": {
                  "index": {
                    "description": "Its position in that scene after the move, counted from the bottom (0). Must\nbe at most the number of items already in that scene (less than it for the\nitem's own scene), else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move it to. Its own scene is allowed, and then the move is an\n`item.reorder`."
                  },
                  "type": {
                    "const": "item.move",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `item.set_geometry`.\nReplaces an item's placement with a legacy one, which keeps its 0.3 meaning.\nInverse: the previous placement, as `item.set_transform` if it was legacy and\n`item.set_geometry` if it was a geometry.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "transform": {
                    "$ref": "#/$defs/ItemTransform",
                    "description": "The new transform."
                  },
                  "type": {
                    "const": "item.set_transform",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "transform"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's placement with a box on the canvas (ADR-0022). A size that is\nnot greater than zero, a `perspective_px` that is not greater than zero, and any\nnon-neutral `tilt_deg`, `turn_deg`, `depth_px` or `perspective_px` (the\ncompositor does not draw 3D yet) are `invalid_argument`. Inverse: the previous\nplacement, as `item.set_geometry` if it was a geometry and `item.set_transform`\nif it was legacy.",
                "properties": {
                  "geometry": {
                    "$ref": "#/$defs/ItemGeometry",
                    "description": "The new geometry."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to place."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "type": {
                    "const": "item.set_geometry",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "geometry"
                ],
                "type": "object"
              },
              {
                "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to show or hide."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change, as every placement edit\ntakes it (ADR-0024 §2). Omitted, or the item's own scene, changes the item.\nAny other scene is `invalid_argument` until keyframe scenes exist, when naming\na keyframe scene of the item's scene will write that scene's override."
                  },
                  "type": {
                    "const": "item.set_visible",
                    "type": "string"
                  },
                  "visible": {
                    "description": "Whether the item is drawn. Items are visible when added.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "visible"
                ],
                "type": "object"
              },
              {
                "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to move."
                  },
                  "type": {
                    "const": "item.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Changes which source an item places, keeping the item's ID, transform, crop,\nvisibility and stacking position (ADR-0023). It switches an item between a\nreference and a clone: `source.duplicate` then `item.set_source` to the copy makes\na clone, and `item.set_source` back to the copy's `duplicated_from` (then\n`source.delete` of the copy if nothing else places it) makes it a reference again.\nRejected with `not_found` if the item or the source doesn't exist, and with\n`invalid_argument` naming the cycle if the scene would then contain itself,\ndirectly or through other scenes. Inverse: `item.set_source` with the previous\nsource.",
                "properties": {
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to change."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source it places from now on."
                  },
                  "type": {
                    "const": "item.set_source",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
                "properties": {
                  "crop": {
                    "$ref": "#/$defs/Crop",
                    "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
                  },
                  "item_id": {
                    "$ref": "#/$defs/ItemId",
                    "description": "The item to crop."
                  },
                  "scene_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
                  },
                  "type": {
                    "const": "item.set_crop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "item_id",
                  "crop"
                ],
                "type": "object"
              },
              {
                "description": "Lists one scene's items, in stacking order (the first is at the bottom). Fails with\n`not_found` if the scene doesn't exist.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene whose items to list."
                  },
                  "type": {
                    "const": "item.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "item"
    },
    {
      "description": "Runs one `kind` operation: set `op.type` to one of `kind.list` (query), `kind.describe` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `kind` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Lists every kind the engine can create, ordered by ID. Kinds are not collection\nstate, so the result carries no `rev`.",
                "properties": {
                  "type": {
                    "const": "kind.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "description": "One kind's full descriptor, and a JSON Schema of its settings generated from it.\nFails with `invalid_argument` on `kind_id` if the engine has no such kind.",
                "properties": {
                  "kind_id": {
                    "description": "The kind to describe, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "kind.describe",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "kind"
    },
    {
      "description": "Runs one `label` operation: set `op.type` to one of `label.create` (edit), `label.update` (edit), `label.reorder` (edit), `label.delete` (edit). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "LabelId": {
            "description": "A label that sources carry (ADR-0024 §4).",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `label` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds a label, last in label order (ADR-0024 §4). Rejected with `invalid_argument`\nfor an empty name, a colour that isn't `#rrggbb`, or an icon checked as\n`scene.set_meta`'s. Inverse: `label.delete`.",
                "properties": {
                  "color": {
                    "description": "Its colour, sRGB as `#rrggbb`.",
                    "type": "string"
                  },
                  "icon": {
                    "description": "An icon name from the UI's icon set. Omitted means none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The new label's ID, chosen by the client. Rejected if it exists."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "label.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "name",
                  "color"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a label's name, colour and icon, validated as in `label.create`. Every\nsource carrying it shows the change. Inverse: `label.update` with the previous\nvalues.",
                "properties": {
                  "color": {
                    "description": "The new colour.",
                    "type": "string"
                  },
                  "icon": {
                    "description": "The new icon. Omitted means none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to change."
                  },
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "type": {
                    "const": "label.update",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "name",
                  "color"
                ],
                "type": "object"
              },
              {
                "description": "Moves a label to another position in label order. Inverse: `label.reorder` back\nto its previous index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first label (0). Must be less than the\nnumber of labels, else `invalid_argument`.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to move."
                  },
                  "type": {
                    "const": "label.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a label. Rejected with `invalid_argument` while a source carries it,\nlisting them as `blockers`: take it off those sources first, or send the batch\n`delete.plan` returns. Inverse: `label.create` with its name, colour and icon,\nthen `label.reorder` to its old position (unless it was last).",
                "properties": {
                  "label_id": {
                    "$ref": "#/$defs/LabelId",
                    "description": "The label to delete."
                  },
                  "type": {
                    "const": "label.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "label_id"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "label"
    },
    {
      "description": "Runs one `output` operation: set `op.type` to one of `output.create` (edit), `output.set_target` (edit), `output.delete` (edit), `output.set_encoder` (edit), `output.start` (action), `output.stop` (action), `output.set_key` (action), `output.clear_key` (action), `output.status` (query), `output.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. An action has side effects and is never undone; the answer only says it was accepted. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "EncoderProfileId": {
            "description": "An encoder profile in the collection.",
            "type": "string"
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "OutputId": {
            "description": "An output (RTMP(S), recording, virtual camera).",
            "type": "string"
          },
          "OutputKind": {
            "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL, recording to a file and the virtual camera are\nconfigurable so far. The YouTube-bound target of the data model comes later as a new\nvariant.",
            "oneOf": [
              {
                "description": "A stream sent over RTMP or RTMPS.",
                "properties": {
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The ingest server it publishes to."
                  },
                  "type": {
                    "const": "rtmp",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "A recording to a file on the engine's machine.",
                "properties": {
                  "container": {
                    "$ref": "#/$defs/RecordContainer",
                    "description": "The file format."
                  },
                  "path": {
                    "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists. The engine rejects, with `invalid_argument`, an empty or\nrelative path (absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one with control\ncharacters or a `..` segment, and one that ends in a separator or names no\nfile. `output.start` also fails when the path is not absolute on the\nengine's own machine.",
                    "type": "string"
                  },
                  "type": {
                    "const": "record",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "path",
                  "container"
                ],
                "type": "object"
              },
              {
                "description": "The virtual camera: the program video, offered to other apps on the engine's\nmachine as a webcam. Video only: it has no audio, no target and no stream key.\nIt runs at the canvas size the collection has when it starts, at 30 fps.\n`output.start` fails with `action_failed` when the engine has no virtual camera,\nwhen the camera is not registered on the machine, or when it can't offer that\nsize (the Windows camera offers only 1920×1080, the default canvas).",
                "properties": {
                  "type": {
                    "const": "virtual_cam",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          },
          "RecordContainer": {
            "description": "The file format a recording is written in. Serialized as a snake_case string.",
            "oneOf": [
              {
                "const": "mp4",
                "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
                "type": "string"
              }
            ]
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "RtmpTarget": {
            "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
            "oneOf": [
              {
                "description": "Any RTMP(S) ingest server, named by its server URL.",
                "properties": {
                  "type": {
                    "const": "generic",
                    "type": "string"
                  },
                  "url": {
                    "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "type": "object"
              }
            ]
          },
          "SecretString": {
            "description": "A secret string, such as a stream key, sent by a client to the engine.\n\nOn the wire it is a plain JSON string. In Rust it never prints: its `Debug` is\n`\"***\"`, it has no `Display`, and the only way to read it is [`expose`](Self::expose).\nA value that is not a string fails to parse with a message that doesn't repeat it.\nThe engine never sends one back (R-SEC-001).",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `output` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
                "properties": {
                  "kind": {
                    "$ref": "#/$defs/OutputKind",
                    "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The new output's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "output.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept.\nInverse: `output.set_target` with the previous target.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "target": {
                    "$ref": "#/$defs/RtmpTarget",
                    "description": "The new target, validated as in `output.create`."
                  },
                  "type": {
                    "const": "output.set_target",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "target"
                ],
                "type": "object"
              },
              {
                "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key stays in the credential store, so undoing the delete restores a\nworking output; `output.clear_key` removes it. Inverse: `output.create` with its\nkind.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to delete."
                  },
                  "type": {
                    "const": "output.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Chooses the encoder profile an output uses, or the engine's default. A running\noutput keeps its encoder session; the profile applies from its next\n`output.start`. Inverse: `output.set_encoder` with the previous profile.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to change."
                  },
                  "profile_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/EncoderProfileId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "The profile, which must exist, else `not_found`. Absent or `null` means the\nengine's default."
                  },
                  "type": {
                    "const": "output.set_encoder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Starts an output (stream, recording or virtual camera).",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to start."
                  },
                  "type": {
                    "const": "output.start",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Stops an output.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to stop."
                  },
                  "type": {
                    "const": "output.stop",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Stores an output's stream key in the OS credential store (R-SEC-001), replacing\nany key it had. Write-only: the key never comes back in a response, event, error,\n`state.get` or log, and `output.status` reports only `key_set`. An action, not an\nedit: the key is not collection state, so it is never undone. A running output\nuses the new key from its next `output.start`. Fails with `not_found` for an\noutput not in the collection, `invalid_argument` (field `key`) for an empty key,\none over 1024 bytes or one with whitespace or control characters, and\n`action_failed` when the engine has no credential store or the store refuses.",
                "properties": {
                  "key": {
                    "$ref": "#/$defs/SecretString",
                    "description": "The stream key, as the streaming service shows it."
                  },
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output whose key to set."
                  },
                  "type": {
                    "const": "output.set_key",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id",
                  "key"
                ],
                "type": "object"
              },
              {
                "description": "Removes an output's stream key from the credential store. Succeeds when there is\nnone, and for an output that is no longer in the collection, so a client can clear\nthe key of an output it deleted. Fails with `action_failed` when the engine has no\ncredential store or the store refuses.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output whose key to remove."
                  },
                  "type": {
                    "const": "output.clear_key",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Reports an output's current state, and whether its stream key is set. Fails with\n`not_found` for an output the engine doesn't know.",
                "properties": {
                  "output_id": {
                    "$ref": "#/$defs/OutputId",
                    "description": "The output to report on."
                  },
                  "type": {
                    "const": "output.status",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "output_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's outputs, ordered by ID, with what each is and where it\nsends. Outputs have no display order of their own.",
                "properties": {
                  "type": {
                    "const": "output.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "output"
    },
    {
      "description": "Runs one `scene` operation: set `op.type` to one of `scene.create` (edit), `scene.rename` (edit), `scene.set_role` (edit), `scene.delete` (edit), `scene.reorder` (edit), `scene.set_folder` (edit), `scene.set_meta` (edit), `scene.switch` (action), `scene.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. An action has side effects and is never undone; the answer only says it was accepted. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "FolderId": {
            "description": "A folder of the scene list (ADR-0024 §3). Folders organise only.",
            "type": "string"
          },
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "SceneRole": {
            "description": "What a scene is for (ADR-0024 §1). It changes no engine behaviour; it tells clients,\nagents and switchers how to show the scene.",
            "oneOf": [
              {
                "const": "scene",
                "description": "A scene of its own, listed in the scene list. Scenes are created with this role\nunless `scene.create` names another.",
                "type": "string"
              },
              {
                "const": "group",
                "description": "A group: a scene placed in other scenes to hold items together. Clients hide it\nfrom the scene list and show it under the items that place it.",
                "type": "string"
              }
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `scene` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Creates an empty scene. Inverse: `scene.delete`.",
                "properties": {
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "role": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SceneRole"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "What the scene is for (ADR-0024 §1). Omitted means `scene`."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The new scene's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "scene.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to rename."
                  },
                  "type": {
                    "const": "scene.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes what a scene is for (ADR-0024 §1): a `scene`, or a `group` placed in\nother scenes through a `scene` source. The role changes no engine behaviour: a\ngroup renders, nests and can be placed more than once like any scene, and clients\nhide groups from the scene list. Inverse: `scene.set_role` with the previous role.",
                "properties": {
                  "role": {
                    "$ref": "#/$defs/SceneRole",
                    "description": "Its new role."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to change."
                  },
                  "type": {
                    "const": "scene.set_role",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "role"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source shows it or any source's settings refer\nto it: delete those sources, or clear those references, first (in the same batch\nif needed). Inverse: `scene.create` with its role (omitted for `scene`), then\n`scene.reorder` to its old display position (unless it was last), `scene.set_folder`\nand `scene.set_meta` if it had a folder or metadata, then each deleted item's\n`item.remove` inverse, from bottom to top.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to delete."
                  },
                  "type": {
                    "const": "scene.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
                "properties": {
                  "index": {
                    "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to move."
                  },
                  "type": {
                    "const": "scene.reorder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id",
                  "index"
                ],
                "type": "object"
              },
              {
                "description": "Puts a scene in a folder, or takes it out of one. The scene keeps its position in\nthe flat display order. Inverse: `scene.set_folder` with the previous folder.",
                "properties": {
                  "folder_id": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/FolderId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The folder, which must exist, else `not_found`. Absent or `null` means none."
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to file."
                  },
                  "type": {
                    "const": "scene.set_folder",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a scene's organisation metadata: its icon, colour, favourite flag and\nwhether a multiview shows it. Every field left out takes its default. An icon\nthat is empty or longer than 64 bytes, or a colour that isn't\n`#rrggbb`, is `invalid_argument`. Inverse: `scene.set_meta` with the previous\nmetadata.",
                "properties": {
                  "color": {
                    "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "favourite": {
                    "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
                    "type": "boolean"
                  },
                  "icon": {
                    "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to change."
                  },
                  "show_in_multiview": {
                    "description": "Whether a multiview shows it. Omitted for `true`, the default.",
                    "type": "boolean"
                  },
                  "type": {
                    "const": "scene.set_meta",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Puts a scene on program, with a cut: the program mix (`video.snapshot`, and every\noutput that shows program) shows it from the next frame. The program scene is\nruntime state, not collection state (ADR-0030): the switch changes no `rev`, is\nnever undone, and emits `studio.changed`, which `studio.get` reads back. Switching\nto the scene already on program succeeds and emits nothing. Fails with\n`not_found` for a scene not in the collection.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene to put on program."
                  },
                  "type": {
                    "const": "scene.switch",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's scenes, in display order.",
                "properties": {
                  "type": {
                    "const": "scene.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "scene"
    },
    {
      "description": "Runs one `source` operation: set `op.type` to one of `source.create` (edit), `source.rename` (edit), `source.set_settings` (edit), `source.duplicate` (edit), `source.delete` (edit), `source.set_meta` (edit), `source.list` (query). An edit is applied as a batch of one: it is undoable, it raises the state `rev` by one, and it accepts `expected_rev` and `idempotency_key`. Use `batch` to apply several edits atomically. A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "$defs": {
          "IdempotencyKey": {
            "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
            "type": "string"
          },
          "LabelId": {
            "description": "A label that sources carry (ADR-0024 §4).",
            "type": "string"
          },
          "Rev": {
            "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "SceneId": {
            "description": "A scene in the collection.",
            "type": "string"
          },
          "Settings": {
            "additionalProperties": true,
            "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
            "type": "object"
          },
          "SourceId": {
            "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
            "type": "string"
          },
          "SourceKind": {
            "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
            "oneOf": [
              {
                "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
                "properties": {
                  "scene_id": {
                    "$ref": "#/$defs/SceneId",
                    "description": "The scene shown."
                  },
                  "type": {
                    "const": "scene",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "scene_id"
                ],
                "type": "object"
              },
              {
                "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
                "properties": {
                  "kind": {
                    "description": "The kind's ID, as `kind.list` reports it.",
                    "type": "string"
                  },
                  "type": {
                    "const": "builtin",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "kind"
                ],
                "type": "object"
              }
            ]
          }
        },
        "additionalProperties": false,
        "properties": {
          "expected_rev": {
            "anyOf": [
              {
                "$ref": "#/$defs/Rev"
              },
              {
                "type": "null"
              }
            ],
            "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
          },
          "idempotency_key": {
            "anyOf": [
              {
                "$ref": "#/$defs/IdempotencyKey"
              },
              {
                "type": "null"
              }
            ],
            "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
          },
          "op": {
            "description": "The `source` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. Inverse: `source.delete`.",
                "properties": {
                  "duplicated_from": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/SourceId"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The source this one was copied from, as `source.duplicate` records it. A plain\nlink: it may name a source that no longer exists (`source.delete`'s inverse\nrestores it that way), and is reported only while that source exists. It must\nnot name the new source itself, else `invalid_argument`. Omitted means none."
                  },
                  "kind": {
                    "$ref": "#/$defs/SourceKind",
                    "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
                  },
                  "name": {
                    "description": "Display name.",
                    "type": "string"
                  },
                  "settings": {
                    "$ref": "#/$defs/Settings",
                    "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The new source's ID, chosen by the client. Rejected if it exists."
                  },
                  "type": {
                    "const": "source.create",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name",
                  "kind"
                ],
                "type": "object"
              },
              {
                "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
                "properties": {
                  "name": {
                    "description": "The new display name.",
                    "type": "string"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to rename."
                  },
                  "type": {
                    "const": "source.rename",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
                "properties": {
                  "patch": {
                    "$ref": "#/$defs/Settings",
                    "description": "Parameter ID to new value, or `null` for the default."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_settings",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "patch"
                ],
                "type": "object"
              },
              {
                "description": "Copies a source under a new ID: a separate instance with the same kind and\nsettings, labels and favourite flag, which changes independently from then on.\nThe copy's `duplicated_from` names the source it was copied from. Placing the *same* source again is `item.add`\nwith its existing `source_id`. Inverse: `source.delete` of the copy.",
                "properties": {
                  "name": {
                    "description": "The copy's display name.",
                    "type": "string"
                  },
                  "new_source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The copy's ID, chosen by the client. Rejected if it exists."
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to copy."
                  },
                  "type": {
                    "const": "source.duplicate",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id",
                  "new_source_id",
                  "name"
                ],
                "type": "object"
              },
              {
                "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's settings refer to it: remove those items, or clear those\nreferences, first (in the same batch if needed). Deleting a source that others were\ncopied from is allowed: their `duplicated_from` then reads as absent. Inverse:\n`source.create` with its name, kind, settings and `duplicated_from`, then\n`source.set_meta` if it carried labels or was a favourite.",
                "properties": {
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to delete."
                  },
                  "type": {
                    "const": "source.delete",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Replaces a source's organisation metadata: the labels it carries and its\nfavourite flag. Every field left out takes its default, so `labels` omitted\nremoves them all. A label that doesn't exist is `not_found`, and one listed twice\n`invalid_argument`; the engine stores them ordered by ID. Inverse:\n`source.set_meta` with the previous metadata.",
                "properties": {
                  "favourite": {
                    "description": "Whether it is a favourite. Omitted for `false`.",
                    "type": "boolean"
                  },
                  "labels": {
                    "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
                    "items": {
                      "$ref": "#/$defs/LabelId"
                    },
                    "type": "array"
                  },
                  "source_id": {
                    "$ref": "#/$defs/SourceId",
                    "description": "The source to change."
                  },
                  "type": {
                    "const": "source.set_meta",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "source_id"
                ],
                "type": "object"
              },
              {
                "description": "Lists the collection's sources, ordered by ID. Sources have no display order of\ntheir own.",
                "properties": {
                  "type": {
                    "const": "source.list",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "source"
    },
    {
      "description": "Runs one `state` operation: set `op.type` to one of `state.get` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `state` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Reads the whole collection state (the canvas, every source, every scene with its\nitems, every output, every encoder profile, and the folders and labels) at one\nrevision: what a client\nreads on connecting, after a `state.changed` it didn't cause, or before an edit it\nsends with `expected_rev`.",
                "properties": {
                  "type": {
                    "const": "state.get",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "state"
    },
    {
      "description": "Runs one `studio` operation: set `op.type` to one of `studio.get` (query). A query only reads. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `studio` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "Reads the studio state: which scene is on program. It is runtime state, not\ncollection state (ADR-0030), so the result carries no `rev`.",
                "properties": {
                  "type": {
                    "const": "studio.get",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "studio"
    },
    {
      "description": "Runs one `video` operation: set `op.type` to one of `video.snapshot` (query). A query only reads. A `video.snapshot` result leads with the PNG as an image content block; its JSON `png` field only names that block. Failures come back as a tool error whose `error.code` is stable.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "description": "The `video` operation, tagged by `type`.",
            "oneOf": [
              {
                "description": "The current program mix, as a PNG.\n\nThe result's `png` is standard base64 with padding and no line breaks. `width`\nand `height` are that image's size in pixels; the longest side is at most 1280.\n`rev` is the collection revision of the layout the image shows. Source pixels are\nruntime state and can change without a new `rev`.",
                "properties": {
                  "type": {
                    "const": "video.snapshot",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "type": "object"
      },
      "name": "video"
    }
  ]
}
