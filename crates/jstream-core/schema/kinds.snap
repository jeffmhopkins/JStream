        "min": 0.0,
        "max": 2000.0,
        "unit": "px",
        "default": 16.0,
        "label": "Corner radius",
        "description": "In source pixels. Past half the shorter side it stays at half.",
        "live": true
      },
      {
        "id": "border_width",
        "type": "float",
        "min": 0.0,
        "max": 500.0,
        "unit": "px",
        "default": 0.0,
        "label": "Border width",
        "description": "Drawn inside the frame, over the picture. 0 is none.",
        "live": true
      },
      {
        "id": "border_color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Border color",
        "live": true
      }
    ]
  },
  {
    "kind_id": "scene_mask",
    "category": "video_filter",
    "name": "Scene mask",
    "version": 1,
    "video": true,
    "audio": false,
