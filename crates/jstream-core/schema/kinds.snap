---
source: crates/jstream-core/src/kinds.rs
---
[
  {
    "kind_id": "app_audio",
    "category": "source",
    "name": "Application audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "exe",
        "type": "string",
        "multiline": false,
        "max_len": 260,
        "default": "",
        "label": "Application",
        "description": "The application's executable file name, such as game.exe. It is found again when the application restarts.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "apply_lut",
    "category": "video_filter",
    "name": "Apply LUT",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "lut",
        "type": "asset",
        "accept": [
          "cube",
          "png"
        ],
        "default": null,
        "label": "LUT file",
        "live": true
      },
      {
        "id": "amount",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 1.0,
        "label": "Amount",
        "live": true
      }
    ]
  },
  {
    "kind_id": "aspect_ratio",
    "category": "video_filter",
    "name": "Aspect ratio",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "ratio",
        "type": "enum",
        "options": [
          {
            "value": "16:9",
            "label": "16:9 (widescreen)"
          },
          {
            "value": "9:16",
            "label": "9:16 (vertical)"
          },
          {
            "value": "4:3",
            "label": "4:3 (standard)"
          },
          {
            "value": "1:1",
            "label": "1:1 (square)"
          },
          {
            "value": "21:9",
            "label": "21:9 (ultrawide)"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "16:9",
        "label": "Ratio",
        "description": "The shape to give the frame, width:height.",
        "live": true
      },
      {
        "id": "custom_width",
        "type": "int",
        "min": 1,
        "max": 10000,
        "default": 4,
        "label": "Custom width",
        "description": "The width part of a custom ratio.",
        "visible_if": {
          "param": "ratio",
          "equals": "custom"
        },
        "live": true
      },
      {
        "id": "custom_height",
        "type": "int",
        "min": 1,
        "max": 10000,
        "default": 5,
        "label": "Custom height",
        "description": "The height part of a custom ratio.",
        "visible_if": {
          "param": "ratio",
          "equals": "custom"
        },
        "live": true
      },
      {
        "id": "mode",
        "type": "enum",
        "options": [
          {
            "value": "crop",
            "label": "Crop to fill"
          },
          {
            "value": "pad",
            "label": "Pad (letterbox or pillarbox)"
          },
          {
            "value": "stretch",
            "label": "Stretch"
          }
        ],
        "default": "crop",
        "label": "Mode",
        "description": "Crop cuts the long side down, pad adds bars to the short side, stretch resamples the whole frame.",
        "live": true
      },
      {
        "id": "anchor",
        "type": "enum",
        "options": [
          {
            "value": "center",
            "label": "Centre"
          },
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "top_left",
            "label": "Top left"
          },
          {
            "value": "top_right",
            "label": "Top right"
          },
          {
            "value": "bottom_left",
            "label": "Bottom left"
          },
          {
            "value": "bottom_right",
            "label": "Bottom right"
          }
        ],
        "default": "center",
        "label": "Anchor",
        "description": "Crop: the part of the frame kept. Pad: where the frame sits among the bars. Unused by stretch.",
        "live": true
      },
      {
        "id": "pad_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Pad colour",
        "description": "The colour of the bars; may be transparent.",
        "visible_if": {
          "param": "mode",
          "equals": "pad"
        },
        "live": true
      },
      {
        "id": "resampling",
        "type": "enum",
        "options": [
          {
            "value": "bilinear",
            "label": "Bilinear"
          },
          {
            "value": "bicubic",
            "label": "Bicubic"
          },
          {
            "value": "lanczos",
            "label": "Lanczos"
          }
        ],
        "default": "bicubic",
        "label": "Resampling",
        "description": "How stretch scales: bilinear, bicubic (Catmull-Rom) or Lanczos-3.",
        "visible_if": {
          "param": "mode",
          "equals": "stretch"
        },
        "live": true
      }
    ]
  },
  {
    "kind_id": "audio_input",
    "category": "source",
    "name": "Audio input",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "device",
        "type": "string",
        "multiline": false,
        "max_len": 512,
        "default": "",
        "label": "Device",
        "description": "The input device's ID. Empty follows the system's default input.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "blur",
    "category": "video_filter",
    "name": "Blur",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "radius",
        "type": "float",
        "min": 0.0,
        "max": 100.0,
        "unit": "px",
        "default": 8.0,
        "label": "Radius",
        "description": "How far each pixel spreads, in source pixels. Large radii blur a downsampled copy, so the cost stays bounded.",
        "live": true
      },
      {
        "id": "area",
        "type": "enum",
        "options": [
          {
            "value": "whole",
            "label": "Whole frame"
          },
          {
            "value": "inside",
            "label": "Inside the rectangle"
          },
          {
            "value": "outside",
            "label": "Outside the rectangle"
          }
        ],
        "default": "whole",
        "label": "Area",
        "group": "Area",
        "live": true
      },
      {
        "id": "area_x",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.25,
        "label": "Left",
        "group": "Area",
        "live": true
      },
      {
        "id": "area_y",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.25,
        "label": "Top",
        "group": "Area",
        "live": true
      },
      {
        "id": "area_width",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.5,
        "label": "Width",
        "group": "Area",
        "live": true
      },
      {
        "id": "area_height",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "default": 0.5,
        "label": "Height",
        "group": "Area",
        "live": true
      }
    ]
  },
  {
    "kind_id": "browser",
    "category": "source",
    "name": "Browser",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "url",
        "type": "string",
        "multiline": false,
        "max_len": 8192,
        "default": "",
        "label": "URL",
        "description": "The page's address, http:// or https://. Ignored when a local file is set.",
        "live": false
      },
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "html",
          "htm"
        ],
        "default": null,
        "label": "Local file",
        "description": "A local HTML file to show instead of a URL. The page can load files beside it.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      },
      {
        "id": "fps",
        "type": "int",
        "min": 1,
        "max": 60,
        "step": 1,
        "unit": "fps",
        "default": 30,
        "label": "Frame rate",
        "description": "The most frames a second the page paints. It paints less when nothing changes.",
        "live": false
      },
      {
        "id": "css",
        "type": "string",
        "multiline": true,
        "max_len": 65536,
        "default": "body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }",
        "label": "Custom CSS",
        "description": "CSS added to the page after it loads. The default makes the page's background transparent.",
        "live": true
      },
      {
        "id": "local_network",
        "type": "bool",
        "default": false,
        "label": "Allow local network",
        "description": "Let a page from the internet make requests to this computer and the local network (localhost, 192.168.x.x and the like), for widgets that talk to an app running here. Off, those requests are refused. A local file or a page on the local network may always.",
        "advanced": true,
        "live": false
      }
    ]
  },
  {
    "kind_id": "chat_message",
    "category": "source",
    "name": "Chat message",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font. None uses the bundled Roboto, which covers Latin text only.",
        "live": false
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 256.0,
        "step": 1.0,
        "unit": "px",
        "default": 32.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "author_color",
        "type": "color",
        "alpha": true,
        "default": "#ffd54fff",
        "label": "Author colour",
        "live": true
      },
      {
        "id": "text_color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Text colour",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#000000b3",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 16,
        "label": "Padding",
        "live": true
      },
      {
        "id": "max_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 600,
        "label": "Maximum width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline colour",
        "live": true
      }
    ]
  },
  {
    "kind_id": "chroma_key",
    "category": "video_filter",
    "name": "Chroma key",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "key_color_type",
        "type": "enum",
        "options": [
          {
            "value": "green",
            "label": "Green"
          },
          {
            "value": "blue",
            "label": "Blue"
          },
          {
            "value": "magenta",
            "label": "Magenta"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "green",
        "label": "Key color type",
        "live": true
      },
      {
        "id": "key_color",
        "type": "color",
        "alpha": false,
        "default": "#00ff00",
        "label": "Key color",
        "visible_if": {
          "param": "key_color_type",
          "equals": "custom"
        },
        "live": true
      },
      {
        "id": "similarity",
        "type": "int",
        "min": 1,
        "max": 1000,
        "default": 400,
        "label": "Similarity",
        "description": "How far in chroma from the key colour is removed, in thousandths.",
        "live": true
      },
      {
        "id": "smoothness",
        "type": "int",
        "min": 1,
        "max": 1000,
        "default": 80,
        "label": "Smoothness",
        "description": "How far past the similarity the edge fades back in, in thousandths.",
        "live": true
      },
      {
        "id": "spill",
        "type": "int",
        "min": 1,
        "max": 1000,
        "default": 100,
        "label": "Key color spill reduction",
        "description": "How far past the similarity kept colour is desaturated, removing the key colour's cast from edges.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "color",
    "category": "source",
    "name": "Colour",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Colour",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      }
    ]
  },
  {
    "kind_id": "color_correction",
    "category": "video_filter",
    "name": "Color correction",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "gamma",
        "type": "float",
        "min": -3.0,
        "max": 3.0,
        "default": 0.0,
        "label": "Gamma",
        "description": "Above 0 brightens the mid-tones, below 0 darkens them; black and white stay.",
        "live": true
      },
      {
        "id": "contrast",
        "type": "float",
        "min": -4.0,
        "max": 4.0,
        "default": 0.0,
        "label": "Contrast",
        "description": "0 is unchanged, -1 is flat grey; below -1 inverts.",
        "live": true
      },
      {
        "id": "brightness",
        "type": "float",
        "min": -1.0,
        "max": 1.0,
        "default": 0.0,
        "label": "Brightness",
        "description": "Added to every channel.",
        "live": true
      },
      {
        "id": "saturation",
        "type": "float",
        "min": -1.0,
        "max": 5.0,
        "default": 0.0,
        "label": "Saturation",
        "description": "0 is unchanged, -1 is greyscale.",
        "live": true
      },
      {
        "id": "hue_shift",
        "type": "float",
        "min": -180.0,
        "max": 180.0,
        "unit": "°",
        "default": 0.0,
        "label": "Hue shift",
        "description": "Rotates every colour around the grey axis; 120° turns red green.",
        "live": true
      },
      {
        "id": "multiply",
        "type": "color",
        "alpha": false,
        "default": "#ffffff",
        "label": "Multiply color",
        "description": "Multiplies each channel; white is unchanged. Sepia is saturation -1 times a warm colour.",
        "live": true
      },
      {
        "id": "opacity",
        "type": "float",
        "min": 0.0,
        "max": 100.0,
        "unit": "%",
        "default": 100.0,
        "label": "Opacity",
        "live": true
      }
    ]
  },
  {
    "kind_id": "color_key",
    "category": "video_filter",
    "name": "Color key",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "key_color",
        "type": "color",
        "alpha": false,
        "default": "#00ff00",
        "label": "Key color",
        "live": true
      },
      {
        "id": "similarity",
        "type": "int",
        "min": 1,
        "max": 1000,
        "default": 80,
        "label": "Similarity",
        "description": "How far in RGB from the key colour is removed, in thousandths.",
        "live": true
      },
      {
        "id": "smoothness",
        "type": "int",
        "min": 1,
        "max": 1000,
        "default": 50,
        "label": "Smoothness",
        "description": "How far past the similarity the edge fades back in, in thousandths.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "compressor",
    "category": "audio_filter",
    "name": "Compressor",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "threshold_db",
        "type": "float",
        "min": -60.0,
        "max": 0.0,
        "unit": "dB",
        "default": -18.0,
        "label": "Threshold",
        "live": true
      },
      {
        "id": "ratio",
        "type": "float",
        "min": 1.0,
        "max": 100.0,
        "unit": ":1",
        "default": 10.0,
        "label": "Ratio",
        "description": "Input dB over the threshold per output dB. 100 is a limiter's curve.",
        "live": true
      },
      {
        "id": "knee_db",
        "type": "float",
        "min": 0.0,
        "max": 24.0,
        "unit": "dB",
        "default": 6.0,
        "label": "Knee",
        "live": true
      },
      {
        "id": "attack_ms",
        "type": "float",
        "min": 0.0,
        "max": 500.0,
        "unit": "ms",
        "default": 6.0,
        "label": "Attack",
        "live": true
      },
      {
        "id": "release_ms",
        "type": "float",
        "min": 0.0,
        "max": 5000.0,
        "unit": "ms",
        "default": 60.0,
        "label": "Release",
        "live": true
      },
      {
        "id": "makeup_db",
        "type": "float",
        "min": 0.0,
        "max": 24.0,
        "unit": "dB",
        "default": 0.0,
        "label": "Makeup gain",
        "live": true
      }
    ]
  },
  {
    "kind_id": "delay",
    "category": "audio_filter",
    "name": "Delay",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "delay_ms",
        "type": "float",
        "min": 0.0,
        "max": 5000.0,
        "unit": "ms",
        "default": 0.0,
        "label": "Delay",
        "live": true
      }
    ]
  },
  {
    "kind_id": "desktop_audio",
    "category": "source",
    "name": "Desktop audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": []
  },
  {
    "kind_id": "display",
    "category": "source",
    "name": "Display capture",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "target",
        "type": "string",
        "multiline": false,
        "max_len": 1024,
        "default": "",
        "label": "Display",
        "description": "The ID of the display to capture, as `capture.targets` lists it. Empty captures the primary display.",
        "live": false
      },
      {
        "id": "show_cursor",
        "type": "bool",
        "default": true,
        "label": "Show cursor",
        "description": "Whether the pointer shows in the capture.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "drop_shadow",
    "category": "video_filter",
    "name": "Drop shadow",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#000000b3",
        "label": "Color",
        "live": true
      },
      {
        "id": "offset_x",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "unit": "px",
        "default": 8.0,
        "label": "Offset X",
        "live": true
      },
      {
        "id": "offset_y",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "unit": "px",
        "default": 8.0,
        "label": "Offset Y",
        "live": true
      },
      {
        "id": "blur",
        "type": "float",
        "min": 0.0,
        "max": 100.0,
        "unit": "px",
        "default": 8.0,
        "label": "Blur",
        "live": true
      }
    ]
  },
  {
    "kind_id": "gain",
    "category": "audio_filter",
    "name": "Gain",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "gain_db",
        "type": "float",
        "min": -96.0,
        "max": 24.0,
        "unit": "dB",
        "default": 0.0,
        "label": "Gain",
        "live": true
      }
    ]
  },
  {
    "kind_id": "glow",
    "category": "video_filter",
    "name": "Glow",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "radius",
        "type": "float",
        "min": 0.0,
        "max": 100.0,
        "unit": "px",
        "default": 16.0,
        "label": "Radius",
        "live": true
      },
      {
        "id": "strength",
        "type": "float",
        "min": 0.0,
        "max": 4.0,
        "default": 1.0,
        "label": "Strength",
        "description": "Multiplies the glow's opacity before it is clamped, so values above 1 widen its bright core.",
        "live": true
      }
    ]
  },
