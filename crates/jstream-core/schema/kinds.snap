        "min": 0.0,
        "max": 1.0,
        "default": 0.0,
        "label": "Luma min smooth",
        "live": true
      }
    ]
  },
  {
    "kind_id": "media",
    "category": "source",
    "name": "Media file",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "mp4",
          "mkv",
          "mov",
          "webm",
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg"
        ],
        "default": null,
        "label": "Media file",
