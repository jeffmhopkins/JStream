      },
      {
        "id": "loop",
        "type": "bool",
        "default": true,
        "label": "Loop",
        "live": true
      },
      {
        "id": "speed",
        "type": "float",
        "min": 0.25,
        "max": 4.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Speed",
        "description": "1 is normal speed.",
        "live": true
      },
      {
        "id": "restart_on_show",
        "type": "bool",
        "default": true,
        "label": "Restart when shown",
        "description": "Plays from the start each time the program shows it again.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "noise_gate",
    "category": "audio_filter",
    "name": "Noise gate",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "open_threshold_db",
        "type": "float",
        "min": -96.0,
        "max": 0.0,
        "unit": "dB",
        "default": -26.0,
        "label": "Open threshold",
        "live": true
      },
      {
        "id": "close_threshold_db",
        "type": "float",
        "min": -96.0,
        "max": 0.0,
        "unit": "dB",
        "default": -32.0,
        "label": "Close threshold",
        "description": "Where an open gate starts to close. Above the open threshold, it is the open threshold.",
        "live": true
      },
      {
        "id": "attack_ms",
        "type": "float",
        "min": 0.0,
        "max": 1000.0,
        "unit": "ms",
        "default": 25.0,
        "label": "Attack",
        "live": true
      },
      {
        "id": "hold_ms",
        "type": "float",
        "min": 0.0,
        "max": 5000.0,
        "unit": "ms",
        "default": 200.0,
        "label": "Hold",
        "live": true
      },
      {
        "id": "release_ms",
        "type": "float",
        "min": 0.0,
        "max": 5000.0,
        "unit": "ms",
        "default": 150.0,
        "label": "Release",
        "live": true
      },
      {
        "id": "range_db",
        "type": "float",
        "min": -96.0,
        "max": 0.0,
        "unit": "dB",
        "default": -96.0,
        "label": "Range",
        "description": "The level while closed. −96 dB is silence.",
        "live": true
      }
    ]
  },
