          },
          {
            "value": "luma",
            "label": "Luma matte"
          },
          {
            "value": "clip",
            "label": "Clip to scene"
          }
        ],
        "default": "alpha",
        "label": "Mode",
        "live": true
      },
      {
        "id": "invert",
        "type": "bool",
        "default": false,
