        "live": true
      }
    ]
  },
  {
    "kind_id": "scroll",
    "category": "video_filter",
    "name": "Scroll",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "speed_x",
        "type": "float",
        "min": -2000.0,
        "max": 2000.0,
        "unit": "px/s",
        "default": 0.0,
        "label": "Horizontal speed",
        "description": "Positive moves the picture right.",
        "live": true
      },
      {
        "id": "speed_y",
        "type": "float",
        "min": -2000.0,
        "max": 2000.0,
        "unit": "px/s",
        "default": 0.0,
        "label": "Vertical speed",
        "description": "Positive moves the picture down.",
        "live": true
      },
      {
        "id": "loop_x",
        "type": "bool",
        "default": true,
        "label": "Loop horizontally",
        "description": "Wrap the picture around. Off, the area it leaves is transparent.",
        "live": true
      },
      {
        "id": "loop_y",
        "type": "bool",
        "default": true,
        "label": "Loop vertically",
        "live": true
      }
    ]
  },
  {
    "kind_id": "sharpen",
    "category": "video_filter",
    "name": "Sharpen",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "amount",
        "type": "float",
        "min": 0.0,
        "max": 4.0,
        "default": 0.5,
        "label": "Amount",
        "description": "How far each pixel is pushed away from its neighbourhood's mean. 0 is unchanged.",
        "live": true
      },
      {
        "id": "radius",
        "type": "int",
        "min": 1,
        "max": 3,
        "unit": "px",
        "default": 1,
        "label": "Radius",
        "description": "The neighbourhood's half-width. Larger sharpens coarser detail.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "spectrum",
    "category": "source",
    "name": "Audio spectrum",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "audio",
        "type": "bus",
        "default": null,
        "label": "Audio",
        "description": "What it draws. None draws the program mix: the master after its filters, as the outputs hear it. A bus draws that bus after its fader, before the master's filters. Either is silent while no output runs.",
        "live": false
      },
      {
        "id": "audio_source",
        "type": "source",
        "media": "audio",
        "default": null,
        "label": "Audio source",
        "description": "A source to draw instead of the audio above: that source after its own filters, fader, mute and follow, before any bus, as the audience hears it. Silent while that source isn't playing into the mixer, and while no output runs.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 640,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 240,
        "label": "Height",
        "live": false
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Colour",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "bars",
        "type": "int",
        "min": 1,
        "max": 1024,
        "step": 1,
        "default": 64,
        "label": "Bars",
        "live": true
      },
      {
        "id": "smoothing",
        "type": "float",
        "min": 0.0,
        "max": 0.99,
        "step": 0.01,
        "default": 0.7,
        "label": "Smoothing",
        "description": "How slowly a bar falls back: 0 follows the audio exactly.",
        "live": true
      },
      {
        "id": "scale",
        "type": "enum",
        "options": [
          {
            "value": "log",
            "label": "Logarithmic"
          },
          {
            "value": "linear",
            "label": "Linear"
          }
        ],
        "default": "log",
        "label": "Scale",
        "description": "How frequencies spread across the bars: log gives each octave the same width from 20 Hz, as the ear hears them; linear gives each hertz the same width from 0 Hz.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "text",
    "category": "source",
    "name": "Text",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "text",
        "type": "string",
        "multiline": true,
        "max_len": 4096,
        "default": "",
        "label": "Text",
        "live": true
      },
      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font, or the first font of a collection. None uses the bundled Roboto.",
        "live": false
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 1024.0,
        "step": 1.0,
        "unit": "px",
        "default": 64.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Colour",
        "live": true
      },
      {
        "id": "align",
        "type": "enum",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centre"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Alignment",
        "live": true
      },
      {
        "id": "wrap_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Wrap width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline colour",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Padding",
        "live": true
      }
    ]
  },
  {
    "kind_id": "video_delay",
    "category": "video_filter",
    "name": "Video delay",
