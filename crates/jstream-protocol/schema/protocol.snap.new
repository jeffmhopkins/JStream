{
  "$defs": {
    "Action": {
      "description": "A command with side effects outside the collection state: never undoable and never\nbatchable.\n\nSerialized with an internal `type` tag holding the command name. The response only\nsays the action was accepted; how it goes is reported by events\n(`output.state_changed`).",
      "oneOf": [
        {
          "description": "Starts an output (stream, recording or virtual camera).",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to start."
            },
            "type": {
              "const": "output.start",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Stops an output.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to stop."
            },
            "type": {
              "const": "output.stop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Stores an output's stream key in the OS credential store (R-SEC-001), replacing\nany key it had. Write-only: the key never comes back in a response, event, error,\n`state.get` or log, and `output.status` reports only `key_set`. An action, not an\nedit: the key is not collection state, so it is never undone. A running output\nuses the new key from its next `output.start`. Fails with `not_found` for an\noutput not in the collection, `invalid_argument` (field `key`) for an empty key,\none over 1024 bytes or one with whitespace or control characters, and\n`action_failed` when the engine has no credential store or the store refuses.",
          "properties": {
            "key": {
              "$ref": "#/$defs/SecretString",
              "description": "The stream key, as the streaming service shows it."
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output whose key to set."
            },
            "type": {
              "const": "output.set_key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "Removes an output's stream key from the credential store. Succeeds when there is\nnone, and for an output that is no longer in the collection, so a client can clear\nthe key of an output it deleted. Fails with `action_failed` when the engine has no\ncredential store or the store refuses.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output whose key to remove."
            },
            "type": {
              "const": "output.clear_key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Restarts the master bus's integrated loudness measurement (ADR-0028). Meters are\nruntime state, so this is an action, never an edit. Succeeds, doing nothing, while\nthe mixer isn't running.",
          "properties": {
            "type": {
              "const": "audio.reset_loudness",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "AudioCodec": {
      "description": "An audio codec. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "aac",
          "description": "AAC-LC.",
          "type": "string"
        }
      ]
    },
    "AudioEncoding": {
      "description": "How the audio is encoded.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/AudioCodec",
          "description": "The codec."
        },
        "kbps": {
          "description": "The bit rate, in kilobits per second: 32..=320, else `invalid_argument`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "codec",
        "kbps"
      ],
      "type": "object"
    },
    "AudioFollow": {
      "description": "When a source's audio is heard (ADR-0028, D18). Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "always",
          "description": "Heard whether or not the source is on program: microphones and other audio\ninputs, desktop and application audio.",
          "type": "string"
        },
        {
          "const": "when_shown",
          "description": "Heard only while the source is shown on the Program mix, fading with the\ntransition that shows or hides it: browser, media, webcam audio and nested\nscenes.",
          "type": "string"
        }
      ]
    },
    "Batch": {
      "description": "One or more edits, applied atomically.\n\nThe engine checks `expected_rev`, then applies the edits in order, each against the\nstate the previous one left. If any edit fails, nothing is applied and `rev` doesn't\nchange. On success `rev` increases by exactly one, whatever the number of edits, and\nthe batch becomes one undo step for the sending client.",
      "properties": {
        "edits": {
          "description": "The edits, in order. An empty list is rejected with `empty_batch`.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "minItems": 1,
          "type": "array"
        },
        "expected_rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
        },
        "idempotency_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
        }
      },
      "required": [
        "edits"
      ],
      "type": "object"
    },
    "BusId": {
      "description": "An audio bus in the collection (ADR-0028). [`BusId::master`] names the master\nbus, which every collection has.",
      "type": "string"
    },
    "BusInfo": {
      "description": "One bus, as `bus.list` and `state.get` report it.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus's ID. The master bus's is `master`."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The bus fader, in dB, applied after the sum: from −100 to +24."
        },
        "muted": {
          "description": "Whether the bus is muted.",
          "type": "boolean"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        }
      },
      "required": [
        "bus_id",
        "name",
        "gain_db",
        "muted"
      ],
      "type": "object"
    },
    "BusMeter": {
      "description": "One bus's levels in a `meters.tick`, after its fader. Levels are linear full scale\nper channel, left then right.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus."
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Loudness"
            },
            {
              "type": "null"
            }
          ],
          "description": "The bus's loudness. Measured on the master bus only for now; absent on the\nothers."
        },
        "peak": {
          "description": "The largest absolute sample since the previous tick.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rms": {
          "description": "The RMS level over the most recent mixer block.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "true_peak": {
          "description": "The true peak since the previous tick (ITU-R BS.1770, 4× oversampled). Measured\non the master bus only for now; absent on the others.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "bus_id",
        "peak",
        "rms"
      ],
      "type": "object"
    },
    "Call": {
      "description": "What a request asks for. Tagged by `kind`, so the class of every call (ADR-0013) is\nexplicit on the wire.",
      "oneOf": [
        {
          "$ref": "#/$defs/Batch",
          "description": "Apply edits atomically. A single edit is a batch of one.",
          "properties": {
            "kind": {
              "const": "batch",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Perform one action.",
          "properties": {
            "action": {
              "$ref": "#/$defs/Action",
              "description": "The action."
            },
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "type": "object"
        },
        {
          "description": "Read something.",
          "properties": {
            "kind": {
              "const": "query",
              "type": "string"
            },
            "query": {
              "$ref": "#/$defs/Query",
              "description": "The query."
            }
          },
          "required": [
            "kind",
            "query"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/HistoryCall",
          "description": "Undo or redo one of this client's own steps (ADR-0032). Carries no command: the\nengine applies a batch of edits it already holds.",
          "properties": {
            "kind": {
              "const": "history",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CallResult": {
      "description": "The result of a [`Call`], tagged by the same `kind`.",
      "oneOf": [
        {
          "description": "The batch was applied (or had already been applied under its idempotency key).",
          "properties": {
            "kind": {
              "const": "batch",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the batch produced."
            }
          },
          "required": [
            "kind",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "The action was accepted. Its progress is reported by events.",
          "properties": {
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The query's answer.",
          "properties": {
            "kind": {
              "const": "query",
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/QueryResult",
              "description": "The result."
            }
          },
          "required": [
            "kind",
            "result"
          ],
          "type": "object"
        },
        {
          "description": "The undo or redo was applied (or had already been applied under its idempotency\nkey).",
          "properties": {
            "kind": {
              "const": "history",
              "type": "string"
            },
            "redo_depth": {
              "description": "How many steps the client can redo.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the undo or redo produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced. It names the step."
            },
            "undo_depth": {
              "description": "How many steps the client can still undo.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "rev",
            "step_rev",
            "undo_depth",
            "redo_depth"
          ],
          "type": "object"
        }
      ]
    },
    "Canvas": {
      "description": "The collection's canvas: every scene's coordinate space, in whole pixels.\n\nx points right and y down, with (0, 0) at the top-left corner. A `scene` source's\nnative size is the canvas size, and a mix renders the canvas fitted inside its\nresolution. Missing (from a server older than 0.11) parses as the 1920×1080 default.",
      "properties": {
        "height": {
          "description": "Height in pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "ClientId": {
      "description": "A connected client, assigned by the server in `welcome`. Undo history and the\naudit log are keyed by it.",
      "type": "string"
    },
    "ClientMessage": {
      "description": "A message from a client to the server. Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Hello",
          "description": "Opens the session. Must be the first message.",
          "properties": {
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Request",
          "description": "A batch of edits, an action or a query.",
          "properties": {
            "type": {
              "const": "request",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Crop": {
      "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
      "properties": {
        "bottom": {
          "description": "Pixels cut from the bottom edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "left": {
          "description": "Pixels cut from the left edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "right": {
          "description": "Pixels cut from the right edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "description": "Pixels cut from the top edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "type": "object"
    },
    "DropCounts": {
      "description": "Running totals of frames and packets the pipeline has dropped since the engine\nstarted (R-RT-004).\n\nEach field sums one kind of drop across every stage that counts it. A stage that\ndoes not count that kind contributes nothing. Totals only grow: a client computes\nan interval by subtracting the previous tick.\n\nSilence a stage inserts to cover a gap (an audio underrun, a device gap, encoder\ngap-fill) is not a drop and is not included.\n\nA missing field parses as 0, so a counter added in a later minor version can be left\nout by an older sender (R-API-001). Unknown fields are ignored.",
      "properties": {
        "audio_frames": {
          "default": 0,
          "description": "Audio frames dropped before the mixer consumed them: a device ring that\noverwrote unread frames, frames that arrived after the mixer had passed them,\nand frames the mixer skipped because it fell behind the clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "capture_frames": {
          "default": 0,
          "description": "Video frames a capture mailbox replaced before the reader took them.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encode_blocks": {
          "default": 0,
          "description": "Audio blocks dropped before an encoder accepted them (its input queue was full,\nor the encoder was busy).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encode_frames": {
          "default": 0,
          "description": "Video frames dropped before an encoder accepted them (its input queue was full,\nor the encoder was busy).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_packets": {
          "default": 0,
          "description": "Encoded packets dropped handing a stream to an output: a subscriber that fell\nbehind, or the output's own queue.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "render_ticks": {
          "default": 0,
          "description": "Render ticks the render loop skipped to catch up with the media clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Edit": {
      "description": "A change to the collection state: undoable, batchable and atomic.\n\nSerialized with an internal `type` tag holding the command name (`noun.verb`,\nR-API-002). Every variant documents its inverse. The engine (`jstream-graph`)\ncomputes the inverse from the state *before* the edit, so the protocol has to be\nclosed under inversion: every inverse must itself be a sequence of edits, and it is.\n\nPositions are indexes: scenes in display order (0 is first), items in stacking order\nwithin their scene (0 is the bottom).",
      "oneOf": [
        {
          "description": "Creates an empty scene. Inverse: `scene.delete`.",
          "properties": {
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The new scene's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "scene.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to rename."
            },
            "type": {
              "const": "scene.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes what a scene is for (ADR-0024 §1): a `scene`, or a `group` placed in\nother scenes through a `scene` source. The role changes no engine behaviour: a\ngroup renders, nests and can be placed more than once like any scene, and clients\nhide groups from the scene list. Inverse: `scene.set_role` with the previous role.",
          "properties": {
            "role": {
              "$ref": "#/$defs/SceneRole",
              "description": "Its new role."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_role",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "role"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source shows it or any source's settings refer\nto it: delete those sources, or clear those references, first (in the same batch\nif needed). Inverse: `scene.create`, then `scene.reorder` to its old\ndisplay position (unless it was last), `scene.set_role` if it was a group, then\neach deleted item's `item.remove` inverse, from bottom to top.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to delete."
            },
            "type": {
              "const": "scene.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.\n\nThe item's placement is `geometry` when that is sent, else a legacy placement:\n`transform`, or [`ItemTransform::IDENTITY`] when both are omitted (ADR-0022).\nSending both is `invalid_argument`.",
          "properties": {
            "geometry": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemGeometry"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The initial placement as a box on the canvas, checked like\n`item.set_geometry`'s."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The new item's ID, chosen by the client. Rejected if it exists."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to add to."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source the item shows."
            },
            "transform": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemTransform"
                },
                {
                  "type": "null"
                }
              ],
              "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `geometry`. The\ninitial legacy placement, with its 0.3 meaning."
            },
            "type": {
              "const": "item.add",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Removes an item from its scene. The source itself stays. Inverse: `item.add` with\nthe removed item's scene, ID and source, and its placement in the field matching\nits form (`transform` or `geometry`), then `item.reorder` to its old stacking\nposition (unless it was on top), `item.set_crop` if it was cropped, and\n`item.set_visible` if it was hidden.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to remove."
            },
            "type": {
              "const": "item.remove",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Moves an item to a stacking position in another scene, keeping its ID, source,\nplacement, crop and visibility (ADR-0024 §1). Grouping is a batch that creates a\ngroup scene, places it, and moves the selected items into it. Rejected with\n`invalid_argument` if the move would make a scene contain itself (field\n`scene_id`, naming the cycle) or if the index is out of range. Inverse:\n`item.move` back to its previous scene and index.",
          "properties": {
            "index": {
              "description": "Its position in that scene after the move, counted from the bottom (0). Must\nbe at most the number of items already in that scene (less than it for the\nitem's own scene), else `invalid_argument`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to move it to. Its own scene is allowed, and then the move is an\n`item.reorder`."
            },
            "type": {
              "const": "item.move",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "scene_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `item.set_geometry`.\nReplaces an item's placement with a legacy one, which keeps its 0.3 meaning.\nInverse: the previous placement, as `item.set_transform` if it was legacy and\n`item.set_geometry` if it was a geometry.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "transform": {
              "$ref": "#/$defs/ItemTransform",
              "description": "The new transform."
            },
            "type": {
              "const": "item.set_transform",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "transform"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an item's placement with a box on the canvas (ADR-0022). A size that is\nnot greater than zero, a `perspective_px` that is not greater than zero, and any\nnon-neutral `tilt_deg`, `turn_deg`, `depth_px` or `perspective_px` (the\ncompositor does not draw 3D yet) are `invalid_argument`. Inverse: the previous\nplacement, as `item.set_geometry` if it was a geometry and `item.set_transform`\nif it was legacy.",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/ItemGeometry",
              "description": "The new geometry."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to place."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_geometry",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "geometry"
          ],
          "type": "object"
        },
        {
          "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to show or hide."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change, as every placement edit\ntakes it (ADR-0024 §2). Omitted, or the item's own scene, changes the item.\nAny other scene is `invalid_argument` until keyframe scenes exist, when naming\na keyframe scene of the item's scene will write that scene's override."
            },
            "type": {
              "const": "item.set_visible",
              "type": "string"
            },
            "visible": {
              "description": "Whether the item is drawn. Items are visible when added.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "item_id",
            "visible"
          ],
          "type": "object"
        },
        {
          "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
          "properties": {
            "index": {
              "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "type": {
              "const": "item.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Changes which source an item places, keeping the item's ID, transform, crop,\nvisibility and stacking position (ADR-0023). It switches an item between a\nreference and a clone: `source.duplicate` then `item.set_source` to the copy makes\na clone, and `item.set_source` back to the copy's `duplicated_from` (then\n`source.delete` of the copy if nothing else places it) makes it a reference again.\nRejected with `not_found` if the item or the source doesn't exist, and with\n`invalid_argument` naming the cycle if the scene would then contain itself,\ndirectly or through other scenes. Inverse: `item.set_source` with the previous\nsource.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source it places from now on."
            },
            "type": {
              "const": "item.set_source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
          "properties": {
            "crop": {
              "$ref": "#/$defs/Crop",
              "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to crop."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_crop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "crop"
          ],
          "type": "object"
        },
        {
          "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. An audio source (its kind produces audio, or it is a `scene` source)\nstarts with its kind's default audio settings, and one that is not a `scene`\nsource sends to the master bus at 0 dB (ADR-0028). Inverse: `source.delete`.",
          "properties": {
            "duplicated_from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The source this one was copied from, as `source.duplicate` records it. A plain\nlink: it may name a source that no longer exists (`source.delete`'s inverse\nrestores it that way), and is reported only while that source exists. It must\nnot name the new source itself, else `invalid_argument`. Omitted means none."
            },
            "kind": {
              "$ref": "#/$defs/SourceKind",
              "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "settings": {
              "$ref": "#/$defs/Settings",
              "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The new source's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "source.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "name",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to rename."
            },
            "type": {
              "const": "source.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
          "properties": {
            "patch": {
              "$ref": "#/$defs/Settings",
              "description": "Parameter ID to new value, or `null` for the default."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to change."
            },
            "type": {
              "const": "source.set_settings",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "patch"
          ],
          "type": "object"
        },
        {
          "description": "Copies a source under a new ID: a separate instance with the same kind,\nsettings, audio settings and sends, which changes independently from then on. The copy's `duplicated_from`\nnames the source it was copied from. Placing the *same* source again is `item.add`\nwith its existing `source_id`. Inverse: `source.delete` of the copy.",
          "properties": {
            "name": {
              "description": "The copy's display name.",
              "type": "string"
            },
            "new_source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The copy's ID, chosen by the client. Rejected if it exists."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to copy."
            },
            "type": {
              "const": "source.duplicate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "new_source_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's settings refer to it: remove those items, or clear those\nreferences, first (in the same batch if needed). Deleting a source that others were\ncopied from is allowed: their `duplicated_from` then reads as absent. Its sends go\nwith it. Inverse: `source.create` with its name, kind, settings and\n`duplicated_from`, then `send.remove` of its master send if it had none,\n`send.set` for each send that `source.create` doesn't restore as it was, and\n`source.set_audio` if its audio settings were not the defaults.",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to delete."
            },
            "type": {
              "const": "source.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
          "properties": {
            "index": {
              "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to move."
            },
            "type": {
              "const": "scene.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/OutputKind",
              "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The new output's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "output.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept.\nInverse: `output.set_target` with the previous target.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "target": {
              "$ref": "#/$defs/RtmpTarget",
              "description": "The new target, validated as in `output.create`."
            },
            "type": {
              "const": "output.set_target",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "Changes the canvas: every scene's coordinate space, in whole pixels (ADR-0022).\nItems keep their canvas-pixel placements; nothing moves or resizes. Zero, or a\nside over the engine's maximum (at least 7680, both ways), is `invalid_argument`.\nInverse: `canvas.set_size` with the previous size.",
          "properties": {
            "height": {
              "description": "Canvas height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "canvas.set_size",
              "type": "string"
            },
            "width": {
              "description": "Canvas width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key stays in the credential store, so undoing the delete restores a\nworking output; `output.clear_key` removes it. Inverse: `output.create` with its\nkind.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to delete."
            },
            "type": {
              "const": "output.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Chooses the encoder profile an output uses, or the engine's default. A running\noutput keeps its encoder session; the profile applies from its next\n`output.start`. Inverse: `output.set_encoder` with the previous profile.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "profile_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EncoderProfileId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The profile, which must exist, else `not_found`. Absent or `null` means the\nengine's default."
            },
            "type": {
              "const": "output.set_encoder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds an encoder profile. Inverse: `encoder.delete`.",
          "properties": {
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "profile": {
              "$ref": "#/$defs/EncoderProfile",
              "description": "The encoding. Out-of-range values, and codecs or rate controls the engine\ndoesn't know, are rejected with `invalid_argument`."
            },
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The new profile's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "encoder.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id",
            "name",
            "profile"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an encoder profile's name and encoding. Running outputs keep their\nencoder sessions; the new encoding applies from each output's next\n`output.start`. Inverse: `encoder.update` with the previous name and encoding.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "profile": {
              "$ref": "#/$defs/EncoderProfile",
              "description": "The new encoding, validated as in `encoder.create`."
            },
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The profile to change."
            },
            "type": {
              "const": "encoder.update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id",
            "name",
            "profile"
          ],
          "type": "object"
        },
        {
          "description": "Deletes an encoder profile. Rejected with `invalid_argument` while an output\nuses it: point those outputs elsewhere with `output.set_encoder` first (in the\nsame batch if needed). Inverse: `encoder.create` with its name and encoding.",
          "properties": {
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The profile to delete."
            },
            "type": {
              "const": "encoder.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id"
          ],
          "type": "object"
        },
        {
          "description": "Changes some of an audio source's settings (ADR-0028): the fields sent change,\nthe others keep their values, and sending none is `invalid_argument`. A source\nwithout audio is `invalid_argument` on `source_id`. A `scene` source has no fader\nor mute of its own, so `gain_db` or `muted` on one is `invalid_argument`, and so\nis a gain outside −100 to +24 dB. Inverse: `source.set_audio`\nwith the previous values of the fields sent.",
          "properties": {
            "enabled": {
              "description": "Whether the engine opens the source's audio. Off keeps its sends, inactive.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "follow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AudioFollow"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the source is heard."
            },
            "gain_db": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The fader, in dB."
            },
            "muted": {
              "description": "Whether it is muted.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to change."
            },
            "type": {
              "const": "source.set_audio",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a bus, at 0 dB, unmuted, with no sends into it. A collection holds at most\n16 buses, the master included; one more is `invalid_argument`. Inverse:\n`bus.delete`.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The new bus's ID, chosen by the client. Rejected if it exists, so `master` is\nalways taken."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "type": {
              "const": "bus.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Renames a bus, the master included. Inverse: `bus.rename` back to the previous\nname.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to rename."
            },
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "type": {
              "const": "bus.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes a bus's fader or mute, the master's included: the fields sent change,\nand sending neither is `invalid_argument`, as is a gain outside −100 to +24 dB.\nInverse: `bus.set_fader` with the previous values of the fields sent.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to change."
            },
            "gain_db": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The fader, in dB, applied after the bus's sum."
            },
            "muted": {
              "description": "Whether the bus is muted.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "const": "bus.set_fader",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a bus and every send into it. The master bus can't be deleted\n(`invalid_argument`). Inverse: `bus.create` with its name, `bus.set_fader` if\nits fader or mute were not the defaults, then `send.set` for each send it had.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to delete."
            },
            "type": {
              "const": "bus.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "Sends a source into a bus at a gain, post-fader, or changes that send's gain.\nThe source must be an audio source that is not a `scene` source, which has no\nsends of its own (`invalid_argument` on `source_id`), and the gain must be from\n−100 to +24 dB. Buses never feed other buses (ADR-0028), so sends can't form a\ncycle. Inverse: `send.remove` for a new send, else `send.set` with the previous\ngain.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus it sends into."
            },
            "gain_db": {
              "$ref": "#/$defs/Finite32",
              "description": "The send's gain, in dB."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source sending."
            },
            "type": {
              "const": "send.set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "bus_id",
            "gain_db"
          ],
          "type": "object"
        },
        {
          "description": "Stops a source sending into a bus. No such send is `invalid_argument` on\n`bus_id`. Inverse: `send.set` with its gain.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus it sends into."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source sending."
            },
            "type": {
              "const": "send.remove",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "bus_id"
          ],
          "type": "object"
        }
      ]
    },
    "EncoderProfile": {
      "description": "How an output's video and audio are encoded.\n\nAn output with no profile uses the engine's default, [`EncoderProfile::DEFAULT`]:\nH.264 at a constant 2500 kbit/s with a keyframe every 2 s on the software encoder,\nand AAC at 160 kbit/s.",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioEncoding",
          "description": "The audio encoding."
        },
        "video": {
          "$ref": "#/$defs/VideoEncoding",
          "description": "The video encoding."
        }
      },
      "required": [
        "video",
        "audio"
      ],
      "type": "object"
    },
    "EncoderProfileId": {
      "description": "An encoder profile in the collection.",
      "type": "string"
    },
    "EncoderProfileInfo": {
      "description": "One encoder profile, as `encoder.list` and `state.get` report it.",
      "properties": {
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/EncoderProfile",
          "description": "The encoding it describes."
        },
        "profile_id": {
          "$ref": "#/$defs/EncoderProfileId",
          "description": "The profile's ID."
        }
      },
      "required": [
        "profile_id",
        "name",
        "profile"
      ],
      "type": "object"
    },
    "EncoderSessionInfo": {
      "description": "The encoder session a running output uses, as `output.status` reports it.",
      "properties": {
        "hardware": {
          "description": "Whether the session's video encoder is a hardware one.",
          "type": "boolean"
        },
        "profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncoderProfileId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The profile the session was opened with, or absent for the engine's default.\nThe profile's settings at the time count: an output started after\n`encoder.update` gets a session of its own."
        },
        "shared_with": {
          "default": [],
          "description": "The other running outputs that share this session, ordered by ID. Empty when\nthe output has the session to itself.",
          "items": {
            "$ref": "#/$defs/OutputId"
          },
          "type": "array"
        }
      },
      "required": [
        "hardware"
      ],
      "type": "object"
    },
    "EntityKind": {
      "description": "The kinds of object an error can name.",
      "oneOf": [
        {
          "const": "scene",
          "description": "A scene.",
          "type": "string"
        },
        {
          "const": "item",
          "description": "A scene item.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "A source.",
          "type": "string"
        },
        {
          "const": "output",
          "description": "An output.",
          "type": "string"
        },
        {
          "const": "encoder",
          "description": "An encoder profile.",
          "type": "string"
        },
        {
          "const": "bus",
          "description": "An audio bus.",
          "type": "string"
        }
      ]
    },
    "EnumOption": {
      "description": "One option of an [`ParamType::Enum`].",
      "properties": {
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "value": {
          "description": "The value stored in settings.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "description": "A failed request, a failed handshake, or a message that couldn't be parsed.",
      "properties": {
        "error": {
          "$ref": "#/$defs/WireError",
          "description": "What went wrong."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The failed request's ID. Absent when the failure isn't tied to a request (the\nhandshake, or a message too broken to read an ID from)."
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Event": {
      "description": "Something that happened in the engine.\n\nSerialized with an internal `type` tag holding the event name (`noun.past_tense`).\nClients must ignore events they don't know: a newer server may send new ones in a\nminor version, and they parse as [`Event::Unknown`].",
      "oneOf": [
        {
          "description": "The collection state moved to a new revision: one per applied batch (or undo).\nClients holding a copy of the state re-query, or apply the change if they made it.",
          "properties": {
            "cause": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HistoryDirection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`undo` or `redo` when a history call made the change; absent for a batch."
            },
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The new revision."
            },
            "type": {
              "const": "state.changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "An output changed state, for example after `output.start`.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "state": {
              "$ref": "#/$defs/OutputState",
              "description": "Its new state."
            },
            "type": {
              "const": "output.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "This connection's queued events were dropped because the client read them too\nslowly: the server keeps a bounded buffer per connection and empties it when it\noverflows. `state.changed` events may be among those lost, so the client re-reads\nthe state with `state.get`, which carries `rev`. Drops that happen before the\nnotice is sent add up in that one notice. Only events are dropped: every request\nstill gets its answer. Sent by the WebSocket server, never by an in-process engine.",
          "properties": {
            "count": {
              "description": "How many events were dropped.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "events.dropped",
              "type": "string"
            }
          },
          "required": [
            "type",
            "count"
          ],
          "type": "object"
        },
        {
          "description": "A sample of the pipeline's drop counters (R-RT-004).\n\n`drops` is a running total since the engine started, not the count since the\nprevious tick. A client that misses one subtracts the last tick it did see.\n`seq` starts at 1 and increases by one per sample, so a gap means a missed tick\nand not a reset. The engine sends it when its control thread asks, about once a\nsecond once the media pipeline is running. Until event subscriptions exist, every\nclient receives it.",
          "properties": {
            "drops": {
              "$ref": "#/$defs/DropCounts",
              "description": "Running drop totals."
            },
            "seq": {
              "description": "Monotonic sample number, starting at 1.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "stats.tick",
              "type": "string"
            }
          },
          "required": [
            "type",
            "seq",
            "drops"
          ],
          "type": "object"
        },
        {
          "description": "The mixer's levels (ADR-0028): sent about ten times a second while the mixer runs\n(an output is running), and never while it doesn't. Runtime state: a client that\nmisses one just shows the next. Until event subscriptions exist, every client\nreceives it.",
          "properties": {
            "buses": {
              "default": [],
              "description": "Each bus, ordered by ID, the master among them.",
              "items": {
                "$ref": "#/$defs/BusMeter"
              },
              "type": "array"
            },
            "sources": {
              "default": [],
              "description": "Each audio source with a mixer channel, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceMeter"
              },
              "type": "array"
            },
            "type": {
              "const": "meters.tick",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EventMessage": {
      "description": "An event, as pushed to clients.",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event",
          "description": "The event."
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "Finite32": {
      "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
      "format": "float",
      "type": "number"
    },
    "FitMode": {
      "description": "How the cropped source fills the item's box.\n\nThe three values are the complete set. A new one is a string-enum addition.",
      "oneOf": [
        {
          "const": "stretch",
          "description": "Fill the box exactly, ignoring the source's aspect ratio.",
          "type": "string"
        },
        {
          "const": "fit",
          "description": "The largest rectangle of the source's aspect ratio that fits inside the box,\ncentred. The rest of the box stays transparent.",
          "type": "string"
        },
        {
          "const": "fill",
          "description": "The smallest rectangle of the source's aspect ratio that covers the box,\ncentred. The part outside the box is clipped by the compositor.",
          "type": "string"
        }
      ]
    },
    "HardwarePreference": {
      "description": "Whether a video encoder runs on the GPU's encoder block. Serialized as a snake_case\nstring. Hardware encoders limit how many sessions run at once, per GPU vendor and\ndriver; the engine doesn't guess that limit, and `output.status` reports the\nhardware sessions in use.",
      "oneOf": [
        {
          "const": "prefer",
          "description": "Hardware if there is one, else software.",
          "type": "string"
        },
        {
          "const": "require",
          "description": "Hardware only: `output.start` fails when there is none.",
          "type": "string"
        },
        {
          "const": "avoid",
          "description": "Software only.",
          "type": "string"
        }
      ]
    },
    "Hello": {
      "description": "The client's opening message.",
      "properties": {
        "client_name": {
          "description": "A name for the client (`jstream-cli`, `claude-desktop`), shown in the audit log.",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the client speaks."
        }
      },
      "required": [
        "protocol",
        "client_name"
      ],
      "type": "object"
    },
    "HistoryCall": {
      "description": "An undo or redo request, sent as `{\"kind\":\"history\",\"op\":{\"type\":\"history.undo\"}}`.",
      "properties": {
        "expected_rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`.\nChecked before anything else about the history. Omitted means apply against\nwhatever is current."
        },
        "idempotency_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Makes a retry safe, sharing the client's batch keys: a retried undo whose answer\nwas lost gets the original result and does not undo a second step."
        },
        "op": {
          "$ref": "#/$defs/HistoryOp",
          "description": "Which way to move through the client's history."
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "HistoryDirection": {
      "description": "A direction through a client's history: the `cause` of a `state.changed` that an\nundo or redo produced, and the `direction` of a `history_empty` error.",
      "oneOf": [
        {
          "const": "undo",
          "description": "Backward: an undo.",
          "type": "string"
        },
        {
          "const": "redo",
          "description": "Forward again: a redo.",
          "type": "string"
        }
      ]
    },
    "HistoryOp": {
      "description": "What a [`HistoryCall`] asks for. Serialized with an internal `type` tag holding the\ncall's name (`history.undo`).",
      "oneOf": [
        {
          "description": "Undoes the client's most recent step that is not undone yet: applies its inverse\nand moves it to the redo stack. Fails with `history_empty` when there is none, and\nwith `undo_conflict` when another client has since changed what the step touched.",
          "properties": {
            "type": {
              "const": "history.undo",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Applies the client's most recently undone step again and moves it back to the\nundo stack. The client's next batch clears what can be redone.",
          "properties": {
            "type": {
              "const": "history.redo",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "IdempotencyKey": {
      "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
      "type": "string"
    },
    "ItemGeometry": {
      "description": "Where a scene item sits on the canvas: its box, the fit of the source inside that\nbox, and the 3D placement ADR-0022 defines.\n\n`center`, `size` and `rotation_deg` alone define the box, so selection handles need\nno source size. The 3D fields default to neutral (no tilt, turn or depth, and no\nperspective). The formula below still evaluates a non-neutral value; drawing it is\nthe compositor's M3 work, and until then the engine rejects it. [`Self::is_neutral_3d`]\nis that check. A negative `size` is rejected, not read as a flip.\n\nEvery number is a [`Finite32`]. On the wire, omitted `fit_mode` and angles mean the\ndefaults below, and omitted `perspective_px` means orthographic.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Vec2",
          "description": "Centre of the box, in canvas pixels."
        },
        "depth_px": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Offset along the viewing axis, in pixels. Positive is toward the viewer.\nDefault 0."
        },
        "fit_mode": {
          "$ref": "#/$defs/FitMode",
          "default": "fit",
          "description": "How the cropped source fills the box. Default [`FitMode::Fit`]."
        },
        "perspective_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distance from the viewer to the canvas plane, for this item only. Absent means\northographic. When present it must be greater than zero."
        },
        "rotation_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Clockwise rotation in the canvas plane, in degrees, about [`Self::center`].\nDefault 0."
        },
        "size": {
          "$ref": "#/$defs/Size",
          "description": "Width and height of the box, in canvas pixels. Each must be greater than zero."
        },
        "tilt_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Rotation about the box's horizontal axis through the centre, in degrees.\nPositive moves the top edge away from the viewer. Default 0."
        },
        "turn_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Rotation about the box's vertical axis through the centre, in degrees.\nPositive moves the right edge away from the viewer. Default 0."
        }
      },
      "required": [
        "center",
        "size"
      ],
      "type": "object"
    },
    "ItemId": {
      "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
      "type": "string"
    },
    "ItemInfo": {
      "description": "One item, a placement of a source in a scene, as `item.list` and `state.get` report\nit. It carries every property an edit can set.",
      "properties": {
        "crop": {
          "$ref": "#/$defs/Crop",
          "description": "How much of the source it cuts off."
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemGeometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stored geometry. Absent for a legacy item, whose box depends on the source's\nruntime size."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "The item's ID."
        },
        "placement": {
          "$ref": "#/$defs/PlacementForm",
          "default": "legacy",
          "description": "Which form its placement is stored in. Missing (from a server older than 0.11)\nparses as `legacy`."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source it places."
        },
        "transform": {
          "$ref": "#/$defs/ItemTransform",
          "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: read `geometry`. For a\nlegacy item, the stored transform exactly as written. For a geometry item, a\nview computed from the geometry alone: the box's rotated top-left corner, its\nrotation, and scale (1, 1)."
        },
        "visible": {
          "description": "Whether it is drawn.",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "source_id",
        "transform",
        "crop",
        "visible"
      ],
      "type": "object"
    },
    "ItemTransform": {
      "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n**Deprecated** since 0.11 (ADR-0022) and removed in 1.0, with `item.set_transform`,\n`item.add`'s `transform` and `ItemInfo.transform`. Until then it keeps the meaning\nbelow.\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "description": "Top-left corner, in pixels of the scene's canvas."
        },
        "rotation_deg": {
          "$ref": "#/$defs/Finite32",
          "description": "Clockwise rotation, in degrees."
        },
        "scale": {
          "$ref": "#/$defs/Vec2",
          "description": "Scale factors; 1.0 is the source's native size."
        }
      },
      "required": [
        "position",
        "scale",
        "rotation_deg"
      ],
      "type": "object"
    },
    "KindCategory": {
      "description": "What a kind is: a source kind, or a filter kind for video or audio.",
      "oneOf": [
        {
          "const": "source",
          "description": "A source kind (`source.create` with `builtin { kind }`).",
          "type": "string"
        },
        {
          "const": "video_filter",
          "description": "A video filter kind.",
          "type": "string"
        },
        {
          "const": "audio_filter",
          "description": "An audio filter kind.",
          "type": "string"
        }
      ]
    },
    "KindDescriptor": {
      "description": "Everything a client needs to show and edit one kind's settings.",
      "properties": {
        "audio": {
          "description": "Whether the kind produces audio.",
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/KindCategory",
          "description": "What the kind is."
        },
        "kind_id": {
          "description": "The kind's ID, as in [`KindSummary::kind_id`].",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "params": {
          "description": "The parameters, in display order. Their IDs are unique within the kind.",
          "items": {
            "$ref": "#/$defs/ParamDescriptor"
          },
          "type": "array"
        },
        "version": {
          "description": "The descriptor's version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "description": "Whether the kind produces video.",
          "type": "boolean"
        }
      },
      "required": [
        "kind_id",
        "category",
        "name",
        "version",
        "video",
        "audio",
        "params"
      ],
      "type": "object"
    },
    "KindSummary": {
      "description": "One kind in a `kind.list` result.",
      "properties": {
        "category": {
          "$ref": "#/$defs/KindCategory",
          "description": "What the kind is."
        },
        "kind_id": {
          "description": "The kind's ID: a bare name for a built-in kind (`image`), `<pack>/<effect>` for a\npack kind.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "version": {
          "description": "The descriptor's version. Stored settings record the version they were written\nwith.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind_id",
        "category",
        "name",
        "version"
      ],
      "type": "object"
    },
    "Loudness": {
      "description": "BS.1770 loudness, in LUFS. Each value is absent until enough audio has been measured\nfor it, and while the signal is below the absolute gate (−70 LUFS).",
      "properties": {
        "integrated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gated integrated loudness since the mixer started or the last\n`audio.reset_loudness`."
        },
        "momentary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Momentary loudness, over the last 400 ms."
        },
        "short_term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Short-term loudness, over the last 3 s."
        }
      },
      "type": "object"
    },
    "Media": {
      "description": "What a source produces, for restricting a source reference.",
      "oneOf": [
        {
          "const": "video",
          "description": "Pictures.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound.",
          "type": "string"
        }
      ]
    },
    "OutputId": {
      "description": "An output (RTMP(S), recording, virtual camera).",
      "type": "string"
    },
    "OutputInfo": {
      "description": "One output, as `output.list` and `state.get` report it: its collection state.\nWhether it runs, and whether its stream key is set, are in `output.status`.",
      "properties": {
        "encoder_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncoderProfileId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The encoder profile it uses (`output.set_encoder`). Absent means the engine's\ndefault, as from a server older than 0.13."
        },
        "kind": {
          "$ref": "#/$defs/OutputKind",
          "description": "What it is and where it sends."
        },
        "output_id": {
          "$ref": "#/$defs/OutputId",
          "description": "The output's ID."
        }
      },
      "required": [
        "output_id",
        "kind"
      ],
      "type": "object"
    },
    "OutputKind": {
      "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL and recording to a file are configurable so far. The\nvirtual camera and the YouTube-bound target of the data model come later as new\nvariants.",
      "oneOf": [
        {
          "description": "A stream sent over RTMP or RTMPS.",
          "properties": {
            "target": {
              "$ref": "#/$defs/RtmpTarget",
              "description": "The ingest server it publishes to."
            },
            "type": {
              "const": "rtmp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "A recording to a file on the engine's machine.",
          "properties": {
            "container": {
              "$ref": "#/$defs/RecordContainer",
              "description": "The file format."
            },
            "path": {
              "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists. The engine rejects, with `invalid_argument`, an empty or\nrelative path (absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one with control\ncharacters or a `..` segment, and one that ends in a separator or names no\nfile. `output.start` also fails when the path is not absolute on the\nengine's own machine.",
              "type": "string"
            },
            "type": {
              "const": "record",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "container"
          ],
          "type": "object"
        }
      ]
    },
    "OutputState": {
      "description": "The lifecycle state of an output.",
      "oneOf": [
        {
          "const": "stopped",
          "description": "Not running.",
          "type": "string"
        },
        {
          "const": "starting",
          "description": "Started and connecting or initializing.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Running: streaming, recording or feeding the virtual camera.",
          "type": "string"
        },
        {
          "const": "reconnecting",
          "description": "Lost its connection and is retrying.",
          "type": "string"
        },
        {
          "const": "stopping",
          "description": "Stopping: flushing and disconnecting.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Stopped because of an error. The error is in the audit log.",
          "type": "string"
        }
      ]
    },
    "ParamDescriptor": {
      "description": "One parameter of a kind.",
      "oneOf": [
        {
          "description": "`true` or `false`.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A whole number.",
          "properties": {
            "max": {
              "description": "Largest allowed value.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "min": {
              "description": "Smallest allowed value.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "step": {
              "description": "UI hint: the increment a control steps by.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "int",
              "type": "string"
            },
            "unit": {
              "description": "Display unit (`px`, `ms`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A finite number.",
          "properties": {
            "max": {
              "description": "Largest allowed value.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "description": "Smallest allowed value.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "step": {
              "description": "UI hint: the increment a control steps by.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "float",
              "type": "string"
            },
            "unit": {
              "description": "Display unit (`dB`, `%`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One of a fixed set of strings.",
          "properties": {
            "options": {
              "description": "The allowed values, in display order.",
              "items": {
                "$ref": "#/$defs/EnumOption"
              },
              "type": "array"
            },
            "type": {
              "const": "enum",
              "type": "string"
            }
          },
          "required": [
            "type",
            "options"
          ],
          "type": "object"
        },
        {
          "description": "A colour: `#rrggbb`, or `#rrggbbaa` when `alpha` is true.",
          "properties": {
            "alpha": {
              "description": "Whether the value may carry an alpha byte.",
              "type": "boolean"
            },
            "type": {
              "const": "color",
              "type": "string"
            }
          },
          "required": [
            "type",
            "alpha"
          ],
          "type": "object"
        },
        {
          "description": "Text.",
          "properties": {
            "max_len": {
              "description": "Longest allowed value, in characters.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "multiline": {
              "default": false,
              "description": "UI hint: shown as multi-line text.",
              "type": "boolean"
            },
            "type": {
              "const": "string",
              "type": "string"
            }
          },
          "required": [
            "type",
            "max_len"
          ],
          "type": "object"
        },
        {
          "description": "A file reference (`{\"type\":\"asset\",\"root\":…,\"path\":…}`) or `null`.",
          "properties": {
            "accept": {
              "default": [],
              "description": "The accepted file extensions, lower case without the dot (`png`). Empty\naccepts any file.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "asset",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A scene reference (`{\"type\":\"scene\",\"scene_id\":…}`) or `null`.",
          "properties": {
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A source reference (`{\"type\":\"source\",\"source_id\":…}`) or `null`.",
          "properties": {
            "media": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Media"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Accept only sources that produce this. Omitted accepts any source."
            },
            "type": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "advanced": {
          "description": "UI hint: shown only among advanced settings.",
          "type": "boolean"
        },
        "default": {
          "description": "The value a new source gets when it doesn't set this parameter."
        },
        "description": {
          "description": "A longer explanation for UIs and agents.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "UI hint: the group to show it in.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Unique within the kind, and stable across versions.",
          "type": "string"
        },
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "live": {
          "default": false,
          "description": "Whether a change applies without restarting the source or filter (a colour), or\nrestarts it (a capture device). `live.set` may override a live parameter during a\ngesture (ADR-0032).",
          "type": "boolean"
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisibleIf"
            },
            {
              "type": "null"
            }
          ],
          "description": "UI hint: shown only while another parameter has a given value."
        }
      },
      "required": [
        "id",
        "default",
        "label"
      ],
      "type": "object"
    },
    "PlacementForm": {
      "description": "Which of the two forms an item's stored placement has (ADR-0022 decision 5).\n\nThe two values are the complete set until 1.0, which removes `legacy`.",
      "oneOf": [
        {
          "const": "legacy",
          "description": "A 0.3 `ItemTransform`, evaluated every frame against the source's current size.\nWhat a server older than 0.11 stores, so a missing field parses as this.",
          "type": "string"
        },
        {
          "const": "geometry",
          "description": "An [`ItemGeometry`]: a box on the canvas.",
          "type": "string"
        }
      ]
    },
    "ProtocolVersion": {
      "description": "A protocol version: `major.minor`. Patch releases never change the wire format, so\nthey are not part of it.",
      "properties": {
        "major": {
          "description": "Incremented by a breaking change (a removal or rename).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "Incremented by an addition.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Query": {
      "description": "A read. Queries change nothing, so they need no classification as edit or action.\n\nSerialized with an internal `type` tag holding the query name (`noun.verb`).",
      "oneOf": [
        {
          "description": "Lists the collection's scenes, in display order.",
          "properties": {
            "type": {
              "const": "scene.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reports an output's current state, and whether its stream key is set. Fails with\n`not_found` for an output the engine doesn't know.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to report on."
            },
            "type": {
              "const": "output.status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's sources, ordered by ID. Sources have no display order of\ntheir own.",
          "properties": {
            "type": {
              "const": "source.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists one scene's items, in stacking order (the first is at the bottom). Fails with\n`not_found` if the scene doesn't exist.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene whose items to list."
            },
            "type": {
              "const": "item.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Reads the whole collection state (the canvas, every source, every scene with its\nitems, every output, every encoder profile, and the buses and sends) at one\nrevision: what a client\nreads on connecting, after a `state.changed` it didn't cause, or before an edit it\nsends with `expected_rev`.",
          "properties": {
            "type": {
              "const": "state.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The current program mix, as a PNG.\n\nThe result's `png` is standard base64 with padding and no line breaks. `width`\nand `height` are that image's size in pixels; the longest side is at most 1280.\n`rev` is the collection revision of the layout the image shows. Source pixels are\nruntime state and can change without a new `rev`.",
          "properties": {
            "type": {
              "const": "video.snapshot",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists every kind the engine can create, ordered by ID. Kinds are not collection\nstate, so the result carries no `rev`.",
          "properties": {
            "type": {
              "const": "kind.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One kind's full descriptor, and a JSON Schema of its settings generated from it.\nFails with `invalid_argument` on `kind_id` if the engine has no such kind.",
          "properties": {
            "kind_id": {
              "description": "The kind to describe, as `kind.list` reports it.",
              "type": "string"
            },
            "type": {
              "const": "kind.describe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind_id"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's outputs, ordered by ID, with what each is and where it\nsends. Outputs have no display order of their own.",
          "properties": {
            "type": {
              "const": "output.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's encoder profiles, ordered by ID.",
          "properties": {
            "type": {
              "const": "encoder.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's audio buses, ordered by ID, and every send into them.",
          "properties": {
            "type": {
              "const": "bus.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "QueryResult": {
      "description": "The result of a [`Query`]. Its `type` tag repeats the query's name.",
      "oneOf": [
        {
          "description": "The result of `scene.list`.",
          "properties": {
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "scenes": {
              "description": "The scenes, in display order.",
              "items": {
                "$ref": "#/$defs/SceneSummary"
              },
              "type": "array"
            },
            "type": {
              "const": "scene.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "scenes"
          ],
          "type": "object"
        },
        {
          "description": "The result of `output.status`. Output state is runtime state, not collection\nstate, so it carries no `rev`.",
          "properties": {
            "encoder": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EncoderSessionInfo"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The encoder session the output uses while it runs: which profile, and which\nother running outputs share it. Absent while it isn't running, and from a\nserver older than 0.13."
            },
            "encoder_sessions": {
              "default": 0,
              "description": "How many video encoder sessions the engine has open now, for every output,\nand how many of them are hardware ones. Hardware encoders cap their\nconcurrent sessions per GPU vendor and driver, and the engine doesn't guess\nthe cap. Missing (from a server older than 0.13) parses as 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "hardware_sessions": {
              "default": 0,
              "description": "Of `encoder_sessions`, the hardware ones. Missing parses as 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "key_set": {
              "default": false,
              "description": "Whether the credential store holds a stream key for it. The key itself is\nnever reported. Missing (from a server older than 0.7) parses as `false`.",
              "type": "boolean"
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output reported on."
            },
            "state": {
              "$ref": "#/$defs/OutputState",
              "description": "Its current state."
            },
            "type": {
              "const": "output.status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The result of `source.list`.",
          "properties": {
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "sources": {
              "description": "The sources, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "source.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "sources"
          ],
          "type": "object"
        },
        {
          "description": "The result of `item.list`.",
          "properties": {
            "items": {
              "description": "Its items, in stacking order: the first is at the bottom.",
              "items": {
                "$ref": "#/$defs/ItemInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene listed."
            },
            "type": {
              "const": "item.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "scene_id",
            "items"
          ],
          "type": "object"
        },
        {
          "description": "The result of `state.get`: the whole collection state at one revision.",
          "properties": {
            "buses": {
              "default": [],
              "description": "Every audio bus, ordered by ID, the master among them. Missing (from a\nserver older than 0.21) parses as empty.",
              "items": {
                "$ref": "#/$defs/BusInfo"
              },
              "type": "array"
            },
            "canvas": {
              "$ref": "#/$defs/Canvas",
              "default": {
                "height": 1080,
                "width": 1920
              },
              "description": "The canvas every scene is laid out on. Missing (from a server older than 0.11)\nparses as 1920×1080."
            },
            "encoders": {
              "default": [],
              "description": "Every encoder profile, ordered by ID. Missing (from a server older than\n0.13) parses as empty.",
              "items": {
                "$ref": "#/$defs/EncoderProfileInfo"
              },
              "type": "array"
            },
            "outputs": {
              "default": [],
              "description": "Every output, ordered by ID. Missing (from a server older than 0.7) parses\nas empty.",
              "items": {
                "$ref": "#/$defs/OutputInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the state was read at."
            },
            "scenes": {
              "description": "Every scene with its items, in display order.",
              "items": {
                "$ref": "#/$defs/SceneInfo"
              },
              "type": "array"
            },
            "sends": {
              "default": [],
              "description": "Every send, ordered by bus, then by source. Missing (from a server older\nthan 0.21) parses as empty.",
              "items": {
                "$ref": "#/$defs/SendInfo"
              },
              "type": "array"
            },
            "sources": {
              "description": "Every source, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "state.get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "sources",
            "scenes"
          ],
          "type": "object"
        },
        {
          "description": "The result of `video.snapshot`: the program mix encoded as a PNG.",
          "properties": {
            "height": {
              "description": "PNG height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "png": {
              "description": "The PNG file, standard base64 with padding and no line breaks.",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The collection revision of the layout this image shows."
            },
            "type": {
              "const": "video.snapshot",
              "type": "string"
            },
            "width": {
              "description": "PNG width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "rev",
            "width",
            "height",
            "png"
          ],
          "type": "object"
        },
        {
          "description": "The result of `kind.list`.",
          "properties": {
            "kinds": {
              "description": "Every kind, ordered by ID.",
              "items": {
                "$ref": "#/$defs/KindSummary"
              },
              "type": "array"
            },
            "type": {
              "const": "kind.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kinds"
          ],
          "type": "object"
        },
        {
          "description": "The result of `kind.describe`.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/KindDescriptor",
              "description": "The kind's descriptor."
            },
            "settings_schema": {
              "description": "A JSON Schema (draft 2020-12) of a complete settings map of this kind,\ngenerated from `kind`."
            },
            "type": {
              "const": "kind.describe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "settings_schema"
          ],
          "type": "object"
        },
        {
          "description": "The result of `output.list`.",
          "properties": {
            "outputs": {
              "description": "The outputs, ordered by ID.",
              "items": {
                "$ref": "#/$defs/OutputInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "type": {
              "const": "output.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "outputs"
          ],
          "type": "object"
        },
        {
          "description": "The result of `encoder.list`.",
          "properties": {
            "encoders": {
              "description": "The profiles, ordered by ID.",
              "items": {
                "$ref": "#/$defs/EncoderProfileInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "type": {
              "const": "encoder.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "encoders"
          ],
          "type": "object"
        },
        {
          "description": "The result of `bus.list`.",
          "properties": {
            "buses": {
              "description": "The buses, ordered by ID, the master among them.",
              "items": {
                "$ref": "#/$defs/BusInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "sends": {
              "description": "Every send, ordered by bus, then by source.",
              "items": {
                "$ref": "#/$defs/SendInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "bus.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "buses",
            "sends"
          ],
          "type": "object"
        }
      ]
    },
    "RateControl": {
      "description": "How a video encoder spends bits. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Constant bit rate, as RTMP ingest expects.",
          "properties": {
            "kbps": {
              "description": "The target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps"
          ],
          "type": "object"
        },
        {
          "description": "Variable bit rate with a peak, for a recording.",
          "properties": {
            "kbps": {
              "description": "The average target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "max_kbps": {
              "description": "The peak, in kilobits per second; at least `kbps`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "vbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps",
            "max_kbps"
          ],
          "type": "object"
        }
      ]
    },
    "RecordContainer": {
      "description": "The file format a recording is written in. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "mp4",
          "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
          "type": "string"
        }
      ]
    },
    "Request": {
      "description": "One request: a call plus the client-chosen ID its answer will carry.",
      "properties": {
        "call": {
          "$ref": "#/$defs/Call",
          "description": "What to do."
        },
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Echoed in the matching `response` or `error`."
        }
      },
      "required": [
        "id",
        "call"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Chosen by the client for each request and echoed in its response or error.",
      "type": "string"
    },
    "Response": {
      "description": "A successful answer to a [`Request`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "The request's ID."
        },
        "result": {
          "$ref": "#/$defs/CallResult",
          "description": "What happened. Its `kind` matches the request's call."
        }
      },
      "required": [
        "id",
        "result"
      ],
      "type": "object"
    },
    "Rev": {
      "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RtmpTarget": {
      "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Any RTMP(S) ingest server, named by its server URL.",
          "properties": {
            "type": {
              "const": "generic",
              "type": "string"
            },
            "url": {
              "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        }
      ]
    },
    "SceneId": {
      "description": "A scene in the collection.",
      "type": "string"
    },
    "SceneInfo": {
      "description": "One scene with its items, as `state.get` reports it.",
      "properties": {
        "items": {
          "description": "Its items, in stacking order: the first is at the bottom.",
          "items": {
            "$ref": "#/$defs/ItemInfo"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        }
      },
      "required": [
        "scene_id",
        "name",
        "items"
      ],
      "type": "object"
    },
    "SceneRole": {
      "description": "What a scene is for (ADR-0024 §1). It changes no engine behaviour; it tells clients,\nagents and switchers how to show the scene.",
      "oneOf": [
        {
          "const": "scene",
          "description": "A scene of its own, listed in the scene list. Scenes are created with this role.",
          "type": "string"
        },
        {
          "const": "group",
          "description": "A group: a scene placed in other scenes to hold items together. Clients hide it\nfrom the scene list and show it under the items that place it.",
          "type": "string"
        }
      ]
    },
    "SceneSummary": {
      "description": "One scene in a `scene.list` result.",
      "properties": {
        "item_count": {
          "description": "How many items it has.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        }
      },
      "required": [
        "scene_id",
        "name",
        "item_count"
      ],
      "type": "object"
    },
    "SecretString": {
      "description": "A secret string, such as a stream key, sent by a client to the engine.\n\nOn the wire it is a plain JSON string. In Rust it never prints: its `Debug` is\n`\"***\"`, it has no `Display`, and the only way to read it is [`expose`](Self::expose).\nA value that is not a string fails to parse with a message that doesn't repeat it.\nThe engine never sends one back (R-SEC-001).",
      "type": "string"
    },
    "SendInfo": {
      "description": "One send: a source's audio routed into a bus, post-fader, as `bus.list` and\n`state.get` report it.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus it sends into."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The send's gain, in dB, applied after the source's fader: from −100 to +24."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source sending."
        }
      },
      "required": [
        "source_id",
        "bus_id",
        "gain_db"
      ],
      "type": "object"
    },
    "ServerMessage": {
      "description": "A message from the server to a client. Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Welcome",
          "description": "Accepts the handshake.",
          "properties": {
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Response",
          "description": "A request succeeded.",
          "properties": {
            "type": {
              "const": "response",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ErrorResponse",
          "description": "A request (or the handshake, or an unparseable message) failed.",
          "properties": {
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/EventMessage",
          "description": "Something happened in the engine.",
          "properties": {
            "type": {
              "const": "event",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Settings": {
      "additionalProperties": true,
      "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
      "type": "object"
    },
    "Size": {
      "description": "A width and height, in canvas pixels.\n\nBoth components are [`Finite32`]. A non-positive component is rejected by\n[`ItemGeometry::validate`], not stored as a flip.",
      "properties": {
        "height": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical extent. Must be greater than zero for a placement to be valid."
        },
        "width": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal extent. Must be greater than zero for a placement to be valid."
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "SourceAudio": {
      "description": "A source's audio settings, as `source.list` and `state.get` report them. Only an\naudio source has them: a source whose kind produces audio, or a `scene` source (a\nnested scene, whose audio is its contents').\n\nSignal order (ADR-0028): the source's stream, then its fader and mute, then the\nactivity gain `follow` sets, then each send's gain into its bus.",
      "properties": {
        "enabled": {
          "description": "Whether the engine opens the source's audio at all. Off, the source has no mixer\nchannel and no meter, and its sends are kept but carry nothing, so turning it\nback on restores them. Not the same as `muted`, which keeps the stream open and\nmetered. For a `scene` source, off stops what the scene shows from being heard\nthrough it. New sources start on.",
          "type": "boolean"
        },
        "follow": {
          "$ref": "#/$defs/AudioFollow",
          "description": "When it is heard. A new source takes its kind's default: `always` for a kind\nwith audio and no video (an audio input), `when_shown` for every other audio\nsource, `scene` sources included."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The fader, in dB, applied before the sends: from −100 to +24. New sources start\nat 0. Always 0 for a `scene` source, which has no fader of its own."
        },
        "muted": {
          "description": "Whether the source is muted: still open and metered, but feeding no bus. Always\nfalse for a `scene` source, which has no mute of its own.",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "follow",
        "gain_db",
        "muted"
      ],
      "type": "object"
    },
    "SourceId": {
      "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
      "type": "string"
    },
    "SourceInfo": {
      "description": "One source, as `source.list` and `state.get` report it.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAudio"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its audio settings, for an audio source: one whose kind produces audio, or a\n`scene` source. Omitted for every other source, and by a server older than 0.21."
        },
        "duplicated_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The source this one was copied from by `source.duplicate`, while that source\nexists. Omitted if it was not copied, or its original has been deleted. An item\nplacing this source can go back to placing the original with `item.set_source`."
        },
        "kind": {
          "$ref": "#/$defs/SourceKind",
          "description": "What it shows."
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings: every parameter of its kind. Empty (and omitted) for a `scene`\nsource and for a kind without parameters."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source's ID."
        }
      },
      "required": [
        "source_id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
      "oneOf": [
        {
          "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene shown."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
          "properties": {
            "kind": {
              "description": "The kind's ID, as `kind.list` reports it.",
              "type": "string"
            },
            "type": {
              "const": "builtin",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceMeter": {
      "description": "One source's levels in a `meters.tick`, post-fader and before its sends. Levels are\nlinear full scale per channel, left then right: 1.0 is 0 dBFS, 0.0 is silence.",
      "properties": {
        "peak": {
          "description": "The largest absolute sample since the previous tick.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rms": {
          "description": "The RMS level over the most recent mixer block.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id",
        "peak",
        "rms"
      ],
      "type": "object"
    },
    "Vec2": {
      "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
      "properties": {
        "x": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal component."
        },
        "y": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical component."
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "VideoCodec": {
      "description": "A video codec. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 (AVC).",
          "type": "string"
        }
      ]
    },
    "VideoEncoding": {
      "description": "How the video is encoded.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "The codec."
        },
        "hardware": {
          "$ref": "#/$defs/HardwarePreference",
          "default": "avoid",
          "description": "Whether to use a hardware encoder. Omitted means `avoid`."
        },
        "keyframe_interval_s": {
          "description": "Seconds from one keyframe to the next, 1..=10, else `invalid_argument`. Most\nstreaming services ask for 2.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate_control": {
          "$ref": "#/$defs/RateControl",
          "description": "How the encoder spends bits. Rejected with `invalid_argument` outside\n100..=100000 kbit/s, or, for `vbr`, with a peak below the average or above\n200000 kbit/s."
        }
      },
      "required": [
        "codec",
        "rate_control",
        "keyframe_interval_s"
      ],
      "type": "object"
    },
    "VisibleIf": {
      "description": "A UI hint: show a parameter only while parameter `param` equals `equals`. Hints never\naffect validation.",
      "properties": {
        "equals": {
          "description": "The value it must have."
        },
        "param": {
          "description": "The parameter whose value decides.",
          "type": "string"
        }
      },
      "required": [
        "param",
        "equals"
      ],
      "type": "object"
    },
    "Welcome": {
      "description": "The server's answer to [`Hello`].",
      "properties": {
        "client_id": {
          "$ref": "#/$defs/ClientId",
          "description": "The identity this connection acts as: its undo history and audit-log entries are\nkeyed by it."
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the server speaks."
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The current state revision, so the client knows where it starts."
        }
      },
      "required": [
        "protocol",
        "client_id",
        "rev"
      ],
      "type": "object"
    },
    "WireError": {
      "description": "A [`ProtocolError`] as sent on the wire: its `code` and details, plus a message.\n\n```json\n{\"code\": \"rev_conflict\", \"expected\": 4, \"current\": 5,\n \"message\": \"expected rev 4, but the state is at rev 5\"}\n```",
      "oneOf": [
        {
          "description": "The server can't speak the client's protocol version.",
          "properties": {
            "client": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the client asked for in `hello`."
            },
            "code": {
              "const": "unsupported_version",
              "type": "string"
            },
            "server": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the server speaks."
            }
          },
          "required": [
            "code",
            "client",
            "server"
          ],
          "type": "object"
        },
        {
          "description": "A request arrived before the `hello`/`welcome` handshake finished.",
          "properties": {
            "code": {
              "const": "handshake_required",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The message could not be parsed: bad JSON, an unknown `type`, a missing or\nmistyped field, or a number that isn't a finite `f32` (NaN, infinity, or out of\nrange such as `1e39`). `ClientMessage::parse` produces it.",
          "properties": {
            "code": {
              "const": "malformed",
              "type": "string"
            },
            "reason": {
              "description": "What the parser reported.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A batch had no edits.",
          "properties": {
            "code": {
              "const": "empty_batch",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The batch's `expected_rev` was not the current revision. Nothing was applied:\nre-read the state and retry.",
          "properties": {
            "code": {
              "const": "rev_conflict",
              "type": "string"
            },
            "current": {
              "$ref": "#/$defs/Rev",
              "description": "The state's revision when the batch was checked."
            },
            "expected": {
              "$ref": "#/$defs/Rev",
              "description": "The `expected_rev` the batch carried."
            }
          },
          "required": [
            "code",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "description": "A command named an object that doesn't exist.",
          "properties": {
            "code": {
              "const": "not_found",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A creating edit used an ID that is already taken.",
          "properties": {
            "code": {
              "const": "already_exists",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A field had a value the engine can't accept.",
          "properties": {
            "code": {
              "const": "invalid_argument",
              "type": "string"
            },
            "field": {
              "description": "The field, as a dotted path into the command (`edits.2.name`).",
              "type": "string"
            },
            "reason": {
              "description": "Why it was rejected.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "field",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "An undo or redo would overwrite another client's work: a batch that client\napplied after the step changed a property the step sets, created or deleted an\nobject the step creates or deletes, or made the step's edits no longer apply.\nNothing was applied, and the step was dropped from the history, so the next undo\nreaches the step before it.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose batch conflicts."
            },
            "code": {
              "const": "undo_conflict",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision that batch produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced."
            }
          },
          "required": [
            "code",
            "step_rev",
            "client_id",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "There is nothing to undo, or nothing to redo.",
          "properties": {
            "code": {
              "const": "history_empty",
              "type": "string"
            },
            "direction": {
              "$ref": "#/$defs/HistoryDirection",
              "description": "Which way the call asked to move."
            }
          },
          "required": [
            "code",
            "direction"
          ],
          "type": "object"
        },
        {
          "description": "An action was accepted for processing but could not be carried out.",
          "properties": {
            "code": {
              "const": "action_failed",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The engine hit a bug or an unexpected condition. The request may be retried.",
          "properties": {
            "code": {
              "const": "internal",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "message": {
          "description": "A human-readable explanation, for logs and for agents. Not stable: match on\n`code`, never on this.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ],
  "description": "Any message on a JStream control connection: client to server, or server to client.",
  "title": "JStream protocol 0.14"
}
