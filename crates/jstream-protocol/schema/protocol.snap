              "description": "The revision the list was read at."
            },
            "type": {
              "const": "output.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "outputs"
          ],
          "type": "object"
        },
        {
          "description": "The result of `studio.get`. Studio state is runtime state, so it carries no `rev`.",
          "properties": {
            "keyframes": {
              "description": "The scenes drawn through one of their keyframe scenes where they are placed\n(ADR-0116, since 0.88), ordered by scene. Omitted when none is.",
              "items": {
                "$ref": "#/$defs/PlacedKeyframe"
              },
              "type": "array"
            },
            "preview_scene": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene on preview, which `studio.set_preview` sets. Omitted only while the\ncollection has no scene, and by a server older than 0.30."
            },
            "program_scene": {
