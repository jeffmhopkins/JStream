              },
              "type": "array"
            },
            "type": {
              "const": "capture.targets",
              "type": "string"
            }
          },
          "required": [
            "type",
            "targets"
          ],
          "type": "object"
        },
        {
          "description": "The result of `device.list`. Devices are not collection state, so it carries no\n`rev`.",
          "properties": {
            "devices": {
              "description": "The paired devices, ordered by ID.",
              "items": {
                "$ref": "#/$defs/DeviceInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "device.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "devices"
          ],
          "type": "object"
        },
        {
          "description": "The result of `activity.list` (0.51).",
          "properties": {
            "entries": {
              "description": "The entries, newest first.",
              "items": {
                "$ref": "#/$defs/ActivityEntry"
              },
              "type": "array"
            },
            "now_ms": {
              "description": "The engine's clock now, in milliseconds since the Unix epoch (UTC), so a\nclient on another machine can say how long ago each entry was without\ntrusting its own clock.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "activity.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "now_ms",
            "entries"
          ],
          "type": "object"
        },
        {
          "description": "The result of `ui_settings.get`. UI settings are not collection state, so it\ncarries no `rev`.",
