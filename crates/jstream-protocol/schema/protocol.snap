              },
              "type": "array"
            },
            "type": {
              "const": "studio.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The result of the deprecated `privacy.get` (ADR-0080): always `on: false`.",
