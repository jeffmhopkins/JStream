              "type": "string"
            }
          },
          "required": [
            "type",
            "on"
          ],
          "type": "object"
        },
        {
          "description": "The result of `encoder.list`.",
          "properties": {
            "encoders": {
              "description": "The profiles, ordered by ID.",
              "items": {
                "$ref": "#/$defs/EncoderProfileInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "type": {
              "const": "encoder.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "encoders"
          ],
          "type": "object"
        },
        {
          "description": "The result of `video_mix.list`.",
          "properties": {
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "type": {
              "const": "video_mix.list",
              "type": "string"
            },
            "video_mixes": {
              "description": "The mixes, ordered by ID.",
              "items": {
                "$ref": "#/$defs/VideoMixInfo"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "rev",
            "video_mixes"
          ],
          "type": "object"
        },
        {
          "description": "The result of `live.list`.",
          "properties": {
            "gestures": {
              "description": "The open gestures, ordered by client ID, then gesture ID.",
              "items": {
                "$ref": "#/$defs/GestureInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "live.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "gestures"
          ],
          "type": "object"
        },
        {
          "description": "The result of `youtube.status`. Runtime state, so it carries no `rev`.",
          "properties": {
            "auth": {
              "$ref": "#/$defs/YoutubeAuth",
              "description": "Whether the engine is signed in."
            },
            "type": {
              "const": "youtube.status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "auth"
          ],
          "type": "object"
        },
        {
          "description": "The result of `youtube.list_broadcasts`.",
          "properties": {
            "broadcasts": {
              "description": "This page's broadcasts.",
              "items": {
                "$ref": "#/$defs/BroadcastInfo"
              },
              "type": "array"
            },
            "next_page_token": {
              "description": "The token for the next page, if there is one.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "youtube.list_broadcasts",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcasts"
          ],
          "type": "object"
        },
        {
          "description": "The result of `youtube.list_streams`.",
          "properties": {
            "next_page_token": {
              "description": "The token for the next page, if there is one.",
              "type": [
                "string",
                "null"
              ]
            },
            "streams": {
              "description": "This page's streams.",
              "items": {
                "$ref": "#/$defs/StreamInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "youtube.list_streams",
              "type": "string"
            }
          },
          "required": [
            "type",
            "streams"
          ],
          "type": "object"
        },
        {
          "description": "The result of `youtube.stats`. Runtime state, so it carries no `rev`.",
          "properties": {
            "outputs": {
              "description": "The audience of each running `youtube` output YouTube has reported one for,\nordered by output ID.",
              "items": {
                "$ref": "#/$defs/AudienceStatsInfo"
              },
              "type": "array"
            },
            "quota": {
              "$ref": "#/$defs/QuotaInfo",
              "description": "The day's estimated quota."
            },
            "type": {
              "const": "youtube.stats",
              "type": "string"
            }
          },
          "required": [
            "type",
            "outputs",
            "quota"
          ],
          "type": "object"
        },
        {
          "description": "The result of `bus.list`.",
          "properties": {
            "buses": {
              "description": "The buses, ordered by ID, the master among them.",
              "items": {
                "$ref": "#/$defs/BusInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "sends": {
              "description": "Every send, ordered by bus, then by source.",
              "items": {
                "$ref": "#/$defs/SendInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "bus.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "buses",
            "sends"
          ],
          "type": "object"
        },
        {
          "description": "The result of `delete.plan`.",
          "properties": {
            "edits": {
              "description": "The edits, in order: `item.remove` for the items that place a deleted source,\n`source.set_settings` and `filter.set_settings` setting each reference to a\ndeleted object to `null`, `source.delete` for the `scene` sources that show a deleted scene, and last the\ndelete of the target itself.",
              "items": {
                "$ref": "#/$defs/Edit"
              },
              "type": "array"
            },
            "hotkeys": {
              "description": "The hotkey bindings the batch removes because their action names an object it\ndeletes, ordered by chord, so the client can say \"this also removes the hotkey\nCtrl+Digit1\". The deletes remove them; undo restores them. Omitted when there\nare none, and missing (from a server older than 0.25) parses as empty.",
              "items": {
                "$ref": "#/$defs/HotkeyBinding"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the plan was made at. Send `edits` with this `expected_rev`, so\nthe batch is refused if the state changed since."
            },
            "type": {
              "const": "delete.plan",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "edits"
          ],
          "type": "object"
        },
        {
          "description": "The result of `source.sizes`. Runtime state, so it carries no `rev`.",
          "properties": {
            "sources": {
              "description": "Every source in the collection, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceSize"
              },
              "type": "array"
            },
            "type": {
              "const": "source.sizes",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sources"
          ],
          "type": "object"
        },
        {
          "description": "The result of `capture.targets`.",
          "properties": {
            "targets": {
              "description": "The displays, then the windows, in the order the OS lists them.",
              "items": {
                "$ref": "#/$defs/CaptureTargetInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "capture.targets",
              "type": "string"
            }
          },
          "required": [
            "type",
            "targets"
          ],
          "type": "object"
        },
        {
          "description": "The result of `font.list`.",
          "properties": {
            "fonts": {
              "description": "The installed fonts, ordered by family, then style, then path.",
              "items": {
                "$ref": "#/$defs/FontInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "font.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fonts"
          ],
          "type": "object"
        },
        {
          "description": "The result of `pack.list`.",
          "properties": {
            "packs": {
              "description": "The packs, ordered by ID.",
              "items": {
                "$ref": "#/$defs/PackInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "pack.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "packs"
          ],
          "type": "object"
        },
        {
          "description": "The result of `pack.read`.",
          "properties": {
            "files": {
              "description": "The pack's files, ordered by path: every file, or the one `path` named.",
              "items": {
                "$ref": "#/$defs/PackFileInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "pack.read",
              "type": "string"
            }
          },
          "required": [
            "type",
            "files"
          ],
          "type": "object"
        },
        {
          "description": "The result of `values.list` (0.78). Shared values are not collection state, so it\ncarries no `rev`.",
          "properties": {
            "type": {
              "const": "values.list",
              "type": "string"
            },
            "values": {
              "description": "The values, ordered by name.",
              "items": {
                "$ref": "#/$defs/SharedValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "values"
          ],
          "type": "object"
        },
        {
          "description": "The result of `device.list`. Devices are not collection state, so it carries no\n`rev`.",
          "properties": {
            "devices": {
              "description": "The paired devices, ordered by ID.",
              "items": {
                "$ref": "#/$defs/DeviceInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "device.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "devices"
          ],
          "type": "object"
        },
        {
          "description": "The result of `activity.list` (0.51).",
          "properties": {
            "entries": {
              "description": "The entries, newest first.",
              "items": {
                "$ref": "#/$defs/ActivityEntry"
              },
              "type": "array"
            },
            "now_ms": {
              "description": "The engine's clock now, in milliseconds since the Unix epoch (UTC), so a\nclient on another machine can say how long ago each entry was without\ntrusting its own clock.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "activity.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "now_ms",
            "entries"
          ],
          "type": "object"
        },
        {
          "description": "The result of `ui_settings.get`. UI settings are not collection state, so it\ncarries no `rev`.",
          "properties": {
            "key": {
              "description": "The key read.",
              "type": "string"
            },
            "type": {
              "const": "ui_settings.get",
              "type": "string"
            },
            "value": {
              "description": "Its value, omitted when the key has none."
            }
          },
          "required": [
            "type",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "The result of `collection.info` (0.94). Not collection state, so it carries no\n`rev`.",
          "properties": {
            "path": {
              "description": "The absolute path of the collection file the engine saves to.",
              "type": "string"
            },
            "recent": {
              "description": "Up to ten collection files opened, created or saved as, most recent first,\n`path` among them. A file may have moved or gone since.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "collection.info",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "The result of `plugin.list` (0.58). Installed plugins are not collection state, so\nit carries no `rev`.",
          "properties": {
            "plugins": {
              "description": "The installed plugins, ordered by ID.",
              "items": {
                "$ref": "#/$defs/PluginInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "plugin.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plugins"
          ],
          "type": "object"
        },
        {
          "description": "The result of `codec.downloads` (0.69). Runtime state, so it carries no `rev`.",
          "properties": {
            "downloads": {
              "description": "The downloads, ordered by ID.",
              "items": {
                "$ref": "#/$defs/CodecDownloadInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "codec.downloads",
              "type": "string"
            }
          },
          "required": [
            "type",
            "downloads"
          ],
          "type": "object"
        },
        {
          "description": "The result of `profile.get` (0.73). Runtime state, so it carries no `rev`.",
          "properties": {
            "drawers": {
              "default": [],
              "description": "The threads that drew in the window: the program stage's while an output runs,\nthe preview hub's while a preview stream is open.",
              "items": {
                "$ref": "#/$defs/DrawerProfile"
              },
              "type": "array"
            },
            "frame_budget_ms": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "The program's frame period in milliseconds: a drawer whose frames take longer\ncan't keep up."
            },
            "gpu_timing": {
              "default": false,
              "description": "Whether units carry `gpu_ms`, measured with GPU timestamp queries. `false` until\nthe engine measures GPU time, and on an adapter that can't.",
              "type": "boolean"
            },
            "mixer": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MixerProfile"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The audio mixer and its inputs in the window (since 0.92). Omitted when the\nmixer didn't run in it."
            },
            "plan": {
              "$ref": "#/$defs/PlanProfile",
              "default": {
                "ms": 0.0,
                "plans": 0,
                "recent_max_ms": 0.0
              },
              "description": "What planning the program mix cost: each plan holds the collection lock."
            },
            "process_cpu_pct": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The CPU the engine's process used in the window, as a percentage of one core\n(200 is two cores busy), when the host can read it."
            },
            "seconds": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "The seconds the window covers: what was asked for, or less when the engine has\nread for less time than that (it keeps a reading from each `stats.tick` and each\n`profile.get`)."
            },
            "sources": {
              "default": [],
              "description": "The sources that cost the `jstream-sources` thread or the planner time,\ncostliest first.",
              "items": {
                "$ref": "#/$defs/SourceProfile"
              },
              "type": "array"
            },
            "streams": {
              "default": [],
              "description": "What happened to the frames past the drawers (since 0.92): each output's and\neach H.264 preview stream's, from its encoder to where it sends them, most\nframes lost first. A stream that ran in none of the window is left out.",
              "items": {
                "$ref": "#/$defs/StreamProfile"
              },
              "type": "array"
            },
            "thread_cpu": {
              "default": false,
              "description": "Whether `threads` was read: `false` on a host that can't list its threads.",
              "type": "boolean"
            },
            "threads": {
              "default": [],
              "description": "The process's threads, those of one name added together, busiest first.",
              "items": {
                "$ref": "#/$defs/ThreadProfile"
              },
              "type": "array"
            },
            "type": {
              "const": "profile.get",
              "type": "string"
            },
            "units": {
              "default": [],
              "description": "The units of drawing work the drawers did, costliest first.",
              "items": {
                "$ref": "#/$defs/UnitProfile"
              },
              "type": "array"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "QuotaInfo": {
      "description": "The engine's estimate of the day's YouTube API quota (ADR-0041 §5). It adds up what\neach call the engine makes costs by YouTube's published unit costs. YouTube's own\ncount, which other apps on the same Google project share, can differ.",
      "properties": {
        "daily": {
          "description": "The units the engine assumes a day has.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exhausted": {
          "description": "Whether YouTube refused a call since the quota last reset because it is used up.\nOmitted when it hasn't.",
          "type": "boolean"
        },
        "stats": {
          "$ref": "#/$defs/StatsPolling",
          "description": "How audience stats are polled now."
        },
        "used": {
          "description": "Units used since the quota last reset, by the engine's count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "used",
        "daily",
        "stats"
      ],
      "type": "object"
    },
    "RateControl": {
      "description": "How a video encoder spends bits. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Constant bit rate, as RTMP ingest expects.",
          "properties": {
            "kbps": {
              "description": "The target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps"
          ],
          "type": "object"
        },
        {
          "description": "Variable bit rate with a peak, for a recording.",
          "properties": {
            "kbps": {
              "description": "The average target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "max_kbps": {
              "description": "The peak, in kilobits per second; at least `kbps`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "vbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps",
            "max_kbps"
          ],
          "type": "object"
        }
      ]
    },
    "RecordContainer": {
      "description": "The file format a recording is written in. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "mp4",
          "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
          "type": "string"
        }
      ]
    },
    "Request": {
      "description": "One request: a call plus the client-chosen ID its answer will carry.",
      "properties": {
        "call": {
          "$ref": "#/$defs/Call",
          "description": "What to do."
        },
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Echoed in the matching `response` or `error`."
        }
      },
      "required": [
        "id",
        "call"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Chosen by the client for each request and echoed in its response or error.",
      "type": "string"
    },
    "Response": {
      "description": "A successful answer to a [`Request`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "The request's ID."
        },
        "result": {
          "$ref": "#/$defs/CallResult",
          "description": "What happened. Its `kind` matches the request's call."
        }
      },
      "required": [
        "id",
        "result"
      ],
      "type": "object"
    },
    "Rev": {
      "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RtmpTarget": {
      "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Any RTMP(S) ingest server, named by its server URL.",
          "properties": {
            "type": {
              "const": "generic",
              "type": "string"
            },
            "url": {
              "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "A YouTube broadcast (ADR-0058): on `output.start` the engine reads the\nbroadcast's bound stream from the Live API and publishes to that stream's\n`rtmps://` ingest address with its key. The key comes from YouTube, so\n`output.set_key` isn't needed. The start fails with `action_failed` when the\nengine isn't signed in to YouTube, the broadcast has no bound stream\n(`youtube.bind_broadcast`), or YouTube refuses. The engine rejects, with\n`invalid_argument`, an ID that is empty, longer than 128 bytes or has characters\nother than ASCII letters, digits, `-` and `_`.",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast's ID, as `youtube.list_broadcasts` reports it.",
              "type": "string"
            },
            "type": {
              "const": "youtube",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast_id"
          ],
          "type": "object"
        }
      ]
    },
    "SceneCamera": {
      "description": "A scene's camera (ADR-0094): where it is, what it looks at, and how wide it sees.\n\nA scene with a camera is a **3D scene**: every item in it is placed in the scene's\nspace by its geometry and seen through the camera, and its own `perspective_px` is\nignored. On the wire, omitted `fov_deg` is 45, omitted `roll_deg` 0, omitted\n`depth_sort` `true` and omitted `blur_px` 0, neither of which is written, and omitted\n`focus_px` no depth of field.",
      "properties": {
        "blur_px": {
          "$ref": "#/$defs/Finite32",
          "description": "How soft focus gets: the blur radius, in canvas pixels, of a point infinitely far\nbehind the focus plane, from 0 to 64. With `focus_px`, the camera has a depth of\nfield when this is above 0. Default 0 (ADR-0108)."
        },
        "depth_sort": {
          "description": "Whether items draw far to near, by the depth of their box centre along the\nviewing axis, with stacking order breaking ties. `false` keeps stacking order.\nDefault `true`.",
          "type": "boolean"
        },
        "focus_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "The distance along the viewing axis, from the camera, of the plane in focus, in\nscene pixels: above 0 and at most the drawable distance. Absent, everything is in\nfocus (ADR-0108)."
        },
        "fov_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 45.0,
          "description": "Vertical field of view, in degrees, from 1 to 170. Default 45."
        },
        "position": {
          "$ref": "#/$defs/Vec3",
          "description": "Where the camera is."
        },
        "roll_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Rotation of the picture about the viewing axis, clockwise, in degrees. Default 0."
        },
        "target": {
          "$ref": "#/$defs/Vec3",
          "description": "The point it looks at. At least 0.001 px from `position`."
        }
      },
      "required": [
        "position",
        "target"
      ],
      "type": "object"
    },
    "SceneId": {
      "description": "A scene in the collection.",
      "type": "string"
    },
    "SceneInfo": {
      "description": "One scene with its items, as `state.get` reports it.",
      "properties": {
        "background": {
          "description": "Its background colour (ADR-0024 §4, ADR-0089 §4, since 0.65): sRGB `#rrggbb`, or\n`#rrggbbaa` with straight alpha, drawn under its items wherever the scene is\ndrawn, nested or not. Omitted for none, the default, which is transparent: where\na video mix shows a transparent pixel, the output is black. A keyframe scene\nshows its parent's, so `scene.set_options` refuses one of its own, and a group\ndraws none: it is part of the scene that holds it.",
          "type": [
            "string",
            "null"
          ]
        },
        "camera": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneCamera"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its camera (ADR-0094, since 0.70), which makes it a 3D scene. On a keyframe scene,\nits override of its parent's camera; the keyframe shows the parent's camera where\nit has none. Omitted for none, so missing (also from an older server) parses as a\n2D scene."
        },
        "camera_follow": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraFollow"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its follow camera (ADR-0113, since 0.85), which glides after the pointer over a capture. It\nbelongs to the family, so a keyframe scene reports none and draws its parent's.\nSince 0.91 it is read from its items' effects (ADR-0120): the first enabled\n`follow_pointer` filter in stacking order, as a follow of that item. Omitted for\nnone."
        },
        "camera_motion": {
          "description": "Its camera motion (ADR-0113, since 0.85): the modifiers that change its camera as it is drawn.\nIt belongs to the family, so a keyframe scene reports none and draws its parent's.\nOmitted when empty.",
          "items": {
            "$ref": "#/$defs/CameraMotionModifier"
          },
          "type": "array"
        },
        "color": {
          "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "favourite": {
          "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its filter chains (ADR-0065, since 0.43), which `filter.*` edits with the owner\n`{\"type\":\"scene\",\"scene_id\":…}`. They run on the scene's composite. Only the video\nchain holds filters, and a keyframe scene has none of its own, since it shows its\nparent's. Omitted while both are empty, so missing (also from an older server)\nparses as none."
        },
        "folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The folder it is filed in (ADR-0024 §3). Omitted for none."
        },
        "icon": {
          "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "include_audio": {
          "description": "Whether its sources reach the Mixer through the nested scene sources that show\nit. Off, a scene placed inside another adds none of its audio there, whatever\nthose sources' own `audio.enabled`; it changes nothing while the scene itself is\non program. A group is only reached through nesting, so on a group it leaves\nout its children's audio wherever the group shows. Omitted for `true`, the\ndefault.",
          "type": "boolean"
        },
        "items": {
          "description": "Its items, in stacking order: the first is at the bottom. Always empty for a\nkeyframe scene, which shows its parent's.",
          "items": {
            "$ref": "#/$defs/ItemInfo"
          },
          "type": "array"
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "overrides": {
          "description": "A keyframe scene's overrides of its parent's items, in item ID order. Omitted\nwhen there are none, and for every scene that is not a variant.",
          "items": {
            "$ref": "#/$defs/ItemOverride"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        },
        "show_in_multiview": {
          "description": "Whether a multiview shows it. Omitted for `true`, the default.",
          "type": "boolean"
        },
        "timelines": {
          "description": "Its timelines (ADR-0115, since 0.87), ordered by ID: timed cues that\n`timeline.play` runs. Omitted when it has none.",
          "items": {
            "$ref": "#/$defs/TimelineInfo"
          },
          "type": "array"
        },
        "transition_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionPresetId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The preset a switch into this scene uses, unless the switch names one. Omitted\nfor none."
        },
        "transition_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionPresetId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The preset a switch out of this scene uses, unless the switch or the next scene\nnames one. Omitted for none."
        },
        "variant_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The scene this one is a keyframe scene of (ADR-0024 §2, protocol 0.39), whose\nitems it shows. Omitted for a scene that is not a variant."
        }
      },
      "required": [
        "scene_id",
        "name",
        "items"
      ],
      "type": "object"
    },
    "SceneRole": {
      "description": "What a scene is for (ADR-0024 §1). It changes no engine behaviour; it tells clients,\nagents and switchers how to show the scene.",
      "oneOf": [
        {
          "const": "scene",
          "description": "A scene of its own, listed in the scene list. Scenes are created with this role\nunless `scene.create` names another.",
          "type": "string"
        },
        {
          "const": "group",
          "description": "A group: a scene placed in other scenes to hold items together. Clients hide it\nfrom the scene list and show it under the items that place it.",
          "type": "string"
        }
      ]
    },
    "SceneSummary": {
      "description": "One scene in a `scene.list` result.",
      "properties": {
        "color": {
          "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "favourite": {
          "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
          "type": "boolean"
        },
        "folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The folder it is filed in (ADR-0024 §3). Omitted for none."
        },
        "icon": {
          "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "item_count": {
          "description": "How many items it has.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        },
        "show_in_multiview": {
          "description": "Whether a multiview shows it. Omitted for `true`, the default.",
          "type": "boolean"
        }
      },
      "required": [
        "scene_id",
        "name",
        "item_count"
      ],
      "type": "object"
    },
    "SecretString": {
      "description": "A secret string, such as a stream key sent by a client to the engine, or the\npairing code a server answers `pairing.start` with.\n\nOn the wire it is a plain JSON string. In Rust it never prints: its `Debug` is\n`\"***\"`, it has no `Display`, and the only way to read it is [`expose`](Self::expose).\nA value that is not a string fails to parse with a message that doesn't repeat it.\nThe engine never sends one back, and a pairing code travels only in that one answer\n(R-SEC-001).",
      "type": "string"
    },
    "SendInfo": {
      "description": "One send: a source's audio routed into a bus, post-fader, as `bus.list` and\n`state.get` report it.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus it sends into."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The send's gain, in dB, applied after the source's fader: from −100 to +24."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source sending."
        }
      },
      "required": [
        "source_id",
        "bus_id",
        "gain_db"
      ],
      "type": "object"
    },
    "ServerMessage": {
      "description": "A message from the server to a client. Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Welcome",
          "description": "Accepts the handshake.",
          "properties": {
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Response",
          "description": "A request succeeded.",
          "properties": {
            "type": {
              "const": "response",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ErrorResponse",
          "description": "A request (or the handshake, or an unparseable message) failed.",
          "properties": {
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/EventMessage",
          "description": "Something happened in the engine.",
          "properties": {
            "type": {
              "const": "event",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Settings": {
      "additionalProperties": true,
      "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
      "type": "object"
    },
    "SharedValue": {
      "description": "One shared value, as `values.list` answers it.",
      "properties": {
        "name": {
          "description": "Its name: dotted segments of `a`–`z`, `0`–`9` and `_`, such as `status.text`.",
          "type": "string"
        },
        "value": {
          "description": "Its value: any JSON value but `null`, which `values.set` takes as a removal."
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "SheetFrame": {
      "description": "One picture of a [`FrameSheet`].",
      "properties": {
        "at_ms": {
          "description": "When it was taken, in milliseconds after the call (after the switch, for\n`scene.switch_and_watch`), on the clock transitions run on. It is the time the\npicture shows, which can lag the time asked for by a few milliseconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The collection revision of the layout it shows."
        }
      },
      "required": [
        "at_ms",
        "rev"
      ],
      "type": "object"
    },
    "Size": {
      "description": "A width and height, in canvas pixels.\n\nBoth components are [`Finite32`]. A non-positive component is rejected by\n[`ItemGeometry::validate`], not stored as a flip.",
      "properties": {
        "height": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical extent. Must be greater than zero for a placement to be valid."
        },
        "width": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal extent. Must be greater than zero for a placement to be valid."
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "SourceAudio": {
      "description": "A source's audio settings, as `source.list` and `state.get` report them. Only an\naudio source has them: a source whose kind produces audio, or a `scene` source (a\nnested scene, whose audio is its contents').\n\nSignal order (ADR-0028): the source's stream, then its fader and mute, then the\nactivity gain `follow` sets, then each send's gain into its bus.",
      "properties": {
        "enabled": {
          "description": "Whether the engine opens the source's audio at all. Off, the source has no mixer\nchannel and no meter, and its sends are kept but carry nothing, so turning it\nback on restores them. Not the same as `muted`, which keeps the stream open and\nmetered. For a `scene` source, off stops what the scene shows from being heard\nthrough it. New sources start on.",
          "type": "boolean"
        },
        "follow": {
          "$ref": "#/$defs/AudioFollow",
          "description": "When it is heard. A new source takes its kind's default: `always` for a kind\nwith audio and no video (an audio input), `when_shown` for every other audio\nsource, `scene` sources included."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The fader, in dB, applied before the sends: from −100 to +24. New sources start\nat 0. Always 0 for a `scene` source, which has no fader of its own."
        },
        "muted": {
          "description": "Whether the source is muted: still open and metered, but feeding no bus. Always\nfalse for a `scene` source, which has no mute of its own.",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "follow",
        "gain_db",
        "muted"
      ],
      "type": "object"
    },
    "SourceId": {
      "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
      "type": "string"
    },
    "SourceInfo": {
      "description": "One source, as `source.list` and `state.get` report it.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAudio"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its audio settings, for an audio source: one whose kind produces audio, or a\n`scene` source. Omitted for every other source, and by a server older than 0.19."
        },
        "duplicated_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The source this one was copied from by `source.duplicate`, while that source\nexists. Omitted if it was not copied, or its original has been deleted. An item\nplacing this source can go back to placing the original with `item.set_source`."
        },
        "favourite": {
          "description": "Whether it is a favourite. Omitted for `false`.",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its filter chains (ADR-0026). Omitted while both are empty."
        },
        "kind": {
          "$ref": "#/$defs/SourceKind",
          "description": "What it shows."
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings: every parameter of its kind. Empty (and omitted) for a `scene`\nsource and for a kind without parameters."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source's ID."
        }
      },
      "required": [
        "source_id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
      "oneOf": [
        {
          "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene shown."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
          "properties": {
            "kind": {
              "description": "The kind's ID, as `kind.list` reports it.",
              "type": "string"
            },
            "type": {
              "const": "builtin",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceMeter": {
      "description": "One source's levels in a `meters.tick`, post-fader and before its sends. Levels are\nlinear full scale per channel, left then right: 1.0 is 0 dBFS, 0.0 is silence.",
      "properties": {
        "peak": {
          "description": "The largest absolute sample since the previous tick.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rms": {
          "description": "The RMS level over the most recent mixer block.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id",
        "peak",
        "rms"
      ],
      "type": "object"
    },
    "SourceProfile": {
      "description": "What one source cost outside the drawing threads ([`ProfileInfo::sources`]).",
      "properties": {
        "build_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "How long its last build took, in milliseconds: reading and decoding its files,\nor opening its page. Omitted when it wasn't built in the window."
        },
        "look_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time a plan spent asking it for its frame, in milliseconds, with the\ncollection lock held."
        },
        "looks": {
          "default": 0,
          "description": "How many plans asked it for its frame.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "paint_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time a paint took, in milliseconds."
        },
        "paints": {
          "default": 0,
          "description": "How many times the `jstream-sources` thread painted it: a source that draws its\nown frames as they come due (`waveform`, `spectrum`, `timer`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id"
      ],
      "type": "object"
    },
    "SourceSize": {
      "description": "One source's current size, in a `source.sizes` result.",
      "properties": {
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its current frame's size. Omitted while the source has no video frame: it hasn't\nstarted, it has no video (an audio-only kind), or it failed."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id"
      ],
      "type": "object"
    },
    "StatsPolling": {
      "description": "How the engine polls audience stats, by how much of the day's estimated YouTube\nquota is left (ADR-0041 §5). Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "normal",
          "description": "At the normal rate.",
          "type": "string"
        },
        {
          "const": "slowed",
          "description": "Less often, because the quota is running low.",
          "type": "string"
        },
        {
          "const": "stopped",
          "description": "Not at all until the quota resets, because it is nearly or entirely used up.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from a newer server.",
          "type": "string"
        }
      ]
    },
    "StreamHealth": {
      "description": "How YouTube rates what a stream receives (`status.healthStatus.status`). Serialized\nas a snake_case string.",
      "oneOf": [
        {
          "const": "good",
          "description": "No problems.",
          "type": "string"
        },
        {
          "const": "ok",
          "description": "Minor problems.",
          "type": "string"
        },
        {
          "const": "bad",
          "description": "Problems that hurt the stream.",
          "type": "string"
        },
        {
          "const": "no_data",
          "description": "YouTube has no data yet.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "StreamInfo": {
      "description": "One stream, as `youtube.list_streams` reports it. Its key is never reported.",
      "properties": {
        "health": {
          "$ref": "#/$defs/StreamHealth",
          "description": "How healthy what it receives is."
        },
        "status": {
          "$ref": "#/$defs/StreamStatus",
          "description": "What it is doing."
        },
        "stream_id": {
          "description": "YouTube's ID for it: what `youtube.bind_broadcast` takes.",
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "title",
        "status",
        "health"
      ],
      "type": "object"
    },
    "StreamProfile": {
      "description": "One encoded stream's frames in the window ([`ProfileInfo::streams`]): what reached\nits encoder, what left it, and what was lost or late on the way.\n\nAn output's frames are its program feed's, from the video encoder to the muxer or\npublish target; a preview stream's go from its encoder to the client's socket. An\nencoder two outputs share counts for both, so `frames_in`, `encoded`, `late` and\n`encode_ms` repeat; what each sends and loses after it is its own.",
      "properties": {
        "dropped": {
          "default": 0,
          "description": "The video frames lost between its encoder's input and where it sends them: a\nfull encoder queue, a busy encoder, a full packet queue, or a dropped link.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encode_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time its encoder spent on a frame, in milliseconds. A hardware\nencoder that works asynchronously spends only the time to submit it."
        },
        "encoded": {
          "default": 0,
          "description": "The video frames its encoder took.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The frame rate it is encoded at."
        },
        "frames_in": {
          "default": 0,
          "description": "The video frames handed to its encoder, dropped ones included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames_out": {
          "default": 0,
          "description": "The video frames it sent: to the muxer or publish target for an output, to the\nclient for a preview stream.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kbps": {
          "default": 0,
          "description": "The bit rate it sent at over the window, in kilobits a second: video and audio\nfor an output, video for a preview stream.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "late": {
          "default": 0,
          "description": "The video frames its encoder took more than a frame period after they were\nhanded over: a stream falls behind before it drops.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream": {
          "$ref": "#/$defs/ProfileStream",
          "description": "Which stream."
        },
        "target_kbps": {
          "default": 0,
          "description": "The bit rate its encoders are set to, in kilobits a second, the same way.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stream"
      ],
      "type": "object"
    },
    "StreamStatus": {
      "description": "What YouTube says a stream is doing (`status.streamStatus`). Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "active",
          "description": "Receiving data.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "Created, with settings still missing.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Something is wrong with it.",
          "type": "string"
        },
        {
          "const": "inactive",
          "description": "Not receiving data.",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "Ready to receive data.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "ThreadProfile": {
      "description": "The threads of one name ([`ProfileInfo::threads`]).\n\nJStream names its own threads `jstream-…`, and those are `name`. A thread a library\nor driver loaded into the process started has the name that library gave it, if any:\nthird-party text (ADR-0059), so it is `remote_name`, data to show and never\ninstructions. An unnamed thread has neither.",
      "properties": {
        "count": {
          "default": 0,
          "description": "How many threads of that name ran in the window.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cpu_pct": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The CPU they used in the window, as a percentage of one core."
        },
        "name": {
          "description": "The name of JStream's own threads.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote_name": {
          "description": "The name another thread's library or driver gave it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TimelineChange": {
      "description": "Why a timeline's playing changed, in `timeline.changed`.",
      "oneOf": [
        {
          "const": "started",
          "description": "`timeline.play`, a `timeline.play` cue, or a hotkey bound to one started it from\n0, or started it again from 0.",
          "type": "string"
        },
        {
          "const": "sought",
          "description": "`timeline.seek` started it from `position_ms`.",
          "type": "string"
        },
        {
          "const": "looped",
          "description": "It reached the end of a pass and started the next one.",
          "type": "string"
        },
        {
          "const": "ended",
          "description": "A `once` timeline reached its `duration_ms`, after its last cue fired.",
          "type": "string"
        },
        {
          "const": "stopped",
          "description": "`timeline.stop`, or a `timeline.stop` cue, stopped it.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "A batch, undo or redo deleted it, or the scene holding it, while it played.",
          "type": "string"
        }
      ]
    },
    "TimelineCue": {
      "description": "One timed action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "What it does: one of the actions [`Action::cue_problem`] allows. Read as plain\nJSON, as a hotkey's action is, so a client older than an action a later cue may\nrun still reads the collection. [`TimelineCue::action`] parses it."
        },
        "at_ms": {
          "description": "When it fires, in milliseconds from the timeline's start.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "action"
      ],
      "type": "object"
    },
    "TimelineId": {
      "description": "A timeline a scene holds (ADR-0115). Unique across the collection, so an action\nnames it alone.",
      "type": "string"
    },
    "TimelineInfo": {
      "description": "One timeline: cues at times from its start, a length, and how it repeats.",
      "properties": {
        "cues": {
          "default": [],
          "description": "Its cues, in time order: each cue's `at_ms` is at least the one before it's, and\ncues at the same time fire in list order. At most 256.",
          "items": {
            "$ref": "#/$defs/TimelineCue"
          },
          "type": "array"
        },
        "duration_ms": {
          "description": "How long one pass runs, in milliseconds: at most one hour. A timeline that\nrepeats needs a length above 0.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "loop": {
          "$ref": "#/$defs/TimelineLoop",
          "default": "once",
          "description": "How it repeats. Omitted means `once`."
        },
        "name": {
          "description": "Its display name. Omitted means empty.",
          "type": "string"
        },
        "timeline_id": {
          "$ref": "#/$defs/TimelineId",
          "description": "Its ID, chosen by the client: 1 to 64 bytes of ASCII letters, digits, `_` and\n`-`, unique across the collection, so an action can name it alone."
        }
      },
      "required": [
        "timeline_id",
        "duration_ms"
      ],
      "type": "object"
    },
    "TimelineLoop": {
      "description": "How a timeline repeats.",
      "oneOf": [
        {
          "const": "once",
          "description": "It plays once, and ends at its `duration_ms`. A cue at `duration_ms` fires.",
          "type": "string"
        },
        {
          "const": "loop",
          "description": "It plays from 0 to `duration_ms` again and again, until stopped. A cue at\n`duration_ms` would never fire, so it is refused: put it at 0. `duration_ms` is at\nleast 100 ([`MIN_LOOP_MS`]).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "It plays from 0, and each time it reaches `to_ms` jumps back to `from_ms`: an\nintro, then a loop. `from_ms < to_ms <= duration_ms`, `to_ms - from_ms` is at\nleast 100 ([`MIN_LOOP_MS`]), and a cue at or after `to_ms` is refused.",
          "properties": {
            "range": {
              "properties": {
                "from_ms": {
                  "description": "Where each repeat starts, in milliseconds.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "to_ms": {
                  "description": "Where each pass jumps back, in milliseconds.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "from_ms",
                "to_ms"
              ],
              "type": "object"
            }
          },
          "required": [
            "range"
          ],
          "type": "object"
        }
      ]
    },
    "TransitionEffect": {
      "description": "How an item without a partner appears or disappears.",
      "oneOf": [
        {
          "const": "inherit",
          "description": "The preset's `unmatched` setting.",
          "type": "string"
        },
        {
          "const": "fade",
          "description": "Opacity only.",
          "type": "string"
        },
        {
          "const": "scale",
          "description": "Toward 65% of its size about its centre, while fading.",
          "type": "string"
        },
        {
          "const": "slide",
          "description": "Toward the nearest canvas edge until it is off the canvas, while fading.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "At once, at the item's start: no animation.",
          "type": "string"
        }
      ]
    },
    "TransitionPresetId": {
      "description": "A transition preset in the collection (ADR-0029).",
      "type": "string"
    },
    "TransitionPresetInfo": {
      "description": "One transition preset, as `state.get` reports it.",
      "properties": {
        "duration_ms": {
          "description": "How long one item takes, in milliseconds. A kind that ignores it (`cut`) still\nkeeps it.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "description": "The curve its items follow unless they set their own."
        },
        "kind": {
          "description": "Its transition kind's ID, as `kind.list` reports it (`cut`, `fade`, `move`).",
          "type": "string"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset's ID."
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its kind's settings: every parameter of the kind. Omitted for a kind without\nparameters."
        }
      },
      "required": [
        "preset_id",
        "name",
        "kind",
        "duration_ms",
        "easing"
      ],
      "type": "object"
    },
    "TransitionStarted": {
      "description": "What `studio.changed` reports about the transition a switch started.",
      "properties": {
        "duration_ms": {
          "description": "How long the transition runs, in milliseconds, from the switch to its last item's\nend. 0 for a cut, which shows the new scene on the next frame.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preset_id": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset the engine chose: the one the switch named, else the new scene's\n`transition_in`, else the old scene's `transition_out`, else the default."
        }
      },
      "required": [
        "preset_id",
        "duration_ms"
      ],
      "type": "object"
    },
    "TransitionsInfo": {
      "description": "The collection's transition presets, as `state.get` reports them.",
      "properties": {
        "default": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset a switch uses when nothing else names one. It always exists."
        },
        "presets": {
          "description": "Every preset, ordered by ID.",
          "items": {
            "$ref": "#/$defs/TransitionPresetInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "presets",
        "default"
      ],
      "type": "object"
    },
    "UnitProfile": {
      "description": "One unit of drawing work and what it cost ([`ProfileInfo::units`]).",
      "properties": {
        "drawer": {
          "$ref": "#/$defs/Drawer",
          "description": "The thread that did it."
        },
        "frames": {
          "default": 0,
          "description": "The frames it ran in. A source's upload runs only in frames where its picture\nchanged.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "gpu_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "The average GPU time it took in a frame it ran in, in milliseconds, when\n`gpu_timing` is on."
        },
        "ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time it took in a frame it ran in, in milliseconds."
        },
        "recent_max_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The longest it took in one frame during the last second the drawer reported,\nin milliseconds."
        },
        "share": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Its share of the drawer's time in the window, from 0 to 1."
        },
        "unit": {
          "$ref": "#/$defs/ProfileUnit",
          "description": "What it is and who owns it."
        }
      },
      "required": [
        "drawer",
        "unit"
      ],
      "type": "object"
    },
    "Vec2": {
      "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
      "properties": {
        "x": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal component."
        },
        "y": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical component."
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Vec3": {
      "description": "A point or a direction in a scene's 3D space, in scene pixels: x right, y down, z\ntoward the viewer, the canvas at `z = 0`.",
      "properties": {
        "x": {
          "$ref": "#/$defs/Finite32",
          "description": "Right."
        },
        "y": {
          "$ref": "#/$defs/Finite32",
          "description": "Down."
        },
        "z": {
          "$ref": "#/$defs/Finite32",
          "description": "Toward the viewer."
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "type": "object"
    },
    "VideoCodec": {
      "description": "A video codec. Serialized as a snake_case string. Streams carry HEVC and AV1 in\nenhanced RTMP; a recording takes H.264 only so far, and its start fails with another.\nA machine with no encoder for the codec, or none that fits the profile's\n`hardware`, fails `output.start`.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 (AVC).",
          "type": "string"
        },
        {
          "const": "hevc",
          "description": "HEVC (H.265). Since 0.41.",
          "type": "string"
        },
        {
          "const": "av1",
          "description": "AV1. Since 0.41.",
          "type": "string"
        }
      ]
    },
    "VideoEncoding": {
      "description": "How the video is encoded.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "The codec."
        },
        "hardware": {
          "$ref": "#/$defs/HardwarePreference",
          "default": "avoid",
          "description": "Whether to use a hardware encoder. Omitted means `avoid`."
        },
        "keyframe_interval_s": {
          "description": "Seconds from one keyframe to the next, 1..=10, else `invalid_argument`. Most\nstreaming services ask for 2.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate_control": {
          "$ref": "#/$defs/RateControl",
          "description": "How the encoder spends bits. Rejected with `invalid_argument` outside\n100..=100000 kbit/s, or, for `vbr`, with a peak below the average or above\n200000 kbit/s."
        }
      },
      "required": [
        "codec",
        "rate_control",
        "keyframe_interval_s"
      ],
      "type": "object"
    },
    "VideoMix": {
      "description": "A mix: which picture, at what size and rate.",
      "properties": {
        "fps_divisor": {
          "default": 1,
          "description": "Renders every `fps_divisor`th tick of the engine's base frame rate: 1 is the base\nrate, 2 half of it. Missing parses as 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "input": {
          "$ref": "#/$defs/MixInput",
          "description": "What it shows."
        },
        "resolution": {
          "$ref": "#/$defs/MixResolution",
          "description": "Its frame size in pixels. The canvas is fitted inside it, centred, with black\nbars where the aspect ratios differ, never stretched (ADR-0022)."
        }
      },
      "required": [
        "input",
        "resolution"
      ],
      "type": "object"
    },
    "VideoMixId": {
      "description": "A video mix in the collection: what an output's video shows.",
      "type": "string"
    },
    "VideoMixInfo": {
      "description": "One mix, as `video_mix.list` and `state.get` report it.",
      "properties": {
        "mix": {
          "$ref": "#/$defs/VideoMix",
          "description": "What it shows, and at what size and rate."
        },
        "mix_id": {
          "$ref": "#/$defs/VideoMixId",
          "description": "The mix's ID."
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        }
      },
      "required": [
        "mix_id",
        "name",
        "mix"
      ],
      "type": "object"
    },
    "VisibleIf": {
      "description": "A UI hint: show a parameter only while parameter `param` equals `equals`. Hints never\naffect validation.",
      "properties": {
        "equals": {
          "description": "The value it must have."
        },
        "param": {
          "description": "The parameter whose value decides.",
          "type": "string"
        }
      },
      "required": [
        "param",
        "equals"
      ],
      "type": "object"
    },
    "Welcome": {
      "description": "The server's answer to [`Hello`].",
      "properties": {
        "client_id": {
          "$ref": "#/$defs/ClientId",
          "description": "The identity this connection acts as: its undo history and audit-log entries are\nkeyed by it."
        },
        "max_request_bytes": {
          "description": "The request limit (0.62, ADR-0074): the most message text, in bytes, the server\nhandles in one client message. A message over it, up to the server's frame limit,\nis refused with `too_large` and the connection stays open. Only a server in front\nof the engine sets it; missing (an older server, or an engine with no server in\nfront) means 4 MiB.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the server speaks."
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The current state revision, so the client knows where it starts."
        }
      },
      "required": [
        "protocol",
        "client_id",
        "rev"
      ],
      "type": "object"
    },
    "WireError": {
      "description": "A [`ProtocolError`] as sent on the wire: its `code` and details, plus a message.\n\n```json\n{\"code\": \"rev_conflict\", \"expected\": 4, \"current\": 5,\n \"message\": \"expected rev 4, but the state is at rev 5\"}\n```",
      "oneOf": [
        {
          "description": "The server can't speak the client's protocol version.",
          "properties": {
            "client": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the client asked for in `hello`."
            },
            "code": {
              "const": "unsupported_version",
              "type": "string"
            },
            "server": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the server speaks."
            }
          },
          "required": [
            "code",
            "client",
            "server"
          ],
          "type": "object"
        },
        {
          "description": "A request arrived before the `hello`/`welcome` handshake finished.",
          "properties": {
            "code": {
              "const": "handshake_required",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The message could not be parsed: bad JSON, an unknown `type`, a missing or\nmistyped field, or a number that isn't a finite `f32` (NaN, infinity, or out of\nrange such as `1e39`). `ClientMessage::parse` produces it.",
          "properties": {
            "code": {
              "const": "malformed",
              "type": "string"
            },
            "reason": {
              "description": "What the parser reported.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A batch had no edits.",
          "properties": {
            "code": {
              "const": "empty_batch",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The batch's `expected_rev` was not the current revision. Nothing was applied:\nre-read the state and retry.",
          "properties": {
            "code": {
              "const": "rev_conflict",
              "type": "string"
            },
            "current": {
              "$ref": "#/$defs/Rev",
              "description": "The state's revision when the batch was checked."
            },
            "expected": {
              "$ref": "#/$defs/Rev",
              "description": "The `expected_rev` the batch carried."
            }
          },
          "required": [
            "code",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "description": "A command named an object that doesn't exist.",
          "properties": {
            "code": {
              "const": "not_found",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A creating edit used an ID that is already taken.",
          "properties": {
            "code": {
              "const": "already_exists",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A field had a value the engine can't accept.",
          "properties": {
            "blockers": {
              "description": "When a `scene.delete` or `source.delete` is refused because other objects still\nrefer to its target: every one of those references, in a stable order. The\n`delete.plan` query returns the batch that removes them with the target. Empty\notherwise, and then omitted. Missing (from a server older than 0.15)\nparses as empty.",
              "items": {
                "$ref": "#/$defs/Blocker"
              },
              "type": "array"
            },
            "code": {
              "const": "invalid_argument",
              "type": "string"
            },
            "field": {
              "description": "The field, as a dotted path into the command (`edits.2.name`).",
              "type": "string"
            },
            "reason": {
              "description": "Why it was rejected.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "field",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "An undo or redo would overwrite another client's work: a batch that client\napplied after the step changed a property the step sets, created or deleted an\nobject the step creates or deletes, or made the step's edits no longer apply.\nNothing was applied, and the step was dropped from the history, so the next undo\nreaches the step before it.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose batch conflicts."
            },
            "code": {
              "const": "undo_conflict",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision that batch produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced."
            }
          },
          "required": [
            "code",
            "step_rev",
            "client_id",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "There is nothing to undo, or nothing to redo.",
          "properties": {
            "code": {
              "const": "history_empty",
              "type": "string"
            },
            "direction": {
              "$ref": "#/$defs/HistoryDirection",
              "description": "Which way the call asked to move."
            }
          },
          "required": [
            "code",
            "direction"
          ],
          "type": "object"
        },
        {
          "description": "An action was accepted for processing but could not be carried out.",
          "properties": {
            "code": {
              "const": "action_failed",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The call is valid, but whoever answered it doesn't serve it: `pairing.start`,\n`device.list` and `device.revoke` sent to an engine with no server in front,\na `plugin.*` action sent to an engine that hosts no plugins yet, or the deprecated\n`privacy.set` (ADR-0080).\nRetrying won't help.",
          "properties": {
            "call": {
              "description": "The call's name (`pairing.start`).",
              "type": "string"
            },
            "code": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call"
          ],
          "type": "object"
        },
        {
          "description": "The caller may not make this call (0.35): a plugin's call outside its granted\ncapability classes, a command no plugin is ever granted, or a plugin past its cap\nof commands a second (ADR-0069). Nothing was applied. Retrying won't help until\na person widens the grant, except after the command cap, which clears within a\nsecond.",
          "properties": {
            "call": {
              "description": "The call's name (`output.start`), or for a batch, its first edit's.",
              "type": "string"
            },
            "code": {
              "const": "forbidden",
              "type": "string"
            },
            "reason": {
              "description": "Why: the class the caller lacks, or that no plugin may make it.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "`output.start` could not open a hardware video encoder while other hardware\nencoder sessions were open, so the machine's hardware session limit is taken to\nbe reached (0.44, ADR-0080 §3). The engine doesn't guess vendor caps and never\nfalls back to a software encoder for this. Nothing was started. Stop one of\n`outputs`, share an encoder session with one, or start this output with an\nencoder profile whose `hardware` is `avoid`.",
          "properties": {
            "code": {
              "const": "hardware_session_limit",
              "type": "string"
            },
            "outputs": {
              "description": "The running outputs that hold hardware encoder sessions, sorted.",
              "items": {
                "$ref": "#/$defs/OutputId"
              },
              "type": "array"
            },
            "reason": {
              "description": "What the encoder said when it refused the new session.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "outputs",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The message was over the server's request limit (0.62, ADR-0074). The server read\nonly its envelope's `id`: nothing in it was applied, and the connection stays\nopen. Retrying the same message won't help: split the work, for example one\nfilter's `state` per batch. `Welcome.max_request_bytes` advertises the limit.",
          "properties": {
            "code": {
              "const": "too_large",
              "type": "string"
            },
            "limit_bytes": {
              "description": "The server's request limit in bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "size_bytes": {
              "description": "The message's size in bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "code",
            "size_bytes",
            "limit_bytes"
          ],
          "type": "object"
        },
        {
          "description": "The engine hit a bug or an unexpected condition. The request may be retried.",
          "properties": {
            "code": {
              "const": "internal",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "message": {
          "description": "A human-readable explanation, for logs and for agents. Not stable: match on\n`code`, never on this.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "YoutubeAuth": {
      "description": "Whether the engine is signed in to YouTube. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "unavailable",
          "description": "The engine has no Google OAuth client (as in a build whose built-in client is\nstill empty), so YouTube's API features are off. Clients hide YouTube's sign-in and\nbroadcast controls; the YouTube actions and queries fail with `action_failed`.",
          "type": "string"
        },
        {
          "const": "signed_out",
          "description": "Not signed in. `youtube.sign_in` starts a sign-in.",
          "type": "string"
        },
        {
          "const": "signing_in",
          "description": "A sign-in is waiting for the user to finish it in the browser.",
          "type": "string"
        },
        {
          "const": "signed_in",
          "description": "Signed in. The engine holds the account's refresh token in the OS credential\nstore and uses it for every YouTube call.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A state this version of the protocol doesn't know, from a newer server.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ],
  "description": "Any message on a JStream control connection: client to server, or server to client.",
  "title": "JStream protocol 0.95"
}
