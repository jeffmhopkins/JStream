              "description": "This page's streams.",
              "items": {
                "$ref": "#/$defs/StreamInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "youtube.list_streams",
              "type": "string"
            }
          },
          "required": [
            "type",
            "streams"
          ],
          "type": "object"
        },
        {
          "description": "The result of `youtube.stats`. Runtime state, so it carries no `rev`.",
          "properties": {
            "outputs": {
              "description": "The audience of each running `youtube` output YouTube has reported one for,\nordered by output ID.",
