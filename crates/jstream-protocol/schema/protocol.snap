---
source: crates/jstream-protocol/src/fixtures.rs
---
{
  "$defs": {
    "Action": {
      "description": "A command with side effects outside the collection state: never undoable and never\nbatchable.\n\nSerialized with an internal `type` tag holding the command name. The response says\nthe action was accepted, with an [`ActionResult`](crate::ActionResult) for the\nactions that return something (a YouTube sign-in's consent URL, a broadcast); how\nit goes is reported by events (`output.state_changed`).",
      "oneOf": [
        {
          "description": "Starts an output (stream, recording or virtual camera).",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to start."
            },
            "type": {
              "const": "output.start",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Stops an output.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to stop."
            },
            "type": {
              "const": "output.stop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Stores an output's stream key in the OS credential store (R-SEC-001), replacing\nany key it had. Write-only: the key never comes back in a response, event, error,\n`state.get` or log, and `output.status` reports only `key_set`. An action, not an\nedit: the key is not collection state, so it is never undone. A running output\nuses the new key from its next `output.start`. Fails with `not_found` for an\noutput not in the collection, `invalid_argument` (field `key`) for an empty key,\none over 1024 bytes or one with whitespace, control or non-ASCII characters, and\n`action_failed` when the engine has no credential store, the store refuses, or\nthe output's `output.start` is still opening its target (#343): send it again\nonce the start has settled.",
          "properties": {
            "key": {
              "$ref": "#/$defs/SecretString",
              "description": "The stream key, as the streaming service shows it."
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output whose key to set."
            },
            "type": {
              "const": "output.set_key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "Removes an output's stream key from the credential store. Succeeds when there is\nnone, and for an output that is no longer in the collection, so a client can clear\nthe key of an output it deleted. Fails with `action_failed` when the engine has no\ncredential store or the store refuses.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output whose key to remove."
            },
            "type": {
              "const": "output.clear_key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Opens the gesture `gesture_id` if it is new, and sets its live values (ADR-0032):\neach overrides one parameter of the collection on output, from the next render\ntick, without changing `rev`. A value replaces the gesture's previous value for\nthe same parameter, and takes the parameter over from any other gesture that held\nit. Values are validated as a batch's edits are (`not_found`, `invalid_argument`\nwith the field `values.<n>.<field>`); a value that is not a live-adjustable\nsetter (`item.set_transform`, `item.set_geometry`, `item.set_crop`, and since\n0.67 `source.set_settings` naming only parameters its kind marks `live`, each a\nparameter of its own, ADR-0091), an empty or over-256 list, and a 17th open\ngesture are `invalid_argument`. Nothing in a\nrejected message is applied. A value whose `scene_id` names a keyframe scene is,\nsince 0.53 (refused before), that keyframe's parameter, apart from the item's\nown: it shows only where the keyframe draws the item, and the item's own value\nshows there only in a field the keyframe doesn't override. The gesture ends with\na batch carrying `ends_gesture`, with `live.cancel`, or when its client's session\nends.",
          "properties": {
            "gesture_id": {
              "$ref": "#/$defs/GestureId",
              "description": "The gesture, chosen by the client and unique among its open gestures."
            },
            "type": {
              "const": "live.set",
              "type": "string"
            },
            "values": {
              "description": "The values, as setter edits: the same edits the committing batch carries.",
              "items": {
                "$ref": "#/$defs/Edit"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "type",
            "gesture_id",
            "values"
          ],
          "type": "object"
        },
        {
          "description": "Ends one of the client's gestures without a commit: its parameters show their\ncollection values again, and no edit is made. Succeeds when the client has no\nsuch gesture open, so a retry is safe.",
          "properties": {
            "gesture_id": {
              "$ref": "#/$defs/GestureId",
              "description": "The gesture to cancel."
            },
            "type": {
              "const": "live.cancel",
              "type": "string"
            }
          },
          "required": [
            "type",
            "gesture_id"
          ],
          "type": "object"
        },
        {
          "description": "Starts signing in to YouTube with the full `youtube` scope (ADR-0041 §4, kept by ADR-0058) and\nreturns Google's consent URL (`ActionResult` `youtube.sign_in`). The client opens\nit in a browser; Google then redirects to a listener the engine opened on\n`127.0.0.1`, and the engine finishes the sign-in, keeps the refresh token in the\nOS credential store and emits `youtube.status_changed` (`signed_in`, or\n`signed_out` when the user declines or the sign-in times out after 5 minutes).\nSent again while a sign-in waits, it returns the same URL. Sent while signed in,\nit starts a new sign-in, which replaces the account once it finishes. Fails with\n`action_failed` when no YouTube OAuth client is configured.",
          "properties": {
            "type": {
              "const": "youtube.sign_in",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Signs out of YouTube: removes the account's token from the credential store,\nabandons a sign-in that is waiting, then revokes the token at Google (best\neffort).\nEmits `youtube.status_changed` `signed_out`. Succeeds when already signed out.\nA running `youtube` output keeps its connection. Fails with `action_failed` when\nno YouTube OAuth client is configured or the credential store refuses.",
          "properties": {
            "type": {
              "const": "youtube.sign_out",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Creates a YouTube broadcast (`liveBroadcasts.insert`) and returns it. JStream\nmoves it through its states itself (`youtube.transition_broadcast`), so automatic\nstart and stop are off, and its monitor stream is on so `testing` works. Fails\nwith `invalid_argument` for an empty title or start time or an `other` privacy,\nand with `action_failed` when not signed in or YouTube refuses, including when\nthe day's API quota is used up.",
          "properties": {
            "description": {
              "description": "Its description. Omitted means empty.",
              "type": "string"
            },
            "made_for_kids": {
              "default": false,
              "description": "Whether it is made for kids. Omitted means `false`.",
              "type": "boolean"
            },
            "privacy": {
              "$ref": "#/$defs/BroadcastPrivacy",
              "default": "private",
              "description": "Who can watch it. Omitted means `private`."
            },
            "scheduled_start_time": {
              "description": "When it is scheduled to start, RFC 3339 (`2026-10-16T19:00:00Z`).",
              "type": "string"
            },
            "title": {
              "description": "Its title.",
              "type": "string"
            },
            "type": {
              "const": "youtube.create_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "title",
            "scheduled_start_time"
          ],
          "type": "object"
        },
        {
          "description": "Binds a stream to a broadcast (`liveBroadcasts.bind`) and returns the broadcast.\nA `youtube` output sends to its broadcast's bound stream. With no `stream_id`,\nthe engine first creates a reusable stream named after the broadcast. Fails\nwith `action_failed` when not signed in or YouTube refuses.",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast.",
              "type": "string"
            },
            "stream_id": {
              "description": "The stream to bind, as `youtube.list_streams` reports it. Omitted creates one.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "youtube.bind_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast_id"
          ],
          "type": "object"
        },
        {
          "description": "Moves a broadcast to `testing`, `live` or `complete`\n(`liveBroadcasts.transition`) and returns it. `testing` and `live` need its\nbound stream to be receiving: start its `youtube` output first. Fails with\n`action_failed` when not signed in or YouTube refuses (a transition the\nbroadcast can't make, or a stream that isn't sending).",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast.",
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/BroadcastTransition",
              "description": "Where to move it."
            },
            "type": {
              "const": "youtube.transition_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast_id",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Restarts the master bus's integrated loudness measurement (ADR-0028). Meters are\nruntime state, so this is an action, never an edit. Succeeds, doing nothing, while\nthe mixer isn't running.",
          "properties": {
            "type": {
              "const": "audio.reset_loudness",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Opens a preview stream of the program mix, or of the scene `scene_id`, for this\nsession: low-resolution pictures sent as binary frames on `channel`, only to this\nsession (ADR-0045). The picture is the canvas scaled down to fit `max_width` ×\n`max_height`, with even sides; it follows the canvas when that changes. A picture\nis sent when what the stream shows changes, at most `fps` times a second, and at\nleast once every 2 s (a keyframe), so a client that lost frames recovers. The\nengine picks the first of `codecs` it can encode, and every frame names its codec.\nThe stream shows the mix before any master stage. A scene's stream shows the\nscene alone, as program would show it with no transition running, and never makes\na source shown or heard (ADR-0028). It lasts until `preview.unsubscribe`, the\nsession's end, or an end frame (the engine could not go on, or the scene was\ndeleted; the frame says why).\n\nWith `source`, the stream shows that source alone, fitted into the canvas as an\nitem filling it would show it, with no filters: what a display, window or webcam\nsource would capture, before it exists or before its new settings are saved (the\nProperties dialog's picture). The engine opens the capture for the stream alone;\na webcam or capture card already open is shared, not opened twice. The canvas\nsize is the one at the subscription: subscribe again for other settings.\n\nWith `source_id`, the stream shows that source of the collection alone, fitted\ninto the canvas as an item filling it would show it, with the source's own\nfilters and none of an item's: a projector of the source. It follows the\nsource's settings and filters as they change, and the canvas too. Like a scene's\nstream it never makes the source shown or heard. It ends, with an end frame, when\nthe source is deleted.\n\nFails with `invalid_argument` for a field out of range (`max_width` 16 to 1920,\ndefault 640; `max_height` 16 to 1080, default 360; `fps` 1 to 30, default 15), a\ncodec named twice, a `channel` this session already has open (`channel`), a\nseventeenth open stream, more than one of `scene_id`, `source` and `source_id` (the\nlater field), or a `source`\nwhose kind is not a capture kind or whose settings its kind refuses\n(`source.kind`, `source.settings.<param>`); with `not_found` for a `scene_id` or a\n`source_id` the collection doesn't have; and with `action_failed` when the session cannot receive binary frames (an\nMCP session) or none of `codecs` can be encoded here.",
          "properties": {
            "channel": {
              "description": "The number this stream's binary frames carry, chosen by the client. Not an\nID: it only tells this session's streams apart, and can be reused once the\nstream has ended.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "codecs": {
              "description": "The codecs the client can decode, most preferred first. Empty or omitted\nmeans `[\"h264\", \"jpeg\"]`.",
              "items": {
                "$ref": "#/$defs/PreviewCodec"
              },
              "type": "array"
            },
            "fps": {
              "description": "Pictures per second, at most. Default 15.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "max_height": {
              "description": "The tallest the picture may be, in pixels. Default 360.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "max_width": {
              "description": "The widest the picture may be, in pixels. Default 640.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene to show. Omitted for the program mix."
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PreviewDraft"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A source to show alone instead, one the collection doesn't hold (since 0.49).\nOmitted for the program mix or `scene_id`'s scene."
            },
            "source_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A source of the collection to show alone (since 0.56), as a projector of it\ndoes. Omitted for the program mix, `scene_id`'s scene or `source`."
            },
            "type": {
              "const": "preview.subscribe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "channel"
          ],
          "type": "object"
        },
        {
          "description": "Closes one of this session's preview streams. No end frame follows; frames\nalready sent may still arrive. Succeeds for a channel that is not open.",
          "properties": {
            "channel": {
              "description": "The channel the stream was opened on.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "preview.unsubscribe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "channel"
          ],
          "type": "object"
        },
        {
          "description": "Puts a scene on program, with a transition (ADR-0029): the preset `preset_id`\nnames, else the scene's `transition_in`, else the current program scene's\n`transition_out`, else the default preset. A `cut`, a zero duration, or a preset\nwhose kind the engine doesn't have shows the scene from the next frame. A switch\nduring a transition starts from what is on screen. The program scene is runtime\nstate, not collection state (ADR-0030): the switch changes no `rev`, is never\nundone, and emits `studio.changed` naming the preset it used, which `studio.get`\nreads back. Switching to the scene already on program succeeds and emits nothing.\nFails with `not_found` for a scene or a preset not in the collection.",
          "properties": {
            "preset_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionPresetId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The preset to use, overriding the scenes' and the default."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to put on program."
            },
            "type": {
              "const": "scene.switch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "`scene.switch`, then a frame sheet of the program mix from the switch on (since\n0.82, #1061), as `video.frames` takes one: so an agent sees a transition, a\nstinger's cover or a keyframe move as it plays, from one call. The switch is made\nas `scene.switch` makes it, and emits what it emits; the answer comes once the\nlast picture is drawn, as a `scene.switch_and_watch` result. Switching to the\nscene already on program still takes the sheet. Fails as `scene.switch` does,\nbefore switching with `invalid_argument` past the [`FrameStrip`] limits.",
          "properties": {
            "count": {
              "description": "How many pictures, 2 to 16.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "delay_ms": {
              "description": "How long to wait before the first picture, in milliseconds. Default 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "interval_ms": {
              "description": "The time between two pictures, in milliseconds, at least 10.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "preset_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionPresetId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The preset to use, overriding the scenes' and the default."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to put on program."
            },
            "type": {
              "const": "scene.switch_and_watch",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "count",
            "interval_ms"
          ],
          "type": "object"
        },
        {
          "description": "Puts a scene on preview, the scene studio mode prepares before it goes on program\nwith `scene.switch`. Preview is runtime state like program: it changes no `rev`,\nis never undone, and emits `studio.changed`. It never affects what an output\nshows unless the output's mix is the preview mix. Setting the scene already on\npreview succeeds and emits nothing. Fails with `not_found` for a scene not in\nthe collection.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to put on preview."
            },
            "type": {
              "const": "studio.set_preview",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Shows an item (0.80, ADR-0101) with its own appear effect, the way a hotkey shows\none: the placement's `visible` becomes `true` as `item.set_visible` would make it,\nwith the same `scene_id` rules and the same errors (`not_found` for an item or\nscene not in the collection, `invalid_argument` on `scene_id` for a scene whose\nplacement it can't change). It is collection state: `rev` moves on by one,\n`state.changed` follows and the collection saves it. It is an action, so it is\nnever a step of the sender's undo history (ADR-0024 §5); another client's undo that\nwould overwrite it fails with `undo_conflict`, as after a batch. Showing an item\nalready shown succeeds and changes nothing.\n\nWhen the program scene draws the item, it appears with its `appear` effect, after\nits `delay_ms` and with its easing, over the default preset's duration. `inherit`\nis the default preset's `unmatched`, or no animation when that preset is a `cut`\nor another kind without one. A source the program shows again this way restarts\nas on a scene switch: a `media` or `browser` source with `restart_on_show` starts\nfrom the beginning. A running transition continues from what is on screen.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to show."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.show",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Hides an item with its own `disappear` effect (0.80, ADR-0101): `item.show`'s\nopposite, with the same rules. Hiding an item already hidden succeeds and changes\nnothing.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to hide."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.hide",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Shows the item if that placement hides it, else hides it (0.80, ADR-0101), as\n`item.show` and `item.hide` do. In a keyframe scene, the placement's visibility is\nthe keyframe's override if it has one, else the item's own. An action takes no\n`expected_rev` or idempotency key, so a retried toggle flips twice: a caller that\nmay retry sends `item.show` or `item.hide`, which are safe to repeat.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to show or hide."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.toggle",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Zooms a scene's follow camera (ADR-0113 §4, since 0.85): multiplies its live zoom by 1.25 per\nstep, a negative step zooming out, held to 1 to 4, and smoothed over 350 ms. Not an\nedit: nothing is stored or undone, and the zoom starts again at the follow camera's\nown `zoom` when it changes or the engine restarts. One step by default, so a hotkey\ncan run it (ADR-0112). `not_found` for a scene that doesn't exist,\n`action_failed` for one without a camera that follows, and\n`invalid_argument` for `steps` outside -16..=16.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene whose camera to zoom: a keyframe scene zooms its family's."
            },
            "steps": {
              "default": 1,
              "description": "How many steps in; negative zooms out. Default 1.",
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "scene.zoom_camera",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Fires an item's motion modifiers on the `triggered` clock (ADR-0099, #1107),\nsince 0.84: the one `modifier_id` names, or every one on the item when it is\nomitted. Each starts again from its beginning, so firing one while it runs\nrestarts it. The fire is runtime state like the program scene: it changes no\n`rev`, is never undone and emits nothing; the item moves on every mix that draws\nit. A modifier on a group's item moves the whole group. Firing a modifier the\nitem doesn't hold, or one on another clock, does nothing, since a keyframe scene\ncan override the list it fires. Fails with `not_found` for an item not in the\ncollection, and with `invalid_argument` for a malformed `modifier_id`.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item whose modifiers it fires."
            },
            "modifier_id": {
              "description": "The modifier to fire. Omitted for every one on the `triggered` clock.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "item.trigger_motion",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Sets the keyframe a scene is drawn through wherever another scene places it\n(ADR-0116, since 0.88): keyframe tracks. A scene with keyframe scenes then switches\nbetween them on its own, independently of the scene placing it and of every other\nplaced scene, so independent states (a background, a panel layout, an effect)\ndon't multiply into one keyframe each combination. Where the placing scene is\ndrawn through a keyframe of its own that overrides an item in this scene's tree,\nthat keyframe draws it instead. What each placed scene draws through is studio\nstate like the program scene: it changes no `rev`, is never undone or saved, and\n`studio.get` reports it. When program draws the scene and the preset is a `move`\nor `fade`, the change plays as its Move from what is on screen, pairing each item\nwith itself, as `item.show` does; any other kind switches at once. Emits `scene.keyframe_changed`. Fails with `not_found` for a\nscene, keyframe or preset the collection doesn't have, and with\n`invalid_argument` when `scene_id` is itself a keyframe scene or `keyframe_id`\nisn't one of its keyframe scenes.",
          "properties": {
            "keyframe_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One of its keyframe scenes. Omitted for the scene's own values."
            },
            "preset_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionPresetId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The preset whose timing the Move takes. Omitted for the default preset; one\nwith no length (a cut) switches at once."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene whose placements switch: not a keyframe scene."
            },
            "type": {
              "const": "scene.set_keyframe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Plays a timeline from its start (ADR-0115, since 0.87), or from its start again if\nit is playing. Its cues fire at their times on the animation clock (ADR-0099\ndecision 2), on every pass of a loop, until it ends or is stopped. Playing is\nstudio state like the program scene: it changes no `rev`, is never undone, and\nemits `timeline.changed` (`started`); each cue emits `timeline.cue_fired`. A cue\nruns its action as the call would run, with the effects that call has (a\n`scene.switch` emits `studio.changed`, an `item.show` moves `rev`), credited to the\nclient that started the timeline. A transition a cue starts takes the cue's exact\ntime as its start, so a late tick doesn't delay what is seen. It plays whatever\nscene is on program, since each cue names its own target. Fails with `not_found`\nfor a timeline the collection doesn't hold.",
          "properties": {
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline to play."
            },
            "type": {
              "const": "timeline.play",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id"
          ],
          "type": "object"
        },
        {
          "description": "Stops a playing timeline (ADR-0115, since 0.87), where it is: what its cues did\nstays. Emits `timeline.changed` (`stopped`). Stopping a timeline that isn't playing\nsucceeds and emits nothing. Fails with `not_found` for a timeline the collection\ndoesn't hold.",
          "properties": {
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline to stop."
            },
            "type": {
              "const": "timeline.stop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id"
          ],
          "type": "object"
        },
        {
          "description": "Plays a timeline from `at_ms` on its first pass (ADR-0115, since 0.87), whether or\nnot it was playing, so the scene shows what it would if the timeline had played\nthere: first the cues before `at_ms` that set a state run at once, only the last\none for each thing they set (the program scene, an item's visibility, a shared\nvalue), then the timeline plays on from `at_ms`. Cues that are events (a toggle, a\nrestart, a fired motion, another timeline's play, stop or seek) don't run again.\nEmits `timeline.changed` (`sought`). Fails with `not_found` for a timeline the\ncollection doesn't hold, and with `invalid_argument` on `at_ms` past its\n`duration_ms`, or for a timeline that repeats, at or past where it jumps back.",
          "properties": {
            "at_ms": {
              "description": "Where to play it from, in milliseconds from its start.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline."
            },
            "type": {
              "const": "timeline.seek",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id",
            "at_ms"
          ],
          "type": "object"
        },
        {
          "description": "Restarts a source from its beginning (ADR-0115, since 0.87): a `browser` page\nloads again, and a `media` file plays from its start. Other kinds have nothing to\nrestart, so for them it succeeds and does nothing, as it does for a source no mix\nshows yet. Runtime state like a scene switch's restart: it changes no `rev` and is\nnever undone. Fails with `not_found` for a source the collection doesn't hold.",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to restart."
            },
            "type": {
              "const": "source.restart",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Opens pairing for one more device (ADR-0044): the server draws a one-time\npairing code and answers with it, to this client only (a `result` of type\n`pairing.start`). A device that posts the code with a name to `POST\n/api/v1/pair` within 2 minutes gets its own device token. One code is open at a\ntime: a new `pairing.start` replaces the one open. A code is single-use and void\nafter 5 wrong attempts. The code never appears in a log, an event or any other\nanswer (R-SEC-001). Answered by the server that admits clients, not the engine:\na `Control` with no server in front fails with `unsupported`. Fails with\n`action_failed` when the server listens beyond loopback, since a device token\ntravels only over loopback or TLS and the server has no TLS yet.",
          "properties": {
            "type": {
              "const": "pairing.start",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Revokes a paired device: its token stops working at once, and its open\nconnections are closed. Fails with `not_found` for a device that isn't paired\n(or whose token lapsed after 30 days unused). Answered by the server, like\n`pairing.start`.",
          "properties": {
            "device_id": {
              "$ref": "#/$defs/DeviceId",
              "description": "The device to revoke, as `device.list` reports it."
            },
            "type": {
              "const": "device.revoke",
              "type": "string"
            }
          },
          "required": [
            "type",
            "device_id"
          ],
          "type": "object"
        },
        {
          "description": "Keeps a UI setting on the engine's machine (0.52, ADR-0084): an opaque JSON value\nthe UI owns, under `key` (the web UI keeps its dock under `workspace.dock`), so\nevery client of the engine, the desktop app and each browser, reads the same one\nback with `ui_settings.get`. A `value` of `null`, or none, removes the key. Not\ncollection state: it changes no `rev`, is never undone, emits no event, and is\nkept across restarts in the data folder (ADR-0020), whatever collection is open.\nAnswered by the server that admits clients, not the engine: a `Control` with no\nserver in front fails with `unsupported`. Fails with `invalid_argument` on `key`\nfor a key that isn't 1 to 64 of `a`-`z`, `0`-`9`, `.`, `_` and `-`, on `value`\nfor a value over 64 KiB as compact JSON, and on `key` for a 65th key;\n`action_failed` when the settings file can't be written (the value is then kept\nuntil the server stops).",
          "properties": {
            "key": {
              "description": "The setting's key.",
              "type": "string"
            },
            "type": {
              "const": "ui_settings.set",
              "type": "string"
            },
            "value": {
              "description": "Its new value, any JSON; `null` or none removes the key."
            }
          },
          "required": [
            "type",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "Installs a WASM automation plugin from the package at `path` on the engine's\nmachine, with what the person granted it after seeing its manifest (0.35,\nADR-0069). It starts enabled, and `plugin.state_changed` reports it. For a person\nonly: no MCP tool carries it, and no plugin is ever granted it. Fails with\n`already_exists` for a plugin ID in use, `invalid_argument` for a grant whose\n`problem` names a field (`grant.hosts.0`), a grant that gives more than the\nmanifest asks for (`grant.classes.0`, `grant.hosts.0`, `grant.folders.0`), or a\npackage that isn't a plugin, `action_failed` for a module whose `start` function\ntraps or runs past its limits, and `unsupported` from an engine that hosts no\nplugins.",
          "properties": {
            "grant": {
              "$ref": "#/$defs/PluginGrant",
              "description": "The classes, hosts and folders the person granted it."
            },
            "path": {
              "description": "The plugin's package: its manifest and module.",
              "type": "string"
            },
            "plugin_id": {
              "$ref": "#/$defs/PluginId",
              "description": "The ID to install it under."
            },
            "type": {
              "const": "plugin.install",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plugin_id",
            "path",
            "grant"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an installed plugin's grant, widening or narrowing it (0.35), never past\nwhat its manifest asks for (`invalid_argument`, as for `plugin.install`). The\nperson grants it knowing what `plugin.list` last showed their client the manifest\nasks for (what it asks for now, if their client never listed it), so a plugin\ndisabled because an update asks for more (`needs_grant`) can then be re-enabled.\nAn update loaded after that list isn't acknowledged, and one that asks for more\nstill waits as `needs_grant`. For a person only, like `plugin.install`. Fails with\n`not_found` (entity `plugin`) for a plugin that isn't installed.",
          "properties": {
            "grant": {
              "$ref": "#/$defs/PluginGrant",
              "description": "Its new grant."
            },
            "plugin_id": {
              "$ref": "#/$defs/PluginId",
              "description": "The plugin."
            },
            "type": {
              "const": "plugin.grant",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plugin_id",
            "grant"
          ],
          "type": "object"
        },
        {
          "description": "Re-enables a disabled plugin (0.35). The engine disables a plugin that runs past a\nlimit or traps, and never re-enables it by itself. Succeeds for one already\nenabled. Fails with `not_found` for a plugin that isn't installed, and\n`action_failed` for one whose update asks for more than its grant. For a person\nonly, like `plugin.install`.",
          "properties": {
            "plugin_id": {
              "$ref": "#/$defs/PluginId",
              "description": "The plugin."
            },
            "type": {
              "const": "plugin.enable",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plugin_id"
          ],
          "type": "object"
        },
        {
          "description": "Re-enables an effect-pack kind the engine quarantined after a GPU device loss was\nblamed on it (0.61, #349; `gpu.device_lost`), and the whole pack when the pack\nwas quarantined. Its filters draw again from the next frame. The engine never\nlifts a quarantine by itself, nor when the pack's files change. Succeeds for a\nkind that isn't quarantined. Fails with `invalid_argument` on `kind_id`, as\n`kind.describe` does, for a kind that no loaded pack has and no quarantine names. For a person only, like\n`plugin.enable`.",
          "properties": {
            "kind_id": {
              "description": "The kind, `<pack>/<effect>`.",
              "type": "string"
            },
            "type": {
              "const": "effect.enable",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind_id"
          ],
          "type": "object"
        },
        {
          "description": "Downloads a codec library `codec.downloads` lists, from its maker's server, and\nchecks it against what the engine pins (0.69, ADR-0061): on Linux, Cisco's\nOpenH264. Send it only when a person asks, after showing the download's `notice`\nand a link to its `license_url`. It answers once the library is in place, which\ntakes as long as the download; outputs started afterwards can encode with it.\nSucceeds for one already installed, downloading it again. For a person only: no\nMCP tool carries it, no plugin is granted it and no hotkey binds it. Fails with\n`invalid_argument` on `download_id` for an ID `codec.downloads` doesn't list, and\n`action_failed` when the download fails or doesn't match the pin (nothing is kept\nthen), with the reason.",
          "properties": {
            "download_id": {
              "description": "The download, as `codec.downloads` lists it.",
              "type": "string"
            },
            "type": {
              "const": "codec.download",
              "type": "string"
            }
          },
          "required": [
            "type",
            "download_id"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a downloaded codec library (0.69, ADR-0061). `codec.downloads` then\nlists it as not installed, and outputs started afterwards can't encode with it;\none running keeps its encoder. Succeeds for one that isn't installed. For a\nperson only, like `codec.download`. Fails with `invalid_argument` on\n`download_id` for an ID `codec.downloads` doesn't list, and `action_failed` when\nthe file can't be deleted.",
          "properties": {
            "download_id": {
              "description": "The download, as `codec.downloads` lists it.",
              "type": "string"
            },
            "type": {
              "const": "codec.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "download_id"
          ],
          "type": "object"
        },
        {
          "description": "Writes one effect pack (0.72, ADR-0097): replaces the pack `pack` whole with\n`files`, or adds it, and loads it at once. The pack is always the folder named\n`pack` in the packs folder, whose `effect.toml` must say `id = \"<pack>\"`. Answers\nwith the pack as loaded. Fails, writing nothing and keeping the old version, with\n`too_large` for `files` over 3 MiB as sent (`MAX_PACK_WRITE_BYTES`); with\n`invalid_argument` for more than 64 files, an image over 2 MiB, a pack ID or file\npath outside the rules, a manifest that names another ID, an ID another folder\nholds, a folder `pack` that holds anything but that pack, or a pack that doesn't\nload (the first problem's file, line and message); with `internal` when the disk\nrefuses the swap; and with `unsupported` from an engine that loads no packs. Not\nan edit: undo doesn't reach the disk. Agents may call it; no plugin is granted it.",
          "properties": {
            "files": {
              "description": "Every file of the pack.",
              "items": {
                "$ref": "#/$defs/PackFile"
              },
              "type": "array"
            },
            "pack": {
              "description": "The pack ID: lower-case ASCII letters, digits and `-`, starting with a letter\nor digit.",
              "type": "string"
            },
            "type": {
              "const": "pack.write",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pack",
            "files"
          ],
          "type": "object"
        },
        {
          "description": "Removes one effect pack (0.72, ADR-0097): the folder whose `effect.toml` names\npack ID `pack`, whatever its name and whether or not it loads. Its kinds leave\n`kind.list`, and filters and sources of them draw nothing, as before a pack loads.\nFails with `not_found` (entity `pack`) when no folder holds that pack, `internal`\nwhen the disk refuses, and `unsupported` from an engine that loads no packs. Not\nan edit: undo doesn't reach the disk. Agents may call it; no plugin is granted it.",
          "properties": {
            "pack": {
              "description": "The pack ID.",
              "type": "string"
            },
            "type": {
              "const": "pack.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pack"
          ],
          "type": "object"
        },
        {
          "description": "Sets one shared value (0.78, ADR-0102 decision 7), or removes it when `value` is\n`null` or left out. Shared values are named JSON values the engine holds for pages and agents\nto read: never saved, never `rev`, and not an edit, so a value that changes often\nfills no undo history. Every client gets `values.changed` when it changes; setting\nthe value a name already has, or removing a name that has none, changes nothing\nand sends nothing. Fails with `invalid_argument` at `name` for a name outside the\nrules (dotted segments of `a`-`z`, `0`-`9` and `_`, at most 64 bytes), at `value`\nfor a value over 16 KiB as compact JSON, and at `name` when the store already\nholds 256 names and this is a new one.",
          "properties": {
            "name": {
              "description": "The value's name, such as `status.text`.",
              "type": "string"
            },
            "type": {
              "const": "values.set",
              "type": "string"
            },
            "value": {
              "description": "The value. `null`, or leaving it out, removes the value. Inside a value, `null`\nis an ordinary JSON value."
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Opens the project (collection file) at `path` on the engine's machine and saves\nthere from then on (0.94, ADR-0121). The file is loaded and checked first; a file\nthe engine can't read or load (a newer `schema_version`, a broken file) fails with\n`action_failed` and its reason, and the open project stays open with nothing\nstopped, as it does when the open project can't be saved first. Then every\noutput that isn't stopped stops, and the collection is\nreplaced: `rev` becomes the file's or one past the current one, whichever is\ngreater, every client's undo history and idempotency keys are cleared, open\ngestures are cancelled, timelines stop, and the first scene goes on program and\npreview. Every client gets `state.changed`, `studio.changed` and\n`collection.file_changed`. Fails with `invalid_argument` on `path` for a path\nthat breaks the `absolute` asset path rules, and `unsupported` when the host\nnamed no collection file. Not an edit: undo can't take it back.",
          "properties": {
            "path": {
              "description": "The absolute path of the collection file.",
              "type": "string"
            },
            "type": {
              "const": "collection.open",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Creates a new, empty project at `path` (the four sample labels, the default\ncanvas and frame rate) and opens it as `collection.open` would (0.94, ADR-0121).\nIt never replaces a file: fails with `already_exists` when anything is at `path`,\n`action_failed` when it can't be written, and otherwise as `collection.open`.",
          "properties": {
            "path": {
              "description": "The absolute path of the new collection file.",
              "type": "string"
            },
            "type": {
              "const": "collection.new",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Writes the current project to a new file at `path` and saves there from then on\n(0.94, ADR-0121). Every client gets `collection.file_changed`. When the new folder\ndiffers, each `collection` asset reference is rewritten to keep naming the same\nfile: relative to the new folder when the file is under it, otherwise\n`absolute`; an `absolute` reference to a file under the new folder becomes\nrelative to it. A rewrite is a new `rev` (`state.changed`) and clears every client's\nundo history. Nothing stops. Each output's stream key is copied to the new file.\nIt never replaces a file: fails with `already_exists` when anything is at `path`,\nthe open file included, `invalid_argument` on `path` for a path that breaks the\n`absolute` asset path rules, `action_failed` when the file can't be written (the\nopen file stays the one saved to), and `unsupported` when the host named no\ncollection file.",
          "properties": {
            "path": {
              "description": "The absolute path of the new collection file.",
              "type": "string"
            },
            "type": {
              "const": "collection.save_as",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "**Deprecated** (ADR-0080), removed in 1.0. JStream has no privacy\nscreen: the engine refuses this with `unsupported` and covers nothing.",
          "properties": {
            "on": {
              "description": "Ignored: JStream has no privacy screen.",
              "type": "boolean"
            },
            "type": {
              "const": "privacy.set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "on"
          ],
          "type": "object"
        }
      ]
    },
    "ActionResult": {
      "description": "What an action answered, for the few actions whose answer carries data. Its `type`\ntag repeats the action's name.",
      "oneOf": [
        {
          "description": "The answer to `pack.write` (0.72): the pack as now loaded.",
          "properties": {
            "pack": {
              "$ref": "#/$defs/PackInfo",
              "description": "The pack."
            },
            "type": {
              "const": "pack.write",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pack"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `pairing.start`: the one-time pairing code, sent to the client that\nstarted pairing and to no one else (ADR-0044).",
          "properties": {
            "code": {
              "$ref": "#/$defs/SecretString",
              "description": "The code: 8 characters of Crockford's base32 alphabet, written `XXXX-XXXX`.\nThe host shows it; the device posts it to `POST /api/v1/pair`. Never logged."
            },
            "expires_in_secs": {
              "description": "How long the code stays open, in seconds (120).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "pairing.start",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "expires_in_secs"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `youtube.sign_in`.",
          "properties": {
            "type": {
              "const": "youtube.sign_in",
              "type": "string"
            },
            "url": {
              "description": "Google's consent page. The client opens it in a browser; once the user\nagrees, Google redirects to the engine, which finishes the sign-in and emits\n`youtube.status_changed`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `youtube.create_broadcast`: the new broadcast.",
          "properties": {
            "broadcast": {
              "$ref": "#/$defs/BroadcastInfo",
              "description": "The broadcast, as YouTube created it."
            },
            "type": {
              "const": "youtube.create_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `youtube.bind_broadcast`: the broadcast with its new stream.",
          "properties": {
            "broadcast": {
              "$ref": "#/$defs/BroadcastInfo",
              "description": "The broadcast after the bind."
            },
            "type": {
              "const": "youtube.bind_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `youtube.transition_broadcast`.",
          "properties": {
            "broadcast": {
              "$ref": "#/$defs/BroadcastInfo",
              "description": "The broadcast after the transition. Its lifecycle may still be moving\n(`test_starting`, `live_starting`)."
            },
            "type": {
              "const": "youtube.transition_broadcast",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast"
          ],
          "type": "object"
        },
        {
          "description": "The answer to `scene.switch_and_watch`: the frame sheet of the program mix from\nthe switch on (since 0.82).",
          "properties": {
            "columns": {
              "description": "Tiles per row.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "frames": {
              "description": "Each picture, in the order the tiles show them.",
              "items": {
                "$ref": "#/$defs/SheetFrame"
              },
              "type": "array"
            },
            "height": {
              "description": "The PNG's height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "png": {
              "description": "The PNG file, standard base64 with padding and no line breaks.",
              "type": "string"
            },
            "rows": {
              "description": "Rows of tiles.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "tile_height": {
              "description": "One tile's height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "tile_width": {
              "description": "One tile's width in pixels: the canvas scaled down to fit 480 × 270.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "scene.switch_and_watch",
              "type": "string"
            },
            "width": {
              "description": "The PNG's width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "width",
            "height",
            "columns",
            "rows",
            "tile_width",
            "tile_height",
            "frames",
            "png"
          ],
          "type": "object"
        }
      ]
    },
    "ActivityEntry": {
      "description": "One executed batch, undo, redo or action, or a gesture that ended without a commit:\nan entry of the engine's audit log, as `activity.list` answers it.",
      "properties": {
        "call": {
          "description": "What it called, as the audit log names it: `batch`, `history.undo`,\n`history.redo`, an action's name (`scene.switch`), or `live.cancel` or\n`live.ended` for a gesture that ended without a commit.",
          "type": "string"
        },
        "client_id": {
          "$ref": "#/$defs/ClientId",
          "description": "The client that sent it. Numbered per engine run."
        },
        "client_name": {
          "description": "The name the client gave in its latest `hello` (`claude-desktop`), or\n`device:<name>` for a paired device. Chosen by the client, so it says who claims\nto act, not who proved it.",
          "type": "string"
        },
        "error": {
          "description": "The protocol error code when the call failed (`rev_conflict`). Omitted when it\nsucceeded.",
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "description": "Its number: 1 for the engine's first entry, and one more for each after it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "description": "One English sentence saying what it did (\"Switched to “Desktop + Cam”\", \"Mic\ngain −1.5 → −3.0 dB\"), written from the collection just before the call ran.\nIt names objects and gives numeric, on/off and enum values only: never a\nsource's or filter's settings, an output's target, or a stream key. At most 256\ncharacters ([`MAX_ACTIVITY_SUMMARY_CHARS`]).",
          "type": "string"
        },
        "time_ms": {
          "description": "When the call finished, in milliseconds since the Unix epoch (UTC).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "time_ms",
        "client_id",
        "client_name",
        "call",
        "summary"
      ],
      "type": "object"
    },
    "AudienceStatsInfo": {
      "description": "A running `youtube` output's audience, as YouTube last reported it (ADR-0041 §3,\n0.38): what the `youtube.stats` event sends and the `youtube.stats` query lists.\nThe engine reads it at a low fixed rate, about once a minute, while the output runs.\nA count YouTube doesn't report (the owner hides it, or the broadcast has no viewers\nnow or has ended) is omitted.",
      "properties": {
        "broadcast_id": {
          "description": "The broadcast it sends to.",
          "type": "string"
        },
        "concurrent_viewers": {
          "description": "People watching now.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "likes": {
          "description": "Likes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_id": {
          "$ref": "#/$defs/OutputId",
          "description": "The output."
        },
        "views": {
          "description": "Views.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "output_id",
        "broadcast_id"
      ],
      "type": "object"
    },
    "AudioCodec": {
      "description": "An audio codec. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "aac",
          "description": "AAC-LC.",
          "type": "string"
        }
      ]
    },
    "AudioEncoding": {
      "description": "How the audio is encoded.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/AudioCodec",
          "description": "The codec."
        },
        "kbps": {
          "description": "The bit rate, in kilobits per second: 32..=320, else `invalid_argument`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "codec",
        "kbps"
      ],
      "type": "object"
    },
    "AudioFollow": {
      "description": "When a source's audio is heard (ADR-0028, D18). Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "always",
          "description": "Heard whether or not the source is on program: microphones and other audio\ninputs, desktop and application audio.",
          "type": "string"
        },
        {
          "const": "when_shown",
          "description": "Heard only while the source is shown on the Program mix, fading with the\ntransition that shows or hides it: browser, media, webcam audio and nested\nscenes.",
          "type": "string"
        }
      ]
    },
    "Batch": {
      "description": "One or more edits, applied atomically.\n\nThe engine checks `expected_rev`, then applies the edits in order, each against the\nstate the previous one left. If any edit fails, nothing is applied and `rev` doesn't\nchange. On success `rev` increases by exactly one, whatever the number of edits, and\nthe batch becomes one undo step for the sending client.",
      "properties": {
        "edits": {
          "description": "The edits, in order. An empty list is rejected with `empty_batch`.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "minItems": 1,
          "type": "array"
        },
        "ends_gesture": {
          "anyOf": [
            {
              "$ref": "#/$defs/GestureId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commits one of the client's open gestures (ADR-0032): when the batch applies, the\ngesture ends in the same step, and its live values give way to the committed\nstate. A gesture the client has not open is `invalid_argument` (field\n`ends_gesture`), and nothing is applied. A batch that fails leaves the gesture\nopen."
        },
        "expected_rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`\n(optimistic concurrency). Omitted means apply against whatever is current."
        },
        "idempotency_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Makes a retry safe: a batch whose key the engine has already applied for this\nclient is not applied again, and gets the original result."
        }
      },
      "required": [
        "edits"
      ],
      "type": "object"
    },
    "BlendMode": {
      "description": "How an item composites onto what is below it (ADR-0023 §1, register D13).\n\nThe list is the modes the UI offers, and the compositor draws every one (ADR-0082, since\n0.47; before it the engine refused all but `normal`). They blend in linear light,\nexcept overlay, difference and exclusion, and the two `_srgb` modes (since 0.75),\nwhich blend sRGB-encoded values.",
      "oneOf": [
        {
          "const": "normal",
          "description": "Source-over: the item covers what is below it, by its alpha.",
          "type": "string"
        },
        {
          "const": "additive",
          "description": "Adds the item's colour to what is below it.",
          "type": "string"
        },
        {
          "const": "multiply",
          "description": "Multiplies the colours, which darkens.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "The inverse of multiplying the inverses, which lightens.",
          "type": "string"
        },
        {
          "const": "overlay",
          "description": "Multiply or screen, depending on the colour below.",
          "type": "string"
        },
        {
          "const": "darken",
          "description": "The darker of the two colours, per channel.",
          "type": "string"
        },
        {
          "const": "lighten",
          "description": "The lighter of the two colours, per channel.",
          "type": "string"
        },
        {
          "const": "difference",
          "description": "The absolute difference of the colours.",
          "type": "string"
        },
        {
          "const": "exclusion",
          "description": "Like difference, with lower contrast.",
          "type": "string"
        },
        {
          "const": "normal_srgb",
          "description": "Source-over mixed in sRGB-encoded values, as a web browser blends (since 0.75,\n#1096): a soft overlay designed in a browser keeps its strength, where `normal`\nmixes linear light and a faint veil over a dark backdrop comes out brighter.",
          "type": "string"
        },
        {
          "const": "additive_srgb",
          "description": "Additive in sRGB-encoded values (since 0.75, #1096): the encoded colours add as in\na browser's `plus-lighter`, so a faint glow adds what it does in the browser. Alpha\nis source-over, so the two differ inside a translucent layer.",
          "type": "string"
        }
      ]
    },
    "Blocker": {
      "description": "One reference that stops a `scene.delete`, `source.delete`, `folder.delete` or\n`label.delete`: the object that refers to the target, and the field of that object\nthat holds the reference.\n\n```json\n{\"entity\": \"source\", \"id\": \"webcam\", \"field\": \"settings.mask\"}\n```",
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityKind",
          "description": "What kind of object refers to the target: an `item` that places a source, a\n`source` that shows a scene, whose settings refer to the target or that carries\na label, a `video_mix` that shows a scene, or a `scene` or `folder` that sits in a\nfolder."
        },
        "field": {
          "description": "The field of that object that refers to the target, as a dotted path into its\nquery form: `source_id` for an item, `kind.scene_id` for a `scene` source,\n`settings.<param>` for a settings reference, `mix.input.scene_id` for a mix,\n`labels` for a source carrying a label, `folder` for a scene in a folder, and\n`parent` for a folder in one.",
          "type": "string"
        },
        "id": {
          "description": "That object's ID.",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "id",
        "field"
      ],
      "type": "object"
    },
    "BroadcastInfo": {
      "description": "One broadcast, as the YouTube queries and actions report it.",
      "properties": {
        "bound_stream_id": {
          "description": "The stream bound to it, if any. A `youtube` output can start only once one is.",
          "type": [
            "string",
            "null"
          ]
        },
        "broadcast_id": {
          "description": "YouTube's ID for it: what a `youtube` output target names.",
          "type": "string"
        },
        "description": {
          "description": "Its description. Omitted when empty.",
          "type": "string"
        },
        "life_cycle": {
          "$ref": "#/$defs/BroadcastLifeCycle",
          "description": "Where it is in its lifecycle."
        },
        "privacy": {
          "$ref": "#/$defs/BroadcastPrivacy",
          "description": "Who can watch it."
        },
        "scheduled_start_time": {
          "description": "When it is scheduled to start, RFC 3339, as YouTube reports it.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        }
      },
      "required": [
        "broadcast_id",
        "title",
        "life_cycle",
        "privacy"
      ],
      "type": "object"
    },
    "BroadcastLifeCycle": {
      "description": "Where a broadcast is in its lifecycle (`status.lifeCycleStatus`). Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "created",
          "description": "Created, but missing settings it needs to go live.",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "Ready to go live once a stream is bound and sending.",
          "type": "string"
        },
        {
          "const": "test_starting",
          "description": "Moving to `testing`.",
          "type": "string"
        },
        {
          "const": "testing",
          "description": "Visible only through its monitor stream.",
          "type": "string"
        },
        {
          "const": "live_starting",
          "description": "Moving to `live`.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Visible to viewers.",
          "type": "string"
        },
        {
          "const": "complete",
          "description": "Ended.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "Removed by YouTube.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A state this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "BroadcastListStatus": {
      "description": "Which broadcasts `youtube.list_broadcasts` returns, by state. Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "all",
          "description": "Every broadcast.",
          "type": "string"
        },
        {
          "const": "upcoming",
          "description": "Not started yet.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Live now (or testing).",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Ended.",
          "type": "string"
        }
      ]
    },
    "BroadcastPrivacy": {
      "description": "Who can watch a broadcast. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "private",
          "description": "Only the channel.",
          "type": "string"
        },
        {
          "const": "public",
          "description": "Anyone.",
          "type": "string"
        },
        {
          "const": "unlisted",
          "description": "Anyone with the link.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server. Refused in\n`youtube.create_broadcast` with `invalid_argument`.",
          "type": "string"
        }
      ]
    },
    "BroadcastTransition": {
      "description": "Which way `youtube.transition_broadcast` moves a broadcast. Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "testing",
          "description": "Visible only through the monitor stream. The bound stream must be sending.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Visible to viewers. The bound stream must be sending.",
          "type": "string"
        },
        {
          "const": "complete",
          "description": "Ended. A complete broadcast can't go live again.",
          "type": "string"
        }
      ]
    },
    "BroadcastType": {
      "description": "Which broadcasts `youtube.list_broadcasts` returns, by type. Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "all",
          "description": "Both kinds.",
          "type": "string"
        },
        {
          "const": "event",
          "description": "Scheduled events.",
          "type": "string"
        },
        {
          "const": "persistent",
          "description": "The channel's persistent (\"Stream now\") broadcast.",
          "type": "string"
        }
      ]
    },
    "BusId": {
      "description": "An audio bus in the collection (ADR-0028). [`BusId::master`] names the master\nbus, which every collection has.",
      "type": "string"
    },
    "BusInfo": {
      "description": "One bus, as `bus.list` and `state.get` report it.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus's ID. The master bus's is `master`."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The bus fader, in dB, applied after the sum: from −100 to +24."
        },
        "monitor": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusMonitor"
            },
            {
              "type": "null"
            }
          ],
          "description": "The bus's monitor, if it has one (since 0.42; omitted when it has none)."
        },
        "muted": {
          "description": "Whether the bus is muted.",
          "type": "boolean"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        }
      },
      "required": [
        "bus_id",
        "name",
        "gain_db",
        "muted"
      ],
      "type": "object"
    },
    "BusMeter": {
      "description": "One bus's levels in a `meters.tick`, after its fader. Levels are linear full scale\nper channel, left then right.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus."
        },
        "loudness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Loudness"
            },
            {
              "type": "null"
            }
          ],
          "description": "The bus's loudness. Measured on the master bus only for now; absent on the\nothers."
        },
        "peak": {
          "description": "The largest absolute sample since the previous tick.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rms": {
          "description": "The RMS level over the most recent mixer block.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "true_peak": {
          "description": "The true peak since the previous tick (ITU-R BS.1770, 4× oversampled). Measured\non the master bus only for now; absent on the others.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "bus_id",
        "peak",
        "rms"
      ],
      "type": "object"
    },
    "BusMonitor": {
      "description": "A bus's monitor (ADR-0028, D22): an output device the engine plays the bus on while\nthe program mixer runs, for the operator to hear. Collection state, set by\n`bus.set_monitor`. A monitor hears the bus through its fader and mute and never\nthrough the master's filters, so it is not what an output carries.",
      "properties": {
        "device": {
          "default": "",
          "description": "The output device, as the platform names it; empty (the default) for the\nsystem's default output, which the monitor follows when it changes. A device\nthat isn't connected leaves the monitor silent; the edit is not refused. At most\n512 bytes.",
          "type": "string"
        },
        "tap": {
          "$ref": "#/$defs/MonitorTap",
          "default": "post_filters",
          "description": "Where on the bus the monitor listens. Omitted means `post_filters`."
        }
      },
      "type": "object"
    },
    "Call": {
      "description": "What a request asks for. Tagged by `kind`, so the class of every call (ADR-0013) is\nexplicit on the wire.",
      "oneOf": [
        {
          "$ref": "#/$defs/Batch",
          "description": "Apply edits atomically. A single edit is a batch of one.",
          "properties": {
            "kind": {
              "const": "batch",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Perform one action.",
          "properties": {
            "action": {
              "$ref": "#/$defs/Action",
              "description": "The action."
            },
            "kind": {
              "const": "action",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "type": "object"
        },
        {
          "description": "Read something.",
          "properties": {
            "kind": {
              "const": "query",
              "type": "string"
            },
            "query": {
              "$ref": "#/$defs/Query",
              "description": "The query."
            }
          },
          "required": [
            "kind",
            "query"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/HistoryCall",
          "description": "Undo or redo one of this client's own steps (ADR-0032). Carries no command: the\nengine applies a batch of edits it already holds.",
          "properties": {
            "kind": {
              "const": "history",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CallResult": {
      "description": "The result of a [`Call`], tagged by the same `kind`.",
      "oneOf": [
        {
          "description": "The batch was applied (or had already been applied under its idempotency key).",
          "properties": {
            "dropped_overrides": {
              "description": "The keyframe-scene overrides the batch dropped because their item left the\nvariant's parent (ADR-0040 §1), in the order it dropped them. Undoing the\nbatch restores them. Omitted when there are none, and missing (from a server\nolder than 0.39) parses as empty.",
              "items": {
                "$ref": "#/$defs/DroppedOverride"
              },
              "type": "array"
            },
            "kind": {
              "const": "batch",
              "type": "string"
            },
            "removed_hotkeys": {
              "description": "The hotkey bindings the batch removed because their action named an object it\ndeleted (ADR-0040 §3), in the order it removed them. Undoing the batch restores\nthem. Omitted when there are none, and missing (from a server older than 0.25)\nparses as empty.",
              "items": {
                "$ref": "#/$defs/HotkeyBinding"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the batch produced."
            }
          },
          "required": [
            "kind",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "The action was accepted. Its progress is reported by events. An action whose\nanswer carries data (`pairing.start`, `youtube.sign_in` and the YouTube broadcast\nactions) has it in `result`; the others omit it.",
          "properties": {
            "kind": {
              "const": "action",
              "type": "string"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ActionResult"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the action answered, tagged by the action's name, for the actions that\nanswer something. Absent for every other action, and from a server older\nthan 0.21."
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "The query's answer.",
          "properties": {
            "kind": {
              "const": "query",
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/QueryResult",
              "description": "The result."
            }
          },
          "required": [
            "kind",
            "result"
          ],
          "type": "object"
        },
        {
          "description": "The undo or redo was applied (or had already been applied under its idempotency\nkey).",
          "properties": {
            "kind": {
              "const": "history",
              "type": "string"
            },
            "redo_depth": {
              "description": "How many steps the client can redo.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the undo or redo produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced. It names the step."
            },
            "undo_depth": {
              "description": "How many steps the client can still undo.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "rev",
            "step_rev",
            "undo_depth",
            "redo_depth"
          ],
          "type": "object"
        }
      ]
    },
    "CameraFollow": {
      "description": "A camera that follows the pointer over a display or window capture (ADR-0113 §2).\nWhile a scene has one, the engine computes its camera's position and target every\nframe; the camera's field of view, roll, depth sorting and blur apply as always, and\nwith a blur its focus is where it looks.",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "The item it follows: one of the scene's, showing a display or window capture."
        },
        "lean_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 9.0,
          "description": "How far the camera leans with the pointer's speed, in degrees, from 0 (off) to 30.\nDefault 9."
        },
        "pitch_deg": {
          "$ref": "#/$defs/Finite32",
          "default": -10.0,
          "description": "The resting angle below the item's normal, in degrees, within ±60: positive looks\nup at it from below, negative down from above. Default −10."
        },
        "safe_margin_pct": {
          "default": 10,
          "description": "The safe margin, in percent of the frame's width and height on each side, from 0\nto 40 (since 0.91, #1216). Default 10: the pointer stays in the middle 80% of the\nframe on every frame, whatever the smoothing, wherever the item's box lets the\nframe reach it. At 0 it stays inside the frame.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "smooth_ms": {
          "default": 450,
          "description": "The time constant of each of its two springs, in milliseconds, from 50 to 5000.\nDefault 450.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "yaw_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 20.0,
          "description": "The resting angle to the right of the item's normal, in degrees, within ±60.\nDefault 20."
        },
        "zoom": {
          "$ref": "#/$defs/Finite32",
          "default": 1.0,
          "description": "The resting zoom, from 1 to 4. At 1 the frame shows two thirds of the item's\nheight; at `z`, `1/z` of that. Default 1."
        }
      },
      "required": [
        "item_id"
      ],
      "type": "object"
    },
    "CameraMotionModifier": {
      "description": "One motion modifier on a scene camera: an item's [`MotionModifier`] with a camera\nproperty.",
      "oneOf": [
        {
          "description": "Smooth seeded noise within `-amplitude..=amplitude`. The same seed gives the same\nmotion on every machine; each extra octave adds detail at twice the frequency and\nhalf the size.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "The largest value it reaches, `0..=100000`."
            },
            "frequency_hz": {
              "$ref": "#/$defs/Finite32",
              "description": "About how many turns of direction a second, `0..=60` and not 0."
            },
            "kind": {
              "const": "wiggle",
              "type": "string"
            },
            "octaves": {
              "default": 1,
              "description": "How many octaves, `1..=4`. Default 1.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "seed": {
              "default": 0,
              "description": "Picks the noise. Default 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "amplitude",
            "frequency_hz"
          ],
          "type": "object"
        },
        {
          "description": "A periodic wave within `-amplitude..=amplitude`.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "The largest value it reaches, `0..=100000`."
            },
            "kind": {
              "const": "oscillate",
              "type": "string"
            },
            "period_ms": {
              "description": "One period, in milliseconds, `1..=3600000`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "phase": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "Its offset into the period, as a fraction in `0..1`. Default 0."
            },
            "shape": {
              "$ref": "#/$defs/MotionShape",
              "default": "sine",
              "description": "Its waveform. Default `sine`."
            }
          },
          "required": [
            "kind",
            "amplitude",
            "period_ms"
          ],
          "type": "object"
        },
        {
          "description": "A constant rate per second, of either sign, wrapping into `0..wrap` when `wrap`\nis set.",
          "properties": {
            "kind": {
              "const": "drift",
              "type": "string"
            },
            "rate_per_s": {
              "$ref": "#/$defs/Finite32",
              "description": "Units per second, within `-100000..=100000`."
            },
            "wrap": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where it wraps back to 0, `0..=100000` and not 0. Omitted for no wrap."
            }
          },
          "required": [
            "kind",
            "rate_per_s"
          ],
          "type": "object"
        },
        {
          "description": "Follows a measure of a bus or a source (ADR-0100, since 0.86): the measure in dBFS from\n`floor_db` to `ceiling_db` is mapped onto 0 to 1 (an onset as it is), followed with\n`attack_ms` and `release_ms`, bent by `curve`, and mapped onto `from..to`. Silence\nis `from`. It hears what a `spectrum` source with the same `audio` and\n`audio_source` would draw, and silence while that is silent.",
          "properties": {
            "attack_ms": {
              "default": 10,
              "description": "How fast it rises, in milliseconds, `0..=10000`. Default 10.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "audio": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BusId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The bus it hears, after its fader. Omitted for the program mix: the master\nafter its filters, as the outputs hear it."
            },
            "audio_source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A source to hear instead of the bus: that source after its own filters,\nfader, mute and follow. Omitted to hear the bus."
            },
            "ceiling_db": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "The level, in dBFS, that maps to 1: above `floor_db` and at most 0. Default 0."
            },
            "curve": {
              "$ref": "#/$defs/MotionCurve",
              "default": "linear",
              "description": "How the envelope is bent. Default `linear`."
            },
            "floor_db": {
              "$ref": "#/$defs/Finite32",
              "default": -60.0,
              "description": "The level, in dBFS, that maps to 0: at least -90 and below `ceiling_db`.\nDefault -60."
            },
            "from": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "Its value at silence, in the property's unit, within `-100000..=100000`.\nDefault 0."
            },
            "high_hz": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A `band` measure's highest frequency, in hertz, above `low_hz` and at most\n20000. Only with `band`."
            },
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "low_hz": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A `band` measure's lowest frequency, in hertz, `20..=20000`. Only with `band`."
            },
            "measure": {
              "$ref": "#/$defs/MotionMeasure",
              "default": "level",
              "description": "What it measures. Default `level`."
            },
            "release_ms": {
              "default": 250,
              "description": "How fast it falls, in milliseconds, `0..=10000`. Default 250.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "to": {
              "$ref": "#/$defs/Finite32",
              "default": 1.0,
              "description": "Its value at the ceiling, within `-100000..=100000`; below `from` to invert.\nDefault 1."
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A one-shot decaying shake, since 0.84 (#1107):\n`amplitude · e^(−decay_per_s·t) · sin(2π·frequency_hz·t)` for `t` seconds from\nthe start of its clock, until `duration_ms`, and 0 after. Usually on the\n`triggered` clock, so `item.trigger_motion` (a hotkey, say) fires it.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "Its size at the start, `0..=100000`."
            },
            "decay_per_s": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "How fast it dies away, per second, `0..=1000`: 0 keeps its size to the end.\nDefault 0."
            },
            "duration_ms": {
              "description": "How long it lasts, in milliseconds, `1..=3600000`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "frequency_hz": {
              "$ref": "#/$defs/Finite32",
              "description": "How many times a second it swings, `0..=60` and not 0."
            },
            "kind": {
              "const": "impulse",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amplitude",
            "frequency_hz",
            "duration_ms"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "clock": {
          "$ref": "#/$defs/MotionClock",
          "default": "engine",
          "description": "The clock it runs on. Default `engine`; `shown` starts when the scene starts being\ndrawn on program."
        },
        "enabled": {
          "description": "Whether it runs. Default `true`, which isn't written.",
          "type": "boolean"
        },
        "modifier_id": {
          "description": "Unique within the list: 1 to 64 bytes of ASCII letters, digits, `_` and `-`.",
          "type": "string"
        },
        "property": {
          "$ref": "#/$defs/CameraProperty",
          "description": "What it changes."
        }
      },
      "required": [
        "modifier_id",
        "property"
      ],
      "type": "object"
    },
    "CameraProperty": {
      "description": "The camera property a camera motion modifier changes. Every value is added to the\ncamera as it is drawn; the field of view is then held to 1 to 170°, focus above 0 and\nblur to 0 to 64.",
      "oneOf": [
        {
          "const": "position_x",
          "description": "The camera's position, x (right), in scene pixels.",
          "type": "string"
        },
        {
          "const": "position_y",
          "description": "The camera's position, y (down), in scene pixels.",
          "type": "string"
        },
        {
          "const": "position_z",
          "description": "The camera's position, z (toward the viewer), in scene pixels.",
          "type": "string"
        },
        {
          "const": "target_x",
          "description": "The point it looks at, x, in scene pixels.",
          "type": "string"
        },
        {
          "const": "target_y",
          "description": "The point it looks at, y, in scene pixels.",
          "type": "string"
        },
        {
          "const": "target_z",
          "description": "The point it looks at, z, in scene pixels.",
          "type": "string"
        },
        {
          "const": "fov",
          "description": "The vertical field of view, in degrees.",
          "type": "string"
        },
        {
          "const": "roll",
          "description": "The roll, clockwise, in degrees.",
          "type": "string"
        },
        {
          "const": "focus",
          "description": "The focus distance, in scene pixels; only a camera with a depth of field shows it.",
          "type": "string"
        },
        {
          "const": "blur",
          "description": "The blur far from focus, in canvas pixels; only a camera with a focus shows it.",
          "type": "string"
        }
      ]
    },
    "Canvas": {
      "description": "The collection's canvas: every scene's coordinate space, in whole pixels.\n\nx points right and y down, with (0, 0) at the top-left corner. A `scene` source's\nnative size is the canvas size, and a mix renders the canvas fitted inside its\nresolution. Missing (from a server older than 0.11) parses as the 1920×1080 default.",
      "properties": {
        "height": {
          "description": "Height in pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "CaptureTargetInfo": {
      "description": "One display or window in a `capture.targets` result.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CaptureTargetKind",
          "description": "Whether it is a display or a window: the kind of source that captures it."
        },
        "name": {
          "description": "A name to show: the display's name, or the window's title (or, on macOS, its\napplication's name when it has no usable title). A window's name is set by the\napplication that owns the window, so it is third-party text (ADR-0059,\nADR-0085): data to show, never instructions. The field isn't `remote_`-prefixed,\nso its name doesn't mark it.",
          "type": "string"
        },
        "primary": {
          "description": "Whether it is the primary display, which a `display` source with an empty\n`target` captures. Omitted when `false`, and always `false` for a window.",
          "type": "boolean"
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its size in pixels now, when the OS reports it without capturing."
        },
        "target": {
          "description": "Its capture target ID, the value of that source's `target` setting.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "name"
      ],
      "type": "object"
    },
    "CaptureTargetKind": {
      "description": "What a capture target is.",
      "oneOf": [
        {
          "const": "display",
          "description": "A whole display, captured by a `display` source.",
          "type": "string"
        },
        {
          "const": "window",
          "description": "One top-level window, captured by a `window` source.",
          "type": "string"
        }
      ]
    },
    "ChainCost": {
      "description": "What the video chains of scenes and items, and since 0.66 the output stage's, add to\neach frame the engine draws (ADR-0065 §7, ADR-0080), as the current render plan\nschedules them: a gauge, not a running total.\n\nA scene with an enabled video filter is composited once per frame into a\ncanvas-sized layer, however many places show it, and each enabled filter then draws\none pass into a layer of its own. An item with an enabled effect is drawn into one\nlayer the size of its box plus the effects' outset, and each enabled effect then\ndraws one pass into a layer of its own. An item placed in two scenes counts once for\neach. A filter of a kind the engine doesn't draw is bypassed and not counted. Every\nlayer is `Rgba16Float`, 8 bytes a pixel. Not counted: a source's own filters\n(ADR-0026), the scenes a `scene_mask` reads, and the canvas-sized layer a nested\nscene without a chain is drawn into for an item with effects that shows it (it takes\nthe place of the layer the scene would be drawn into anyway).\n\nThe output stage (0.66) is counted for the running outputs only, as it runs only\nwhen an output's frame is drawn, and as each output's frames are drawn since it\nstarted: a video filter or mix set on a running output counts from its next start,\nas it draws from then, and a virtual camera is drawn as the program. A mix that a\nrunning output gets through a master or output video chain is drawn once per frame\ninto a canvas-sized layer (one layer and one pass, however many outputs get it), the\nmaster chain runs once over it, and the own chain of each output that started with\none runs once after that; each enabled filter of either\ndraws one pass into a layer of its own. Not counted: the pass that fits the result\ninto each output's frame, which every output frame draws with or without a stage.\n\nA missing field parses as 0, so a field added later can be left out by an older\nsender (R-API-001). Unknown fields are ignored.",
      "properties": {
        "item_effects": {
          "default": 0,
          "description": "Items whose effects run each frame, once for each scene that draws the item.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "item_layers": {
          "default": 0,
          "description": "The offscreen layers those effects draw into: each item's box and one per\neffect.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "item_passes": {
          "default": 0,
          "description": "The GPU passes those effects draw: each item's box and one per effect.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "layer_bytes": {
          "default": 0,
          "description": "The texture memory of every layer counted here, the output stage's included\n(0.66), in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scene_chains": {
          "default": 0,
          "description": "Scenes whose video chain runs each frame.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scene_layers": {
          "default": 0,
          "description": "The offscreen layers those chains draw into: each scene's composite and one per\nfilter.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scene_passes": {
          "default": 0,
          "description": "The GPU passes those chains draw: each scene's composite and one per filter.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stage_chains": {
          "default": 0,
          "description": "The output stage's video chains that run each frame (0.66): the master chain\nonce for each mix a running output gets through it, and each running output's\nown.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stage_layers": {
          "default": 0,
          "description": "The offscreen layers the output stage draws into (0.66): each staged mix's\ncanvas-sized layer and one per filter. Their bytes are in `layer_bytes`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stage_passes": {
          "default": 0,
          "description": "The GPU passes the output stage draws (0.66): each staged mix's composite into\nits layer and one per filter.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Chord": {
      "description": "A key chord: zero or more modifiers then one key, joined by `+`, such as `Ctrl+KeyA`,\n`Ctrl+Shift+Digit1`, `F1` or `Pause`.\n\n- The modifiers are `Ctrl`, `Alt`, `Shift` and `Meta` (the Windows or Command key),\n  each at most once, in that order. A chord has exactly one spelling, so two chords\n  are the same keys exactly when their strings are equal.\n- The key is a W3C UI Events `KeyboardEvent.code` value from [`Chord::KEYS`]: the\n  physical key, whatever the keyboard layout, as browsers and the desktop host's\n  global-shortcut API both report it. Modifier keys themselves are not keys here.\n\nOn the wire it is a plain string. The protocol layer doesn't check it: the engine\nrejects one that isn't valid with `invalid_argument`, giving [`Chord::problem`]'s\nreason.",
      "type": "string"
    },
    "ClientId": {
      "description": "A connected client, assigned by the server in `welcome`. Undo history and the\naudit log are keyed by it.",
      "type": "string"
    },
    "ClientMessage": {
      "description": "A message from a client to the server. Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Hello",
          "description": "Opens the session. Must be the first message.",
          "properties": {
            "type": {
              "const": "hello",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Request",
          "description": "A batch of edits, an action or a query.",
          "properties": {
            "type": {
              "const": "request",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CodecDownloadInfo": {
      "description": "A codec library the engine downloads on a person's request, as `codec.downloads`\nlists it (0.69, ADR-0061). On Linux it is Cisco's OpenH264: JStream never ships it,\nand downloads Cisco's own binary from Cisco's server only when a person asks, since\nCisco's patent licence covers that copy alone. A client offering the download shows\n`notice` with a link to `license_url`, and sends `codec.download` only when the\nperson confirms.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "The codec it encodes. An output whose profile asks for it in software\n(`hardware: avoid`), or on a machine with no hardware encoder for it, needs it."
        },
        "download_id": {
          "description": "The download's ID, which `codec.download` and `codec.delete` take: `openh264`.",
          "type": "string"
        },
        "hardware_encoder": {
          "description": "Whether this machine has a hardware encoder for `codec`. When it has none, an\noutput that encodes `codec` needs this download whatever its profile's\n`hardware` preference, except `require`, which then fails.",
          "type": "boolean"
        },
        "installed": {
          "description": "Whether it is downloaded and in place.",
          "type": "boolean"
        },
        "license_text": {
          "description": "That licence's full text, which a client reproduces where it presents licensing\ninformation for the download (Cisco's condition 4), beside the offer and the\ninstalled codec.",
          "type": "string"
        },
        "license_url": {
          "description": "The maker's licence for its binary, linked beside `notice`.",
          "type": "string"
        },
        "name": {
          "description": "What it is, for people: \"Cisco's OpenH264 (software H.264)\".",
          "type": "string"
        },
        "notice": {
          "description": "The attribution the maker's licence asks for, shown wherever the download is\noffered and in the app's licence information: \"OpenH264 Video Codec provided by\nCisco Systems, Inc.\".",
          "type": "string"
        },
        "version": {
          "description": "The release the engine pins, such as `2.6.0`. A newer one comes with a JStream\nupdate.",
          "type": "string"
        }
      },
      "required": [
        "download_id",
        "name",
        "codec",
        "version",
        "notice",
        "license_url",
        "license_text",
        "installed",
        "hardware_encoder"
      ],
      "type": "object"
    },
    "CollectionCause": {
      "description": "Which call made the engine save the collection to another file\n([`Event::CollectionFileChanged`], 0.94).",
      "oneOf": [
        {
          "const": "open",
          "description": "`collection.open`: another collection was loaded.",
          "type": "string"
        },
        {
          "const": "new",
          "description": "`collection.new`: an empty collection was created.",
          "type": "string"
        },
        {
          "const": "save_as",
          "description": "`collection.save_as`: the same collection, saved to another file.",
          "type": "string"
        }
      ]
    },
    "Crop": {
      "description": "How many source pixels an item cuts off each edge before it is transformed.\n\nWhole pixels of the source's own frame, so every value is valid; cropping more than\nthe source's size leaves nothing to draw.",
      "properties": {
        "bottom": {
          "description": "Pixels cut from the bottom edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "left": {
          "description": "Pixels cut from the left edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "right": {
          "description": "Pixels cut from the right edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "top": {
          "description": "Pixels cut from the top edge.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "type": "object"
    },
    "DeleteTarget": {
      "description": "What a `delete.plan` deletes: a scene, a source, (since 0.24) a bus, a folder or a\nlabel.",
      "oneOf": [
        {
          "description": "A scene.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to delete."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "A source.",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to delete."
            },
            "type": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "A bus other than the master. Since 0.24.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to delete."
            },
            "type": {
              "const": "bus",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "A folder. The plan moves the scenes and folders in it up to its parent (to the\ntop level for a top-level folder), then deletes it.",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The folder to delete."
            },
            "type": {
              "const": "folder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id"
          ],
          "type": "object"
        },
        {
          "description": "A label. The plan takes it off every source that carries it, then deletes it.",
          "properties": {
            "label_id": {
              "$ref": "#/$defs/LabelId",
              "description": "The label to delete."
            },
            "type": {
              "const": "label",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label_id"
          ],
          "type": "object"
        }
      ]
    },
    "DeviceId": {
      "description": "A paired device: one browser or other client admitted with its own device token\n(ADR-0044). Assigned by the server when the device pairs.",
      "type": "string"
    },
    "DeviceInfo": {
      "description": "One paired device, as `device.list` reports it. Its token is never reported.",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/DeviceId",
          "description": "The device's ID, which `device.revoke` takes."
        },
        "last_used_at": {
          "description": "When its token was last presented, in seconds since the Unix epoch (UTC), to the\nhour. A token unused for 30 days lapses and the device is dropped.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "The name it gave when it paired. The audit log names its sessions\n`device:<name>`.",
          "type": "string"
        },
        "paired_at": {
          "description": "When it paired, in seconds since the Unix epoch (UTC).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "device_id",
        "name",
        "paired_at",
        "last_used_at"
      ],
      "type": "object"
    },
    "Drawer": {
      "description": "A thread that draws shots ([`ProfileInfo::drawers`]).",
      "oneOf": [
        {
          "const": "program",
          "description": "The program stage's `jstream-render` thread, which draws what the outputs send.",
          "type": "string"
        },
        {
          "const": "preview",
          "description": "The preview hub's `jstream-preview` thread, which draws the preview streams.",
          "type": "string"
        }
      ]
    },
    "DrawerProfile": {
      "description": "One drawing thread's frames in the window.",
      "properties": {
        "drawer": {
          "$ref": "#/$defs/Drawer",
          "description": "Which thread."
        },
        "frame_max_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The longest frame, in milliseconds: exact for the window, as the drawer keeps the\nlongest frame of each second it publishes."
        },
        "frame_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time a frame took, in milliseconds."
        },
        "frame_p95_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The time 95 in 100 frames took at most, to the nearest bucket of its histogram\n(a quarter millisecond below 16 ms, wider above)."
        },
        "frames": {
          "default": 0,
          "description": "The frames it drew.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "over_budget": {
          "default": 0,
          "description": "The frames that took longer than `frame_budget_ms`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "phases": {
          "$ref": "#/$defs/PhaseProfile",
          "default": {
            "captures_ms": 0.0,
            "chains_ms": 0.0,
            "finish_ms": 0.0,
            "passes_ms": 0.0,
            "uploads_ms": 0.0
          },
          "description": "The average time per frame in each phase."
        },
        "skipped": {
          "default": 0,
          "description": "The program's ticks skipped because drawing fell a whole period or more behind\n(R-RT-004). Always 0 for the preview, which draws when it can.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "drawer"
      ],
      "type": "object"
    },
    "DropCounts": {
      "description": "Running totals of frames and packets the pipeline has dropped since the engine\nstarted (R-RT-004).\n\nEach field sums one kind of drop across every stage that counts it. A stage that\ndoes not count that kind contributes nothing. Totals only grow: a client computes\nan interval by subtracting the previous tick.\n\nSilence a stage inserts to cover a gap (an audio underrun, a device gap, encoder\ngap-fill) is not a drop and is not included.\n\nA missing field parses as 0, so a counter added in a later minor version can be left\nout by an older sender (R-API-001). Unknown fields are ignored.",
      "properties": {
        "audio_frames": {
          "default": 0,
          "description": "Audio frames dropped before the mixer consumed them: a device ring that\noverwrote unread frames, frames that arrived after the mixer had passed them,\nand frames the mixer skipped because it fell behind the clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "capture_frames": {
          "default": 0,
          "description": "Video frames a capture mailbox replaced before the reader took them.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encode_blocks": {
          "default": 0,
          "description": "Audio blocks dropped before an encoder accepted them (its input queue was full,\nor the encoder was busy).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encode_frames": {
          "default": 0,
          "description": "Video frames dropped before an encoder accepted them (its input queue was full,\nor the encoder was busy).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_packets": {
          "default": 0,
          "description": "Encoded packets dropped handing a stream to an output: a subscriber that fell\nbehind, or the output's own queue.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "render_ticks": {
          "default": 0,
          "description": "Render ticks the render loop skipped to catch up with the media clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DroppedOverride": {
      "description": "Overrides a batch dropped because their item left the keyframe scene's tree\n(ADR-0040 §1): `item.remove` of the item, `item.move` of it out of the tree, or an\nedit that takes the group holding it out (`scene.set_role` of the group, or removing\nor retargeting the last item that places it). Undoing the batch restores them.",
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden crop."
        },
        "effects": {
          "description": "The overridden effects, first first, which the keyframe draws in place of the\nitem's own (since 0.63, ADR-0088). An empty list is an override too: no effects\nthere.",
          "items": {
            "$ref": "#/$defs/FilterInfo"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemGeometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden geometry, as `item.set_geometry` wrote it."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "The parent's item."
        },
        "motion": {
          "description": "The overridden motion modifiers, which the keyframe moves the item with in place\nof the item's own (since 0.81, ADR-0099). An empty list is an override too: no\nmotion there. A Move between two members of a family blends both sides'.",
          "items": {
            "$ref": "#/$defs/MotionModifier"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden opacity, from 0 to [`MAX_OPACITY`](crate::MAX_OPACITY)."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The keyframe scene that held the override."
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemTransform"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden geometry in the deprecated 0.3 form, as `item.set_transform` wrote\nit. Never set together with `geometry`: both are the one `geometry` field."
        },
        "visible": {
          "description": "The overridden visibility.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "scene_id",
        "item_id"
      ],
      "type": "object"
    },
    "Easing": {
      "description": "How a value moves from its start to its end over a transition\n([ADR-0029](../../../docs/adr/0029-transitions.md) §5).",
      "oneOf": [
        {
          "const": "ease_in_out",
          "description": "Cubic ease-in-out: slow at both ends.",
          "type": "string"
        },
        {
          "const": "ease_out",
          "description": "Cubic ease-out: fast at the start, slow at the end.",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "Constant speed.",
          "type": "string"
        },
        {
          "const": "spring",
          "description": "`1 − e^(−6p)·cos(11p)`: overshoots the end and settles back.",
          "type": "string"
        }
      ]
    },
    "Edit": {
      "description": "A change to the collection state: undoable, batchable and atomic.\n\nSerialized with an internal `type` tag holding the command name (`noun.verb`,\nR-API-002). Every variant documents its inverse. The engine (`jstream-graph`)\ncomputes the inverse from the state *before* the edit, so the protocol has to be\nclosed under inversion: every inverse must itself be a sequence of edits, and it is.\n\nPositions are indexes: scenes in display order (0 is first), items in stacking order\nwithin their scene (0 is the bottom).",
      "oneOf": [
        {
          "description": "Creates an empty scene. Inverse: `scene.delete`.",
          "properties": {
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the scene is for (ADR-0024 §1). Omitted means `scene`."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The new scene's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "scene.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Creates a keyframe scene (a variant) of `variant_of` (ADR-0024 §2, ADR-0049): a\nscene with no items of its own that shows its parent's items, each at its parent's\nvalues until the variant overrides a field. Placement edits with `scene_id` set to\nthe variant write its overrides; `item.clear_override` removes them. `variant_of`\nmust name an existing scene that is not itself a variant (a keyframe of a keyframe\nis made on the parent), else `invalid_argument`; a missing one is `not_found`.\nThe variant has the role `scene`, no folder (it sits under its parent) and no\ntransition overrides; its own `scene.set_transitions` and `scene.set_meta` apply.\nInverse: `scene.delete`.",
          "properties": {
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The new scene's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "scene.create_variant",
              "type": "string"
            },
            "variant_of": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene it is a keyframe of."
            }
          },
          "required": [
            "type",
            "scene_id",
            "variant_of",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Removes one field of a keyframe scene's override of an item (ADR-0049 §2), so\nthat field follows the parent again. \"Reset keyframe\" is a batch of these.\n`scene_id` must name a keyframe scene and `item_id` an item in its parent's tree\n(one of the parent's own, or, since 0.55, a child of a group it places, at any\ndepth), else `invalid_argument` (`not_found` for a missing one). Clearing a field the variant\ndoesn't override is allowed and changes nothing. Inverse: the placement edit that\nwrites the old value with `scene_id` set, or nothing when the field was absent.",
          "properties": {
            "field": {
              "$ref": "#/$defs/OverrideField",
              "description": "The field to clear."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item in the parent's tree."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The keyframe scene."
            },
            "type": {
              "const": "item.clear_override",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id",
            "field"
          ],
          "type": "object"
        },
        {
          "description": "Writes a keyframe scene's override of an item's effects, the whole list, which the\nkeyframe draws in place of the item's own (ADR-0088, since 0.63). `scene_id` must\nname a keyframe scene whose tree holds `item_id`, else `invalid_argument` on\n`scene_id` (`not_found` for a missing one): an item's own effects are edited with\n`filter.*`. Each entry is checked, and its settings completed, as `filter.add`\nchecks an item effect's; the field is `effects.<n>.<field>`. An empty list is an\noverride with no effects. One effect of the override is edited with `filter.*`\non the `keyframe` owner. Inverse: `item.set_effects` with the old list, or\n`item.clear_override` of `effects` when the keyframe didn't override it.",
          "properties": {
            "effects": {
              "description": "The effects, first first: at most\n[`MAX_CHAIN_FILTERS`](crate::MAX_CHAIN_FILTERS), else `invalid_argument` on\n`effects`.",
              "items": {
                "$ref": "#/$defs/FilterInfo"
              },
              "type": "array"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item in the parent's tree."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The keyframe scene."
            },
            "type": {
              "const": "item.set_effects",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id",
            "effects"
          ],
          "type": "object"
        },
        {
          "description": "Writes an item's motion modifiers, the whole list (ADR-0099, since 0.81), which\nmove it on the engine's animation clock as each frame is drawn. Without\n`scene_id`, or with its own scene's, it writes the item's own list; with a\nkeyframe scene whose tree holds the item, it writes that keyframe's override.\nAny other scene is `invalid_argument` on `scene_id`. The list holds at most\n[`MAX_MOTION_MODIFIERS`](crate::MAX_MOTION_MODIFIERS), else `invalid_argument` on\n`motion`; each ID is unique and well formed, and each parameter in its range,\nelse `invalid_argument` on `motion.<n>.<field>`. An empty list stops all motion\n(in a keyframe, an override with none). Inverse: `item.set_motion` with the old\nlist, or `item.clear_override` of `motion` when the keyframe didn't override it.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item."
            },
            "motion": {
              "description": "The modifiers, first first.",
              "items": {
                "$ref": "#/$defs/MotionModifier"
              },
              "type": "array"
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_motion",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "motion"
          ],
          "type": "object"
        },
        {
          "description": "Renames a scene. Inverse: `scene.rename` back to the previous name.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to rename."
            },
            "type": {
              "const": "scene.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes what a scene is for (ADR-0024 §1): a `scene`, or a `group` placed in\nother scenes through a `scene` source. A group renders, nests and can be placed\nmore than once like any scene, and clients hide groups from the scene list. A\nkeyframe scene may override a group's children, and draws a group it overrides\nwith those values (since 0.55): so setting a group to `scene` takes its children\nout of every keyframe scene's tree and drops their overrides there, reported in\nthe batch result's `dropped_overrides` (ADR-0040 §1). Inverse: `scene.set_role`\nwith the previous role, then the writes that restore any dropped overrides.",
          "properties": {
            "role": {
              "$ref": "#/$defs/SceneRole",
              "description": "Its new role."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_role",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "role"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a scene and its items; the sources they placed stay. Rejected with\n`invalid_argument` while a `scene` source or a video mix shows it, or any source's\nor transition preset's settings refer to it (a stinger's `scene`): delete those\nsources, point those mixes elsewhere, or clear those references, first (in the\nsame batch if needed). Hotkey bindings whose\naction names the scene are not blockers: they are removed with it (ADR-0040 §3).\nA scene with keyframe scenes is refused the same way, the variants listed as its\nblockers; delete them first. Inverse: `scene.create` with its role (omitted for\n`scene`), or `scene.create_variant` for a keyframe scene, then `scene.reorder`\nto its old display position (unless it was last), `scene.set_transitions` if it\nhad an override, `scene.set_folder` and `scene.set_meta` if it had a folder or\nmetadata, then each deleted item's `item.remove` inverse, from bottom to top (a\nkeyframe scene's overrides instead, as placement edits with its `scene_id`), then\n`hotkey.set` for each removed binding.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to delete."
            },
            "type": {
              "const": "scene.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Places an existing source in a scene as a new item, on top. The item refers to the\nsource, it doesn't copy it: one source can be placed in many scenes, or several\ntimes in one, and every placement shows the same instance (`source.duplicate`\nmakes a separate copy). Inverse: `item.remove`.\n\nThe item's placement is `geometry` when that is sent, else a legacy placement:\n`transform`, or [`ItemTransform::IDENTITY`] when both are omitted (ADR-0022).\nSending both is `invalid_argument`. That identity draws the source at its own\npixel size from the canvas's top-left, so a `display`, `window` or `webcam` larger\nthan the canvas shows only its corner: for those, send a `geometry` covering the\ncanvas (`center` at half the canvas size, `size` the canvas size, `fit_mode`\n`fit`), as `jstream-cli` does.",
          "properties": {
            "blend": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BlendMode"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The initial blend mode, checked like `item.set_blend`'s. Omitted means\n`normal`."
            },
            "geometry": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemGeometry"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The initial placement as a box on the canvas, checked like\n`item.set_geometry`'s."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The new item's ID, chosen by the client. Rejected if it exists."
            },
            "opacity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The initial opacity, checked like `item.set_opacity`'s. Omitted means 1."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to add to."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source the item shows."
            },
            "transform": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ItemTransform"
                },
                {
                  "type": "null"
                }
              ],
              "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `geometry`. The\ninitial legacy placement, with its 0.3 meaning."
            },
            "type": {
              "const": "item.add",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Removes an item from its scene. The source itself stays. Every keyframe scene\nwhose tree held the item loses its override of it, and of the items of a group\nit was the last path to, reported in the batch result's `dropped_overrides`\n(ADR-0040 §1). Inverse: `item.add` with\nthe removed item's scene, ID and source, its placement in the field matching its\nform (`transform` or `geometry`), and its opacity and blend where they differ from\nthe defaults, then `item.reorder` to its old stacking position (unless it was on\ntop), `item.set_crop` if it was cropped, `item.set_visible` if it was hidden,\n`item.set_transition` if its transition settings were not the default,\n`item.set_locked` if it was locked (since 0.71), `item.set_effects_space` if its\neffects run in canvas space (since 0.76), and the placement edits that write each\ndropped override back.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to remove."
            },
            "type": {
              "const": "item.remove",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "Moves an item to a stacking position in another scene, keeping its ID, source,\nplacement, crop and visibility (ADR-0024 §1). Grouping is a batch that creates a\ngroup scene, places it, and moves the selected items into it. Rejected with\n`invalid_argument` if the move would make a scene contain itself (field\n`scene_id`, naming the cycle), if the index is out of range, or if the scene is\na keyframe scene, which has no items of its own. A move out of a keyframe scene's\ntree drops the item's overrides there, as `item.remove` does; a move between a\nparent and a group it places keeps them. Inverse: `item.move` back to its previous scene and index,\nthen the placement edits that write each dropped override back.",
          "properties": {
            "index": {
              "description": "Its position in that scene after the move, counted from the bottom (0). Must\nbe at most the number of items already in that scene (less than it for the\nitem's own scene), else `invalid_argument`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to move it to. Its own scene is allowed, and then the move is an\n`item.reorder`."
            },
            "type": {
              "const": "item.move",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "scene_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: send `item.set_geometry`.\nReplaces an item's placement with a legacy one, which keeps its 0.3 meaning.\nInverse: the previous placement, as `item.set_transform` if it was legacy and\n`item.set_geometry` if it was a geometry.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "transform": {
              "$ref": "#/$defs/ItemTransform",
              "description": "The new transform."
            },
            "type": {
              "const": "item.set_transform",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "transform"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an item's placement with a box on the canvas (ADR-0022). A size that is\nnot greater than zero and a `perspective_px` that is not greater than zero are\n`invalid_argument`. Any `tilt_deg`, `turn_deg`, `depth_px` and `perspective_px` is\naccepted from 0.34 (ADR-0050) if the compositor can draw it: a non-neutral one\nwhose centre, size, depth or perspective is past 10^15 canvas pixels, or whose\ndrawn polygon would not be finite or would reach past that, is `invalid_argument`\non `geometry`. Earlier minors\nrejected a non-neutral one with `invalid_argument`. Inverse: the previous\nplacement, as `item.set_geometry` if it was a geometry and `item.set_transform`\nif it was legacy.",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/ItemGeometry",
              "description": "The new geometry."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to place."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_geometry",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "geometry"
          ],
          "type": "object"
        },
        {
          "description": "Shows or hides an item. Inverse: `item.set_visible` with the previous value.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to show or hide."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change, as every placement edit\ntakes it (ADR-0024 §2). Omitted, or the item's own scene, changes the item. A\nkeyframe scene whose tree holds the item (of the item's scene, or of a scene\nthat reaches the item's group through groups it places, at any depth) writes\nthat scene's override of this\nfield (since 0.39), whose inverse is `item.clear_override` if the field was\nnot overridden and this edit with the old value if it was. Any other scene is\n`invalid_argument`."
            },
            "type": {
              "const": "item.set_visible",
              "type": "string"
            },
            "visible": {
              "description": "Whether the item is drawn. Items are visible when added.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "item_id",
            "visible"
          ],
          "type": "object"
        },
        {
          "description": "Changes how transparent an item is drawn (ADR-0023 §1): its colour and alpha are\nmultiplied by `opacity` after crop and fit. Above 1 (since 0.83, #1101) it is a\ngain on the item's light: its premultiplied colour is multiplied by the opacity\nwhile its alpha is multiplied by 1, so an `additive` item adds more light than its\nsource draws, and an item in another mode is drawn brighter. A value outside 0 to\n[`MAX_OPACITY`] is `invalid_argument`. Items are added at 1. Inverse:\n`item.set_opacity` with the previous value.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "opacity": {
              "$ref": "#/$defs/Finite32",
              "description": "From 0 (invisible) through 1 (as the source draws it) to [`MAX_OPACITY`]\n(its light that many times over)."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_opacity",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "opacity"
          ],
          "type": "object"
        },
        {
          "description": "Changes how an item composites onto what is below it (ADR-0023 §1). A mode the\ncompositor doesn't draw yet is `invalid_argument`, so stored state never claims\nsomething that isn't drawn; today that is every mode but `normal`. Inverse:\n`item.set_blend` with the previous mode.",
          "properties": {
            "blend": {
              "$ref": "#/$defs/BlendMode",
              "description": "The new blend mode. Items are added with `normal`."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "type": {
              "const": "item.set_blend",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "blend"
          ],
          "type": "object"
        },
        {
          "description": "Moves an item to another stacking position in its scene. Inverse: `item.reorder`\nback to its previous index.",
          "properties": {
            "index": {
              "description": "The new position, counted from the bottom (0). Must be less than the number of\nitems in the scene, else `invalid_argument`. The other items keep their\nrelative order.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to move."
            },
            "type": {
              "const": "item.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Changes which source an item places, keeping the item's ID, transform, crop,\nvisibility and stacking position (ADR-0023). It switches an item between a\nreference and a clone: `source.duplicate` then `item.set_source` to the copy makes\na clone, and `item.set_source` back to the copy's `duplicated_from` (then\n`source.delete` of the copy if nothing else places it) makes it a reference again.\nRejected with `not_found` if the item or the source doesn't exist, and with\n`invalid_argument` naming the cycle if the scene would then contain itself,\ndirectly or through other scenes. Retargeting the last item that places a group\ntakes the group's children out of a keyframe scene's tree and drops their\noverrides there, reported in `dropped_overrides` (ADR-0040 §1, since 0.55).\nInverse: `item.set_source` with the previous source, then the writes that restore\nany dropped overrides.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source it places from now on."
            },
            "type": {
              "const": "item.set_source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an item's crop. Inverse: `item.set_crop` with the previous one.",
          "properties": {
            "crop": {
              "$ref": "#/$defs/Crop",
              "description": "The new crop. Items are added uncropped ([`Crop::NONE`])."
            },
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to crop."
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene whose placement of the item to change. See [`Edit::ItemSetVisible`]."
            },
            "type": {
              "const": "item.set_crop",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "crop"
          ],
          "type": "object"
        },
        {
          "description": "Adds a source to the collection. It appears in no scene until an `item.add`\nplaces it. An audio source (its kind produces audio, or it is a `scene` source)\nstarts with its kind's default audio settings, and one that is not a `scene`\nsource sends to the master bus at 0 dB (ADR-0028). Inverse: `source.delete`.",
          "properties": {
            "duplicated_from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The source this one was copied from, as `source.duplicate` records it. A plain\nlink: it may name a source that no longer exists (`source.delete`'s inverse\nrestores it that way), and is reported only while that source exists. It must\nnot name the new source itself, else `invalid_argument`. Omitted means none."
            },
            "kind": {
              "$ref": "#/$defs/SourceKind",
              "description": "What the source shows. A `scene` source must name an existing scene; a\n`builtin` one a kind that `kind.list` reports."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "settings": {
              "$ref": "#/$defs/Settings",
              "description": "Initial settings, checked against the kind's descriptor (`kind.describe`).\nParameters left out, or sent as `null`, take their defaults, and the engine\nstores the complete map. A `scene` source has no settings. Omitted means all\ndefaults."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The new source's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "source.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "name",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Renames a source. Inverse: `source.rename` back to the previous name.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to rename."
            },
            "type": {
              "const": "source.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes some of a source's settings. Each entry of `patch` is checked against the\nkind's descriptor like `source.create`'s settings, and replaces that parameter's\nvalue; `null` resets a parameter to its default (a reference parameter to no\nreference). Parameters not in the patch keep their values. A reference that would\nmake a cycle is rejected with `invalid_argument` naming it. Inverse:\n`source.set_settings` with the patched parameters' previous values.",
          "properties": {
            "patch": {
              "$ref": "#/$defs/Settings",
              "description": "Parameter ID to new value, or `null` for the default."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to change."
            },
            "type": {
              "const": "source.set_settings",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "patch"
          ],
          "type": "object"
        },
        {
          "description": "Copies a source under a new ID: a separate instance with the same kind, settings,\nfilters (with the same filter IDs), audio settings and sends, labels and favourite\nflag, which changes independently from then on. The copy's `duplicated_from`\nnames the source it was copied from. Placing the *same* source again is `item.add`\nwith its existing `source_id`. Inverse: `source.delete` of the copy.",
          "properties": {
            "name": {
              "description": "The copy's display name.",
              "type": "string"
            },
            "new_source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The copy's ID, chosen by the client. Rejected if it exists."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to copy."
            },
            "type": {
              "const": "source.duplicate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "new_source_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a source. Rejected with `invalid_argument` while any item still places it,\nor any source's or filter's settings refer to it: remove those items, or clear\nthose references, first (in the same batch if needed). Deleting a source that\nothers were copied from is allowed: their `duplicated_from` then reads as absent.\nIts sends go with it, and so do the hotkey bindings whose action names it\n(ADR-0040 §3). Inverse: `source.create` with its name, kind, settings and\n`duplicated_from`, then `send.remove` of its master send if it had none,\n`send.set` for each send that `source.create` doesn't restore as it was,\n`source.set_audio` if its audio settings were not the defaults, `filter.add`\nfor each of its filters, video chain first, in chain order, `source.set_meta` if\nit carried labels or was a favourite, then `hotkey.set` for each removed binding.",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to delete."
            },
            "type": {
              "const": "source.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a filter to one of a source's chains (ADR-0026). Rejected with `not_found` if\nthe owner doesn't exist, `already_exists` if it has a filter with this ID, and\n`invalid_argument` if the source has no such chain, the chain is full\n([`MAX_CHAIN_FILTERS`](crate::MAX_CHAIN_FILTERS)), `kind` is not a filter kind of\nthat chain (`video_filter` or `audio_filter`), a setting fails its descriptor as in\n`source.create`, a reference in the settings would close a cycle, or `index` is\npast the end. Inverse: `filter.remove`.",
          "properties": {
            "chain": {
              "$ref": "#/$defs/FilterChain",
              "description": "Which chain."
            },
            "enabled": {
              "description": "Whether it runs. Omitted means enabled.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "filter_id": {
              "$ref": "#/$defs/FilterId",
              "description": "The new filter's ID, chosen by the client, unique within its owner."
            },
            "index": {
              "description": "Its position in the chain, counted from the first filter (0). Must be at most\nthe number of filters already in the chain. Omitted means last.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "description": "The filter's kind, as `kind.list` reports it.",
              "type": "string"
            },
            "owner": {
              "$ref": "#/$defs/FilterOwner",
              "description": "What owns the chain."
            },
            "settings": {
              "$ref": "#/$defs/Settings",
              "description": "Initial settings, checked against the kind's descriptor and completed with its\ndefaults, as `source.create`'s are. Omitted means all defaults."
            },
            "type": {
              "const": "filter.add",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner",
            "chain",
            "filter_id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Removes a filter from its chain. Inverse: `filter.add` with its chain, kind,\nsettings, `enabled: false` if it was disabled, and its index.",
          "properties": {
            "filter_id": {
              "$ref": "#/$defs/FilterId",
              "description": "The filter to remove."
            },
            "owner": {
              "$ref": "#/$defs/FilterOwner",
              "description": "What owns the filter."
            },
            "type": {
              "const": "filter.remove",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner",
            "filter_id"
          ],
          "type": "object"
        },
        {
          "description": "Turns a filter on or off. A disabled filter stays in its chain and keeps its\nsettings, and is bypassed. Inverse: `filter.set_enabled` with the previous value.",
          "properties": {
            "enabled": {
              "description": "Whether it runs.",
              "type": "boolean"
            },
            "filter_id": {
              "$ref": "#/$defs/FilterId",
              "description": "The filter to change."
            },
            "owner": {
              "$ref": "#/$defs/FilterOwner",
              "description": "What owns the filter."
            },
            "type": {
              "const": "filter.set_enabled",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner",
            "filter_id",
            "enabled"
          ],
          "type": "object"
        },
        {
          "description": "Changes some of a filter's settings, with `source.set_settings`'s rules: each entry\nis checked against the kind's descriptor, `null` resets a parameter to its default\n(a reference to none), and a reference that would make a cycle is\n`invalid_argument` naming it. Inverse: `filter.set_settings` with the patched\nparameters' previous values.",
          "properties": {
            "filter_id": {
              "$ref": "#/$defs/FilterId",
              "description": "The filter to change."
            },
            "owner": {
              "$ref": "#/$defs/FilterOwner",
              "description": "What owns the filter."
            },
            "patch": {
              "$ref": "#/$defs/Settings",
              "description": "Parameter ID to new value, or `null` for the default."
            },
            "type": {
              "const": "filter.set_settings",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner",
            "filter_id",
            "patch"
          ],
          "type": "object"
        },
        {
          "description": "Moves a filter to another position in its own chain. Inverse: `filter.reorder`\nback to its previous index.",
          "properties": {
            "filter_id": {
              "$ref": "#/$defs/FilterId",
              "description": "The filter to move."
            },
            "index": {
              "description": "The new position, counted from the first filter (0). Must be less than the\nnumber of filters in its chain, else `invalid_argument`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "owner": {
              "$ref": "#/$defs/FilterOwner",
              "description": "What owns the filter."
            },
            "type": {
              "const": "filter.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "owner",
            "filter_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Moves a scene to another display position. Inverse: `scene.reorder` back to its\nprevious index.",
          "properties": {
            "index": {
              "description": "The new position, counted from the first scene (0). Must be less than the\nnumber of scenes, else `invalid_argument`. The other scenes keep their\nrelative order.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to move."
            },
            "type": {
              "const": "scene.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Adds an output to the collection, `stopped`. Its stream key is not part of it:\nset that with the `output.set_key` action. Inverse: `output.delete`.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/OutputKind",
              "description": "What it is and where it sends. A URL that is not a valid RTMP(S) server URL,\nor that could carry a credential, is rejected with `invalid_argument`."
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The new output's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "output.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Changes where an RTMP output publishes. A running output keeps its connection;\nthe new target applies from its next `output.start`. Its stream key is kept only\nwhile the server stays the same (scheme, host and port; the path may change): a\nnew server removes the key from the credential store, so the old key never goes\nto it, and needs a new `output.set_key`. Inverse: `output.set_target` with the\nprevious target, which can't restore a removed key.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "target": {
              "$ref": "#/$defs/RtmpTarget",
              "description": "The new target, validated as in `output.create`."
            },
            "type": {
              "const": "output.set_target",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "Changes where a recording output writes its file (since 0.74, #1072), keeping its\ncontainer, encoder profile, mix, bus and filters. A running output keeps writing\nwhere it started; the new path applies from its next `output.start`, which still\nnever overwrites. The path is checked as in `output.create`'s\n[`OutputKind::Record`](crate::OutputKind::Record). An output that isn't a\nrecording is `invalid_argument`. Inverse: `output.set_path` with the previous\npath.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The recording output to change."
            },
            "path": {
              "description": "Where the finished recording goes: an absolute path on the engine's machine,\nending in a file name.",
              "type": "string"
            },
            "type": {
              "const": "output.set_path",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "path"
          ],
          "type": "object"
        },
        {
          "description": "Changes the canvas: every scene's coordinate space, in whole pixels (ADR-0022).\nItems keep their canvas-pixel placements; nothing moves or resizes. Zero, or a\nside over the engine's maximum (at least 7680, both ways), is `invalid_argument`.\nInverse: `canvas.set_size` with the previous size.",
          "properties": {
            "height": {
              "description": "Canvas height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "canvas.set_size",
              "type": "string"
            },
            "width": {
              "description": "Canvas width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "description": "Sets the collection's base frame rate to 30 or 60 (since 0.89, ADR-0119). A new\ncollection is 30. The program stage keeps the rate it opened with; a change\napplies the next time the stage opens. A preview stream holds the stage open, so\nthe program keeps the old rate until every consumer stops. `profile.get`'s\n`frame_budget_ms` is the rate the stage is actually running at. Mixes run at this\nrate divided by their `fps_divisor`, so 60 doubles every mix. Anything else is\n`invalid_argument`. Inverse: `canvas.set_frame_rate` with the previous rate.",
          "properties": {
            "fps": {
              "description": "Frames per second: 30 or 60.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "canvas.set_frame_rate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fps"
          ],
          "type": "object"
        },
        {
          "description": "Deletes an output. Rejected with `invalid_argument` while it runs: stop it first.\nIts stream key is removed from the credential store, so an output created later\nwith the same ID doesn't inherit it. Hotkey bindings whose action names the output\nare removed with it (ADR-0040 §3). Inverse: `output.create` with its kind,\n`output.set_encoder` if it had a profile, then `hotkey.set` for each removed\nbinding; it can't restore the key: set it again with `output.set_key`.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to delete."
            },
            "type": {
              "const": "output.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Chooses the encoder profile an output uses, or the engine's default. A running\noutput keeps its encoder session; the profile applies from its next\n`output.start`. Inverse: `output.set_encoder` with the previous profile.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "profile_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EncoderProfileId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "The profile, which must exist, else `not_found`. Absent or `null` means the\nengine's default."
            },
            "type": {
              "const": "output.set_encoder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds an encoder profile. Inverse: `encoder.delete`.",
          "properties": {
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "profile": {
              "$ref": "#/$defs/EncoderProfile",
              "description": "The encoding. Out-of-range values, and codecs or rate controls the engine\ndoesn't know, are rejected with `invalid_argument`."
            },
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The new profile's ID, chosen by the client. Rejected if it exists."
            },
            "type": {
              "const": "encoder.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id",
            "name",
            "profile"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an encoder profile's name and encoding. Running outputs keep their\nencoder sessions; the new encoding applies from each output's next\n`output.start`. Inverse: `encoder.update` with the previous name and encoding.",
          "properties": {
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "profile": {
              "$ref": "#/$defs/EncoderProfile",
              "description": "The new encoding, validated as in `encoder.create`."
            },
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The profile to change."
            },
            "type": {
              "const": "encoder.update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id",
            "name",
            "profile"
          ],
          "type": "object"
        },
        {
          "description": "Deletes an encoder profile. Rejected with `invalid_argument` while an output\nuses it: point those outputs elsewhere with `output.set_encoder` first (in the\nsame batch if needed). Inverse: `encoder.create` with its name and encoding.",
          "properties": {
            "profile_id": {
              "$ref": "#/$defs/EncoderProfileId",
              "description": "The profile to delete."
            },
            "type": {
              "const": "encoder.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "profile_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a video mix: what an output's video can show, at what size and rate. A mix\nrenders only while an output that shows it runs. Inverse: `video_mix.delete`.",
          "properties": {
            "mix": {
              "$ref": "#/$defs/VideoMix",
              "description": "What it shows, and at what size and rate. An input the engine doesn't know, a\nside that is odd or outside 16..=8192, or an `fps_divisor` outside 1..=60 is\nrejected with `invalid_argument`, and a `scene` input naming a scene that\ndoesn't exist with `not_found`."
            },
            "mix_id": {
              "$ref": "#/$defs/VideoMixId",
              "description": "The new mix's ID, chosen by the client. Rejected if it exists."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "type": {
              "const": "video_mix.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "mix_id",
            "name",
            "mix"
          ],
          "type": "object"
        },
        {
          "description": "Replaces a video mix's name, input, resolution and rate. Running outputs that\nshow it follow a new input from the next frame; a new resolution or rate applies\nfrom each output's next `output.start`. Inverse: `video_mix.update` with the\nprevious name and mix.",
          "properties": {
            "mix": {
              "$ref": "#/$defs/VideoMix",
              "description": "The new mix, validated as in `video_mix.create`."
            },
            "mix_id": {
              "$ref": "#/$defs/VideoMixId",
              "description": "The mix to change."
            },
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "type": {
              "const": "video_mix.update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "mix_id",
            "name",
            "mix"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a video mix. Rejected with `invalid_argument` while an output shows it:\npoint those outputs elsewhere with `output.set_video_mix` first (in the same batch\nif needed). Inverse: `video_mix.create` with its name and mix.",
          "properties": {
            "mix_id": {
              "$ref": "#/$defs/VideoMixId",
              "description": "The mix to delete."
            },
            "type": {
              "const": "video_mix.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "mix_id"
          ],
          "type": "object"
        },
        {
          "description": "Chooses the video mix an output shows, or none: the program at the engine's\ncanvas size and base rate. A running output keeps its encoder session; the mix\napplies from its next `output.start`. Inverse: `output.set_video_mix` with the\nprevious mix.",
          "properties": {
            "mix_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VideoMixId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mix, which must exist, else `not_found`. Absent or `null` means none."
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "type": {
              "const": "output.set_video_mix",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Chooses the buses whose audio an output carries (since 0.59), one per audio\ntrack, in track order. Every output writes one audio track for now, so the list\nholds exactly one bus; any other length is `invalid_argument` on `audio_buses`,\nas is an output with no audio (a virtual camera). Each bus must exist, else\n`not_found`. The master stage's audio chain runs on the bus, then the output's\nown chain (ADR-0080 §1). A running output reads its bus, so moving it to another\nis `invalid_argument` on `output_id` until it stops. Inverse:\n`output.set_audio_buses` with the previous buses.",
          "properties": {
            "audio_buses": {
              "description": "The buses, in track order.",
              "items": {
                "$ref": "#/$defs/BusId"
              },
              "type": "array"
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to change."
            },
            "type": {
              "const": "output.set_audio_buses",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "audio_buses"
          ],
          "type": "object"
        },
        {
          "description": "Adds a folder to the scene list, last in folder order (ADR-0024 §3). Folders\norganise only: they change no rendering, switching or nesting. Inverse:\n`folder.delete`.",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The new folder's ID, chosen by the client. Rejected if it exists."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "parent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FolderId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The folder it sits in, which must exist, else `not_found`. Omitted means top\nlevel."
            },
            "type": {
              "const": "folder.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Renames a folder. Inverse: `folder.rename` back to the previous name.",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The folder to rename."
            },
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "type": {
              "const": "folder.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Moves a folder into another folder, or to the top level (ADR-0064: folders nest).\nA parent that would put the folder inside itself is `invalid_argument` (field\n`parent`), and a parent that doesn't exist `not_found`. Inverse:\n`folder.set_parent` with the previous parent.",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The folder to move."
            },
            "parent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FolderId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Its new parent. Absent or `null` means top level."
            },
            "type": {
              "const": "folder.set_parent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id"
          ],
          "type": "object"
        },
        {
          "description": "Moves a folder to another position in folder order. The folders in one parent\nshow in that order. Inverse: `folder.reorder` back to its previous index.",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The folder to move."
            },
            "index": {
              "description": "The new position, counted from the first folder (0). Must be less than the\nnumber of folders, else `invalid_argument`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "folder.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Deletes an empty folder. Rejected with `invalid_argument` while a scene or another\nfolder sits in it, listing them as `blockers`: move them out first, or send the\nbatch `delete.plan` returns, which moves them up to the folder's parent. Inverse:\n`folder.create` with its name and parent, then `folder.reorder` to its old\nposition (unless it was last).",
          "properties": {
            "folder_id": {
              "$ref": "#/$defs/FolderId",
              "description": "The folder to delete."
            },
            "type": {
              "const": "folder.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "folder_id"
          ],
          "type": "object"
        },
        {
          "description": "Puts a scene in a folder, or takes it out of one. The scene keeps its position in\nthe flat display order. Inverse: `scene.set_folder` with the previous folder.",
          "properties": {
            "folder_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FolderId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The folder, which must exist, else `not_found`. Absent or `null` means none."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to file."
            },
            "type": {
              "const": "scene.set_folder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces a scene's organisation metadata: the labels it carries, its icon, colour,\nfavourite flag and whether a multiview shows it. Every field left out takes its\ndefault, so `labels` omitted removes them all. An icon that is empty or longer\nthan 64 bytes, a colour that isn't `#rrggbb`, or a label listed twice is\n`invalid_argument`, and a label that doesn't exist `not_found`; the engine stores\nlabels ordered by ID. Inverse: `scene.set_meta` with the previous metadata.",
          "properties": {
            "color": {
              "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
              "type": [
                "string",
                "null"
              ]
            },
            "favourite": {
              "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
              "type": "boolean"
            },
            "icon": {
              "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
              "type": [
                "string",
                "null"
              ]
            },
            "labels": {
              "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
              "items": {
                "$ref": "#/$defs/LabelId"
              },
              "type": "array"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "show_in_multiview": {
              "description": "Whether a multiview shows it. Omitted for `true`, the default.",
              "type": "boolean"
            },
            "type": {
              "const": "scene.set_meta",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces a scene's options (ADR-0089, since 0.65): whether its audio reaches the\nMixer when it is nested, and its background colour. Every field left out takes\nits default. A keyframe scene has options of its own, except a background, which\nit shows from its parent. `invalid` for a background that isn't a colour, or one\non a keyframe scene. Inverse: `scene.set_options` with the previous options.",
          "properties": {
            "background": {
              "description": "Its background colour (ADR-0024 §4, ADR-0089 §4, since 0.65): sRGB `#rrggbb`, or\n`#rrggbbaa` with straight alpha, drawn under its items wherever the scene is\ndrawn, nested or not. Omitted for none, the default, which is transparent: where\na video mix shows a transparent pixel, the output is black. A keyframe scene\nshows its parent's, so `scene.set_options` refuses one of its own, and a group\ndraws none: it is part of the scene that holds it.",
              "type": [
                "string",
                "null"
              ]
            },
            "include_audio": {
              "description": "Whether its sources reach the Mixer through the nested scene sources that show\nit. Off, a scene placed inside another adds none of its audio there, whatever\nthose sources' own `audio.enabled`; it changes nothing while the scene itself is\non program. A group is only reached through nesting, so on a group it leaves\nout its children's audio wherever the group shows. Omitted for `true`, the\ndefault.",
              "type": "boolean"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_options",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Sets or removes a scene's camera (ADR-0094, since 0.70). A scene with a camera is a\n3D scene: its items are placed in one 3D space by their geometry and seen through\nthe camera. On a keyframe scene it writes or, with `camera` omitted, removes the\nkeyframe's override of its parent's camera. `invalid_argument` for a field of view\noutside 1 to 170, a position within 0.001 px of the target, a coordinate past the\ndrawable bound, or a camera on a keyframe scene whose parent has none. Removing a\nparent's camera also removes its keyframe scenes' overrides. Inverse:\n`scene.set_camera` with the previous camera, then each removed override.",
          "properties": {
            "camera": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneCamera"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The new camera. Omitted removes it."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_camera",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Sets a scene's camera motion (ADR-0113, since 0.85): the whole list of modifiers that change\nits camera as it is drawn. It belongs to the scene family: `invalid_argument` on a\nkeyframe scene, which draws its parent's, and for a list `check_camera_motion`\nrefuses. A scene without a camera keeps the list, which draws nothing until it has\none. Inverse: `scene.set_camera_motion` with the previous list.",
          "properties": {
            "motion": {
              "default": [],
              "description": "The new list, at most 8. Empty removes every modifier.",
              "items": {
                "$ref": "#/$defs/CameraMotionModifier"
              },
              "type": "array"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_camera_motion",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Sets or removes a scene's follow camera (ADR-0113, since 0.85): a camera that glides after the\npointer over a display or window capture in the scene. Since 0.91 a follow camera\nis a `follow_pointer` filter on the followed item's effects (ADR-0120), and this\nedit is kept as a shortcut for those filter edits: with `follow`, it sets that\nitem's `follow_pointer` filter to its numbers and turns it on, adding one last in\nthe item's effects when it has none, and removes every other `follow_pointer`\nfilter of the scene's items; without, it removes them all. It belongs to the scene\nfamily: `invalid_argument` on a keyframe scene, for an item that isn't in the\nscene or doesn't show a display or window capture, for a number\n`CameraFollow::check` refuses, and when the item's effects are full. The follow\ncamera reads the pointer only where the program is drawn live: `video.snapshot`\nand a frame sheet show it at rest, on the capture's centre. Inverse: the inverse\nof those filter edits (`filter.remove`, `filter.add`, `filter.set_settings` and\n`filter.set_enabled`).",
          "properties": {
            "follow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CameraFollow"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The new follow camera. Omitted removes it."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "type": {
              "const": "scene.set_camera_follow",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a label, last in label order (ADR-0024 §4). Rejected with `invalid_argument`\nfor an empty name, a colour that isn't `#rrggbb`, or an icon checked as\n`scene.set_meta`'s. Inverse: `label.delete`.",
          "properties": {
            "color": {
              "description": "Its colour, sRGB as `#rrggbb`.",
              "type": "string"
            },
            "icon": {
              "description": "An icon name from the UI's icon set. Omitted means none.",
              "type": [
                "string",
                "null"
              ]
            },
            "label_id": {
              "$ref": "#/$defs/LabelId",
              "description": "The new label's ID, chosen by the client. Rejected if it exists."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "type": {
              "const": "label.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label_id",
            "name",
            "color"
          ],
          "type": "object"
        },
        {
          "description": "Replaces a label's name, colour and icon, validated as in `label.create`. Every\nsource carrying it shows the change. Inverse: `label.update` with the previous\nvalues.",
          "properties": {
            "color": {
              "description": "The new colour.",
              "type": "string"
            },
            "icon": {
              "description": "The new icon. Omitted means none.",
              "type": [
                "string",
                "null"
              ]
            },
            "label_id": {
              "$ref": "#/$defs/LabelId",
              "description": "The label to change."
            },
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "type": {
              "const": "label.update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label_id",
            "name",
            "color"
          ],
          "type": "object"
        },
        {
          "description": "Moves a label to another position in label order. Inverse: `label.reorder` back\nto its previous index.",
          "properties": {
            "index": {
              "description": "The new position, counted from the first label (0). Must be less than the\nnumber of labels, else `invalid_argument`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "label_id": {
              "$ref": "#/$defs/LabelId",
              "description": "The label to move."
            },
            "type": {
              "const": "label.reorder",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label_id",
            "index"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a label. Rejected with `invalid_argument` while a source or scene carries\nit, listing them as `blockers`: take it off those first, or send the batch\n`delete.plan` returns. Inverse: `label.create` with its name, colour and icon,\nthen `label.reorder` to its old position (unless it was last).",
          "properties": {
            "label_id": {
              "$ref": "#/$defs/LabelId",
              "description": "The label to delete."
            },
            "type": {
              "const": "label.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces a source's organisation metadata: the labels it carries and its\nfavourite flag. Every field left out takes its default, so `labels` omitted\nremoves them all. A label that doesn't exist is `not_found`, and one listed twice\n`invalid_argument`; the engine stores them ordered by ID. Inverse:\n`source.set_meta` with the previous metadata.",
          "properties": {
            "favourite": {
              "description": "Whether it is a favourite. Omitted for `false`.",
              "type": "boolean"
            },
            "labels": {
              "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
              "items": {
                "$ref": "#/$defs/LabelId"
              },
              "type": "array"
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to change."
            },
            "type": {
              "const": "source.set_meta",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Binds a key chord to an action (ADR-0024 §5). A client that listens for keys\nsends the action when the chord is pressed; the engine only stores the binding.\nOnly actions can be bound, so pressing a hotkey never adds to an undo history.\nRejected with `invalid_argument` for a chord that isn't valid (see [`Chord`]) or\nan action that can't be bound (`output.set_key`, whose stream key is never stored\nin the collection), with `already_exists` (entity `hotkey`) for a chord that is\nalready bound (rebinding is a batch of `hotkey.clear` then `hotkey.set`), and with\n`not_found` for a scene or output the action names that doesn't exist. Deleting\nthat object later removes the binding with it (ADR-0040 §3). Inverse:\n`hotkey.clear`.",
          "properties": {
            "action": {
              "$ref": "#/$defs/Action",
              "description": "The action request it runs, checked as an `action` call is."
            },
            "chord": {
              "$ref": "#/$defs/Chord",
              "description": "The chord, such as `Ctrl+Digit1` or `F1`."
            },
            "type": {
              "const": "hotkey.set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "chord",
            "action"
          ],
          "type": "object"
        },
        {
          "description": "Removes a hotkey binding. Rejected with `not_found` (entity `hotkey`) for a chord\nthat isn't bound. Inverse: `hotkey.set` with its action.",
          "properties": {
            "chord": {
              "$ref": "#/$defs/Chord",
              "description": "The chord to unbind."
            },
            "type": {
              "const": "hotkey.clear",
              "type": "string"
            }
          },
          "required": [
            "type",
            "chord"
          ],
          "type": "object"
        },
        {
          "description": "Stores a timeline in a scene (ADR-0115, since 0.87): a new one, or the whole of\none the scene already holds, in its place. A timeline is timed cues, each running\nan action (ADR-0099 decision 4). Rejected with `not_found` for a scene that doesn't\nexist; with `already_exists` (entity `timeline`) for an ID another scene's timeline\nhas; and with `invalid_argument` at `timeline.<field>` for what\n[`TimelineInfo::problem`] refuses (an ID, a length, a loop, cues out of time order\nor past where they can fire, an action a cue can't run) and for a 33rd timeline in\nthe scene. The objects a cue names are not checked, and deleting one leaves the cue\nin place, inert, like a follow camera's item: when it fires its action fails as the\ncall would, and its `timeline.cue_fired` carries the error. Changing a timeline\nwhile it plays keeps its start, so its cues fire at their new times from then on.\nInverse: `timeline.delete` for a new timeline, else `timeline.set` with the old one.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene that holds it."
            },
            "timeline": {
              "$ref": "#/$defs/TimelineInfo",
              "description": "The timeline, whole."
            },
            "type": {
              "const": "timeline.set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "timeline"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a timeline (ADR-0115, since 0.87). A playing one stops, with a\n`timeline.changed` `removed`. Hotkey bindings whose action names it are removed\nwith it (ADR-0040 §3), and listed in the result's `removed_hotkeys`; cues of other\ntimelines that name it stay, inert. Rejected with `not_found` (entity\n`timeline`) for a timeline the collection doesn't hold. Inverse: `timeline.set`\nwith it, then `hotkey.set` for each removed binding.",
          "properties": {
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline to delete."
            },
            "type": {
              "const": "timeline.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a transition preset (ADR-0029, ADR-0037). Inverse: `transition.delete`.",
          "properties": {
            "duration_ms": {
              "description": "How long one item takes, in milliseconds; at most 60000.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "easing": {
              "$ref": "#/$defs/Easing",
              "description": "The curve its items follow unless they set their own."
            },
            "kind": {
              "description": "A transition kind `kind.list` reports (`cut`, `fade`, `move`), else\n`invalid_argument`.",
              "type": "string"
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "preset_id": {
              "$ref": "#/$defs/TransitionPresetId",
              "description": "The new preset's ID, chosen by the client. Rejected if it exists."
            },
            "settings": {
              "$ref": "#/$defs/Settings",
              "description": "Initial settings, checked against the kind's descriptor as `source.create`'s\nare. Parameters left out take their defaults. Omitted means all defaults."
            },
            "type": {
              "const": "transition.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "preset_id",
            "name",
            "kind",
            "duration_ms",
            "easing"
          ],
          "type": "object"
        },
        {
          "description": "Changes a transition preset. Fields left out keep their values; `patch` changes\nsettings as `source.set_settings` does. A new `kind` replaces the settings with\nthat kind's defaults, overlaid by `patch`. Inverse: `transition.update` with the\nprevious values of what it changed (and, after a kind change, the previous kind\nand every previous setting).",
          "properties": {
            "duration_ms": {
              "description": "A new duration, in milliseconds; at most 60000.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "easing": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Easing"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A new easing."
            },
            "kind": {
              "description": "A new transition kind, checked as in `transition.create`.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "A new display name.",
              "type": [
                "string",
                "null"
              ]
            },
            "patch": {
              "$ref": "#/$defs/Settings",
              "description": "Parameter ID to new value, or `null` for the default."
            },
            "preset_id": {
              "$ref": "#/$defs/TransitionPresetId",
              "description": "The preset to change."
            },
            "type": {
              "const": "transition.update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "preset_id"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a transition preset, and clears every scene's `transition_in` and\n`transition_out` that names it. Hotkey bindings whose `scene.switch` names it\nare removed with it (ADR-0040 §3). The default preset can't be deleted\n(`invalid_argument`): make another one the default first. Inverse:\n`transition.create` with its name, kind, timing and settings, then\n`scene.set_transitions` for each scene it cleared, then `hotkey.set` for each\nremoved binding.",
          "properties": {
            "preset_id": {
              "$ref": "#/$defs/TransitionPresetId",
              "description": "The preset to delete."
            },
            "type": {
              "const": "transition.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "preset_id"
          ],
          "type": "object"
        },
        {
          "description": "Makes a preset the default: the one a switch uses when neither the switch nor\nthe scenes name one. Inverse: `transition.set_default` with the previous default.",
          "properties": {
            "preset_id": {
              "$ref": "#/$defs/TransitionPresetId",
              "description": "The preset, which must exist, else `not_found`."
            },
            "type": {
              "const": "transition.set_default",
              "type": "string"
            }
          },
          "required": [
            "type",
            "preset_id"
          ],
          "type": "object"
        },
        {
          "description": "Sets the presets a scene overrides switches with: `transition_in` when switching\ninto it, `transition_out` when switching out of it. A switch that names a preset\nwins over both, and `transition_in` wins over the other scene's `transition_out`.\nEach must name an existing preset, else `not_found`; omitted means none. Inverse:\n`scene.set_transitions` with the previous two.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene to change."
            },
            "transition_in": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionPresetId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The preset for switching into this scene, or none."
            },
            "transition_out": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionPresetId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The preset for switching out of this scene, or none."
            },
            "type": {
              "const": "scene.set_transitions",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Replaces an item's transition settings (ADR-0029 §6): its delay, easing, whether\nit may glide to other scenes, and how it appears and disappears without a\npartner. A `delay_ms` over 60000 is `invalid_argument`. Inverse:\n`item.set_transition` with the previous settings.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "transition": {
              "$ref": "#/$defs/ItemTransition",
              "description": "Its new settings."
            },
            "type": {
              "const": "item.set_transition",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "transition"
          ],
          "type": "object"
        },
        {
          "description": "Locks or unlocks an item (ADR-0096, since 0.71). A lock is an editing aid kept\nwith the collection, as OBS's is: a client doesn't let a locked item be dragged,\nresized or turned on its canvas, but the engine still applies every edit to it,\nso the Inspector, the menus and a script can change it. It belongs to the item,\nnot to a placement, so it takes no `scene_id` and a keyframe doesn't override\nit. Items are added unlocked. Inverse: `item.set_locked` with the previous value.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to lock or unlock."
            },
            "locked": {
              "description": "Whether its canvas box is locked.",
              "type": "boolean"
            },
            "type": {
              "const": "item.set_locked",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "locked"
          ],
          "type": "object"
        },
        {
          "description": "Sets where an item's effects run (ADR-0106, since 0.76): over its box before it is\nplaced (`box`, the default), or over the canvas after it is placed (`canvas`), so\na mask or a gradient lines up with the canvas however the item is moved, scaled,\nturned or flipped. Like a lock, it belongs to the item, so it takes no `scene_id`\nand a keyframe doesn't override it; a keyframe's overridden effects run in the\nitem's space. Items are added with `box`. Inverse: `item.set_effects_space` with\nthe previous value.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item to change."
            },
            "space": {
              "$ref": "#/$defs/EffectsSpace",
              "description": "Where its effects run."
            },
            "type": {
              "const": "item.set_effects_space",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id",
            "space"
          ],
          "type": "object"
        },
        {
          "description": "Changes some of an audio source's settings (ADR-0028): the fields sent change,\nthe others keep their values, and sending none is `invalid_argument`. A source\nwithout audio is `invalid_argument` on `source_id`. A `scene` source has no fader\nor mute of its own, so `gain_db` or `muted` on one is `invalid_argument`, and so\nis a gain outside −100 to +24 dB. Inverse: `source.set_audio`\nwith the previous values of the fields sent.",
          "properties": {
            "enabled": {
              "description": "Whether the engine opens the source's audio. Off keeps its sends, inactive.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "follow": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AudioFollow"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the source is heard."
            },
            "gain_db": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The fader, in dB."
            },
            "muted": {
              "description": "Whether it is muted.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source to change."
            },
            "type": {
              "const": "source.set_audio",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Adds a bus, at 0 dB, unmuted, with no sends into it. A collection holds at most\n16 buses (`MAX_BUSES`), the master included; one more is `invalid_argument`.\nInverse: `bus.delete`.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The new bus's ID, chosen by the client. Rejected if it exists, so `master` is\nalways taken."
            },
            "name": {
              "description": "Display name.",
              "type": "string"
            },
            "type": {
              "const": "bus.create",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Renames a bus, the master included. Inverse: `bus.rename` back to the previous\nname.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to rename."
            },
            "name": {
              "description": "The new display name.",
              "type": "string"
            },
            "type": {
              "const": "bus.rename",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "Changes a bus's fader or mute, the master's included: the fields sent change,\nand sending neither is `invalid_argument`, as is a gain outside −100 to +24 dB.\nInverse: `bus.set_fader` with the previous values of the fields sent.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to change."
            },
            "gain_db": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The fader, in dB, applied after the bus's sum."
            },
            "muted": {
              "description": "Whether the bus is muted.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "type": {
              "const": "bus.set_fader",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "Gives a bus a monitor, the master's included, or (with `monitor` omitted or null)\ntakes its monitor away (since 0.42). A monitor `BusMonitor::problem` refuses is\n`invalid_argument` on `monitor.<field>`; a device that isn't connected is not\nrefused. Inverse: `bus.set_monitor` with the previous monitor, or none.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to change."
            },
            "monitor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BusMonitor"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The monitor, or none."
            },
            "type": {
              "const": "bus.set_monitor",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "Deletes a bus and every send into it. The master bus can't be deleted\n(`invalid_argument`), nor (since 0.24) a bus a source's settings refer to, nor\n(since 0.59) a bus an output carries: that `invalid_argument` lists the\n`blockers`, and `delete.plan` clears them, moving such an output to the master\nbus. Inverse: `bus.create` with its name, `bus.set_fader` if\nits fader or mute were not the defaults, `bus.set_monitor` if it had a monitor\n(since 0.42), then `send.set` for each send it had.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus to delete."
            },
            "type": {
              "const": "bus.delete",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bus_id"
          ],
          "type": "object"
        },
        {
          "description": "Sends a source into a bus at a gain, post-fader, or changes that send's gain.\nThe source must be an audio source that is not a `scene` source, which has no\nsends of its own (`invalid_argument` on `source_id`), and the gain must be from\n−100 to +24 dB. Buses never feed other buses (ADR-0028), so sends can't form a\ncycle. Inverse: `send.remove` for a new send, else `send.set` with the previous\ngain.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus it sends into."
            },
            "gain_db": {
              "$ref": "#/$defs/Finite32",
              "description": "The send's gain, in dB."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source sending."
            },
            "type": {
              "const": "send.set",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "bus_id",
            "gain_db"
          ],
          "type": "object"
        },
        {
          "description": "Stops a source sending into a bus. No such send is `invalid_argument` on\n`bus_id`. Inverse: `send.set` with its gain.",
          "properties": {
            "bus_id": {
              "$ref": "#/$defs/BusId",
              "description": "The bus it sends into."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source sending."
            },
            "type": {
              "const": "send.remove",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "bus_id"
          ],
          "type": "object"
        }
      ]
    },
    "EffectsSpace": {
      "description": "Where an item's effects run (ADR-0106, since 0.76).",
      "oneOf": [
        {
          "const": "box",
          "description": "Over the item's cropped, fitted box, in its own frame, before it is placed\n(ADR-0065 §5): an effect turns, scales and flips with its item.",
          "type": "string"
        },
        {
          "const": "canvas",
          "description": "Over the canvas, after the item is placed: the item is drawn where it is on a\ntransparent canvas-sized layer, the effects run over that layer, and the layer is\ndrawn over the scene with the item's opacity and blend. A canvas-sized mask\nlines up with the canvas whatever the item's transform.",
          "type": "string"
        }
      ]
    },
    "EncoderProfile": {
      "description": "How an output's video and audio are encoded.\n\nAn output with no profile uses the engine's default, [`EncoderProfile::DEFAULT`]:\nH.264 at a constant 8000 kbit/s with a keyframe every 2 s on a hardware encoder when\nthere is one (else the software one), and AAC at 160 kbit/s. 8000 kbit/s is\nYouTube's recommended rate for 1080p at 30 fps, the default base rate. A collection\nthat opts into 60 fps (ADR-0119) spreads that same budget over twice the frames.\n2500 kbit/s, the default before, looked poor at 1080p (#1191).",
      "properties": {
        "audio": {
          "$ref": "#/$defs/AudioEncoding",
          "description": "The audio encoding."
        },
        "video": {
          "$ref": "#/$defs/VideoEncoding",
          "description": "The video encoding."
        }
      },
      "required": [
        "video",
        "audio"
      ],
      "type": "object"
    },
    "EncoderProfileId": {
      "description": "An encoder profile in the collection.",
      "type": "string"
    },
    "EncoderProfileInfo": {
      "description": "One encoder profile, as `encoder.list` and `state.get` report it.",
      "properties": {
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/EncoderProfile",
          "description": "The encoding it describes."
        },
        "profile_id": {
          "$ref": "#/$defs/EncoderProfileId",
          "description": "The profile's ID."
        }
      },
      "required": [
        "profile_id",
        "name",
        "profile"
      ],
      "type": "object"
    },
    "EncoderSessionInfo": {
      "description": "The encoder session a running output uses, as `output.status` reports it.",
      "properties": {
        "dedicated": {
          "description": "Whether the output has the session to itself by rule: an output with its own\nvideo chain never shares (ADR-0080 §2), so its picture costs one more GPU pass\nand one more encoder session. Omitted when false: an output whose video chain\nwas empty when it started.",
          "type": "boolean"
        },
        "hardware": {
          "description": "Whether the session's video encoder is a hardware one.",
          "type": "boolean"
        },
        "profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncoderProfileId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The profile the session was opened with, or absent for the engine's default.\nThe profile's settings at the time count: an output started after\n`encoder.update` gets a session of its own."
        },
        "shared_with": {
          "default": [],
          "description": "The other running outputs that share this session, ordered by ID. Empty when\nthe output has the session to itself.",
          "items": {
            "$ref": "#/$defs/OutputId"
          },
          "type": "array"
        }
      },
      "required": [
        "hardware"
      ],
      "type": "object"
    },
    "EngineLoad": {
      "description": "The engine's load at one `stats.tick` (0.48): running totals since the engine\nstarted, beside the engine time they were read at.\n\nA client computes a rate from two ticks: the program's frame rate is the change in\n`program_frames` over the change in `elapsed_ms`, and the process's CPU use is the\nchange in `cpu_ms` over the change in `elapsed_ms` times `cpus` (100% when every\nlogical CPU is busy, as Windows' Task Manager counts it).\n\nA missing field parses as 0 or `None`, so a field added later can be left out by an\nolder sender (R-API-001). Unknown fields are ignored.",
      "properties": {
        "cpu_ms": {
          "description": "CPU time the engine's process has used since it started, in milliseconds, on\nevery thread and in both user and kernel mode, or `None` where the host can't\nread it.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cpus": {
          "default": 0,
          "description": "The logical CPUs the process can run on, or 0 when unknown.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "description": "Milliseconds since the engine started, on a monotonic clock, when the totals\nwere read.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "program_frames": {
          "default": 0,
          "description": "Frames the program stage has drawn since the engine started. It grows only\nwhile the program stage runs (while an output runs), at the canvas frame rate.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "EntityKind": {
      "description": "The kinds of object an error can name.",
      "oneOf": [
        {
          "const": "scene",
          "description": "A scene.",
          "type": "string"
        },
        {
          "const": "item",
          "description": "A scene item.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "A source.",
          "type": "string"
        },
        {
          "const": "output",
          "description": "An output.",
          "type": "string"
        },
        {
          "const": "encoder",
          "description": "An encoder profile.",
          "type": "string"
        },
        {
          "const": "video_mix",
          "description": "A video mix.",
          "type": "string"
        },
        {
          "const": "filter",
          "description": "A filter in a source's chain (0.22, ADR-0026). Its ID is unique within the\nsource. Only an error answering a filter edit names it, so a client older than\n0.22, which sends none, never reads it.",
          "type": "string"
        },
        {
          "const": "transition",
          "description": "A transition preset.",
          "type": "string"
        },
        {
          "const": "folder",
          "description": "A folder of the scene list.",
          "type": "string"
        },
        {
          "const": "label",
          "description": "A label.",
          "type": "string"
        },
        {
          "const": "bus",
          "description": "An audio bus.",
          "type": "string"
        },
        {
          "const": "device",
          "description": "A paired device (0.21). Only an error answering `device.revoke` names it, so a\nclient older than 0.21, which sends none, never reads it.",
          "type": "string"
        },
        {
          "const": "hotkey",
          "description": "A hotkey binding, named by its chord.",
          "type": "string"
        },
        {
          "const": "plugin",
          "description": "An installed plugin (0.35). Only an error answering a `plugin.*` action names it,\nso a client older than 0.35, which sends none, never reads it.",
          "type": "string"
        },
        {
          "const": "pack",
          "description": "An effect pack (0.72, ADR-0097). Only an error answering a `pack.*` command names\nit, so a client older than 0.72, which sends none, never reads it.",
          "type": "string"
        },
        {
          "const": "timeline",
          "description": "A timeline a scene holds (ADR-0115). Only an error answering a `timeline.*`\ncommand, or a `hotkey.set` or `timeline.set` naming one, names it, so a client\nthat sends none never reads it.",
          "type": "string"
        },
        {
          "const": "file",
          "description": "A file on the engine's machine, named by its path (0.94, ADR-0121). Only an\nerror answering `collection.new` or `collection.save_as` names it, so a client\nthat sends neither never reads it.",
          "type": "string"
        }
      ]
    },
    "EnumOption": {
      "description": "One option of an [`ParamType::Enum`].",
      "properties": {
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "value": {
          "description": "The value stored in settings.",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "description": "A failed request, a failed handshake, or a message that couldn't be parsed.",
      "properties": {
        "error": {
          "$ref": "#/$defs/WireError",
          "description": "What went wrong."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The failed request's ID. Absent when the failure isn't tied to a request (the\nhandshake, or a message too broken to read an ID from)."
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Event": {
      "description": "Something that happened in the engine.\n\nSerialized with an internal `type` tag holding the event name (`noun.past_tense`).\nClients must ignore events they don't know: a newer server may send new ones in a\nminor version, and they parse as [`Event::Unknown`].",
      "oneOf": [
        {
          "description": "The collection state moved to a new revision: one per applied batch (or undo).\nClients holding a copy of the state re-query, or apply the change if they made it.",
          "properties": {
            "cause": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HistoryDirection"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`undo` or `redo` when a history call made the change; absent for a batch."
            },
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The new revision."
            },
            "type": {
              "const": "state.changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "An output changed state, for example after `output.start`.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "state": {
              "$ref": "#/$defs/OutputState",
              "description": "Its new state."
            },
            "type": {
              "const": "output.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "A source's size changed (ADR-0022 §4, 0.40), including when it became known (its\nfirst frame) or unknown (it stopped, failed, or was deleted). Runtime state, so it\ncarries no `rev`. The size is the one `source.sizes` reports.",
          "properties": {
            "size": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PixelSize"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Its new size. Omitted when it has no video frame now."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source."
            },
            "type": {
              "const": "source.size_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "The scene on program or on preview changed: after a `scene.switch` or a\n`studio.set_preview`, or after a batch, undo or redo deleted the scene (it gives\nway to the first remaining scene) or created the collection's first scene (it goes\non program and on preview). Studio state is runtime state (ADR-0030), so the event\ncarries no `rev`; a `state.changed` for the same edits comes first.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "preview_scene": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene now on preview. Omitted when the collection has no scene left, and\nby a server older than 0.30."
            },
            "program_scene": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene now on program. Omitted when the collection has no scene left."
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "transition": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TransitionStarted"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The transition a `scene.switch` started: the preset the engine chose and how\nlong it runs. Omitted when program did not change by a switch."
            },
            "type": {
              "const": "studio.changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "The keyframe a scene's placements draw it through changed (ADR-0116, since 0.88):\na `scene.set_keyframe` set it, or a batch, undo or redo deleted the scene or the\nkeyframe scene (`keyframe_id` omitted). Studio state, so it carries no `rev`.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "keyframe_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The keyframe scene it is now drawn through. Omitted for its own values."
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The placed scene."
            },
            "type": {
              "const": "scene.keyframe_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "A shared value changed (0.78, ADR-0102 decision 7): a `values.set` gave it a new\nvalue, or removed it. Not collection state, so it carries no `rev`.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "name": {
              "description": "The value's name.",
              "type": "string"
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "type": {
              "const": "values.changed",
              "type": "string"
            },
            "value": {
              "description": "Its new value. Omitted when it was removed."
            }
          },
          "required": [
            "type",
            "name",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "**Deprecated** (ADR-0080), removed in 1.0. JStream has no privacy\nscreen, so the engine never sends it.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "on": {
              "description": "Whether the privacy screen now covers the outputs.",
              "type": "boolean"
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "type": {
              "const": "privacy.changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "on",
            "client_id"
          ],
          "type": "object"
        },
        {
          "description": "This connection's queued events were dropped because the client read them too\nslowly: the server keeps a bounded buffer per connection and empties it when it\noverflows. `state.changed` events may be among those lost, so the client re-reads\nthe state with `state.get`, which carries `rev`. Drops that happen before the\nnotice is sent add up in that one notice. Only events are dropped: every request\nstill gets its answer. Sent by the WebSocket server, never by an in-process engine.",
          "properties": {
            "count": {
              "description": "How many events were dropped.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "events.dropped",
              "type": "string"
            }
          },
          "required": [
            "type",
            "count"
          ],
          "type": "object"
        },
        {
          "description": "A sample of the pipeline's drop counters (R-RT-004).\n\n`drops` is a running total since the engine started, not the count since the\nprevious tick. A client that misses one subtracts the last tick it did see.\n`seq` starts at 1 and increases by one per sample, so a gap means a missed tick\nand not a reset. The engine sends it when its control thread asks, about once a\nsecond once the media pipeline is running, and about once a second while it is\nidle when the host started the engine's heartbeat (0.48). Until event\nsubscriptions exist, every client receives it.",
          "properties": {
            "chains": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ChainCost"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What the scene filter chains and item effects, and the running outputs'\noutput stage (0.66), add to each frame: their offscreen layers, GPU passes and\nthe layers' texture bytes, as the current render plan schedules them\n(ADR-0065 §7; 0.54). An older engine leaves it out."
            },
            "drops": {
              "$ref": "#/$defs/DropCounts",
              "description": "Running drop totals."
            },
            "load": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EngineLoad"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The engine's load: how many frames the program drew and how much CPU time\nthe engine's process used, as running totals beside the time they were read\nat (0.48). An older engine leaves it out."
            },
            "outputs": {
              "description": "Each running output's live stats, by output ID: what it has sent and lost\nsince it started, its bitrate over the last tick and its health (0.57).\nEmpty, and left out, while no output runs or on an engine with no media\nbackends; an older engine leaves it out too.",
              "items": {
                "$ref": "#/$defs/OutputStatsInfo"
              },
              "type": "array"
            },
            "seq": {
              "description": "Monotonic sample number, starting at 1.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "stats.tick",
              "type": "string"
            }
          },
          "required": [
            "type",
            "seq",
            "drops"
          ],
          "type": "object"
        },
        {
          "description": "A gesture's live values changed (ADR-0032): the newest value of each parameter\nthat changed since the gesture's last `live.changed`, as setter edits. The engine\ncoalesces them per gesture to at most 30 a second, so a slow client gets fewer,\nnewer values, never a backlog; the last values before the gesture ends are always\nsent. Live values are runtime state: no `rev` changes.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client that holds it."
            },
            "gesture_id": {
              "$ref": "#/$defs/GestureId",
              "description": "The gesture."
            },
            "type": {
              "const": "live.changed",
              "type": "string"
            },
            "values": {
              "description": "The parameters' new values.",
              "items": {
                "$ref": "#/$defs/Edit"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "gesture_id",
            "client_id",
            "values"
          ],
          "type": "object"
        },
        {
          "description": "A gesture ended, and its parameters show their collection values again. For\n`committed`, the committing batch's `state.changed` comes first, and `rev` is the\nrevision it produced.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client that held it."
            },
            "gesture_id": {
              "$ref": "#/$defs/GestureId",
              "description": "The gesture."
            },
            "outcome": {
              "$ref": "#/$defs/LiveOutcome",
              "description": "How it ended."
            },
            "rev": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Rev"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The committing batch's revision, for `committed` only."
            },
            "type": {
              "const": "live.ended",
              "type": "string"
            }
          },
          "required": [
            "type",
            "gesture_id",
            "client_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "The engine's YouTube sign-in state changed: a sign-in started, finished or failed,\nthe user signed out, or Google stopped accepting the account's token.",
          "properties": {
            "auth": {
              "$ref": "#/$defs/YoutubeAuth",
              "description": "The new state."
            },
            "type": {
              "const": "youtube.status_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "auth"
          ],
          "type": "object"
        },
        {
          "description": "What YouTube says about the stream a running `youtube` output sends to changed\n(ADR-0058). The engine polls the stream's health while the output runs and sends\nthis when the status, the health or the issues differ from the last report, and\nonce on the first reading.",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast it sends to.",
              "type": "string"
            },
            "health": {
              "$ref": "#/$defs/StreamHealth",
              "description": "How healthy what it receives is."
            },
            "issues": {
              "description": "The problems YouTube found. Omitted when there are none.",
              "items": {
                "$ref": "#/$defs/HealthIssue"
              },
              "type": "array"
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "status": {
              "$ref": "#/$defs/StreamStatus",
              "description": "What YouTube says the stream is doing."
            },
            "stream_id": {
              "description": "The stream bound to that broadcast.",
              "type": "string"
            },
            "type": {
              "const": "youtube.health_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "broadcast_id",
            "stream_id",
            "status",
            "health"
          ],
          "type": "object"
        },
        {
          "description": "A running `youtube` output's audience (ADR-0041 §3, 0.38): sent when a reading\ndiffers from the last one, and once on the first. The engine reads it about once\na minute while the output runs, less often or not at all when the day's quota\nruns low (the `youtube.stats` query says which).",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast it sends to.",
              "type": "string"
            },
            "concurrent_viewers": {
              "description": "People watching now.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "likes": {
              "description": "Likes.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "type": {
              "const": "youtube.stats",
              "type": "string"
            },
            "views": {
              "description": "Views.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "output_id",
            "broadcast_id"
          ],
          "type": "object"
        },
        {
          "description": "The mixer's levels (ADR-0028): sent about ten times a second while the mixer runs\n(an output is running), and never while it doesn't. Runtime state: a client that\nmisses one just shows the next. Until event subscriptions exist, every client\nreceives it.",
          "properties": {
            "buses": {
              "default": [],
              "description": "Each bus, ordered by ID, the master among them.",
              "items": {
                "$ref": "#/$defs/BusMeter"
              },
              "type": "array"
            },
            "sources": {
              "default": [],
              "description": "Each audio source with a mixer channel, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceMeter"
              },
              "type": "array"
            },
            "type": {
              "const": "meters.tick",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A plugin was installed, enabled or disabled (0.35, ADR-0069). The engine disables\na plugin that runs past a limit or traps, says why, and never re-enables it by\nitself.",
          "properties": {
            "plugin_id": {
              "$ref": "#/$defs/PluginId",
              "description": "The plugin."
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PluginDisabledReason"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Why the engine disabled it. Omitted when it is enabled, or when a person\ndisabled it."
            },
            "remote_name": {
              "description": "The name the plugin's manifest gives itself: the plugin's own text, never an\ninstruction (ADR-0059). Omitted when it gives none.",
              "type": [
                "string",
                "null"
              ]
            },
            "state": {
              "$ref": "#/$defs/PluginState",
              "description": "Whether it runs."
            },
            "type": {
              "const": "plugin.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "plugin_id",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The program stage's GPU device was lost (0.61, #349): a GPU hang that the OS\nreset (Windows' TDR), a driver reset or a removed GPU. The engine opens a new\ndevice and the outputs repeat their last frame meanwhile, unless `recovering` is\n`false`. A loss is blamed on the effect-pack kinds drawn in the frames before it;\neach blamed kind is quarantined, its filters bypassed, until a person re-enables\nit (`effect.enable`). Runtime state: a client that misses it sees the quarantine\nin `kind.list`.",
          "properties": {
            "blamed": {
              "default": [],
              "description": "The effect-pack kinds drawn in the frames before the loss, ordered by ID:\nempty when none was, and the loss had another cause.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "cause": {
              "description": "What the driver or the engine said about the loss.",
              "type": "string"
            },
            "quarantined": {
              "default": [],
              "description": "The kinds this loss quarantined, ordered by ID: the blamed ones, or every kind\nof a pack blamed for a second loss in this run.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "recovering": {
              "description": "Whether the engine is opening a new device. `false` when it gave up (too many\nlosses, or nothing it could switch to): the outputs that drew on it fail.",
              "type": "boolean"
            },
            "type": {
              "const": "gpu.device_lost",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cause",
            "recovering"
          ],
          "type": "object"
        },
        {
          "description": "A timeline started, was sought, looped, ended, stopped or was removed (ADR-0115,\nsince 0.87): never once a frame. Playing is studio state, so it carries no `rev`.",
          "properties": {
            "change": {
              "$ref": "#/$defs/TimelineChange",
              "description": "What happened."
            },
            "pass": {
              "description": "Which pass it is on: 0 the first.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "playing": {
              "description": "Whether it plays now: `false` after `ended`, `stopped` and `removed`.",
              "type": "boolean"
            },
            "position_ms": {
              "description": "Where it is now, in milliseconds from its start: where it started from, where\nit looped back to, or where it stopped.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene that holds it."
            },
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline."
            },
            "type": {
              "const": "timeline.changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id",
            "scene_id",
            "change",
            "playing",
            "position_ms",
            "pass"
          ],
          "type": "object"
        },
        {
          "description": "A timeline's cue fired (ADR-0115, since 0.87), once per cue on each pass, and once\nfor each cue `timeline.seek` runs. The cue's action has its own events (a\n`scene.switch` cue's `studio.changed` follows).",
          "properties": {
            "at_ms": {
              "description": "The cue's time, in milliseconds from the timeline's start.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "cue": {
              "description": "The cue's index in the timeline's `cues`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProtocolError"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Why its action failed, as the call would have failed, such as `not_found` for\nan item deleted since the cue was written. Omitted when it succeeded."
            },
            "pass": {
              "description": "Which pass it fired on: 0 the first.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "timeline_id": {
              "$ref": "#/$defs/TimelineId",
              "description": "The timeline."
            },
            "type": {
              "const": "timeline.cue_fired",
              "type": "string"
            }
          },
          "required": [
            "type",
            "timeline_id",
            "cue",
            "pass",
            "at_ms"
          ],
          "type": "object"
        },
        {
          "description": "The engine saves the collection to another file (0.94, ADR-0121): a\n`collection.open`, `collection.new` or `collection.save_as` succeeded. After an\nopen or a new, `state.changed` and `studio.changed` come first, and the client\nreads the new collection with `state.get`.",
          "properties": {
            "cause": {
              "$ref": "#/$defs/CollectionCause",
              "description": "Which call changed it."
            },
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose request caused it."
            },
            "path": {
              "description": "The absolute path of the collection file the engine saves to now.",
              "type": "string"
            },
            "request_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "That client's request ID, so it can match the event to its own response."
            },
            "type": {
              "const": "collection.file_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "cause",
            "client_id"
          ],
          "type": "object"
        }
      ]
    },
    "EventMessage": {
      "description": "An event, as pushed to clients.",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event",
          "description": "The event."
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    "FilterChain": {
      "description": "Which of an owner's chains a filter is on. Every owner has at most these two, so the\nset is closed.",
      "oneOf": [
        {
          "const": "video",
          "description": "The video chain: `video_filter` kinds. A source has one if its kind produces\nvideo.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "The audio chain: `audio_filter` kinds, run before the source's fader\n(ADR-0028). A source has one if its kind produces audio and it is not a `scene`\nsource.",
          "type": "string"
        }
      ]
    },
    "FilterChains": {
      "description": "An owner's two chains, each first filter first.",
      "properties": {
        "audio": {
          "description": "The audio chain. Omitted when empty.",
          "items": {
            "$ref": "#/$defs/FilterInfo"
          },
          "type": "array"
        },
        "video": {
          "description": "The video chain. Omitted when empty.",
          "items": {
            "$ref": "#/$defs/FilterInfo"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "FilterId": {
      "description": "A filter in one of a source's chains. Unique within its source, not across\nsources, so a duplicated source keeps its filters' IDs (ADR-0026).",
      "type": "string"
    },
    "FilterInfo": {
      "description": "One filter, as `source.list`, `output.list` and `state.get` report it.",
      "properties": {
        "enabled": {
          "description": "Whether it runs. A disabled filter is bypassed and keeps its settings.",
          "type": "boolean"
        },
        "filter_id": {
          "$ref": "#/$defs/FilterId",
          "description": "Its ID, unique within its owner's chains."
        },
        "kind": {
          "description": "Its kind, as `kind.list` reports it.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings: every parameter of its kind. Omitted for a kind without\nparameters."
        }
      },
      "required": [
        "filter_id",
        "kind",
        "enabled"
      ],
      "type": "object"
    },
    "FilterOwner": {
      "description": "What owns a filter chain. Serialized with an internal `type` tag. Sources, the master\nstage, outputs, scenes and items own chains so far; buses may be further variants.",
      "oneOf": [
        {
          "description": "A source's chains, which apply wherever it is placed (ADR-0023).",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source."
            },
            "type": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "The master stage's chains, which apply to everything leaving JStream: every\noutput, after the bus it takes (ADR-0080 §1). Not the `master` bus, whose\nfader feeds it. Its audio chain runs once per block on each bus that feeds an\noutput, and monitoring hears the bus before it. Its video chain (since 0.60)\nruns once per frame on each mix an output draws, at the canvas size; the\nediting canvas, previews and `video.snapshot` show the mix before it. Its\nfilters can't hold a scene, source or bus reference; from 0.79 they may name a\nfile (an asset), as an output's may.",
          "properties": {
            "type": {
              "const": "master",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An output's own chains, which run after the master stage for that output only\n(ADR-0080 §2). An output with filters on its audio chain gets its own audio\nencode from its next start; edits to a chain it started with apply live. Every\noutput, the virtual camera included, has a video chain (since 0.60). A stream\nor recording with a filter on it, even a disabled one, gets its own render\npass and encoder session from its next start, which `output.status` reports as\n`dedicated`; a virtual camera, which opens no encoder session, gets its own\nrender pass (a program frame of its own) and is never reported `dedicated`.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "type": {
              "const": "output",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "A scene's filters, which run on the scene's whole composite wherever it renders\n(ADR-0065 §5, since 0.43). A video chain only: `chain: \"audio\"` is\n`invalid_argument` on `chain`. Never a keyframe scene, which shows its parent's.\nThe engine runs this chain on the scene's composite.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "An item's effects, which run on that one placement's cropped, fitted box, before\nits opacity and blend (ADR-0065 §5, since 0.43). A video chain only. Item IDs are\nunique across scenes, so no scene is named. The engine runs them over the item's\nbox, in a layer grown by their kinds' `max_outset_px`, once per frame.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item."
            },
            "type": {
              "const": "item",
              "type": "string"
            }
          },
          "required": [
            "type",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "An item's effects as a keyframe scene draws it (ADR-0088, since 0.63): the\nkeyframe's override of them, or the item's own while it has none. `scene_id` must\nname a keyframe scene whose tree holds `item_id`, else `invalid_argument` on\n`owner` (`not_found` for a missing one). A video chain only. The first edit while\nthe keyframe follows the item's own effects copies them into its override and\napplies there, and its inverse is `item.clear_override` of `effects`; later edits\nhave their usual inverses. The item's own effects never change.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item in its parent's tree."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The keyframe scene."
            },
            "type": {
              "const": "keyframe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id"
          ],
          "type": "object"
        }
      ]
    },
    "Finite32": {
      "description": "A finite `f32`. On the wire it is a plain JSON number, which must narrow to a finite\n`f32` (magnitude up to about `3.4028235e38`); anything else fails to deserialize.",
      "format": "float",
      "type": "number"
    },
    "FitMode": {
      "description": "How the cropped source fills the item's box.\n\nThe three values are the complete set. A new one is a string-enum addition.",
      "oneOf": [
        {
          "const": "stretch",
          "description": "Fill the box exactly, ignoring the source's aspect ratio.",
          "type": "string"
        },
        {
          "const": "fit",
          "description": "The largest rectangle of the source's aspect ratio that fits inside the box,\ncentred. The rest of the box stays transparent.",
          "type": "string"
        },
        {
          "const": "fill",
          "description": "The smallest rectangle of the source's aspect ratio that covers the box,\ncentred. The part outside the box is clipped by the compositor.",
          "type": "string"
        }
      ]
    },
    "FolderId": {
      "description": "A folder of the scene list (ADR-0024 §3). Folders organise only.",
      "type": "string"
    },
    "FolderInfo": {
      "description": "One folder of the scene list, as `state.get` reports it.",
      "properties": {
        "folder_id": {
          "$ref": "#/$defs/FolderId",
          "description": "The folder's ID."
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The folder it sits in. Omitted for a top-level folder."
        }
      },
      "required": [
        "folder_id",
        "name"
      ],
      "type": "object"
    },
    "FontInfo": {
      "description": "One installed font in a `font.list` result: one font file, or the first font of a\ncollection (`.ttc`), which is the one a text source draws.",
      "properties": {
        "path": {
          "description": "The font file's absolute path: an `asset` setting names it with root\n`absolute`.",
          "type": "string"
        },
        "remote_family": {
          "description": "Its family name, from the font's own name table (the typographic family when it\nhas one). Text from the font file's maker, so third-party text (ADR-0059): data\nto show, never instructions.",
          "type": "string"
        },
        "remote_style": {
          "description": "Its style within the family (`Regular`, `Bold Italic`, …), from the same table,\nso third-party text too.",
          "type": "string"
        }
      },
      "required": [
        "remote_family",
        "remote_style",
        "path"
      ],
      "type": "object"
    },
    "GestureId": {
      "description": "A live-value gesture (ADR-0032): a drag, a fader move or a live dialog. Chosen by\nthe client that opens it, and unique among that client's open gestures.",
      "type": "string"
    },
    "GestureInfo": {
      "description": "One open gesture, in a `live.list` result.",
      "properties": {
        "client_id": {
          "$ref": "#/$defs/ClientId",
          "description": "The client that opened it."
        },
        "gesture_id": {
          "$ref": "#/$defs/GestureId",
          "description": "The gesture, as its client named it."
        },
        "values": {
          "description": "The value of each parameter it holds now, as setter edits. A parameter another\ngesture took over is not among them.",
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "type": "array"
        }
      },
      "required": [
        "gesture_id",
        "client_id",
        "values"
      ],
      "type": "object"
    },
    "Glide": {
      "description": "Whether an item may pair with an item of another scene in a `move` transition.",
      "oneOf": [
        {
          "const": "auto",
          "description": "It pairs with the other scene's placement of the same source.",
          "type": "string"
        },
        {
          "const": "never",
          "description": "It never pairs: it disappears and appears with its effects instead.",
          "type": "string"
        }
      ]
    },
    "HardwarePreference": {
      "description": "Whether a video encoder runs on the GPU's encoder block. Serialized as a snake_case\nstring. Hardware encoders limit how many sessions run at once, per GPU vendor and\ndriver; the engine doesn't guess that limit, and `output.status` reports the\nhardware sessions in use.",
      "oneOf": [
        {
          "const": "prefer",
          "description": "Hardware if there is one, else software. What [`EncoderProfile::DEFAULT`] uses\n(ADR-0061: hardware first).",
          "type": "string"
        },
        {
          "const": "require",
          "description": "Hardware only: `output.start` fails when there is none.",
          "type": "string"
        },
        {
          "const": "avoid",
          "description": "Software only. What an omitted `hardware` field means.",
          "type": "string"
        }
      ]
    },
    "HealthIssue": {
      "description": "One problem YouTube found with a stream's settings (`configurationIssues`). Its text\nis YouTube's, cut to 512 characters with control characters replaced: show it as\nplain text.",
      "properties": {
        "description": {
          "description": "A longer explanation.",
          "type": "string"
        },
        "issue": {
          "description": "YouTube's name for the problem (`gopSizeLong`, `bitrateLow`, …).",
          "type": "string"
        },
        "reason": {
          "description": "A short reason.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity",
          "description": "How serious it is."
        }
      },
      "required": [
        "issue",
        "severity",
        "reason",
        "description"
      ],
      "type": "object"
    },
    "Hello": {
      "description": "The client's opening message.",
      "properties": {
        "client_name": {
          "description": "A name for the client (`jstream-cli`, `claude-desktop`), shown in the audit log.",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the client speaks."
        }
      },
      "required": [
        "protocol",
        "client_name"
      ],
      "type": "object"
    },
    "HistoryCall": {
      "description": "An undo or redo request, sent as `{\"kind\":\"history\",\"op\":{\"type\":\"history.undo\"}}`.",
      "properties": {
        "expected_rev": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rev"
            },
            {
              "type": "null"
            }
          ],
          "description": "Apply only if the state is still at this revision, else fail with `rev_conflict`.\nChecked before anything else about the history. Omitted means apply against\nwhatever is current."
        },
        "idempotency_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdempotencyKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Makes a retry safe, sharing the client's batch keys: a retried undo whose answer\nwas lost gets the original result and does not undo a second step."
        },
        "op": {
          "$ref": "#/$defs/HistoryOp",
          "description": "Which way to move through the client's history."
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "HistoryDirection": {
      "description": "A direction through a client's history: the `cause` of a `state.changed` that an\nundo or redo produced, and the `direction` of a `history_empty` error.",
      "oneOf": [
        {
          "const": "undo",
          "description": "Backward: an undo.",
          "type": "string"
        },
        {
          "const": "redo",
          "description": "Forward again: a redo.",
          "type": "string"
        }
      ]
    },
    "HistoryOp": {
      "description": "What a [`HistoryCall`] asks for. Serialized with an internal `type` tag holding the\ncall's name (`history.undo`).",
      "oneOf": [
        {
          "description": "Undoes the client's most recent step that is not undone yet: applies its inverse\nand moves it to the redo stack. Fails with `history_empty` when there is none, and\nwith `undo_conflict` when another client has since changed what the step touched.",
          "properties": {
            "type": {
              "const": "history.undo",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Applies the client's most recently undone step again and moves it back to the\nundo stack. The client's next batch clears what can be redone.",
          "properties": {
            "type": {
              "const": "history.redo",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "HotkeyBinding": {
      "description": "One hotkey binding, as `state.get`, `delete.plan` and a batch result report it.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "The action request the chord runs, as `hotkey.set` bound it. A client sends it as\nan `action` call when the chord is pressed. Read as plain JSON, so a client older\nthan an action type still reads the collection: it keeps the binding and can't\nrun it. [`HotkeyBinding::action`] parses it."
        },
        "chord": {
          "$ref": "#/$defs/Chord",
          "description": "The chord."
        }
      },
      "required": [
        "chord",
        "action"
      ],
      "type": "object"
    },
    "IdempotencyKey": {
      "description": "Makes a retried batch safe: the engine applies a batch with a given key at most\nonce per client and answers a retry with the original result.",
      "type": "string"
    },
    "IssueSeverity": {
      "description": "How serious a [`HealthIssue`] is. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "info",
          "description": "For information.",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Worth fixing.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Hurts the stream.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "ItemEasing": {
      "description": "An item's own easing: one of the curves, or the preset's.",
      "oneOf": [
        {
          "const": "inherit",
          "description": "The preset's easing.",
          "type": "string"
        },
        {
          "const": "ease_in_out",
          "description": "[`Easing::EaseInOut`].",
          "type": "string"
        },
        {
          "const": "ease_out",
          "description": "[`Easing::EaseOut`].",
          "type": "string"
        },
        {
          "const": "linear",
          "description": "[`Easing::Linear`].",
          "type": "string"
        },
        {
          "const": "spring",
          "description": "[`Easing::Spring`].",
          "type": "string"
        }
      ]
    },
    "ItemGeometry": {
      "description": "Where a scene item sits on the canvas: its box, the fit of the source inside that\nbox, and the 3D placement ADR-0022 defines.\n\n`center`, `size` and `rotation_deg` alone define the box, so selection handles need\nno source size. The 3D fields default to neutral (no tilt, turn or depth, and no\nperspective). From protocol 0.34 the engine accepts and draws any 3D it can draw\n([`Self::drawn_polygon`], [`Self::check_drawable`], ADR-0050); earlier minors\nrejected a non-neutral value, and [`Self::is_neutral_3d`] was that check. A negative\n`size` is rejected, not read as a flip: [`Self::flip_h`] and [`Self::flip_v`] mirror\nthe content instead, the additive booleans ADR-0022 reserved.\n\nEvery number is a [`Finite32`]. On the wire, omitted `fit_mode` and angles mean the\ndefaults below, omitted `perspective_px` means orthographic, and omitted flips mean\n`false`. A flip that is `false` is not written.",
      "properties": {
        "center": {
          "$ref": "#/$defs/Vec2",
          "description": "Centre of the box, in canvas pixels."
        },
        "depth_px": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Offset along the viewing axis, in pixels. Positive is toward the viewer.\nDefault 0."
        },
        "fit_mode": {
          "$ref": "#/$defs/FitMode",
          "default": "fit",
          "description": "How the cropped source fills the box. Default [`FitMode::Fit`]."
        },
        "flip_h": {
          "description": "Mirror the content left to right, about the box's vertical centre line in its\nlocal frame, after crop and fit and before rotation. The box itself does not\nchange. Default `false`.",
          "type": "boolean"
        },
        "flip_v": {
          "description": "Mirror the content top to bottom, about the box's horizontal centre line in its\nlocal frame, after crop and fit and before rotation. Default `false`.",
          "type": "boolean"
        },
        "perspective_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distance from the viewer to the canvas plane, for this item only. Absent means\northographic. When present it must be greater than zero."
        },
        "rotation_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Clockwise rotation in the canvas plane, in degrees, about [`Self::center`].\nDefault 0."
        },
        "size": {
          "$ref": "#/$defs/Size",
          "description": "Width and height of the box, in canvas pixels. Each must be greater than zero."
        },
        "tilt_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Rotation about the box's horizontal axis through the centre, in degrees.\nPositive moves the top edge away from the viewer. Default 0."
        },
        "turn_deg": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Rotation about the box's vertical axis through the centre, in degrees.\nPositive moves the right edge away from the viewer. Default 0."
        }
      },
      "required": [
        "center",
        "size"
      ],
      "type": "object"
    },
    "ItemId": {
      "description": "A scene item: one placement of a source inside a scene. Unique across scenes.",
      "type": "string"
    },
    "ItemInfo": {
      "description": "One item, a placement of a source in a scene, as `item.list` and `state.get` report\nit. It carries every property an edit can set.",
      "properties": {
        "blend": {
          "$ref": "#/$defs/BlendMode",
          "default": "normal",
          "description": "How it composites onto what is below it. Missing parses as `normal`."
        },
        "crop": {
          "$ref": "#/$defs/Crop",
          "description": "How much of the source it cuts off."
        },
        "effects": {
          "description": "Its effects (ADR-0065, since 0.43): a video chain, first filter first, which\n`filter.*` edits with the owner `{\"type\":\"item\",\"item_id\":…}`. They run on this\nplacement's cropped, fitted box, before its opacity and blend. Omitted while\nempty, so missing (also from an older server) parses as none.",
          "items": {
            "$ref": "#/$defs/FilterInfo"
          },
          "type": "array"
        },
        "effects_space": {
          "$ref": "#/$defs/EffectsSpace",
          "description": "Where its effects run (ADR-0106, since 0.76): see\n[`Edit::ItemSetEffectsSpace`](crate::Edit::ItemSetEffectsSpace). Omitted while\n`box`, so missing (also from an older server) parses as `box`."
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemGeometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stored geometry. Absent for a legacy item, whose box depends on the source's\nruntime size."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "The item's ID."
        },
        "locked": {
          "description": "Whether its canvas box is locked (ADR-0096, since 0.71): see\n[`Edit::ItemSetLocked`](crate::Edit::ItemSetLocked). Omitted while unlocked, so\nmissing (also from an older server) parses as unlocked.",
          "type": "boolean"
        },
        "motion": {
          "description": "Its motion modifiers (ADR-0099, since 0.81), first first, which move it on the\nengine's animation clock as each frame is drawn: see [`MotionModifier`]. Written\nwhole by `item.set_motion`. Omitted while empty, so missing (also from an older\nserver) parses as none.",
          "items": {
            "$ref": "#/$defs/MotionModifier"
          },
          "type": "array"
        },
        "opacity": {
          "$ref": "#/$defs/Finite32",
          "default": 1.0,
          "description": "Its opacity, from 0 to `MAX_OPACITY` (4): up to 1 an alpha multiplier, and above 1\n(since 0.83, #1101) a gain on its light, as `item.set_opacity` sets it. Missing\n(from a server older than this field) parses as 1."
        },
        "placement": {
          "$ref": "#/$defs/PlacementForm",
          "default": "legacy",
          "description": "Which form its placement is stored in. Missing (from a server older than 0.11)\nparses as `legacy`."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source it places."
        },
        "transform": {
          "$ref": "#/$defs/ItemTransform",
          "description": "**Deprecated** since 0.11 (ADR-0022), removed in 1.0: read `geometry`. For a\nlegacy item, the stored transform exactly as written. For a geometry item, a\nview computed from the geometry alone: the box's rotated top-left corner, its\nrotation, and scale (1, 1)."
        },
        "transition": {
          "$ref": "#/$defs/ItemTransition",
          "description": "Its transition settings (ADR-0029 §6). Omitted while they are the defaults it\nwas added with."
        },
        "visible": {
          "description": "Whether it is drawn.",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "source_id",
        "transform",
        "crop",
        "visible"
      ],
      "type": "object"
    },
    "ItemOverride": {
      "description": "What a keyframe scene overrides for one item in its parent's tree, as `state.get`\nreports it. An omitted field follows the parent. At least one field is set: an item with no\noverride has no entry.",
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/Crop"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden crop."
        },
        "effects": {
          "description": "The overridden effects, first first, which the keyframe draws in place of the\nitem's own (since 0.63, ADR-0088). An empty list is an override too: no effects\nthere.",
          "items": {
            "$ref": "#/$defs/FilterInfo"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemGeometry"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden geometry, as `item.set_geometry` wrote it."
        },
        "item_id": {
          "$ref": "#/$defs/ItemId",
          "description": "The parent's item."
        },
        "motion": {
          "description": "The overridden motion modifiers, which the keyframe moves the item with in place\nof the item's own (since 0.81, ADR-0099). An empty list is an override too: no\nmotion there. A Move between two members of a family blends both sides'.",
          "items": {
            "$ref": "#/$defs/MotionModifier"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden opacity, from 0 to [`MAX_OPACITY`](crate::MAX_OPACITY)."
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemTransform"
            },
            {
              "type": "null"
            }
          ],
          "description": "The overridden geometry in the deprecated 0.3 form, as `item.set_transform` wrote\nit. Never set together with `geometry`: both are the one `geometry` field."
        },
        "visible": {
          "description": "The overridden visibility.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "item_id"
      ],
      "type": "object"
    },
    "ItemTransform": {
      "description": "A protocol 0.3 placement: where a scene item sits until it is stored as\n[`ItemGeometry`](crate::ItemGeometry).\n\n**Deprecated** since 0.11 (ADR-0022) and removed in 1.0, with `item.set_transform`,\n`item.add`'s `transform` and `ItemInfo.transform`. Until then it keeps the meaning\nbelow.\n\n`position` is the top-left corner in canvas pixels, `scale` is relative to the\nsource's current size, and `rotation_deg` turns clockwise about that corner.\nADR-0022 (`docs/adr/0022-item-transform-and-canvas.md`) does not extend this struct\nwith 3D fields. The replacement is [`ItemGeometry`](crate::ItemGeometry): a box,\nrotation about its centre, and a fit mode. Until 1.0 a legacy placement keeps this\nmeaning, and [`legacy_quad`](crate::legacy_quad) evaluates it. Crop is [`Crop`],\napplied before the transform.\n\nEvery number is a [`Finite32`], so a non-finite or out-of-range number is rejected at\ndeserialization as `malformed`.",
      "properties": {
        "position": {
          "$ref": "#/$defs/Vec2",
          "description": "Top-left corner, in pixels of the scene's canvas."
        },
        "rotation_deg": {
          "$ref": "#/$defs/Finite32",
          "description": "Clockwise rotation, in degrees."
        },
        "scale": {
          "$ref": "#/$defs/Vec2",
          "description": "Scale factors; 1.0 is the source's native size."
        }
      },
      "required": [
        "position",
        "scale",
        "rotation_deg"
      ],
      "type": "object"
    },
    "ItemTransition": {
      "description": "An item's transition settings ([ADR-0029](../../../docs/adr/0029-transitions.md) §6).\nThey belong to the placement, keyed by item ID. Items are added with the default:\nno delay, and the preset's easing and effects.",
      "properties": {
        "appear": {
          "$ref": "#/$defs/TransitionEffect",
          "default": "inherit",
          "description": "How it appears when it has no partner."
        },
        "delay_ms": {
          "default": 0,
          "description": "Milliseconds before the item starts moving. An item of the scene being switched\nto also waits the preset's `stagger_ms` × its stacking index; a leaving item\nwaits only its own delay (ADR-0052). At most 60000.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "disappear": {
          "$ref": "#/$defs/TransitionEffect",
          "default": "inherit",
          "description": "How it disappears when it has no partner."
        },
        "easing": {
          "$ref": "#/$defs/ItemEasing",
          "default": "inherit",
          "description": "Its easing, or the preset's."
        },
        "glide": {
          "$ref": "#/$defs/Glide",
          "default": "auto",
          "description": "Whether it may pair in a `move` transition."
        }
      },
      "type": "object"
    },
    "KindCategory": {
      "description": "What a kind is: a source kind, or a filter kind for video or audio.",
      "oneOf": [
        {
          "const": "source",
          "description": "A source kind (`source.create` with `builtin { kind }`).",
          "type": "string"
        },
        {
          "const": "video_filter",
          "description": "A video filter kind.",
          "type": "string"
        },
        {
          "const": "audio_filter",
          "description": "An audio filter kind.",
          "type": "string"
        },
        {
          "const": "transition",
          "description": "A transition kind, which a transition preset names (ADR-0037).",
          "type": "string"
        }
      ]
    },
    "KindDescriptor": {
      "description": "Everything a client needs to show and edit one kind's settings.",
      "properties": {
        "audio": {
          "description": "Whether the kind produces audio.",
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/KindCategory",
          "description": "What the kind is."
        },
        "kind_id": {
          "description": "The kind's ID, as in [`KindSummary::kind_id`].",
          "type": "string"
        },
        "max_outset_px": {
          "description": "For a `video_filter` kind that draws outside its input (a drop shadow, a glow, an\noutline): the most it can draw beyond each edge, in pixels, at any settings\n(ADR-0065 §5, since 0.43). An item's effects layer is padded by the sum over its\nenabled effects, so a live edit never resizes it. On a source's or a scene's chain\nit is ignored, since the output there is the input's size. Omitted for none,\nand for every other category.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "params": {
          "description": "The parameters, in display order. Their IDs are unique within the kind.",
          "items": {
            "$ref": "#/$defs/ParamDescriptor"
          },
          "type": "array"
        },
        "version": {
          "description": "The descriptor's version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "video": {
          "description": "Whether the kind produces video.",
          "type": "boolean"
        }
      },
      "required": [
        "kind_id",
        "category",
        "name",
        "version",
        "video",
        "audio",
        "params"
      ],
      "type": "object"
    },
    "KindSummary": {
      "description": "One kind in a `kind.list` result.",
      "properties": {
        "category": {
          "$ref": "#/$defs/KindCategory",
          "description": "What the kind is."
        },
        "kind_id": {
          "description": "The kind's ID: a bare name for a built-in kind (`image`), `<pack>/<effect>` for a\npack kind.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "quarantined": {
          "description": "An effect-pack kind the engine quarantined after a GPU device loss was blamed on\nit (0.61, `gpu.device_lost`): its filters are bypassed until a person re-enables\nit (`effect.enable`). Omitted when `false`.",
          "type": "boolean"
        },
        "version": {
          "description": "The descriptor's version. Stored settings record the version they were written\nwith.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind_id",
        "category",
        "name",
        "version"
      ],
      "type": "object"
    },
    "LabelId": {
      "description": "A label that sources carry (ADR-0024 §4).",
      "type": "string"
    },
    "LabelInfo": {
      "description": "One label, as `state.get` reports it.",
      "properties": {
        "color": {
          "description": "Its colour, sRGB as `#rrggbb`.",
          "type": "string"
        },
        "icon": {
          "description": "An icon name from the UI's icon set. The engine stores it and checks only its\nlength. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "label_id": {
          "$ref": "#/$defs/LabelId",
          "description": "The label's ID."
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        }
      },
      "required": [
        "label_id",
        "name",
        "color"
      ],
      "type": "object"
    },
    "LiveOutcome": {
      "description": "How a gesture ended, in `live.ended`.",
      "oneOf": [
        {
          "const": "committed",
          "description": "A batch with `ends_gesture` applied; its `rev` is in the event.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Its client sent `live.cancel`.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Its client's session ended.",
          "type": "string"
        }
      ]
    },
    "Loudness": {
      "description": "BS.1770 loudness, in LUFS. Each value is absent until enough audio has been measured\nfor it, and while the signal is below the absolute gate (−70 LUFS).",
      "properties": {
        "integrated": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Gated integrated loudness since the mixer started or the last\n`audio.reset_loudness`."
        },
        "momentary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Momentary loudness, over the last 400 ms."
        },
        "short_term": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finite32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Short-term loudness, over the last 3 s."
        }
      },
      "type": "object"
    },
    "MasterInfo": {
      "description": "The master stage, as `state.get` reports it: what applies to everything leaving\nJStream (ADR-0080 §1).",
      "properties": {
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its chains, which `filter.*` edits with the owner `{\"type\":\"master\"}`. Both hold\nfilters (the video chain since 0.60). Omitted while both are empty."
        }
      },
      "type": "object"
    },
    "Media": {
      "description": "What a source produces, for restricting a source reference.",
      "oneOf": [
        {
          "const": "video",
          "description": "Pictures.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "Sound.",
          "type": "string"
        }
      ]
    },
    "MixInput": {
      "description": "What a mix shows. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "The scene on program (ADR-0030): it follows `scene.switch`.",
          "properties": {
            "type": {
              "const": "program",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The scene on preview. No mix draws studio mode's preview scene yet, so a\n`preview` mix shows the program.",
          "properties": {
            "type": {
              "const": "preview",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One scene, whatever is on program. `scene.delete` is refused while a mix shows\nthe scene.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene shown."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        }
      ]
    },
    "MixResolution": {
      "description": "The size of a mix's frames, in pixels.",
      "properties": {
        "height": {
          "description": "Height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "MixerProfile": {
      "description": "The audio mixer and its inputs in the window ([`ProfileInfo::mixer`]). Every count is\nin engine sample frames (48 000 a second) or mixer blocks.",
      "properties": {
        "block_max_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The longest mix of a block, in milliseconds."
        },
        "block_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The length of a block, in milliseconds: what a mix must stay under."
        },
        "blocks": {
          "default": 0,
          "description": "The blocks the mixer mixed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dropped_frames": {
          "default": 0,
          "description": "Frames the inputs dropped: arrived after the mixer had passed them, or\noverwritten before it read them.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "late_blocks": {
          "default": 0,
          "description": "The blocks whose mix took longer than the audio they hold: the mixer can't keep\nup with the clock while this grows.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "skipped_frames": {
          "default": 0,
          "description": "Frames the mixer skipped because it fell more than half its ring behind the clock.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "underrun_frames": {
          "default": 0,
          "description": "Frames the inputs had no audio for when the mixer read them, played as silence:\na device or source that delivers late or not at all.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MonitorTap": {
      "description": "Where a bus's monitor listens (ADR-0028, D22). Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "pre_filters",
          "description": "The bus's sum before its filters, through its fader and mute: \"before FX\".",
          "type": "string"
        },
        {
          "const": "post_filters",
          "description": "The bus after its filters, fader and mute: \"after FX\", what the bus feeds.",
          "type": "string"
        }
      ]
    },
    "MotionClock": {
      "description": "Where a modifier's time starts.",
      "oneOf": [
        {
          "const": "engine",
          "description": "The engine's animation time: every item with the same parameters moves in step.",
          "type": "string"
        },
        {
          "const": "shown",
          "description": "From when the engine last started drawing the item for program or a video mix,\nso it starts fresh each time it is shown. While it isn't shown, and in a scene\nor source preview, the modifier is at its start.",
          "type": "string"
        },
        {
          "const": "triggered",
          "description": "From when `item.trigger_motion` last fired it, since 0.84 (#1107). Until it is\nfired, and in a scene or source preview, the modifier contributes nothing.",
          "type": "string"
        }
      ]
    },
    "MotionCurve": {
      "description": "How an `audio` modifier bends its 0 to 1 envelope before mapping it onto its range.\nNone overshoots (since 0.86).",
      "oneOf": [
        {
          "const": "linear",
          "description": "As it is.",
          "type": "string"
        },
        {
          "const": "ease_in",
          "description": "Cubic, slow at first: quiet passages stay low and only loud ones lift.",
          "type": "string"
        },
        {
          "const": "ease_out",
          "description": "Cubic, fast at first: quiet passages already show.",
          "type": "string"
        },
        {
          "const": "ease_in_out",
          "description": "Cubic at both ends.",
          "type": "string"
        }
      ]
    },
    "MotionMeasure": {
      "description": "What an `audio` modifier measures of what it hears (since 0.86).",
      "oneOf": [
        {
          "const": "level",
          "description": "The RMS level of the latest window.",
          "type": "string"
        },
        {
          "const": "peak",
          "description": "The peak absolute sample of the latest window.",
          "type": "string"
        },
        {
          "const": "onset",
          "description": "A jump of the level above its recent average: 1 on the jump, else 0.",
          "type": "string"
        },
        {
          "const": "band",
          "description": "The spectrum between `low_hz` and `high_hz`, as an amplitude: a full-scale sine\ninside the band reads 0 dBFS.",
          "type": "string"
        }
      ]
    },
    "MotionModifier": {
      "description": "One motion modifier on an item (ADR-0099 decision 3).",
      "oneOf": [
        {
          "description": "Smooth seeded noise within `-amplitude..=amplitude`. The same seed gives the same\nmotion on every machine; each extra octave adds detail at twice the frequency and\nhalf the size.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "The largest value it reaches, `0..=100000`."
            },
            "frequency_hz": {
              "$ref": "#/$defs/Finite32",
              "description": "About how many turns of direction a second, `0..=60` and not 0."
            },
            "kind": {
              "const": "wiggle",
              "type": "string"
            },
            "octaves": {
              "default": 1,
              "description": "How many octaves, `1..=4`. Default 1.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "seed": {
              "default": 0,
              "description": "Picks the noise. Default 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "amplitude",
            "frequency_hz"
          ],
          "type": "object"
        },
        {
          "description": "A periodic wave within `-amplitude..=amplitude`.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "The largest value it reaches, `0..=100000`."
            },
            "kind": {
              "const": "oscillate",
              "type": "string"
            },
            "period_ms": {
              "description": "One period, in milliseconds, `1..=3600000`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "phase": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "Its offset into the period, as a fraction in `0..1`. Default 0."
            },
            "shape": {
              "$ref": "#/$defs/MotionShape",
              "default": "sine",
              "description": "Its waveform. Default `sine`."
            }
          },
          "required": [
            "kind",
            "amplitude",
            "period_ms"
          ],
          "type": "object"
        },
        {
          "description": "A constant rate per second, of either sign, wrapping into `0..wrap` when `wrap`\nis set.",
          "properties": {
            "kind": {
              "const": "drift",
              "type": "string"
            },
            "rate_per_s": {
              "$ref": "#/$defs/Finite32",
              "description": "Units per second, within `-100000..=100000`."
            },
            "wrap": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where it wraps back to 0, `0..=100000` and not 0. Omitted for no wrap."
            }
          },
          "required": [
            "kind",
            "rate_per_s"
          ],
          "type": "object"
        },
        {
          "description": "Follows a measure of a bus or a source (ADR-0100, since 0.86): the measure in dBFS from\n`floor_db` to `ceiling_db` is mapped onto 0 to 1 (an onset as it is), followed with\n`attack_ms` and `release_ms`, bent by `curve`, and mapped onto `from..to`. Silence\nis `from`. It hears what a `spectrum` source with the same `audio` and\n`audio_source` would draw, and silence while that is silent.",
          "properties": {
            "attack_ms": {
              "default": 10,
              "description": "How fast it rises, in milliseconds, `0..=10000`. Default 10.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "audio": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BusId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The bus it hears, after its fader. Omitted for the program mix: the master\nafter its filters, as the outputs hear it."
            },
            "audio_source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A source to hear instead of the bus: that source after its own filters,\nfader, mute and follow. Omitted to hear the bus."
            },
            "ceiling_db": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "The level, in dBFS, that maps to 1: above `floor_db` and at most 0. Default 0."
            },
            "curve": {
              "$ref": "#/$defs/MotionCurve",
              "default": "linear",
              "description": "How the envelope is bent. Default `linear`."
            },
            "floor_db": {
              "$ref": "#/$defs/Finite32",
              "default": -60.0,
              "description": "The level, in dBFS, that maps to 0: at least -90 and below `ceiling_db`.\nDefault -60."
            },
            "from": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "Its value at silence, in the property's unit, within `-100000..=100000`.\nDefault 0."
            },
            "high_hz": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A `band` measure's highest frequency, in hertz, above `low_hz` and at most\n20000. Only with `band`."
            },
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "low_hz": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finite32"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A `band` measure's lowest frequency, in hertz, `20..=20000`. Only with `band`."
            },
            "measure": {
              "$ref": "#/$defs/MotionMeasure",
              "default": "level",
              "description": "What it measures. Default `level`."
            },
            "release_ms": {
              "default": 250,
              "description": "How fast it falls, in milliseconds, `0..=10000`. Default 250.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "to": {
              "$ref": "#/$defs/Finite32",
              "default": 1.0,
              "description": "Its value at the ceiling, within `-100000..=100000`; below `from` to invert.\nDefault 1."
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A one-shot decaying shake, since 0.84 (#1107):\n`amplitude · e^(−decay_per_s·t) · sin(2π·frequency_hz·t)` for `t` seconds from\nthe start of its clock, until `duration_ms`, and 0 after. Usually on the\n`triggered` clock, so `item.trigger_motion` (a hotkey, say) fires it.",
          "properties": {
            "amplitude": {
              "$ref": "#/$defs/Finite32",
              "description": "Its size at the start, `0..=100000`."
            },
            "decay_per_s": {
              "$ref": "#/$defs/Finite32",
              "default": 0.0,
              "description": "How fast it dies away, per second, `0..=1000`: 0 keeps its size to the end.\nDefault 0."
            },
            "duration_ms": {
              "description": "How long it lasts, in milliseconds, `1..=3600000`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "frequency_hz": {
              "$ref": "#/$defs/Finite32",
              "description": "How many times a second it swings, `0..=60` and not 0."
            },
            "kind": {
              "const": "impulse",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amplitude",
            "frequency_hz",
            "duration_ms"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "clock": {
          "$ref": "#/$defs/MotionClock",
          "default": "engine",
          "description": "Where its time starts. Default `engine`."
        },
        "enabled": {
          "description": "Whether it applies. Default `true`; omitted when `true`.",
          "type": "boolean"
        },
        "modifier_id": {
          "description": "Its ID, unique in the item's list: 1 to [`MAX_MOTION_ID_LEN`] bytes of ASCII\nletters, digits, `_` and `-`.",
          "type": "string"
        },
        "property": {
          "$ref": "#/$defs/MotionProperty",
          "description": "What it changes."
        }
      },
      "required": [
        "modifier_id",
        "property"
      ],
      "type": "object"
    },
    "MotionProperty": {
      "description": "The property a motion modifier changes.",
      "oneOf": [
        {
          "const": "x",
          "description": "Horizontal position of the box's centre, in canvas pixels: added.",
          "type": "string"
        },
        {
          "const": "y",
          "description": "Vertical position of the box's centre, in canvas pixels: added.",
          "type": "string"
        },
        {
          "const": "scale",
          "description": "The box's size about its centre: multiplied by `1 + value`.",
          "type": "string"
        },
        {
          "const": "rotation",
          "description": "Rotation in the canvas plane, in degrees: added.",
          "type": "string"
        },
        {
          "const": "tilt",
          "description": "3D tilt (`tilt_deg`), in degrees: added.",
          "type": "string"
        },
        {
          "const": "turn",
          "description": "3D turn (`turn_deg`), in degrees: added.",
          "type": "string"
        },
        {
          "const": "depth",
          "description": "3D offset along the viewing axis (`depth_px`), in pixels toward the viewer:\nadded.",
          "type": "string"
        },
        {
          "const": "opacity",
          "description": "Opacity: multiplied by `1 + value`, then clamped to `0..=1`.",
          "type": "string"
        },
        {
          "const": "crop_left",
          "description": "Source pixels cut from the left edge: added, never below 0.",
          "type": "string"
        },
        {
          "const": "crop_top",
          "description": "Source pixels cut from the top edge: added, never below 0.",
          "type": "string"
        },
        {
          "const": "crop_right",
          "description": "Source pixels cut from the right edge: added, never below 0.",
          "type": "string"
        },
        {
          "const": "crop_bottom",
          "description": "Source pixels cut from the bottom edge: added, never below 0.",
          "type": "string"
        }
      ]
    },
    "MotionShape": {
      "description": "The waveform of an `oscillate` modifier.",
      "oneOf": [
        {
          "const": "sine",
          "description": "A sine: starts at 0, rising.",
          "type": "string"
        },
        {
          "const": "triangle",
          "description": "A triangle: starts at 0, rising, straight between -1 and 1.",
          "type": "string"
        },
        {
          "const": "square",
          "description": "A square: 1 for the first half of each period, -1 for the second.",
          "type": "string"
        },
        {
          "const": "saw",
          "description": "A sawtooth: rises from -1 to 1 over each period, then jumps back.",
          "type": "string"
        }
      ]
    },
    "OutputHealth": {
      "description": "How a running output is doing, from its own drops and link over the last ten\nseconds: the share of its video frames lost there, and whether its live link is up.\nSerialized as a snake_case string.",
      "oneOf": [
        {
          "const": "waiting",
          "description": "It hasn't sent a video frame yet: it is connecting, or its encoder is starting.",
          "type": "string"
        },
        {
          "const": "good",
          "description": "Nothing lost in the last ten seconds.",
          "type": "string"
        },
        {
          "const": "fair",
          "description": "Something lost in the last ten seconds, but under 2% of its video frames.",
          "type": "string"
        },
        {
          "const": "poor",
          "description": "2% or more of its video frames lost in the last ten seconds, or its live link is\ndown and reconnecting.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from a newer server.",
          "type": "string"
        }
      ]
    },
    "OutputId": {
      "description": "An output (RTMP(S), recording, virtual camera).",
      "type": "string"
    },
    "OutputInfo": {
      "description": "One output, as `output.list` and `state.get` report it: its collection state.\nWhether it runs, and whether its stream key is set, are in `output.status`.",
      "properties": {
        "audio_buses": {
          "description": "The buses whose audio it carries (`output.set_audio_buses`, since 0.59), one per\naudio track, in track order: for now always one, as every output writes one\naudio track. The master stage's audio chain runs on each of them before the\noutput's own chain (ADR-0080 §1). Absent means `[\"master\"]`, as from a server\nolder than 0.59; a virtual camera, which has no audio, always reports that.",
          "items": {
            "$ref": "#/$defs/BusId"
          },
          "type": "array"
        },
        "encoder_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/EncoderProfileId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The encoder profile it uses (`output.set_encoder`). Absent means the engine's\ndefault, as from a server older than 0.13."
        },
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its own chains, which `filter.*` edits with the owner\n`{\"type\":\"output\",\"output_id\":…}` and which run after the master stage\n(ADR-0080 §2). Both hold filters (the video chain since 0.60); a virtual camera,\nwhich has no audio, has a video chain only. Omitted while both are empty."
        },
        "kind": {
          "$ref": "#/$defs/OutputKind",
          "description": "What it is and where it sends."
        },
        "output_id": {
          "$ref": "#/$defs/OutputId",
          "description": "The output's ID."
        },
        "video_mix": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoMixId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The video mix it shows (`output.set_video_mix`). Absent means none: the program\nat the engine's canvas size and base rate, as from a server older than 0.28."
        }
      },
      "required": [
        "output_id",
        "kind"
      ],
      "type": "object"
    },
    "OutputKind": {
      "description": "What an output is and where it sends. Serialized with an internal `type` tag.\n\nRTMP(S) to a generic URL or a YouTube broadcast, recording to a file and the\nvirtual camera are configurable so far.",
      "oneOf": [
        {
          "description": "A stream sent over RTMP or RTMPS.",
          "properties": {
            "target": {
              "$ref": "#/$defs/RtmpTarget",
              "description": "The ingest server it publishes to."
            },
            "type": {
              "const": "rtmp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "A recording to a file on the engine's machine.",
          "properties": {
            "container": {
              "$ref": "#/$defs/RecordContainer",
              "description": "The file format."
            },
            "path": {
              "description": "Where the finished recording goes: an absolute path on the engine's\nmachine, ending in a file name. While recording, the file is written as\n`<path>.part` and renamed to `path` when the output stops. A recording never\noverwrites: `output.start` fails with `action_failed` when `path` or its\n`.part` name exists; `output.set_path` (since 0.74) points it at a new file.\nThe engine rejects, with `invalid_argument`, an empty or relative path\n(absolute is `/…`, `\\…`, `C:\\…` or `C:/…`), one that starts with two\nseparators (a Windows UNC or device path, `\\\\host\\share\\…`, `\\\\.\\…` or\n`\\\\?\\…`), one with `:` other than a drive letter's, `?`, `*`,\ncontrol characters or a `..` segment, one that ends in a separator or names\nno file, and one whose file name is a DOS device name, in any case and with\nor without an extension (`NUL`, `nul.mp4`, `CON`, `PRN`, `AUX`, `COM1`,\n`LPT1`, …), which Windows opens in place of a file. `output.start` also fails\nwhen the path is not absolute on the engine's own machine.",
              "type": "string"
            },
            "type": {
              "const": "record",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path",
            "container"
          ],
          "type": "object"
        },
        {
          "description": "The virtual camera: the program video, offered to other apps on the engine's\nmachine as a webcam. Video only: it has no audio, no target and no stream key.\nIt runs at the canvas size the collection has when it starts, at 30 fps.\n`output.start` fails with `action_failed` when the engine has no virtual camera,\nwhen the camera is not registered on the machine, or when it can't offer that\nsize (the Windows camera offers only 1920×1080, the default canvas).",
          "properties": {
            "type": {
              "const": "virtual_cam",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "OutputState": {
      "description": "The lifecycle state of an output.",
      "oneOf": [
        {
          "const": "stopped",
          "description": "Not running.",
          "type": "string"
        },
        {
          "const": "starting",
          "description": "Started and connecting or initializing.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Running: streaming, recording or feeding the virtual camera.",
          "type": "string"
        },
        {
          "const": "reconnecting",
          "description": "Lost its connection and is retrying.",
          "type": "string"
        },
        {
          "const": "stopping",
          "description": "Stopping: flushing and disconnecting.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Stopped because of an error. The error is in the audit log.",
          "type": "string"
        }
      ]
    },
    "OutputStatsInfo": {
      "description": "One running output's live stats in a `stats.tick` (0.57): what it has sent and lost\nsince its `output.start`, its bitrate and its health.\n\nThe counts are running totals for this run of the output: they start at 0 on each\n`output.start`, and a client that misses a tick subtracts the last one it did see.\n`kbps` and `health` are gauges the engine works out from its own previous samples, so\nthey don't depend on the client seeing every tick.\n\nEvery field but `output_id` may be missing and parses as 0 (or `waiting`), so a\nfield added later can be left out by an older sender (R-API-001). Unknown fields are\nignored.",
      "properties": {
        "bytes": {
          "default": 0,
          "description": "Encoded bytes, video and audio, the output has handed to its muxer this run,\nleft out while its live link is down: the publish target drops what it is handed\nthen, and counts it in `dropped_packets`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dropped_frames": {
          "default": 0,
          "description": "Video frames the output lost this run: frames its video encoder dropped (its\ninput queue was full or it was busy), and encoded frames dropped on their way to\nthis output because it fell behind. An encoder session that two outputs share\ncounts its drops for each.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dropped_packets": {
          "default": 0,
          "description": "Other encoded packets the output lost this run: audio packets that it fell\nbehind on, packets the muxer refused or a stop's drain gave up on, and what the\npublish target dropped while its link was down.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "frames": {
          "default": 0,
          "description": "Video frames the output has handed to its muxer this run, left out like `bytes`\nwhile its live link is down.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "health": {
          "$ref": "#/$defs/OutputHealth",
          "default": "waiting",
          "description": "How the output is doing over the last ten seconds."
        },
        "kbps": {
          "default": 0,
          "description": "What the output sent over the last tick's interval, in kilobits a second (bytes\ntimes 8 over the milliseconds since the previous sample). 0 on the first tick of\na run that hasn't sent anything yet.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "output_id": {
          "$ref": "#/$defs/OutputId",
          "description": "The output."
        },
        "uptime_ms": {
          "default": 0,
          "description": "Milliseconds since the engine received this run's `output.start`, on its\nmonotonic clock: it includes opening the destination and starting the pipeline.\nIt keeps counting while the output reconnects.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "output_id"
      ],
      "type": "object"
    },
    "OverrideField": {
      "description": "One of the fields a keyframe scene can override. Each is overridden whole: a variant\nthat overrides `geometry` overrides all of it, and one that overrides `effects` the\nwhole list.",
      "oneOf": [
        {
          "const": "geometry",
          "description": "The item's geometry (`item.set_geometry`, or `item.set_transform` while it lasts).",
          "type": "string"
        },
        {
          "const": "crop",
          "description": "Its crop (`item.set_crop`).",
          "type": "string"
        },
        {
          "const": "visible",
          "description": "Whether it is drawn (`item.set_visible`).",
          "type": "string"
        },
        {
          "const": "opacity",
          "description": "Its opacity (`item.set_opacity`).",
          "type": "string"
        },
        {
          "const": "effects",
          "description": "Its effects, the whole list (`item.set_effects`, since 0.63, ADR-0088).",
          "type": "string"
        },
        {
          "const": "motion",
          "description": "Its motion modifiers, the whole list (`item.set_motion`, since 0.81, ADR-0099).",
          "type": "string"
        }
      ]
    },
    "PackFile": {
      "description": "One file of a `pack.write`.",
      "oneOf": [
        {
          "description": "UTF-8 text.",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Bytes, as standard base64 with padding.",
          "properties": {
            "base64": {
              "type": "string"
            }
          },
          "required": [
            "base64"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "path": {
          "description": "Its path in the pack, `/`-separated: `effect.toml`, or a `.wgsl`, `.png`, `.jpg`\nor `.jpeg` file, under the asset-path rules (no `..`, no absolute path, no\ncomponent that starts with `.`, no `\\` or `:`, no Windows reserved name).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "PackFileInfo": {
      "description": "One file of a pack, as `pack.read` returns it.",
      "properties": {
        "base64": {
          "description": "An image's bytes as base64, only when `pack.read` named that image by `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "description": "The BLAKE3 digest of its bytes, as lower-case hex.",
          "type": "string"
        },
        "path": {
          "description": "Its path in the pack, `/`-separated.",
          "type": "string"
        },
        "size": {
          "description": "Its size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "The text of an `effect.toml` or `.wgsl` file. Omitted for an image, and in a\nwhole-pack read for a file past its 3 MiB budget of text: read it by `path`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "size",
        "digest"
      ],
      "type": "object"
    },
    "PackInfo": {
      "description": "One pack in the packs folder, as `pack.list` and `pack.write` report it.",
      "properties": {
        "folder": {
          "description": "The folder it is in, within the packs folder. A pack written over the protocol is\nin the folder named by its ID; one a person installed may be in another.",
          "type": "string"
        },
        "id": {
          "description": "Its pack ID, from its `effect.toml`.",
          "type": "string"
        },
        "kinds": {
          "description": "Its kinds, `<pack>/<id>`, effects then sources, while it is loaded. Empty for a\npack that doesn't load.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "loaded": {
          "description": "Whether the engine loads it: `false` for a pack whose manifest or shaders fail\nto load, or whose ID another folder already holds.",
          "type": "boolean"
        },
        "written_by": {
          "description": "The client name (from its `hello`) of the last `pack.write` of this pack ID,\nwhich says who claims to have written it, not who proved it. It stays when a\nperson later edits or replaces the folder by hand. Omitted for a pack ID no\nclient has written, and when the last writer gave no name.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "folder",
        "kinds",
        "loaded"
      ],
      "type": "object"
    },
    "ParamDescriptor": {
      "description": "One parameter of a kind.",
      "oneOf": [
        {
          "description": "`true` or `false`.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A whole number.",
          "properties": {
            "max": {
              "description": "Largest allowed value.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "min": {
              "description": "Smallest allowed value.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "step": {
              "description": "UI hint: the increment a control steps by.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "int",
              "type": "string"
            },
            "unit": {
              "description": "Display unit (`px`, `ms`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A finite number.",
          "properties": {
            "max": {
              "description": "Largest allowed value.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "min": {
              "description": "Smallest allowed value.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "step": {
              "description": "UI hint: the increment a control steps by.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "float",
              "type": "string"
            },
            "unit": {
              "description": "Display unit (`dB`, `%`).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One of a fixed set of strings.",
          "properties": {
            "options": {
              "description": "The allowed values, in display order.",
              "items": {
                "$ref": "#/$defs/EnumOption"
              },
              "type": "array"
            },
            "type": {
              "const": "enum",
              "type": "string"
            }
          },
          "required": [
            "type",
            "options"
          ],
          "type": "object"
        },
        {
          "description": "A colour: `#rrggbb`, or `#rrggbbaa` when `alpha` is true.",
          "properties": {
            "alpha": {
              "description": "Whether the value may carry an alpha byte.",
              "type": "boolean"
            },
            "type": {
              "const": "color",
              "type": "string"
            }
          },
          "required": [
            "type",
            "alpha"
          ],
          "type": "object"
        },
        {
          "description": "Text.",
          "properties": {
            "max_len": {
              "description": "Longest allowed value, in characters.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "multiline": {
              "default": false,
              "description": "UI hint: shown as multi-line text.",
              "type": "boolean"
            },
            "type": {
              "const": "string",
              "type": "string"
            }
          },
          "required": [
            "type",
            "max_len"
          ],
          "type": "object"
        },
        {
          "description": "A file reference (`{\"type\":\"asset\",\"root\":…,\"path\":…}`) or `null`.",
          "properties": {
            "accept": {
              "default": [],
              "description": "The accepted file extensions, lower case without the dot (`png`). Empty\naccepts any file.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "asset",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A scene reference (`{\"type\":\"scene\",\"scene_id\":…}`) or `null`.",
          "properties": {
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A source reference (`{\"type\":\"source\",\"source_id\":…}`) or `null`.",
          "properties": {
            "media": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Media"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Accept only sources that produce this. Omitted accepts any source."
            },
            "type": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A bus reference (`{\"type\":\"bus\",\"bus_id\":…}`) or `null`. Since 0.24.",
          "properties": {
            "type": {
              "const": "bus",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The ID of a display or window, as `capture.targets` lists it, so a UI can offer\nthe targets of that kind to pick from: a string, empty for the kind's default.\nSince 0.50.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/CaptureTargetKind",
              "description": "The kind of target it names."
            },
            "max_len": {
              "description": "Longest allowed value, in characters.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "capture_target",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "max_len"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "advanced": {
          "description": "UI hint: shown only among advanced settings.",
          "type": "boolean"
        },
        "default": {
          "description": "The value a new source gets when it doesn't set this parameter."
        },
        "description": {
          "description": "A longer explanation for UIs and agents.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "UI hint: the group to show it in.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Unique within the kind, and stable across versions.",
          "type": "string"
        },
        "label": {
          "description": "Display label.",
          "type": "string"
        },
        "live": {
          "default": false,
          "description": "Whether a change applies without restarting the source or filter (a colour), or\nrestarts it (a capture device). `live.set` may override a live parameter during a\ngesture (ADR-0032).",
          "type": "boolean"
        },
        "visible_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisibleIf"
            },
            {
              "type": "null"
            }
          ],
          "description": "UI hint: shown only while another parameter has a given value."
        },
        "warning": {
          "description": "One line a client shows beside the control, not only in a tooltip: what setting\nit gives away (0.93, ADR-0124). A client that predates it ignores it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "default",
        "label"
      ],
      "type": "object"
    },
    "PhaseProfile": {
      "description": "Where a drawer's frame time went, as averages per frame in milliseconds. The phases\nadd up to about the frame time.",
      "properties": {
        "captures_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Uploading or importing the captures' frames."
        },
        "chains_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The video chains: source chains (and so shader sources), scene chains, item\neffects, and the scene passes they read."
        },
        "finish_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The output stage, reading the frame back (which waits for the GPU) and\nconverting it for the encoders."
        },
        "passes_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The nested scenes' passes and the program scene's composite."
        },
        "uploads_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "Uploading the source frames that changed, and importing GPU frames."
        }
      },
      "type": "object"
    },
    "PixelSize": {
      "description": "A size in whole pixels.",
      "properties": {
        "height": {
          "description": "Height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "PlacedKeyframe": {
      "description": "A scene drawn through one of its keyframe scenes wherever another scene places it\n(keyframe tracks, ADR-0116, since 0.88), as `studio.get` reports it.",
      "properties": {
        "keyframe_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The keyframe scene its placements draw it through."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The placed scene."
        }
      },
      "required": [
        "scene_id",
        "keyframe_id"
      ],
      "type": "object"
    },
    "PlacementForm": {
      "description": "Which of the two forms an item's stored placement has (ADR-0022 decision 5).\n\nThe two values are the complete set until 1.0, which removes `legacy`.",
      "oneOf": [
        {
          "const": "legacy",
          "description": "A 0.3 `ItemTransform`, evaluated every frame against the source's current size.\nWhat a server older than 0.11 stores, so a missing field parses as this.",
          "type": "string"
        },
        {
          "const": "geometry",
          "description": "An [`ItemGeometry`]: a box on the canvas.",
          "type": "string"
        }
      ]
    },
    "PlanProfile": {
      "description": "What planning the program mix cost ([`ProfileInfo::plan`]).",
      "properties": {
        "ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The average time a plan took, in milliseconds."
        },
        "plans": {
          "default": 0,
          "description": "How many plans ran: one per edit that changes what is drawn, and one per frame\nan animation or a page needs.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "recent_max_ms": {
          "$ref": "#/$defs/Finite32",
          "default": 0.0,
          "description": "The longest plan, in milliseconds, in the last second it was read."
        }
      },
      "type": "object"
    },
    "PlayingTimeline": {
      "description": "A timeline that is playing, as `studio.get` reports it.",
      "properties": {
        "pass": {
          "description": "Which pass it is on: 0 the first. A `once` timeline has only pass 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "position_ms": {
          "description": "Where it is in its pass, in milliseconds from its start.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene that holds it."
        },
        "timeline_id": {
          "$ref": "#/$defs/TimelineId",
          "description": "The timeline."
        }
      },
      "required": [
        "timeline_id",
        "scene_id",
        "position_ms",
        "pass"
      ],
      "type": "object"
    },
    "PluginClass": {
      "description": "A capability class: a set of commands a person grants a plugin as one (ADR-0069 S2).\n`read` is always granted.",
      "oneOf": [
        {
          "const": "read",
          "description": "Every query but the never-granted ones, `kind.*` and `delete.plan`. Always\ngranted.",
          "type": "string"
        },
        {
          "const": "edit",
          "description": "The scene, item, source, filter, transition, bus, send, hotkey, canvas and studio\nedits, live parameter edits (`live.*`), and undo and redo on the plugin's own\nsession.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "What changes what is on air: `scene.switch`.",
          "type": "string"
        },
        {
          "const": "outputs",
          "description": "`output.start` and `output.stop` on outputs that already exist.",
          "type": "string"
        }
      ]
    },
    "PluginDisabledReason": {
      "description": "Why the engine disabled a plugin. The engine never re-enables one by itself.",
      "oneOf": [
        {
          "const": "cpu_limit",
          "description": "It ran past its wall-time deadline.",
          "type": "string"
        },
        {
          "const": "memory_limit",
          "description": "It hit its memory or table cap.",
          "type": "string"
        },
        {
          "const": "trap",
          "description": "It trapped on its own fault.",
          "type": "string"
        },
        {
          "const": "needs_grant",
          "description": "An update asks for more than its grant: a person must grant the difference.",
          "type": "string"
        }
      ]
    },
    "PluginGrant": {
      "description": "What a person grants one plugin (ADR-0069): its capability classes, and the network\nhosts and folders it may reach. A class never widens network or filesystem reach:\na call's URLs and files must be within `hosts` and `folders`.\n\n```json\n{\"classes\": [\"edit\", \"live\"], \"hosts\": [\"https://api.example.com:443\"], \"folders\": []}\n```",
      "properties": {
        "classes": {
          "description": "The classes granted, besides `read`, which every plugin has. Omitted for none.",
          "items": {
            "$ref": "#/$defs/PluginClass"
          },
          "type": "array",
          "uniqueItems": true
        },
        "folders": {
          "description": "The folders the person picked for it, as absolute paths on the engine's machine.\nOmitted for none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hosts": {
          "description": "The hosts the plugin may reach, each as `scheme://host:port` (`http`, `https`,\n`ws` or `wss`). Omitted for none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PluginId": {
      "description": "An installed WASM automation plugin (ADR-0069), chosen by the person who installs\nit.",
      "type": "string"
    },
    "PluginInfo": {
      "description": "One installed plugin, as `plugin.list` lists it (0.58).",
      "properties": {
        "grant": {
          "$ref": "#/$defs/PluginGrant",
          "description": "What a person granted it."
        },
        "path": {
          "description": "Its package directory on the engine's machine, as `plugin.install` named it.",
          "type": "string"
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginId",
          "description": "The plugin."
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginDisabledReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the engine disabled it, as `plugin.state_changed` says. Omitted when it is\nenabled."
        },
        "remote_name": {
          "description": "The name the plugin's manifest gives itself: the plugin's own text, never an\ninstruction (ADR-0059). Omitted when it gives none.",
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "$ref": "#/$defs/PluginRequest",
          "description": "What its manifest asks for, as the engine last read it. For a plugin disabled as\n`needs_grant`, this is the update's request, which a `plugin.grant` from the\nclient it was listed to then acknowledges."
        },
        "state": {
          "$ref": "#/$defs/PluginState",
          "description": "Whether it runs. A plugin being enabled is listed as it was until it loads."
        }
      },
      "required": [
        "plugin_id",
        "state",
        "path",
        "request",
        "grant"
      ],
      "type": "object"
    },
    "PluginRequest": {
      "description": "What a plugin's manifest asks for (ADR-0076): the classes, hosts and folders a\nperson may grant it. A grant may give less, never more. `read` is every plugin's,\nasked for or not.\n\n```json\n{\"classes\": [\"edit\"], \"hosts\": [\"https://api.example.com:443\"], \"folders\": true}\n```",
      "properties": {
        "classes": {
          "description": "The classes it asks for. Omitted for none.",
          "items": {
            "$ref": "#/$defs/PluginClass"
          },
          "type": "array",
          "uniqueItems": true
        },
        "folders": {
          "description": "Whether it wants folders a person picks. Omitted when `false`.",
          "type": "boolean"
        },
        "hosts": {
          "description": "The hosts it asks to reach, each as `scheme://host:port`. Omitted for none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PluginState": {
      "description": "Whether a plugin runs.",
      "oneOf": [
        {
          "const": "enabled",
          "description": "It is loaded and gets its events.",
          "type": "string"
        },
        {
          "const": "disabled",
          "description": "It doesn't run, until a person re-enables it (`plugin.enable`).",
          "type": "string"
        }
      ]
    },
    "PreviewCodec": {
      "description": "How a preview stream's pictures are encoded.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 access units in Annex B form (start codes, parameter sets in band), for\nWebCodecs' `VideoDecoder` with no `description`. A frame is a keyframe exactly\nwhen its header says so.",
          "type": "string"
        },
        {
          "const": "jpeg",
          "description": "One baseline JPEG per frame, every one a keyframe. The fallback when the engine\nhas no H.264 encoder or the client can't decode H.264.",
          "type": "string"
        },
        {
          "const": "png",
          "description": "One PNG per frame, every one a keyframe (ADR-0096, since 0.71): lossless, for a\nscreenshot rather than a moving picture. An older server refuses the name.",
          "type": "string"
        }
      ]
    },
    "PreviewDraft": {
      "description": "A source that is not in the collection, for `preview.subscribe`'s `source`: what a\nsource of `kind` with `settings` would show, so a client can show a device while the\nuser picks it, before the source is created or its settings are saved.",
      "properties": {
        "kind": {
          "description": "The source kind, as `kind.list` reports it. Only the capture kinds (`display`,\n`window` and `webcam`) can be shown this way.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings, checked as `source.create` checks them. Parameters left out, or\nsent as `null`, take their defaults. Omitted means all defaults."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ProfileStream": {
      "description": "An encoded stream, by what it feeds ([`StreamProfile::stream`]).",
      "oneOf": [
        {
          "description": "An output's program feed.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "type": {
              "const": "output",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "An H.264 preview stream.",
          "properties": {
            "channel": {
              "description": "The stream's channel on its connection.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene it shows; omitted with `source_id` for the program."
            },
            "source_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The source it shows alone."
            },
            "type": {
              "const": "preview",
              "type": "string"
            }
          },
          "required": [
            "type",
            "channel"
          ],
          "type": "object"
        }
      ]
    },
    "ProfileUnit": {
      "description": "A unit of drawing work, by its owner.",
      "oneOf": [
        {
          "description": "Uploading a source's frame to the GPU, or importing its GPU frame (a browser\nsource's).",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source."
            },
            "type": {
              "const": "upload",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "Uploading or importing a capture's frame: a display, window or video device.",
          "properties": {
            "source_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The source it is captured for; omitted for a video device, which every\nsource showing it shares, and for the display that fills an output with no\nprogram scene."
            },
            "type": {
              "const": "capture",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A source's video chain: its filters, or a shader source's program.",
          "properties": {
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The source."
            },
            "type": {
              "const": "source_chain",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id"
          ],
          "type": "object"
        },
        {
          "description": "A scene's video chain over its composite, the composite included.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene."
            },
            "type": {
              "const": "scene_chain",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "An item's effects: drawing the item into its box, then each effect.",
          "properties": {
            "item_id": {
              "$ref": "#/$defs/ItemId",
              "description": "The item."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene that draws the item; a keyframe scene draws its parent's items."
            },
            "type": {
              "const": "item_effects",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id",
            "item_id"
          ],
          "type": "object"
        },
        {
          "description": "A `scene` source's chain where it places its scene.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene it places, as planned there."
            },
            "source_id": {
              "$ref": "#/$defs/SourceId",
              "description": "The `scene` source."
            },
            "type": {
              "const": "placed_chain",
              "type": "string"
            }
          },
          "required": [
            "type",
            "source_id",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Compositing a nested scene into its layer, or a scene a filter reads. Every item\nof the scene with no effects of its own is drawn here.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene."
            },
            "type": {
              "const": "scene_pass",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "The program scene's composite, or a running transition's, into the frame.",
          "properties": {
            "type": {
              "const": "composite",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The master stage's chain over a mix.",
          "properties": {
            "mix_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/VideoMixId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The mix; omitted for the program."
            },
            "type": {
              "const": "master_chain",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "An output's own chain.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output."
            },
            "type": {
              "const": "output_chain",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProtocolError": {
      "description": "Why the server refused or failed a request.\n\nOn the wire each variant is an object whose `code` tag is the variant's stable\nsnake_case code (see [`ProtocolError::code`]) and whose other fields are its details.\n[`WireError`] adds the human-readable message. A code, once released, keeps its\nmeaning and its fields (R-API-001). Clients must handle codes they don't know: they\nparse as [`ProtocolError::Unknown`], and the message still explains them.",
      "oneOf": [
        {
          "description": "The server can't speak the client's protocol version.",
          "properties": {
            "client": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the client asked for in `hello`."
            },
            "code": {
              "const": "unsupported_version",
              "type": "string"
            },
            "server": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the server speaks."
            }
          },
          "required": [
            "code",
            "client",
            "server"
          ],
          "type": "object"
        },
        {
          "description": "A request arrived before the `hello`/`welcome` handshake finished.",
          "properties": {
            "code": {
              "const": "handshake_required",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The message could not be parsed: bad JSON, an unknown `type`, a missing or\nmistyped field, or a number that isn't a finite `f32` (NaN, infinity, or out of\nrange such as `1e39`). `ClientMessage::parse` produces it.",
          "properties": {
            "code": {
              "const": "malformed",
              "type": "string"
            },
            "reason": {
              "description": "What the parser reported.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A batch had no edits.",
          "properties": {
            "code": {
              "const": "empty_batch",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The batch's `expected_rev` was not the current revision. Nothing was applied:\nre-read the state and retry.",
          "properties": {
            "code": {
              "const": "rev_conflict",
              "type": "string"
            },
            "current": {
              "$ref": "#/$defs/Rev",
              "description": "The state's revision when the batch was checked."
            },
            "expected": {
              "$ref": "#/$defs/Rev",
              "description": "The `expected_rev` the batch carried."
            }
          },
          "required": [
            "code",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "description": "A command named an object that doesn't exist.",
          "properties": {
            "code": {
              "const": "not_found",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A creating edit used an ID that is already taken.",
          "properties": {
            "code": {
              "const": "already_exists",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A field had a value the engine can't accept.",
          "properties": {
            "blockers": {
              "description": "When a `scene.delete` or `source.delete` is refused because other objects still\nrefer to its target: every one of those references, in a stable order. The\n`delete.plan` query returns the batch that removes them with the target. Empty\notherwise, and then omitted. Missing (from a server older than 0.15)\nparses as empty.",
              "items": {
                "$ref": "#/$defs/Blocker"
              },
              "type": "array"
            },
            "code": {
              "const": "invalid_argument",
              "type": "string"
            },
            "field": {
              "description": "The field, as a dotted path into the command (`edits.2.name`).",
              "type": "string"
            },
            "reason": {
              "description": "Why it was rejected.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "field",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "An undo or redo would overwrite another client's work: a batch that client\napplied after the step changed a property the step sets, created or deleted an\nobject the step creates or deletes, or made the step's edits no longer apply.\nNothing was applied, and the step was dropped from the history, so the next undo\nreaches the step before it.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose batch conflicts."
            },
            "code": {
              "const": "undo_conflict",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision that batch produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced."
            }
          },
          "required": [
            "code",
            "step_rev",
            "client_id",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "There is nothing to undo, or nothing to redo.",
          "properties": {
            "code": {
              "const": "history_empty",
              "type": "string"
            },
            "direction": {
              "$ref": "#/$defs/HistoryDirection",
              "description": "Which way the call asked to move."
            }
          },
          "required": [
            "code",
            "direction"
          ],
          "type": "object"
        },
        {
          "description": "An action was accepted for processing but could not be carried out.",
          "properties": {
            "code": {
              "const": "action_failed",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The call is valid, but whoever answered it doesn't serve it: `pairing.start`,\n`device.list` and `device.revoke` sent to an engine with no server in front,\na `plugin.*` action sent to an engine that hosts no plugins yet, or the deprecated\n`privacy.set` (ADR-0080).\nRetrying won't help.",
          "properties": {
            "call": {
              "description": "The call's name (`pairing.start`).",
              "type": "string"
            },
            "code": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call"
          ],
          "type": "object"
        },
        {
          "description": "The caller may not make this call (0.35): a plugin's call outside its granted\ncapability classes, a command no plugin is ever granted, or a plugin past its cap\nof commands a second (ADR-0069). Nothing was applied. Retrying won't help until\na person widens the grant, except after the command cap, which clears within a\nsecond.",
          "properties": {
            "call": {
              "description": "The call's name (`output.start`), or for a batch, its first edit's.",
              "type": "string"
            },
            "code": {
              "const": "forbidden",
              "type": "string"
            },
            "reason": {
              "description": "Why: the class the caller lacks, or that no plugin may make it.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "`output.start` could not open a hardware video encoder while other hardware\nencoder sessions were open, so the machine's hardware session limit is taken to\nbe reached (0.44, ADR-0080 §3). The engine doesn't guess vendor caps and never\nfalls back to a software encoder for this. Nothing was started. Stop one of\n`outputs`, share an encoder session with one, or start this output with an\nencoder profile whose `hardware` is `avoid`.",
          "properties": {
            "code": {
              "const": "hardware_session_limit",
              "type": "string"
            },
            "outputs": {
              "description": "The running outputs that hold hardware encoder sessions, sorted.",
              "items": {
                "$ref": "#/$defs/OutputId"
              },
              "type": "array"
            },
            "reason": {
              "description": "What the encoder said when it refused the new session.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "outputs",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The message was over the server's request limit (0.62, ADR-0074). The server read\nonly its envelope's `id`: nothing in it was applied, and the connection stays\nopen. Retrying the same message won't help: split the work, for example one\nfilter's `state` per batch. `Welcome.max_request_bytes` advertises the limit.",
          "properties": {
            "code": {
              "const": "too_large",
              "type": "string"
            },
            "limit_bytes": {
              "description": "The server's request limit in bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "size_bytes": {
              "description": "The message's size in bytes.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "code",
            "size_bytes",
            "limit_bytes"
          ],
          "type": "object"
        },
        {
          "description": "The engine hit a bug or an unexpected condition. The request may be retried.",
          "properties": {
            "code": {
              "const": "internal",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ProtocolVersion": {
      "description": "A protocol version: `major.minor`. Patch releases never change the wire format, so\nthey are not part of it.",
      "properties": {
        "major": {
          "description": "Incremented by a breaking change (a removal or rename).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "Incremented by an addition.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Query": {
      "description": "A read. Queries change nothing, so they need no classification as edit or action.\n\nSerialized with an internal `type` tag holding the query name (`noun.verb`).",
      "oneOf": [
        {
          "description": "Lists the collection's scenes, in display order.",
          "properties": {
            "type": {
              "const": "scene.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reports an output's current state, and whether its stream key is set. Fails with\n`not_found` for an output the engine doesn't know.",
          "properties": {
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output to report on."
            },
            "type": {
              "const": "output.status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's sources, ordered by ID. Sources have no display order of\ntheir own.",
          "properties": {
            "type": {
              "const": "source.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Every source's current size (ADR-0022 §4, 0.40): runtime state, so the result\ncarries no `rev`. A source drawn at a density reports its own size, the size its\nframes are placed at, not its pixels (ADR-0073). `source.size_changed` reports each\nchange after this.",
          "properties": {
            "type": {
              "const": "source.sizes",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists one scene's items, in stacking order (the first is at the bottom). Fails with\n`not_found` if the scene doesn't exist.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene whose items to list."
            },
            "type": {
              "const": "item.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "Reads the whole collection state (the canvas, every source, every scene with its\nitems, every output, every encoder profile, every video mix, the buses and sends,\nevery hotkey binding, and the folders and labels) at one revision: what a client\nreads on connecting, after a `state.changed` it didn't cause, or before an edit it\nsends with `expected_rev`.",
          "properties": {
            "type": {
              "const": "state.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The current program mix, as a PNG.\n\nThe result's `png` is standard base64 with padding and no line breaks. `width`\nand `height` are that image's size in pixels; the longest side is at most 1280.\n`rev` is the collection revision of the layout the image shows. Source pixels are\nruntime state and can change without a new `rev`.",
          "properties": {
            "type": {
              "const": "video.snapshot",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A frame sheet (since 0.82, #1061): `count` pictures of the program mix, or of\n`scene_id`'s scene alone, `interval_ms` apart, tiled into one PNG so motion can be\nchecked in one call. The first is taken `delay_ms` after the call. The answer\ncomes once the last picture is drawn, so the call takes at least `delay_ms +\n(count - 1) × interval_ms`. Each picture is what that mix or scene shows at that\nmoment, as `video.snapshot` draws it: a running transition where it is then,\neach source's latest frame, and nothing for a display, window or camera capture.\nA scene off program shows what its preview stream would. Fails with\n`invalid_argument` past the [`FrameStrip`] limits, and `not_found` for a scene not\nin the collection, at the call or when a picture is due. To watch a switch from\nits start, use `scene.switch_and_watch`.",
          "properties": {
            "count": {
              "description": "How many pictures, 2 to 16.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "delay_ms": {
              "description": "How long to wait before the first picture, in milliseconds. Default 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "interval_ms": {
              "description": "The time between two pictures, in milliseconds, at least 10.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scene_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SceneId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The scene to show alone. Omitted for the program mix."
            },
            "type": {
              "const": "video.frames",
              "type": "string"
            }
          },
          "required": [
            "type",
            "count",
            "interval_ms"
          ],
          "type": "object"
        },
        {
          "description": "Lists every kind the engine can create, ordered by ID. Kinds are not collection\nstate, so the result carries no `rev`.",
          "properties": {
            "type": {
              "const": "kind.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "One kind's full descriptor, and a JSON Schema of its settings generated from it.\nFails with `invalid_argument` on `kind_id` if the engine has no such kind.",
          "properties": {
            "kind_id": {
              "description": "The kind to describe, as `kind.list` reports it.",
              "type": "string"
            },
            "type": {
              "const": "kind.describe",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind_id"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's outputs, ordered by ID, with what each is and where it\nsends. Outputs have no display order of their own.",
          "properties": {
            "type": {
              "const": "output.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reads the studio state: which scenes are on program and on preview. It is runtime\nstate, not collection state (ADR-0030), so the result carries no `rev`.",
          "properties": {
            "type": {
              "const": "studio.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "**Deprecated** (ADR-0080), removed in 1.0. JStream has no privacy\nscreen, so the answer is always `on: false`.",
          "properties": {
            "type": {
              "const": "privacy.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's encoder profiles, ordered by ID.",
          "properties": {
            "type": {
              "const": "encoder.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's video mixes, ordered by ID.",
          "properties": {
            "type": {
              "const": "video_mix.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the open live-value gestures (ADR-0032), every client's, ordered by client\nand gesture ID, with the values each holds now: what a client that connects\nduring a drag reads to show it. Live values are runtime state, not collection\nstate, so the result carries no `rev`.",
          "properties": {
            "type": {
              "const": "live.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Whether the engine is signed in to YouTube. Never calls YouTube.",
          "properties": {
            "type": {
              "const": "youtube.status",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the signed-in channel's broadcasts, one page of up to 50 at a time, in\nYouTube's order. Calls the Live API, so it fails with `action_failed` when not\nsigned in or YouTube refuses (including when the day's quota is used up).",
          "properties": {
            "broadcast_type": {
              "$ref": "#/$defs/BroadcastType",
              "default": "all",
              "description": "Which broadcasts, by type. Omitted means `all`, which includes the channel's\npersistent (\"Stream now\") broadcast."
            },
            "page_token": {
              "description": "The `next_page_token` of an earlier page, for the page after it.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/BroadcastListStatus",
              "default": "all",
              "description": "Which broadcasts, by state. Omitted means `all`."
            },
            "type": {
              "const": "youtube.list_broadcasts",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the signed-in channel's streams, one page of up to 50 at a time. Their keys\nare never reported. Fails like `youtube.list_broadcasts`.",
          "properties": {
            "page_token": {
              "description": "The `next_page_token` of an earlier page, for the page after it.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "youtube.list_streams",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The audience of each running `youtube` output, as last read, and the engine's\nestimate of the day's API quota (ADR-0041 §3 and §5, 0.38). Never calls YouTube.",
          "properties": {
            "type": {
              "const": "youtube.stats",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the collection's audio buses, ordered by ID, and every send into them.",
          "properties": {
            "type": {
              "const": "bus.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The batch that deletes a scene, source, bus, folder or label together with\neverything that refers to it, which `scene.delete`, `source.delete`, `bus.delete`,\n`folder.delete` and `label.delete` alone refuse (their `invalid_argument` lists\nthose `blockers`). The plan removes the items that place a deleted source, deletes\nthe `scene` sources that show a deleted scene (and their items), and sets settings\nreferences to the target to `null`, keeping the sources and transition presets that\nhold them. For a\nfolder it moves what sits in it up to the folder's parent; for a label it takes\nthe label off the sources carrying it. It also lists the hotkey bindings the\ndelete removes with what they name (ADR-0040 §3), which need no edit of their own.\nThe client shows it, then sends its `edits` as an ordinary batch with\n`expected_rev` set to the result's `rev`; undo is that batch's inverse. Fails with\n`not_found` if the target doesn't exist.",
          "properties": {
            "target": {
              "$ref": "#/$defs/DeleteTarget",
              "description": "What to delete."
            },
            "type": {
              "const": "delete.plan",
              "type": "string"
            }
          },
          "required": [
            "type",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "Lists the displays and windows the engine can capture now: what a `display` or\n`window` source's `target` setting can name. They are runtime state, not\ncollection state, so the result carries no `rev`, and a window closed since may\nstill be named by a source. Fails with `action_failed` when the engine has no\ncapture backend, or the OS refuses to list them.",
          "properties": {
            "type": {
              "const": "capture.targets",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the fonts installed on the engine's machine (0.68, ADR-0092): each font file\nin the OS's font folders that parses, as a family and style to show and the\nabsolute path an `asset` setting names it by. Runtime state, so no `rev`. The\nengine reads the folders once, on the first `font.list`; a font installed after\nthat shows once it restarts.",
          "properties": {
            "type": {
              "const": "font.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the effect packs in the engine's packs folder (0.72, ADR-0097), ordered by\npack ID: each one's folder, its kinds while it loads, and the client that last\nwrote it with `pack.write`. A folder whose `effect.toml` doesn't parse is left\nout. Packs are not collection state, so no `rev`. Fails with `unsupported` from an\nengine that loads no packs.",
          "properties": {
            "type": {
              "const": "pack.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reads one effect pack's files (0.72, ADR-0097): the text of its `effect.toml` and\n`.wgsl` files, and each image's path, size and digest. Past 3 MiB of text in all,\na file's `text` is left out; read it by `path`. With `path`, only that file, and\nan image's bytes as base64; an image over 2 MiB (`MAX_PACK_IMAGE_BYTES`), which\nonly a person can have put there, fails with `too_large`. Fails with `not_found`\n(entity `pack`) for a pack no folder holds, `invalid_argument` for a `path` it\ndoesn't have, and `unsupported` from an engine that loads no packs.",
          "properties": {
            "pack": {
              "description": "The pack ID.",
              "type": "string"
            },
            "path": {
              "description": "One file of it, `/`-separated. Omitted for every file.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "pack.read",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pack"
          ],
          "type": "object"
        },
        {
          "description": "Lists the shared values (0.78, ADR-0102 decision 7), ordered by name: every one,\nor with `prefix`, the value named `prefix` and every value below it (`status`\ncovers `status` and `status.text`). Shared values are not collection state, so\nthe result carries no `rev`.",
          "properties": {
            "prefix": {
              "description": "Only this name and the names below it. Omitted for every value.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "values.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the paired devices (ADR-0044), ordered by ID: each one's name and when it\npaired and was last used, never its token. Answered by the server that admits\nclients, not the engine: a `Control` with no server in front fails with\n`unsupported`.",
          "properties": {
            "type": {
              "const": "device.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the engine's recent activity (0.51, ADR-0083): what each client's batches,\nundos, redos and actions did, newest first. The engine keeps the last 100\n([`MAX_ACTIVITY_ENTRIES`](crate::MAX_ACTIVITY_ENTRIES)), in memory, so a restarted\nengine starts empty. No event announces a new entry until event subscriptions exist\n(protocol open question 7): a client that shows the log asks again with\n`after_seq`. Runtime state: the result carries no `rev`.",
          "properties": {
            "after_seq": {
              "description": "Only entries with a greater `seq`. Omitted, the newest entries whatever their\nnumber.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "limit": {
              "description": "At most this many, the newest. Omitted, or above 100\n([`MAX_ACTIVITY_ENTRIES`](crate::MAX_ACTIVITY_ENTRIES)), 100.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "activity.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reads a UI setting `ui_settings.set` kept (0.52, ADR-0084): the value under\n`key`, omitted when there is none. Not collection state, so no `rev`. Answered by\nthe server that admits clients, like `device.list`: a `Control` with no server in\nfront fails with `unsupported`. Fails with `invalid_argument` on `key` for a key\n`ui_settings.set` would refuse.",
          "properties": {
            "key": {
              "description": "The setting's key.",
              "type": "string"
            },
            "type": {
              "const": "ui_settings.get",
              "type": "string"
            }
          },
          "required": [
            "type",
            "key"
          ],
          "type": "object"
        },
        {
          "description": "Lists the installed WASM automation plugins (0.58, ADR-0069), ordered by ID: each\none's state, its package, what its manifest asks for and what a person granted it,\nso a client can show them and offer a grant. For a person only, like\n`plugin.install`: no plugin is ever granted it, and no MCP tool carries it. Not\ncollection state, so the result carries no `rev`. An engine built without WASM\nplugins lists none.",
          "properties": {
            "type": {
              "const": "plugin.list",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Lists the codec libraries the engine can download on a person's request (0.69,\nADR-0061): on Linux, Cisco's OpenH264, the software H.264 encoder, which Cisco's\npatent licence covers only when Cisco's own binary is downloaded to the machine.\nEach one carries the notice and licence link a client shows wherever it offers\nthe download, whether it is installed, and whether the machine has a hardware\nencoder for its codec. For a person only, like `codec.download`: no MCP tool\ncarries it and no plugin is granted it. Runtime state, so no `rev`. An engine\nwhose platform downloads no codec, or that has no codec backend, lists none.",
          "properties": {
            "type": {
              "const": "codec.downloads",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reads which project (collection file) the engine saves to, and the projects\nopened most recently (0.94, ADR-0121). Not collection state, so no `rev`. Fails\nwith `unsupported` when the host named no collection file.",
          "properties": {
            "type": {
              "const": "collection.info",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Reads where the engine's time went over the last `seconds` (0.73, ADR-0103): per\ndrawing thread, per unit of drawing work and its owner (a source's upload or\nchain, a scene's chain or pass, an item's effects, an output's chain), per\nsource, the planner, and the CPU of each thread of the process. The engine\nmeasures all the time, so it needs no start. Runtime state: the result carries\nno `rev`.",
          "properties": {
            "seconds": {
              "description": "The window, in seconds, from 1 to 60\n([`MAX_PROFILE_SECONDS`](crate::MAX_PROFILE_SECONDS)). Omitted, 5. A window\nlonger than the engine has read for covers what it has.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "top": {
              "description": "At most this many entries in each list, the costliest. Omitted, 20; above 200\n([`MAX_PROFILE_TOP`](crate::MAX_PROFILE_TOP)), 200.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "const": "profile.get",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "QueryResult": {
      "description": "The result of a [`Query`]. Its `type` tag repeats the query's name.",
      "oneOf": [
        {
          "description": "The result of `scene.list`.",
          "properties": {
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "scenes": {
              "description": "The scenes, in display order.",
              "items": {
                "$ref": "#/$defs/SceneSummary"
              },
              "type": "array"
            },
            "type": {
              "const": "scene.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "scenes"
          ],
          "type": "object"
        },
        {
          "description": "The result of `output.status`. Output state is runtime state, not collection\nstate, so it carries no `rev`.",
          "properties": {
            "cleartext": {
              "default": false,
              "description": "Whether publishing sends the stream key across the network unencrypted:\na generic RTMP target whose server URL is plain `rtmp://` to a host other than\nthe engine's machine (loopback and `localhost` don't count). A client shows it\nas a warning; the engine still publishes. Missing (from a server older than\n0.37) parses as `false`.",
              "type": "boolean"
            },
            "encoder": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EncoderSessionInfo"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The encoder session the output uses while it runs: which profile, and which\nother running outputs share it. Absent while it isn't running, and from a\nserver older than 0.13."
            },
            "encoder_sessions": {
              "default": 0,
              "description": "How many video encoder sessions the engine has open now, for every output,\nand how many of them are hardware ones. Hardware encoders cap their\nconcurrent sessions per GPU vendor and driver, and the engine doesn't guess\nthe cap. Missing (from a server older than 0.13) parses as 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "hardware_sessions": {
              "default": 0,
              "description": "Of `encoder_sessions`, the hardware ones. Missing parses as 0.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "key_set": {
              "default": false,
              "description": "Whether the credential store holds a stream key for it. The key itself is\nnever reported. Missing (from a server older than 0.7) parses as `false`.",
              "type": "boolean"
            },
            "output_id": {
              "$ref": "#/$defs/OutputId",
              "description": "The output reported on."
            },
            "state": {
              "$ref": "#/$defs/OutputState",
              "description": "Its current state."
            },
            "type": {
              "const": "output.status",
              "type": "string"
            }
          },
          "required": [
            "type",
            "output_id",
            "state"
          ],
          "type": "object"
        },
        {
          "description": "The result of `source.list`.",
          "properties": {
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "sources": {
              "description": "The sources, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceInfo"
              },
              "type": "array"
            },
            "type": {
              "const": "source.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "sources"
          ],
          "type": "object"
        },
        {
          "description": "The result of `item.list`.",
          "properties": {
            "items": {
              "description": "Its items, in stacking order: the first is at the bottom.",
              "items": {
                "$ref": "#/$defs/ItemInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the list was read at."
            },
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene listed."
            },
            "type": {
              "const": "item.list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "rev",
            "scene_id",
            "items"
          ],
          "type": "object"
        },
        {
          "description": "The result of `state.get`: the whole collection state at one revision.",
          "properties": {
            "base_fps": {
              "description": "The collection's base frame rate, 30 or 60 (ADR-0119, since 0.89). Omitted\nwhile it is 30, so a collection that has not opted in reads as it did before.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "buses": {
              "default": [],
              "description": "Every audio bus, ordered by ID, the master among them. Missing (from a\nserver older than 0.19) parses as empty.",
              "items": {
                "$ref": "#/$defs/BusInfo"
              },
              "type": "array"
            },
            "canvas": {
              "$ref": "#/$defs/Canvas",
              "default": {
                "height": 1080,
                "width": 1920
              },
              "description": "The canvas every scene is laid out on. Missing (from a server older than 0.11)\nparses as 1920×1080."
            },
            "encoders": {
              "default": [],
              "description": "Every encoder profile, ordered by ID. Missing (from a server older than\n0.13) parses as empty.",
              "items": {
                "$ref": "#/$defs/EncoderProfileInfo"
              },
              "type": "array"
            },
            "folders": {
              "description": "Every folder of the scene list, in folder order (ADR-0024 §3). Omitted when\nthere are none; missing (from an older server) parses as empty.",
              "items": {
                "$ref": "#/$defs/FolderInfo"
              },
              "type": "array"
            },
            "hotkeys": {
              "default": [],
              "description": "Every hotkey binding, ordered by chord. Missing (from a server older than\n0.25) parses as empty.",
              "items": {
                "$ref": "#/$defs/HotkeyBinding"
              },
              "type": "array"
            },
            "labels": {
              "description": "Every label, in label order (ADR-0024 §4). Omitted when there are none;\nmissing (from an older server) parses as empty.",
              "items": {
                "$ref": "#/$defs/LabelInfo"
              },
              "type": "array"
            },
            "master": {
              "$ref": "#/$defs/MasterInfo",
              "description": "The master stage. Omitted while it has no filters, so missing (also from a\nserver older than 0.29) parses as empty."
            },
            "outputs": {
              "default": [],
              "description": "Every output, ordered by ID. Missing (from a server older than 0.7) parses\nas empty.",
              "items": {
                "$ref": "#/$defs/OutputInfo"
              },
              "type": "array"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the state was read at."
            },
            "scenes": {
              "description": "Every scene with its items, in display order.",
              "items": {
                "$ref": "#/$defs/SceneInfo"
              },
              "type": "array"
            },
            "sends": {
              "default": [],
              "description": "Every send, ordered by bus, then by source. Missing (from a server older\nthan 0.19) parses as empty.",
              "items": {
                "$ref": "#/$defs/SendInfo"
              },
              "type": "array"
            },
            "sources": {
              "description": "Every source, ordered by ID.",
              "items": {
                "$ref": "#/$defs/SourceInfo"
              },
              "type": "array"
            },
            "transitions": {
              "$ref": "#/$defs/TransitionsInfo",
              "default": {
                "default": "cut",
                "presets": [
                  {
                    "duration_ms": 0,
                    "easing": "ease_in_out",
                    "kind": "cut",
                    "name": "Cut",
                    "preset_id": "cut"
                  }
                ]
              },
              "description": "The transition presets and which one is the default (ADR-0029). Missing\n(from a server older than 0.30) parses as the one `cut` preset every\ncollection starts with."
            },
            "type": {
              "const": "state.get",
              "type": "string"
            },
            "video_mixes": {
              "default": [],
              "description": "Every video mix, ordered by ID. Missing (from a server older than 0.28)\nparses as empty.",
              "items": {
                "$ref": "#/$defs/VideoMixInfo"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "rev",
            "sources",
            "scenes"
          ],
          "type": "object"
        },
        {
          "description": "The result of `video.snapshot`: the program mix encoded as a PNG.",
          "properties": {
            "height": {
              "description": "PNG height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "png": {
              "description": "The PNG file, standard base64 with padding and no line breaks.",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The collection revision of the layout this image shows."
            },
            "type": {
              "const": "video.snapshot",
              "type": "string"
            },
            "width": {
              "description": "PNG width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "rev",
            "width",
            "height",
            "png"
          ],
          "type": "object"
        },
        {
          "description": "The result of `video.frames`: the frame sheet.",
          "properties": {
            "columns": {
              "description": "Tiles per row.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "frames": {
              "description": "Each picture, in the order the tiles show them.",
              "items": {
                "$ref": "#/$defs/SheetFrame"
              },
              "type": "array"
            },
            "height": {
              "description": "The PNG's height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "png": {
              "description": "The PNG file, standard base64 with padding and no line breaks.",
              "type": "string"
            },
            "rows": {
              "description": "Rows of tiles.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "tile_height": {
              "description": "One tile's height in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "tile_width": {
              "description": "One tile's width in pixels: the canvas scaled down to fit 480 × 270.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "video.frames",
              "type": "string"
            },
            "width": {
              "description": "The PNG's width in pixels.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "width",
            "height",
            "columns",
            "rows",
            "tile_width",
            "tile_height",
            "frames",
            "png"
          ],
          "type": "object"
        },
        {
          "description": "The result of `kind.list`.",
          "properties": {
            "kinds": {
              "description": "Every kind, ordered by ID.",
