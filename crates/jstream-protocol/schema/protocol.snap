          ],
          "type": "object"
        }
      ]
    },
    "QuotaInfo": {
      "description": "The engine's estimate of the day's YouTube API quota (ADR-0041 §5). It adds up what\neach call the engine makes costs by YouTube's published unit costs. YouTube's own\ncount, which other apps on the same Google project share, can differ.",
      "properties": {
        "daily": {
          "description": "The units the engine assumes a day has.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "exhausted": {
          "description": "Whether YouTube refused a call since the quota last reset because it is used up.\nOmitted when it hasn't.",
          "type": "boolean"
        },
        "stats": {
          "$ref": "#/$defs/StatsPolling",
          "description": "How audience stats are polled now."
        },
        "used": {
          "description": "Units used since the quota last reset, by the engine's count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "used",
        "daily",
        "stats"
      ],
      "type": "object"
    },
    "RateControl": {
      "description": "How a video encoder spends bits. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Constant bit rate, as RTMP ingest expects.",
          "properties": {
            "kbps": {
              "description": "The target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "cbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps"
          ],
          "type": "object"
        },
        {
          "description": "Variable bit rate with a peak, for a recording.",
          "properties": {
            "kbps": {
              "description": "The average target, in kilobits per second.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "max_kbps": {
              "description": "The peak, in kilobits per second; at least `kbps`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "vbr",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kbps",
            "max_kbps"
          ],
          "type": "object"
        }
      ]
    },
    "RecordContainer": {
      "description": "The file format a recording is written in. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "mp4",
          "description": "MP4 with H.264 video and AAC audio, written fragmented (a fragment per video\nkeyframe, each synced to disk), so a crash loses at most the last fragment and\nthe `.part` file it leaves plays up to there.",
          "type": "string"
        }
      ]
    },
    "Request": {
      "description": "One request: a call plus the client-chosen ID its answer will carry.",
      "properties": {
        "call": {
          "$ref": "#/$defs/Call",
          "description": "What to do."
        },
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Echoed in the matching `response` or `error`."
        }
      },
      "required": [
        "id",
        "call"
      ],
      "type": "object"
    },
    "RequestId": {
      "description": "Chosen by the client for each request and echoed in its response or error.",
      "type": "string"
    },
    "Response": {
      "description": "A successful answer to a [`Request`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "The request's ID."
        },
        "result": {
          "$ref": "#/$defs/CallResult",
          "description": "What happened. Its `kind` matches the request's call."
        }
      },
      "required": [
        "id",
        "result"
      ],
      "type": "object"
    },
    "Rev": {
      "description": "The collection state revision.\n\nEvery applied batch increments it by exactly one. Queries report the revision they\nread, and a batch may name the revision it was computed against (`expected_rev`).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "RtmpTarget": {
      "description": "Where an RTMP output publishes. Serialized with an internal `type` tag.",
      "oneOf": [
        {
          "description": "Any RTMP(S) ingest server, named by its server URL.",
          "properties": {
            "type": {
              "const": "generic",
              "type": "string"
            },
            "url": {
              "description": "The server URL, `rtmp://host[:port]/app` or `rtmps://…`: what streaming\nservices call the \"server\" or \"ingest URL\". The stream key is not part of\nit: set that with `output.set_key`. The engine rejects, with\n`invalid_argument`, another scheme, a missing host or application, a bad\nport, whitespace or control characters, and anything that can carry a\ncredential: `user:password@`, a `?query` or a `#fragment`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "description": "A YouTube broadcast (ADR-0058): on `output.start` the engine reads the\nbroadcast's bound stream from the Live API and publishes to that stream's\n`rtmps://` ingest address with its key. The key comes from YouTube, so\n`output.set_key` isn't needed. The start fails with `action_failed` when the\nengine isn't signed in to YouTube, the broadcast has no bound stream\n(`youtube.bind_broadcast`), or YouTube refuses. The engine rejects, with\n`invalid_argument`, an ID that is empty, longer than 128 bytes or has characters\nother than ASCII letters, digits, `-` and `_`.",
          "properties": {
            "broadcast_id": {
              "description": "The broadcast's ID, as `youtube.list_broadcasts` reports it.",
              "type": "string"
            },
            "type": {
              "const": "youtube",
              "type": "string"
            }
          },
          "required": [
            "type",
            "broadcast_id"
          ],
          "type": "object"
        }
      ]
    },
    "SceneId": {
      "description": "A scene in the collection.",
      "type": "string"
    },
    "SceneInfo": {
      "description": "One scene with its items, as `state.get` reports it.",
      "properties": {
        "color": {
          "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "favourite": {
          "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its filter chains (ADR-0065, since 0.43), which `filter.*` edits with the owner\n`{\"type\":\"scene\",\"scene_id\":…}`. They run on the scene's composite. Only the video\nchain holds filters, and a keyframe scene has none of its own, since it shows its\nparent's. Omitted while both are empty, so missing (also from an older server)\nparses as none."
        },
        "folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The folder it is filed in (ADR-0024 §3). Omitted for none."
        },
        "icon": {
          "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "description": "Its items, in stacking order: the first is at the bottom. Always empty for a\nkeyframe scene, which shows its parent's.",
          "items": {
            "$ref": "#/$defs/ItemInfo"
          },
          "type": "array"
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "overrides": {
          "description": "A keyframe scene's overrides of its parent's items, in item ID order. Omitted\nwhen there are none, and for every scene that is not a variant.",
          "items": {
            "$ref": "#/$defs/ItemOverride"
          },
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        },
        "show_in_multiview": {
          "description": "Whether a multiview shows it. Omitted for `true`, the default.",
          "type": "boolean"
        },
        "transition_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionPresetId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The preset a switch into this scene uses, unless the switch names one. Omitted\nfor none."
        },
        "transition_out": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionPresetId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The preset a switch out of this scene uses, unless the switch or the next scene\nnames one. Omitted for none."
        },
        "variant_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The scene this one is a keyframe scene of (ADR-0024 §2, protocol 0.39), whose\nitems it shows. Omitted for a scene that is not a variant."
        }
      },
      "required": [
        "scene_id",
        "name",
        "items"
      ],
      "type": "object"
    },
    "SceneRole": {
      "description": "What a scene is for (ADR-0024 §1). It changes no engine behaviour; it tells clients,\nagents and switchers how to show the scene.",
      "oneOf": [
        {
          "const": "scene",
          "description": "A scene of its own, listed in the scene list. Scenes are created with this role\nunless `scene.create` names another.",
          "type": "string"
        },
        {
          "const": "group",
          "description": "A group: a scene placed in other scenes to hold items together. Clients hide it\nfrom the scene list and show it under the items that place it.",
          "type": "string"
        }
      ]
    },
    "SceneSummary": {
      "description": "One scene in a `scene.list` result.",
      "properties": {
        "color": {
          "description": "The scene's colour, sRGB as `#rrggbb`. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "favourite": {
          "description": "Whether it is a favourite. JStream is single-user, so this is not per person.\nOmitted for `false`.",
          "type": "boolean"
        },
        "folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The folder it is filed in (ADR-0024 §3). Omitted for none."
        },
        "icon": {
          "description": "An icon name from the UI's icon set, at most 64 bytes. Omitted for none.",
          "type": [
            "string",
            "null"
          ]
        },
        "item_count": {
          "description": "How many items it has.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SceneRole",
          "description": "What it is for: a `group` that clients hide from the scene list, or a `scene`.\nOmitted for a `scene`."
        },
        "scene_id": {
          "$ref": "#/$defs/SceneId",
          "description": "The scene's ID."
        },
        "show_in_multiview": {
          "description": "Whether a multiview shows it. Omitted for `true`, the default.",
          "type": "boolean"
        }
      },
      "required": [
        "scene_id",
        "name",
        "item_count"
      ],
      "type": "object"
    },
    "SecretString": {
      "description": "A secret string, such as a stream key sent by a client to the engine, or the\npairing code a server answers `pairing.start` with.\n\nOn the wire it is a plain JSON string. In Rust it never prints: its `Debug` is\n`\"***\"`, it has no `Display`, and the only way to read it is [`expose`](Self::expose).\nA value that is not a string fails to parse with a message that doesn't repeat it.\nThe engine never sends one back, and a pairing code travels only in that one answer\n(R-SEC-001).",
      "type": "string"
    },
    "SendInfo": {
      "description": "One send: a source's audio routed into a bus, post-fader, as `bus.list` and\n`state.get` report it.",
      "properties": {
        "bus_id": {
          "$ref": "#/$defs/BusId",
          "description": "The bus it sends into."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The send's gain, in dB, applied after the source's fader: from −100 to +24."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source sending."
        }
      },
      "required": [
        "source_id",
        "bus_id",
        "gain_db"
      ],
      "type": "object"
    },
    "ServerMessage": {
      "description": "A message from the server to a client. Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Welcome",
          "description": "Accepts the handshake.",
          "properties": {
            "type": {
              "const": "welcome",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/Response",
          "description": "A request succeeded.",
          "properties": {
            "type": {
              "const": "response",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ErrorResponse",
          "description": "A request (or the handshake, or an unparseable message) failed.",
          "properties": {
            "type": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/EventMessage",
          "description": "Something happened in the engine.",
          "properties": {
            "type": {
              "const": "event",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Settings": {
      "additionalProperties": true,
      "description": "A source's (or later a filter's) settings: parameter ID to value.\n\nThe values follow the kind's descriptor (`kind.describe`). The engine validates every\nedit against it and stores the complete map, so a reported map holds every parameter\nof the kind.",
      "type": "object"
    },
    "Size": {
      "description": "A width and height, in canvas pixels.\n\nBoth components are [`Finite32`]. A non-positive component is rejected by\n[`ItemGeometry::validate`], not stored as a flip.",
      "properties": {
        "height": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical extent. Must be greater than zero for a placement to be valid."
        },
        "width": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal extent. Must be greater than zero for a placement to be valid."
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "SourceAudio": {
      "description": "A source's audio settings, as `source.list` and `state.get` report them. Only an\naudio source has them: a source whose kind produces audio, or a `scene` source (a\nnested scene, whose audio is its contents').\n\nSignal order (ADR-0028): the source's stream, then its fader and mute, then the\nactivity gain `follow` sets, then each send's gain into its bus.",
      "properties": {
        "enabled": {
          "description": "Whether the engine opens the source's audio at all. Off, the source has no mixer\nchannel and no meter, and its sends are kept but carry nothing, so turning it\nback on restores them. Not the same as `muted`, which keeps the stream open and\nmetered. For a `scene` source, off stops what the scene shows from being heard\nthrough it. New sources start on.",
          "type": "boolean"
        },
        "follow": {
          "$ref": "#/$defs/AudioFollow",
          "description": "When it is heard. A new source takes its kind's default: `always` for a kind\nwith audio and no video (an audio input), `when_shown` for every other audio\nsource, `scene` sources included."
        },
        "gain_db": {
          "$ref": "#/$defs/Finite32",
          "description": "The fader, in dB, applied before the sends: from −100 to +24. New sources start\nat 0. Always 0 for a `scene` source, which has no fader of its own."
        },
        "muted": {
          "description": "Whether the source is muted: still open and metered, but feeding no bus. Always\nfalse for a `scene` source, which has no mute of its own.",
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "follow",
        "gain_db",
        "muted"
      ],
      "type": "object"
    },
    "SourceId": {
      "description": "A source (capture, media, color, ...). One instance however many scenes use it.",
      "type": "string"
    },
    "SourceInfo": {
      "description": "One source, as `source.list` and `state.get` report it.",
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAudio"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its audio settings, for an audio source: one whose kind produces audio, or a\n`scene` source. Omitted for every other source, and by a server older than 0.19."
        },
        "duplicated_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The source this one was copied from by `source.duplicate`, while that source\nexists. Omitted if it was not copied, or its original has been deleted. An item\nplacing this source can go back to placing the original with `item.set_source`."
        },
        "favourite": {
          "description": "Whether it is a favourite. Omitted for `false`.",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/FilterChains",
          "description": "Its filter chains (ADR-0026). Omitted while both are empty."
        },
        "kind": {
          "$ref": "#/$defs/SourceKind",
          "description": "What it shows."
        },
        "labels": {
          "description": "The labels it carries, ordered by ID, each at most once. Every one must exist.\nOmitted for none.",
          "items": {
            "$ref": "#/$defs/LabelId"
          },
          "type": "array"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its settings: every parameter of its kind. Empty (and omitted) for a `scene`\nsource and for a kind without parameters."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source's ID."
        }
      },
      "required": [
        "source_id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "SourceKind": {
      "description": "What a source shows.\n\nSerialized with an internal `type` tag. A source is one shared instance: every item\nthat places it shows the same capture, and (once filters land) the same filters.",
      "oneOf": [
        {
          "description": "Another scene, composited as one layer (a nested scene). An `item.add` that would\nmake a scene contain itself, directly or through other scenes, is rejected with\n`invalid_argument` naming the cycle.",
          "properties": {
            "scene_id": {
              "$ref": "#/$defs/SceneId",
              "description": "The scene shown."
            },
            "type": {
              "const": "scene",
              "type": "string"
            }
          },
          "required": [
            "type",
            "scene_id"
          ],
          "type": "object"
        },
        {
          "description": "A built-in source kind named by the engine (`display`, `window`, `webcam`,\n`image`, `color`, `text`, `media`). `kind.list` reports the kinds, and\n`kind.describe` the settings each takes; the settings travel beside the kind, on\nthe source.",
          "properties": {
            "kind": {
              "description": "The kind's ID, as `kind.list` reports it.",
              "type": "string"
            },
            "type": {
              "const": "builtin",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SourceMeter": {
      "description": "One source's levels in a `meters.tick`, post-fader and before its sends. Levels are\nlinear full scale per channel, left then right: 1.0 is 0 dBFS, 0.0 is silence.",
      "properties": {
        "peak": {
          "description": "The largest absolute sample since the previous tick.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "rms": {
          "description": "The RMS level over the most recent mixer block.",
          "items": {
            "$ref": "#/$defs/Finite32"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id",
        "peak",
        "rms"
      ],
      "type": "object"
    },
    "SourceSize": {
      "description": "One source's current size, in a `source.sizes` result.",
      "properties": {
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its current frame's size. Omitted while the source has no video frame: it hasn't\nstarted, it has no video (an audio-only kind), or it failed."
        },
        "source_id": {
          "$ref": "#/$defs/SourceId",
          "description": "The source."
        }
      },
      "required": [
        "source_id"
      ],
      "type": "object"
    },
    "StatsPolling": {
      "description": "How the engine polls audience stats, by how much of the day's estimated YouTube\nquota is left (ADR-0041 §5). Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "normal",
          "description": "At the normal rate.",
          "type": "string"
        },
        {
          "const": "slowed",
          "description": "Less often, because the quota is running low.",
          "type": "string"
        },
        {
          "const": "stopped",
          "description": "Not at all until the quota resets, because it is nearly or entirely used up.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from a newer server.",
          "type": "string"
        }
      ]
    },
    "StreamHealth": {
      "description": "How YouTube rates what a stream receives (`status.healthStatus.status`). Serialized\nas a snake_case string.",
      "oneOf": [
        {
          "const": "good",
          "description": "No problems.",
          "type": "string"
        },
        {
          "const": "ok",
          "description": "Minor problems.",
          "type": "string"
        },
        {
          "const": "bad",
          "description": "Problems that hurt the stream.",
          "type": "string"
        },
        {
          "const": "no_data",
          "description": "YouTube has no data yet.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "StreamInfo": {
      "description": "One stream, as `youtube.list_streams` reports it. Its key is never reported.",
      "properties": {
        "health": {
          "$ref": "#/$defs/StreamHealth",
          "description": "How healthy what it receives is."
        },
        "status": {
          "$ref": "#/$defs/StreamStatus",
          "description": "What it is doing."
        },
        "stream_id": {
          "description": "YouTube's ID for it: what `youtube.bind_broadcast` takes.",
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "type": "string"
        }
      },
      "required": [
        "stream_id",
        "title",
        "status",
        "health"
      ],
      "type": "object"
    },
    "StreamStatus": {
      "description": "What YouTube says a stream is doing (`status.streamStatus`). Serialized as a\nsnake_case string.",
      "oneOf": [
        {
          "const": "active",
          "description": "Receiving data.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "Created, with settings still missing.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Something is wrong with it.",
          "type": "string"
        },
        {
          "const": "inactive",
          "description": "Not receiving data.",
          "type": "string"
        },
        {
          "const": "ready",
          "description": "Ready to receive data.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A value this version doesn't know, from YouTube or a newer server.",
          "type": "string"
        }
      ]
    },
    "TransitionEffect": {
      "description": "How an item without a partner appears or disappears.",
      "oneOf": [
        {
          "const": "inherit",
          "description": "The preset's `unmatched` setting.",
          "type": "string"
        },
        {
          "const": "fade",
          "description": "Opacity only.",
          "type": "string"
        },
        {
          "const": "scale",
          "description": "Toward 65% of its size about its centre, while fading.",
          "type": "string"
        },
        {
          "const": "slide",
          "description": "Toward the nearest canvas edge until it is off the canvas, while fading.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "At once, at the item's start: no animation.",
          "type": "string"
        }
      ]
    },
    "TransitionPresetId": {
      "description": "A transition preset in the collection (ADR-0029).",
      "type": "string"
    },
    "TransitionPresetInfo": {
      "description": "One transition preset, as `state.get` reports it.",
      "properties": {
        "duration_ms": {
          "description": "How long one item takes, in milliseconds. A kind that ignores it (`cut`) still\nkeeps it.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "easing": {
          "$ref": "#/$defs/Easing",
          "description": "The curve its items follow unless they set their own."
        },
        "kind": {
          "description": "Its transition kind's ID, as `kind.list` reports it (`cut`, `fade`, `move`).",
          "type": "string"
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        },
        "preset_id": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset's ID."
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Its kind's settings: every parameter of the kind. Omitted for a kind without\nparameters."
        }
      },
      "required": [
        "preset_id",
        "name",
        "kind",
        "duration_ms",
        "easing"
      ],
      "type": "object"
    },
    "TransitionStarted": {
      "description": "What `studio.changed` reports about the transition a switch started.",
      "properties": {
        "duration_ms": {
          "description": "How long the transition runs, in milliseconds, from the switch to its last item's\nend. 0 for a cut, which shows the new scene on the next frame.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "preset_id": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset the engine chose: the one the switch named, else the new scene's\n`transition_in`, else the old scene's `transition_out`, else the default."
        }
      },
      "required": [
        "preset_id",
        "duration_ms"
      ],
      "type": "object"
    },
    "TransitionsInfo": {
      "description": "The collection's transition presets, as `state.get` reports them.",
      "properties": {
        "default": {
          "$ref": "#/$defs/TransitionPresetId",
          "description": "The preset a switch uses when nothing else names one. It always exists."
        },
        "presets": {
          "description": "Every preset, ordered by ID.",
          "items": {
            "$ref": "#/$defs/TransitionPresetInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "presets",
        "default"
      ],
      "type": "object"
    },
    "Vec2": {
      "description": "A 2D position or scale, in output pixels (position) or as a factor (scale).\n\nBoth components are [`Finite32`]: a non-finite or out-of-`f32`-range number (`1e39`)\nfails deserialization, so the message is rejected as `malformed`, and in-process code\ncan't build a non-finite value.",
      "properties": {
        "x": {
          "$ref": "#/$defs/Finite32",
          "description": "Horizontal component."
        },
        "y": {
          "$ref": "#/$defs/Finite32",
          "description": "Vertical component."
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "VideoCodec": {
      "description": "A video codec. Serialized as a snake_case string. Streams carry HEVC and AV1 in\nenhanced RTMP; a recording takes H.264 only so far, and its start fails with another.\nA machine with no encoder for the codec, or none that fits the profile's\n`hardware`, fails `output.start`.",
      "oneOf": [
        {
          "const": "h264",
          "description": "H.264 (AVC).",
          "type": "string"
        },
        {
          "const": "hevc",
          "description": "HEVC (H.265). Since 0.41.",
          "type": "string"
        },
        {
          "const": "av1",
          "description": "AV1. Since 0.41.",
          "type": "string"
        }
      ]
    },
    "VideoEncoding": {
      "description": "How the video is encoded.",
      "properties": {
        "codec": {
          "$ref": "#/$defs/VideoCodec",
          "description": "The codec."
        },
        "hardware": {
          "$ref": "#/$defs/HardwarePreference",
          "default": "avoid",
          "description": "Whether to use a hardware encoder. Omitted means `avoid`."
        },
        "keyframe_interval_s": {
          "description": "Seconds from one keyframe to the next, 1..=10, else `invalid_argument`. Most\nstreaming services ask for 2.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rate_control": {
          "$ref": "#/$defs/RateControl",
          "description": "How the encoder spends bits. Rejected with `invalid_argument` outside\n100..=100000 kbit/s, or, for `vbr`, with a peak below the average or above\n200000 kbit/s."
        }
      },
      "required": [
        "codec",
        "rate_control",
        "keyframe_interval_s"
      ],
      "type": "object"
    },
    "VideoMix": {
      "description": "A mix: which picture, at what size and rate.",
      "properties": {
        "fps_divisor": {
          "default": 1,
          "description": "Renders every `fps_divisor`th tick of the engine's base frame rate: 1 is the base\nrate, 2 half of it. Missing parses as 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "input": {
          "$ref": "#/$defs/MixInput",
          "description": "What it shows."
        },
        "resolution": {
          "$ref": "#/$defs/MixResolution",
          "description": "Its frame size in pixels. The canvas is fitted inside it, centred, with black\nbars where the aspect ratios differ, never stretched (ADR-0022)."
        }
      },
      "required": [
        "input",
        "resolution"
      ],
      "type": "object"
    },
    "VideoMixId": {
      "description": "A video mix in the collection: what an output's video shows.",
      "type": "string"
    },
    "VideoMixInfo": {
      "description": "One mix, as `video_mix.list` and `state.get` report it.",
      "properties": {
        "mix": {
          "$ref": "#/$defs/VideoMix",
          "description": "What it shows, and at what size and rate."
        },
        "mix_id": {
          "$ref": "#/$defs/VideoMixId",
          "description": "The mix's ID."
        },
        "name": {
          "description": "Its display name.",
          "type": "string"
        }
      },
      "required": [
        "mix_id",
        "name",
        "mix"
      ],
      "type": "object"
    },
    "VisibleIf": {
      "description": "A UI hint: show a parameter only while parameter `param` equals `equals`. Hints never\naffect validation.",
      "properties": {
        "equals": {
          "description": "The value it must have."
        },
        "param": {
          "description": "The parameter whose value decides.",
          "type": "string"
        }
      },
      "required": [
        "param",
        "equals"
      ],
      "type": "object"
    },
    "Welcome": {
      "description": "The server's answer to [`Hello`].",
      "properties": {
        "client_id": {
          "$ref": "#/$defs/ClientId",
          "description": "The identity this connection acts as: its undo history and audit-log entries are\nkeyed by it."
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the server speaks."
        },
        "rev": {
          "$ref": "#/$defs/Rev",
          "description": "The current state revision, so the client knows where it starts."
        }
      },
      "required": [
        "protocol",
        "client_id",
        "rev"
      ],
      "type": "object"
    },
    "WireError": {
      "description": "A [`ProtocolError`] as sent on the wire: its `code` and details, plus a message.\n\n```json\n{\"code\": \"rev_conflict\", \"expected\": 4, \"current\": 5,\n \"message\": \"expected rev 4, but the state is at rev 5\"}\n```",
      "oneOf": [
        {
          "description": "The server can't speak the client's protocol version.",
          "properties": {
            "client": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the client asked for in `hello`."
            },
            "code": {
              "const": "unsupported_version",
              "type": "string"
            },
            "server": {
              "$ref": "#/$defs/ProtocolVersion",
              "description": "The version the server speaks."
            }
          },
          "required": [
            "code",
            "client",
            "server"
          ],
          "type": "object"
        },
        {
          "description": "A request arrived before the `hello`/`welcome` handshake finished.",
          "properties": {
            "code": {
              "const": "handshake_required",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The message could not be parsed: bad JSON, an unknown `type`, a missing or\nmistyped field, or a number that isn't a finite `f32` (NaN, infinity, or out of\nrange such as `1e39`). `ClientMessage::parse` produces it.",
          "properties": {
            "code": {
              "const": "malformed",
              "type": "string"
            },
            "reason": {
              "description": "What the parser reported.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "A batch had no edits.",
          "properties": {
            "code": {
              "const": "empty_batch",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "description": "The batch's `expected_rev` was not the current revision. Nothing was applied:\nre-read the state and retry.",
          "properties": {
            "code": {
              "const": "rev_conflict",
              "type": "string"
            },
            "current": {
              "$ref": "#/$defs/Rev",
              "description": "The state's revision when the batch was checked."
            },
            "expected": {
              "$ref": "#/$defs/Rev",
              "description": "The `expected_rev` the batch carried."
            }
          },
          "required": [
            "code",
            "expected",
            "current"
          ],
          "type": "object"
        },
        {
          "description": "A command named an object that doesn't exist.",
          "properties": {
            "code": {
              "const": "not_found",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A creating edit used an ID that is already taken.",
          "properties": {
            "code": {
              "const": "already_exists",
              "type": "string"
            },
            "entity": {
              "$ref": "#/$defs/EntityKind",
              "description": "What kind of object."
            },
            "id": {
              "description": "The ID given.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "entity",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A field had a value the engine can't accept.",
          "properties": {
            "blockers": {
              "description": "When a `scene.delete` or `source.delete` is refused because other objects still\nrefer to its target: every one of those references, in a stable order. The\n`delete.plan` query returns the batch that removes them with the target. Empty\notherwise, and then omitted. Missing (from a server older than 0.15)\nparses as empty.",
              "items": {
                "$ref": "#/$defs/Blocker"
              },
              "type": "array"
            },
            "code": {
              "const": "invalid_argument",
              "type": "string"
            },
            "field": {
              "description": "The field, as a dotted path into the command (`edits.2.name`).",
              "type": "string"
            },
            "reason": {
              "description": "Why it was rejected.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "field",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "An undo or redo would overwrite another client's work: a batch that client\napplied after the step changed a property the step sets, created or deleted an\nobject the step creates or deletes, or made the step's edits no longer apply.\nNothing was applied, and the step was dropped from the history, so the next undo\nreaches the step before it.",
          "properties": {
            "client_id": {
              "$ref": "#/$defs/ClientId",
              "description": "The client whose batch conflicts."
            },
            "code": {
              "const": "undo_conflict",
              "type": "string"
            },
            "rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision that batch produced."
            },
            "step_rev": {
              "$ref": "#/$defs/Rev",
              "description": "The revision the step's batch originally produced."
            }
          },
          "required": [
            "code",
            "step_rev",
            "client_id",
            "rev"
          ],
          "type": "object"
        },
        {
          "description": "There is nothing to undo, or nothing to redo.",
          "properties": {
            "code": {
              "const": "history_empty",
              "type": "string"
            },
            "direction": {
              "$ref": "#/$defs/HistoryDirection",
              "description": "Which way the call asked to move."
            }
          },
          "required": [
            "code",
            "direction"
          ],
          "type": "object"
        },
        {
          "description": "An action was accepted for processing but could not be carried out.",
          "properties": {
            "code": {
              "const": "action_failed",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The call is valid, but whoever answered it doesn't serve it: `pairing.start`,\n`device.list` and `device.revoke` sent to an engine with no server in front,\na `plugin.*` action sent to an engine that hosts no plugins yet, or the deprecated\n`privacy.set` (ADR-0080).\nRetrying won't help.",
          "properties": {
            "call": {
              "description": "The call's name (`pairing.start`).",
              "type": "string"
            },
            "code": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call"
          ],
          "type": "object"
        },
        {
          "description": "The caller may not make this call (0.35): a plugin's call outside its granted\ncapability classes, a command no plugin is ever granted, or a plugin past its cap\nof commands a second (ADR-0069). Nothing was applied. Retrying won't help until\na person widens the grant, except after the command cap, which clears within a\nsecond.",
          "properties": {
            "call": {
              "description": "The call's name (`output.start`), or for a batch, its first edit's.",
              "type": "string"
            },
            "code": {
              "const": "forbidden",
              "type": "string"
            },
            "reason": {
              "description": "Why: the class the caller lacks, or that no plugin may make it.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "call",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "`output.start` could not open a hardware video encoder while other hardware\nencoder sessions were open, so the machine's hardware session limit is taken to\nbe reached (0.44, ADR-0080 §3). The engine doesn't guess vendor caps and never\nfalls back to a software encoder for this. Nothing was started. Stop one of\n`outputs`, share an encoder session with one, or start this output with an\nencoder profile whose `hardware` is `avoid`.",
          "properties": {
            "code": {
              "const": "hardware_session_limit",
              "type": "string"
            },
            "outputs": {
              "description": "The running outputs that hold hardware encoder sessions, sorted.",
              "items": {
                "$ref": "#/$defs/OutputId"
              },
              "type": "array"
            },
            "reason": {
              "description": "What the encoder said when it refused the new session.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "outputs",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "The engine hit a bug or an unexpected condition. The request may be retried.",
          "properties": {
            "code": {
              "const": "internal",
              "type": "string"
            },
            "reason": {
              "description": "What went wrong.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "reason"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "message": {
          "description": "A human-readable explanation, for logs and for agents. Not stable: match on\n`code`, never on this.",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "YoutubeAuth": {
      "description": "Whether the engine is signed in to YouTube. Serialized as a snake_case string.",
      "oneOf": [
        {
          "const": "unavailable",
          "description": "The engine has no Google OAuth client (as in a build whose built-in client is\nstill empty), so YouTube's API features are off. Clients hide YouTube's sign-in and\nbroadcast controls; the YouTube actions and queries fail with `action_failed`.",
          "type": "string"
        },
        {
          "const": "signed_out",
          "description": "Not signed in. `youtube.sign_in` starts a sign-in.",
          "type": "string"
        },
        {
          "const": "signing_in",
          "description": "A sign-in is waiting for the user to finish it in the browser.",
          "type": "string"
        },
        {
          "const": "signed_in",
          "description": "Signed in. The engine holds the account's refresh token in the OS credential\nstore and uses it for every YouTube call.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "A state this version of the protocol doesn't know, from a newer server.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ],
  "description": "Any message on a JStream control connection: client to server, or server to client.",
  "title": "JStream protocol 0.55"
}
