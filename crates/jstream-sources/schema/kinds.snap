---
source: crates/jstream-sources/tests/kinds.rs
---
[
  {
    "kind_id": "app_audio",
    "category": "source",
    "name": "Application audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "exe",
        "type": "string",
        "multiline": false,
        "max_len": 260,
        "default": "",
        "label": "Application",
        "description": "The application's executable file name, such as game.exe. It is found again when the application restarts.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "audio_input",
    "category": "source",
    "name": "Audio input",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "device",
        "type": "string",
        "multiline": false,
        "max_len": 512,
        "default": "",
        "label": "Device",
        "description": "The input device's ID. Empty follows the system's default input.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "backdrop",
    "category": "source",
    "name": "Backdrop",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "style",
        "type": "enum",
        "options": [
          {
            "value": "canvas",
            "label": "Painted canvas"
          },
          {
            "value": "muslin",
            "label": "Muslin"
          },
          {
            "value": "paper",
            "label": "Seamless paper"
          }
        ],
        "default": "canvas",
        "label": "Style",
        "description": "Painted canvas has brushy, broken mottling; muslin softer, larger clouds; seamless paper is a smooth sweep with almost none.",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": false,
        "default": "#56697f",
        "label": "Color",
        "description": "The backdrop's main color, where the light falls.",
        "live": true
      },
      {
        "id": "accent",
        "type": "color",
        "alpha": false,
        "default": "#202c3a",
        "label": "Accent",
        "description": "The second color mottled in. A darker or shifted shade of Color looks most like paint.",
        "live": true
      },
      {
        "id": "texture",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.6,
        "label": "Texture",
        "description": "How strongly the two colors mottle. 0 is a plain gradient.",
        "live": true
      },
      {
        "id": "scale",
        "type": "float",
        "min": 0.25,
        "max": 4.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Scale",
        "description": "The size of the mottling: above 1 is larger clouds.",
        "live": true
      },
      {
        "id": "light",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.6,
        "label": "Light",
        "description": "How bright the pool of light is.",
        "live": true
      },
      {
        "id": "light_x",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.5,
        "label": "Light X",
        "description": "Where the light falls, from the left edge (0) to the right (1).",
        "live": true
      },
      {
        "id": "light_y",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.42,
        "label": "Light Y",
        "description": "Where the light falls, from the top (0) to the bottom (1).",
        "live": true
      },
      {
        "id": "vignette",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.5,
        "label": "Vignette",
        "description": "How much the edges and corners fall off into shadow.",
        "live": true
      },
      {
        "id": "grain",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.35,
        "label": "Grain",
        "description": "Film grain over everything.",
        "live": true
      },
      {
        "id": "seed",
        "type": "int",
        "min": 0,
        "max": 999999,
        "step": 1,
        "default": 1,
        "label": "Seed",
        "description": "Another number draws another backdrop with the same look.",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      }
    ]
  },
  {
    "kind_id": "browser",
    "category": "source",
    "name": "Browser",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "url",
        "type": "string",
        "multiline": false,
        "max_len": 8192,
        "default": "",
        "label": "URL",
        "description": "The page's address, http:// or https://. Ignored when a local file is set.",
        "live": false
      },
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "html",
          "htm"
        ],
        "default": null,
        "label": "Local file",
        "description": "A local HTML file to show instead of a URL. The page can load files beside it.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      },
      {
        "id": "fps",
        "type": "int",
        "min": 1,
        "max": 60,
        "step": 1,
        "unit": "fps",
        "default": 30,
        "label": "Frame rate",
        "description": "The most frames a second the page paints. It paints less when nothing changes.",
        "live": false
      },
      {
        "id": "css",
        "type": "string",
        "multiline": true,
        "max_len": 65536,
        "default": "body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }",
        "label": "Custom CSS",
        "description": "CSS added to the page after it loads. The default makes the page's background transparent.",
        "live": true
      },
      {
        "id": "local_network",
        "type": "bool",
        "default": false,
        "label": "Allow local network",
        "description": "Let a page from the internet make requests to this computer and the local network (localhost, 192.168.x.x and the like), for widgets that talk to an app running here. Off, those requests are refused. A local file or a page on the local network may always.",
        "advanced": true,
        "live": false
      }
    ]
  },
  {
    "kind_id": "chat_message",
    "category": "source",
    "name": "Chat message",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font. None uses the bundled Roboto, which covers Latin text only.",
        "live": false
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 256.0,
        "step": 1.0,
        "unit": "px",
        "default": 32.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "author_color",
        "type": "color",
        "alpha": true,
        "default": "#ffd54fff",
        "label": "Author color",
        "live": true
      },
      {
        "id": "text_color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Text color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#000000b3",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 16,
        "label": "Padding",
        "live": true
      },
      {
        "id": "max_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 600,
        "label": "Maximum width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline color",
        "live": true
      }
    ]
  },
  {
    "kind_id": "color",
    "category": "source",
    "name": "Color",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Color",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      }
    ]
  },
  {
    "kind_id": "desktop_audio",
    "category": "source",
    "name": "Desktop audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": []
  },
  {
    "kind_id": "display",
    "category": "source",
    "name": "Display capture",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "target",
        "type": "capture_target",
        "kind": "display",
        "max_len": 1024,
        "default": "",
        "label": "Display",
        "description": "The ID of the display to capture, as `capture.targets` lists it. Empty captures the primary display.",
        "live": false
      },
      {
        "id": "show_cursor",
        "type": "bool",
        "default": true,
        "label": "Show cursor",
        "description": "Whether the pointer shows in the capture.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "image",
    "category": "source",
    "name": "Image",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif"
        ],
        "default": null,
        "label": "Image file",
        "live": false
      }
    ]
  },
  {
    "kind_id": "media",
    "category": "source",
    "name": "Media file",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "mp4",
          "mkv",
          "mov",
          "webm",
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg"
        ],
        "default": null,
        "label": "Media file",
        "description": "A video or audio file the platform can play. Its sound plays while the program shows it, at speed 1.",
        "live": false
      },
      {
        "id": "loop",
        "type": "bool",
        "default": true,
        "label": "Loop",
        "live": true
      },
      {
        "id": "speed",
        "type": "float",
        "min": 0.25,
        "max": 4.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Speed",
        "description": "1 is normal speed.",
        "live": true
      },
      {
        "id": "restart_on_show",
        "type": "bool",
        "default": true,
        "label": "Restart when shown",
        "description": "Plays from the start each time the program shows it again.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "shape",
    "category": "source",
    "name": "Shape",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "shape",
        "type": "enum",
        "options": [
          {
            "value": "rectangle",
            "label": "Rectangle"
          },
          {
            "value": "ellipse",
            "label": "Ellipse"
          }
        ],
        "default": "rectangle",
        "label": "Shape",
        "description": "A rectangle (rounded by Corner radius, a pill when it is half the height) or an ellipse filling the size (a circle when square).",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 400,
        "label": "Width",
        "description": "Draw it at the size of the box it is placed in, so it isn't scaled.",
        "live": true
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 120,
        "label": "Height",
        "description": "See Width.",
        "live": true
      },
      {
        "id": "radius",
        "type": "float",
        "min": 0.0,
        "max": 4096.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Corner radius",
        "description": "A rectangle's corner radius; at most half the shorter side, which makes the short ends round.",
        "live": true
      },
      {
        "id": "fill",
        "type": "enum",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "linear",
            "label": "Linear gradient"
          },
          {
            "value": "radial",
            "label": "Radial gradient"
          }
        ],
        "default": "solid",
        "label": "Fill",
        "description": "Solid Color, or a gradient from Color to End color.",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "description": "The fill, or a gradient's start.",
        "live": true
      },
      {
        "id": "color2",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "End color",
        "description": "A gradient's end: at the far side of a linear one, the edge of a radial one.",
        "live": true
      },
      {
        "id": "angle",
        "type": "float",
        "min": 0.0,
        "max": 360.0,
        "step": 1.0,
        "unit": "deg",
        "default": 90.0,
        "label": "Angle",
        "description": "The direction a linear gradient runs from Color to End color: 0 is left to right, 90 top to bottom.",
        "visible_if": {
          "param": "fill",
          "equals": "linear"
        },
        "live": true
      },
      {
        "id": "border_width",
        "type": "float",
        "min": 0.0,
        "max": 4096.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Border width",
        "description": "A border inside the edge; 0 is none.",
        "live": true
      },
      {
        "id": "border_color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Border color",
        "description": "The border's color.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "spectrum",
    "category": "source",
    "name": "Audio spectrum",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "audio",
        "type": "bus",
        "default": null,
        "label": "Audio",
        "description": "What it draws. None draws the program mix: the master after its filters, as the outputs hear it. A bus draws that bus after its fader, before the master's filters. Either is silent while no output runs.",
        "live": false
      },
      {
        "id": "audio_source",
        "type": "source",
        "media": "audio",
        "default": null,
        "label": "Audio source",
        "description": "A source to draw instead of the audio above: that source after its own filters, fader, mute and follow, before any bus, as the audience hears it. Silent while that source isn't playing into the mixer, and while no output runs.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 640,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 240,
        "label": "Height",
        "live": false
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "bars",
        "type": "int",
        "min": 1,
        "max": 1024,
        "step": 1,
        "default": 64,
        "label": "Bars",
        "live": true
      },
      {
        "id": "smoothing",
        "type": "float",
        "min": 0.0,
        "max": 0.99,
        "step": 0.01,
        "default": 0.7,
        "label": "Smoothing",
        "description": "How slowly a bar falls back: 0 follows the audio exactly.",
        "live": true
      },
      {
        "id": "scale",
        "type": "enum",
        "options": [
          {
            "value": "log",
            "label": "Logarithmic"
          },
          {
            "value": "linear",
            "label": "Linear"
          }
        ],
        "default": "log",
        "label": "Scale",
        "description": "How frequencies spread across the bars: log gives each octave the same width from 20 Hz, as the ear hears them; linear gives each hertz the same width from 0 Hz.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "text",
    "category": "source",
    "name": "Text",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "text",
        "type": "string",
        "multiline": true,
        "max_len": 4096,
        "default": "",
        "label": "Text",
        "live": true
      },
      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font, or the first font of a collection. None uses the bundled Roboto.",
        "live": false
      },
      {
        "id": "face",
        "type": "enum",
        "options": [
          {
            "value": "regular",
            "label": "Regular"
          },
          {
            "value": "bold",
            "label": "Bold"
          },
          {
            "value": "condensed_bold",
            "label": "Condensed bold"
          }
        ],
        "default": "regular",
        "label": "Face",
        "description": "The bundled face drawn while Font is none. A font file ignores it.",
        "live": true
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 1024.0,
        "step": 1.0,
        "unit": "px",
        "default": 64.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "align",
        "type": "enum",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centre"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Alignment",
        "live": true
      },
      {
        "id": "wrap_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Wrap width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Padding",
        "live": true
      },
      {
        "id": "letter_spacing",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "step": 0.5,
        "unit": "px",
        "default": 0.0,
        "label": "Letter spacing",
        "description": "Added after every character. Negative draws them closer.",
        "live": true
      },
      {
        "id": "shadow_color",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Shadow color",
        "description": "The text's shadow, drawn under its outline and fill. Fully transparent draws none.",
        "live": true
      },
      {
        "id": "shadow_x",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Shadow X",
        "live": true
      },
      {
        "id": "shadow_y",
        "type": "float",
        "min": -200.0,
