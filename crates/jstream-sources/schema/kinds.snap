      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font, or the first font of a collection. None uses the bundled Roboto.",
        "live": false
      },
      {
        "id": "face",
        "type": "enum",
        "options": [
          {
            "value": "regular",
            "label": "Regular"
          },
          {
            "value": "bold",
            "label": "Bold"
          },
          {
            "value": "condensed_bold",
            "label": "Condensed bold"
          }
        ],
        "default": "regular",
        "label": "Face",
        "description": "The bundled face drawn while Font is none. A font file ignores it.",
        "live": true
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 1024.0,
        "step": 1.0,
        "unit": "px",
        "default": 64.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "align",
        "type": "enum",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Centre"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Alignment",
        "live": true
      },
      {
        "id": "wrap_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Wrap width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Padding",
        "live": true
      },
      {
        "id": "letter_spacing",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "step": 0.5,
        "unit": "px",
        "default": 0.0,
        "label": "Letter spacing",
        "description": "Added after every character. Negative draws them closer.",
        "live": true
      },
      {
        "id": "shadow_color",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Shadow color",
        "description": "The text's shadow, drawn under its outline and fill. Fully transparent draws none.",
        "live": true
      },
      {
        "id": "shadow_x",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Shadow X",
        "live": true
      },
      {
        "id": "shadow_y",
        "type": "float",
        "min": -200.0,
        "max": 200.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Shadow Y",
        "live": true
      },
      {
        "id": "shadow_blur",
        "type": "float",
        "min": 0.0,
        "max": 100.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Shadow blur",
        "description": "How far the shadow's edge spreads, softening.",
        "live": true
      }
    ]
  },
  {
