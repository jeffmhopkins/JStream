---
source: crates/jstream-sources/tests/kinds.rs
---
[
  {
    "kind_id": "app_audio",
    "category": "source",
    "name": "Application audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "exe",
        "type": "string",
        "multiline": false,
        "max_len": 260,
        "default": "",
        "label": "Application",
        "description": "The application's executable file name, such as game.exe. It is found again when the application restarts.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "audio_input",
    "category": "source",
    "name": "Audio input",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "device",
        "type": "string",
        "multiline": false,
        "max_len": 512,
        "default": "",
        "label": "Device",
        "description": "The input device's ID. Empty follows the system's default input.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "backdrop",
    "category": "source",
    "name": "Backdrop",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "style",
        "type": "enum",
        "options": [
          {
            "value": "canvas",
            "label": "Painted canvas"
          },
          {
            "value": "muslin",
            "label": "Muslin"
          },
          {
            "value": "paper",
            "label": "Seamless paper"
          }
        ],
        "default": "canvas",
        "label": "Style",
        "description": "Painted canvas has brushy, broken mottling; muslin softer, larger clouds; seamless paper is a smooth sweep with almost none.",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": false,
        "default": "#56697f",
        "label": "Color",
        "description": "The backdrop's main color, where the light falls.",
        "live": true
      },
      {
        "id": "accent",
        "type": "color",
        "alpha": false,
        "default": "#202c3a",
        "label": "Accent",
        "description": "The second color mottled in. A darker or shifted shade of Color looks most like paint.",
        "live": true
      },
      {
        "id": "texture",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.6,
        "label": "Texture",
        "description": "How strongly the two colors mottle. 0 is a plain gradient.",
        "live": true
      },
      {
        "id": "scale",
        "type": "float",
        "min": 0.25,
        "max": 4.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Scale",
        "description": "The size of the mottling: above 1 is larger clouds.",
        "live": true
      },
      {
        "id": "light",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.6,
        "label": "Light",
        "description": "How bright the pool of light is.",
        "live": true
      },
      {
        "id": "light_x",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.5,
        "label": "Light X",
        "description": "Where the light falls, from the left edge (0) to the right (1).",
        "live": true
      },
      {
        "id": "light_y",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.42,
        "label": "Light Y",
        "description": "Where the light falls, from the top (0) to the bottom (1).",
        "live": true
      },
      {
        "id": "vignette",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.5,
        "label": "Vignette",
        "description": "How much the edges and corners fall off into shadow.",
        "live": true
      },
      {
        "id": "grain",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.35,
        "label": "Grain",
        "description": "Film grain over everything.",
        "live": true
      },
      {
        "id": "seed",
        "type": "int",
        "min": 0,
        "max": 999999,
        "step": 1,
        "default": 1,
        "label": "Seed",
        "description": "Another number draws another backdrop with the same look.",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 7680,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "description": "At most 7680, and 7680 × 4320 pixels in all. It scales up smoothly.",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 7680,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "description": "At most 7680, and 7680 × 4320 pixels in all. It scales up smoothly.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "browser",
    "category": "source",
    "name": "Browser",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "url",
        "type": "string",
        "multiline": false,
        "max_len": 8192,
        "default": "",
        "label": "URL",
        "description": "The page's address, http:// or https://. Ignored when a local file or HTML is set.",
        "live": false
      },
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "html",
          "htm"
        ],
        "default": null,
        "label": "Local file",
        "description": "A local HTML file to show instead of a URL. The page can load files beside it.",
        "live": false
      },
      {
        "id": "html",
        "type": "string",
        "multiline": true,
        "max_len": 131072,
        "default": "",
        "label": "HTML",
        "description": "The page itself, as HTML with its CSS and scripts inline: a graphic built here instead of loaded from a URL. Ignored when a local file is set. It can load fonts, images and scripts from the web over https, but no local files, and reaches this computer and the local network only when allowed below.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      },
      {
        "id": "fps",
        "type": "int",
        "min": 0,
        "max": 60,
        "step": 1,
        "unit": "fps",
        "default": 0,
        "label": "Frame rate",
        "description": "The most frames a second the page paints. It paints less when nothing changes. 0 follows the program's frame rate, so a page's animation is as smooth as the program.",
        "live": false
      },
      {
        "id": "css",
        "type": "string",
        "multiline": true,
        "max_len": 65536,
        "default": "body { background-color: rgba(0, 0, 0, 0); margin: 0px auto; overflow: hidden; }",
        "label": "Custom CSS",
        "description": "CSS added to the page after it loads. The default makes the page's background transparent.",
        "live": true
      },
      {
        "id": "restart_on_show",
        "type": "bool",
        "default": false,
        "label": "Restart when shown",
        "description": "Load the page again each time the program shows it again, so its animations play from the start: for an HTML graphic or a stinger that should play its entrance every time.",
        "live": true
      },
      {
        "id": "local_network",
        "type": "bool",
        "default": false,
        "label": "Allow local network",
        "description": "Let a page from the internet make requests to this computer and the local network (localhost, 192.168.x.x and the like), for widgets that talk to an app running here. Off, those requests are refused. It covers the page's own origin only, and only a page loaded over https. A local file or a page on the local network may always.",
        "advanced": true,
        "live": false
      },
      {
        "id": "page_api",
        "type": "bool",
        "default": false,
        "label": "Page API",
        "description": "Give the page window.jstream: the engine's clock, so it moves in step with native motion and other pages, and whether this source is shown on program and preview. Each kind of data below is its own checkbox.",
        "warning": "A page from the web can send what it reads anywhere.",
        "group": "Page API",
        "live": false
      },
      {
        "id": "page_api_scenes",
        "type": "bool",
        "default": false,
        "label": "Scenes",
        "description": "Also give the page the program and preview scenes' names.",
        "warning": "Preview scene names can say what hasn't been shown yet.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_shared_values",
        "type": "bool",
        "default": false,
        "label": "Shared values",
        "description": "Also give the page the shared values named below, set with values.set.",
        "warning": "The page can read these values, and a page from the web can send them anywhere.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_values",
        "type": "string",
        "multiline": false,
        "max_len": 1024,
        "default": "",
        "label": "Value names",
        "description": "The shared values the page may read: names or prefixes ending in .*, separated by commas (status.text, counter.*).",
        "group": "Page API",
        "visible_if": {
          "param": "page_api_shared_values",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_audio",
        "type": "bool",
        "default": false,
        "label": "Audio levels",
        "description": "Also give the page one bus's levels and spectrum bands, after its fader, with jstream.levels(). Never its samples.",
        "warning": "A page given a bus can follow the shape of its sound, and a page from the web can send that anywhere. Give it only the bus it shows.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_bus",
        "type": "bus",
        "default": null,
        "label": "Bus",
        "description": "The bus whose levels the page may read.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api_audio",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_tempo",
        "type": "bool",
        "default": false,
        "label": "Tempo",
        "description": "Also give the page the engine's tempo: the tempo.* shared values, and the tempo in jstream.midi()'s reading (ADR-0147).",
        "warning": "A page given the tempo can follow the song's beat and transport, and a page from the web can send that anywhere.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_midi",
        "type": "bool",
        "default": false,
        "label": "MIDI",
        "description": "Also give the page one MIDI input's held notes, controllers and latest notes, with jstream.midi() (ADR-0147); its tempo too while Tempo is on.",
        "warning": "A page given MIDI sees every note and control on its port.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api",
          "equals": true
        },
        "live": false
      },
      {
        "id": "page_api_midi_input",
        "type": "string",
        "multiline": false,
        "max_len": 64,
        "default": "",
        "label": "MIDI input",
        "description": "The MIDI input the page may read: a MIDI port's or JTunnel sender's name. Empty gives it every input at once.",
        "group": "Page API",
        "visible_if": {
          "param": "page_api_midi",
          "equals": true
        },
        "live": false
      }
    ]
  },
  {
    "kind_id": "chat_message",
    "category": "source",
    "name": "Chat message",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "font",
        "type": "asset",
        "accept": [
          "ttf",
          "otf",
          "ttc"
        ],
        "default": null,
        "label": "Font",
        "description": "A TrueType or OpenType font. None uses the bundled Roboto, which covers Latin text only.",
        "live": false
      },
      {
        "id": "size",
        "type": "float",
        "min": 1.0,
        "max": 256.0,
        "step": 1.0,
        "unit": "px",
        "default": 32.0,
        "label": "Size",
        "live": true
      },
      {
        "id": "author_color",
        "type": "color",
        "alpha": true,
        "default": "#ffd54fff",
        "label": "Author color",
        "live": true
      },
      {
        "id": "text_color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Text color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#000000b3",
        "label": "Background",
        "live": true
      },
      {
        "id": "padding",
        "type": "int",
        "min": 0,
        "max": 1024,
        "step": 1,
        "unit": "px",
        "default": 16,
        "label": "Padding",
        "live": true
      },
      {
        "id": "max_width",
        "type": "int",
        "min": 0,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 600,
        "label": "Maximum width",
        "description": "Lines wrap at this width. 0 doesn't wrap.",
        "live": true
      },
      {
        "id": "outline_width",
        "type": "int",
        "min": 0,
        "max": 64,
        "step": 1,
        "unit": "px",
        "default": 0,
        "label": "Outline width",
        "live": true
      },
      {
        "id": "outline_color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Outline color",
        "live": true
      }
    ]
  },
  {
    "kind_id": "color",
    "category": "source",
    "name": "Color",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "Color",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1920,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 1080,
        "label": "Height",
        "live": false
      }
    ]
  },
  {
    "kind_id": "desktop_audio",
    "category": "source",
    "name": "Desktop audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": []
  },
  {
    "kind_id": "display",
    "category": "source",
    "name": "Display capture",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "target",
        "type": "capture_target",
        "kind": "display",
        "max_len": 1024,
        "default": "",
        "label": "Display",
        "description": "The ID of the display to capture, as `capture.targets` lists it. Empty captures the primary display.",
        "live": false
      },
      {
        "id": "show_cursor",
        "type": "bool",
        "default": true,
        "label": "Show cursor",
        "description": "Whether the pointer shows in the capture.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "image",
    "category": "source",
    "name": "Image",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif"
        ],
        "default": null,
        "label": "Image file",
        "live": false
      }
    ]
  },
  {
    "kind_id": "light",
    "category": "source",
    "name": "Light",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "type",
        "type": "enum",
        "options": [
          {
            "value": "point",
            "label": "Point"
          },
          {
            "value": "spot",
            "label": "Spot"
          },
          {
            "value": "directional",
            "label": "Directional"
          },
          {
            "value": "environment",
            "label": "Environment"
          },
          {
            "value": "ambient",
            "label": "Ambient"
          }
        ],
        "default": "point",
        "label": "Type",
        "description": "Point shines every way from the item's centre; spot shines out of the back of the item within its cone; directional shines out of its back from infinitely far; ambient lights everything evenly; environment is the sky all around the scene, which scene-lit models take their ambient light and reflections from (only the first in a scene counts), its item's turn spinning it.",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": false,
        "default": "#ffffff",
        "label": "Color",
        "description": "The light's colour.",
        "live": true
      },
      {
        "id": "intensity",
        "type": "float",
        "min": 0.0,
        "max": 64.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Intensity",
        "description": "How bright it is on a surface facing it, before it fades; the item's opacity scales it, so fading or hiding the item dims it.",
        "live": true
      },
      {
        "id": "range_px",
        "type": "float",
        "min": 0.0,
        "max": 1000000.0,
        "step": 10.0,
        "unit": "px",
        "default": 0.0,
        "label": "Range",
        "description": "How far a point or spot light reaches before it has faded to nothing; 0 never fades.",
        "live": true
      },
      {
        "id": "cone_deg",
        "type": "float",
        "min": 1.0,
        "max": 170.0,
        "step": 1.0,
        "unit": "deg",
        "default": 45.0,
        "label": "Cone",
        "description": "A spot light's full cone angle.",
        "visible_if": {
          "param": "type",
          "equals": "spot"
        },
        "live": true
      },
      {
        "id": "softness",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "default": 0.2,
        "label": "Softness",
        "description": "The share of a spot cone, from its edge inward, over which it fades out.",
        "visible_if": {
          "param": "type",
          "equals": "spot"
        },
        "live": true
      },
      {
        "id": "shadows",
        "type": "bool",
        "default": false,
        "label": "Shadows",
        "description": "A spot or directional light casts shadows from the scene's models and cards onto its scene-lit models. The first two in a scene do.",
        "live": true
      },
      {
        "id": "shadow_softness",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "default": 0.3,
        "label": "Shadow softness",
        "description": "How soft its shadows' edges are, 0 hard.",
        "live": true
      },
      {
        "id": "sky_color",
        "type": "color",
        "alpha": false,
        "default": "#9cc2e8",
        "label": "Sky",
        "description": "An environment's sky straight up.",
        "visible_if": {
          "param": "type",
          "equals": "environment"
        },
        "live": true
      },
      {
        "id": "horizon_color",
        "type": "color",
        "alpha": false,
        "default": "#ffffff",
        "label": "Horizon",
        "description": "An environment's sky at the horizon.",
        "visible_if": {
          "param": "type",
          "equals": "environment"
        },
        "live": true
      },
      {
        "id": "ground_color",
        "type": "color",
        "alpha": false,
        "default": "#3a3a3a",
        "label": "Ground",
        "description": "An environment's ground, below the horizon.",
        "visible_if": {
          "param": "type",
          "equals": "environment"
        },
        "live": true
      },
      {
        "id": "image",
        "type": "source",
        "media": "video",
        "default": null,
        "label": "Image",
        "description": "A source whose picture is the sky instead of the colours, as an equirectangular panorama: an HDRI still, or any live source.",
        "visible_if": {
          "param": "type",
          "equals": "environment"
        },
        "live": true
      }
    ]
  },
  {
    "kind_id": "media",
    "category": "source",
    "name": "Media file",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "mp4",
          "mkv",
          "mov",
          "webm",
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg"
        ],
        "default": null,
        "label": "Media file",
        "description": "A video or audio file the platform can play. Its sound plays while the program shows it, at speed 1.",
        "live": false
      },
      {
        "id": "loop",
        "type": "bool",
        "default": true,
        "label": "Loop",
        "live": true
      },
      {
        "id": "speed",
        "type": "float",
        "min": 0.25,
        "max": 4.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Speed",
        "description": "1 is normal speed.",
        "live": true
      },
      {
        "id": "restart_on_show",
        "type": "bool",
        "default": true,
        "label": "Restart when shown",
        "description": "Plays from the start each time the program shows it again.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "midi_beat",
    "category": "source",
    "name": "MIDI beat",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "input",
        "type": "string",
        "multiline": false,
        "max_len": 64,
        "default": "",
        "label": "MIDI input",
        "description": "The input it draws: a MIDI port's or JTunnel sender's name. Empty draws every input at once.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 480,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
