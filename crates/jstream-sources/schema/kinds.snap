  {
    "kind_id": "waveform",
    "category": "source",
    "name": "Audio waveform",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "audio",
        "type": "bus",
        "default": null,
        "label": "Audio",
        "description": "What it draws. None draws the program mix: the master after its filters, as the outputs hear it. A bus draws that bus after its fader, before the master's filters. Either is silent while no output runs.",
        "live": false
      },
      {
        "id": "audio_source",
        "type": "source",
        "media": "audio",
        "default": null,
        "label": "Audio source",
        "description": "A source to draw instead of the audio above: that source after its own filters, fader, mute and follow, before any bus, as the audience hears it. Silent while that source isn't playing into the mixer, and while no output runs.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 640,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 160,
        "label": "Height",
        "live": false
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "smoothing",
        "type": "float",
        "min": 0.0,
        "max": 0.99,
        "step": 0.01,
        "default": 0.0,
        "label": "Smoothing",
        "description": "How slowly a peak falls back: 0 follows the audio exactly.",
        "live": true
      },
      {
        "id": "scale",
        "type": "enum",
        "options": [
          {
            "value": "linear",
            "label": "Linear"
          },
          {
            "value": "db",
            "label": "dB"
          }
        ],
        "default": "linear",
        "label": "Scale",
        "description": "Linear draws the samples as they are; dB draws their level from -60 dBFS, so quiet audio shows.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "webcam",
    "category": "source",
    "name": "Webcam",
    "version": 1,
    "video": true,
    "audio": true,
    "params": [
      {
        "id": "device",
        "type": "capture_target",
        "kind": "device",
        "max_len": 1024,
        "default": "",
        "label": "Device",
        "description": "The ID of the webcam or capture card, as `capture.targets` lists it. Empty captures the first device listed.",
        "live": false
      },
      {
        "id": "resolution",
        "type": "capture_format",
        "part": "resolution",
        "target": "device",
        "default": "",
        "label": "Resolution",
        "description": "The frame size to capture, as `<width>x<height>` (`1920x1080`), one the device lists in `capture.targets`. Empty lets the engine choose: the largest up to 1920x1080.",
        "group": "Format",
        "live": false
      },
      {
        "id": "fps",
        "type": "capture_format",
        "part": "fps",
        "target": "device",
        "default": 0,
        "label": "Frame rate",
        "description": "The frames per second to capture, one the device lists for the resolution. 0 lets the engine choose: the fastest.",
        "group": "Format",
        "live": false
      },
      {
        "id": "pixel_format",
        "type": "capture_format",
        "part": "pixel_format",
        "target": "device",
        "default": "",
        "label": "Video format",
        "description": "How the device sends its frames: `mjpeg` (compressed, decoded by the engine), `yuy2`, `nv12`, `bgra` or `rgba`. Empty lets the engine choose: uncompressed when it can.",
        "group": "Format",
        "live": false
      },
      {
        "id": "camera_controls",
        "type": "camera_controls",
        "target": "device",
        "default": {},
        "label": "Camera controls",
        "description": "The device's camera controls to set, by name, each to a number in the range `capture.targets` lists for it or to `\"auto\"` to let the device set it: `{\"exposure\": -6, \"white_balance\": \"auto\"}`. A control left out keeps what the device has. Applied while the device captures, without restarting it.",
        "group": "Camera",
        "live": true
      }
    ]
  },
