  {
    "kind_id": "model",
    "category": "source",
    "name": "3D model",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "shape",
        "type": "enum",
        "options": [
          {
            "value": "file",
            "label": "From a file"
          },
          {
            "value": "plane",
            "label": "Plane"
          },
          {
            "value": "cube",
            "label": "Cube"
          },
          {
            "value": "sphere",
            "label": "Sphere"
          },
          {
            "value": "cylinder",
            "label": "Cylinder"
          },
          {
            "value": "cone",
            "label": "Cone"
          }
        ],
        "default": "file",
        "label": "Shape",
        "description": "A glTF file, or a built-in shape one unit across.",
        "live": false
      },
      {
        "id": "file",
        "type": "asset",
        "accept": [
          "glb",
          "gltf"
        ],
        "default": null,
        "label": "Model file",
        "description": "A glTF 2.0 file (.glb, or .gltf with its files beside it), for the shape `file`.",
        "live": false
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "description": "A shape's base colour; multiplies a file's own.",
        "live": true
      },
      {
        "id": "metallic",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.0,
        "label": "Metallic",
        "description": "How metallic a shape is. A file's materials keep their own.",
        "live": true
      },
      {
        "id": "roughness",
        "type": "float",
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "default": 0.5,
        "label": "Roughness",
        "description": "How rough a shape is, 0 a mirror. A file's materials keep their own.",
        "live": true
      },
      {
        "id": "lighting",
        "type": "enum",
        "options": [
          {
            "value": "studio",
            "label": "Studio"
          },
          {
            "value": "unlit",
            "label": "Unlit"
          },
          {
            "value": "scene",
            "label": "Scene"
          }
        ],
        "default": "studio",
        "label": "Lighting",
        "description": "Studio lights it from above and to the left of the camera; unlit shows its colours as they are; scene lights it with the light sources placed in its 3D scene (studio in a 2D scene).",
        "live": true
      },
      {
        "id": "texture",
        "type": "source",
        "media": "video",
        "default": null,
        "label": "Texture",
        "description": "A source whose picture, live and after its own filters, replaces the base-colour texture: a webcam, a browser page, a shader, a scene. Not another model, whose picture is drawn only where an item places it. Missing or not yet drawing, it reads transparent.",
        "live": true
      },
      {
        "id": "texture_material",
        "type": "string",
        "multiline": false,
        "max_len": 256,
        "default": "",
        "label": "Textured material",
        "description": "Which of a file's materials, by name, the texture replaces; empty replaces every material's.",
        "live": true
      },
      {
        "id": "reflection",
        "type": "source",
        "media": "video",
        "default": null,
        "label": "Reflection",
        "description": "A source the model reflects, read as an equirectangular panorama: it replaces the studio environment (or its scene's sky) for its reflections and ambient light. A scene source makes it reflect that scene.",
        "live": true
      },
      {
        "id": "double_sided",
        "type": "bool",
        "default": false,
        "label": "Double-sided",
        "description": "Draw a shape's back faces too. A file's materials keep their own.",
        "live": true
      },
      {
        "id": "casts_shadows",
        "type": "bool",
        "default": true,
        "label": "Casts shadows",
        "description": "Whether it blocks the light of its scene's lights that cast shadows.",
        "live": true
      },
      {
        "id": "receives_shadows",
        "type": "bool",
        "default": true,
        "label": "Receives shadows",
        "description": "Whether, lit by its scene, it is shadowed by the lights that cast them.",
        "live": true
      },
      {
        "id": "reflections",
        "type": "bool",
        "default": true,
        "label": "Reflects the scene",
        "description": "Whether, lit by its scene, it reflects the rest of the scene where the scene's reflections are on and a reflection probe's box holds it; off, it reflects only the environment.",
        "live": true
      },
      {
        "id": "animation",
        "type": "string",
        "multiline": false,
        "max_len": 256,
        "default": "",
        "label": "Animation",
        "description": "The file's animation to play, by its name; empty plays none and stands it at rest. A name the file lacks is refused with the names it has.",
        "live": true
      },
      {
        "id": "animation_speed",
        "type": "float",
        "min": 0.0,
        "max": 8.0,
        "step": 0.05,
        "default": 1.0,
        "label": "Animation speed",
        "description": "How fast it plays: 1 at its own pace, 0 held at its start.",
        "live": true
      },
      {
        "id": "animation_loop",
        "type": "bool",
        "default": true,
        "label": "Loop the animation",
        "description": "Whether it plays again from its start; if not, it holds its last frame.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "network_audio",
    "category": "source",
    "name": "Network audio",
    "version": 1,
    "video": false,
    "audio": true,
    "params": [
      {
        "id": "transport",
        "type": "enum",
        "options": [
          {
            "value": "jtunnel",
            "label": "JTunnel"
          }
        ],
        "default": "jtunnel",
        "label": "Transport",
        "description": "How the audio arrives. JTunnel is a DAW plugin that sends a track over the local network.",
        "live": false
      },
      {
        "id": "sender",
        "type": "string",
        "multiline": false,
        "max_len": 31,
        "default": "",
        "label": "Sender",
        "description": "The sender's name, as its plugin shows it. JStream receives only from senders accepted on this machine.",
        "live": false
      },
      {
        "id": "latency_ms",
        "type": "int",
        "min": 5,
        "max": 500,
        "step": 1,
        "unit": "ms",
        "default": 40,
        "label": "Latency",
        "description": "How long frames wait before they play, so one delayed on the network still arrives in time. Higher survives a busier network; lower is closer to live.",
        "live": false
      }
    ]
  },
  {
    "kind_id": "reflection_probe",
    "category": "source",
    "name": "Reflection probe",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "width_px",
        "type": "float",
        "min": 1.0,
        "max": 100000.0,
        "step": 10.0,
        "unit": "px",
        "default": 2000.0,
        "label": "Width",
        "description": "The box's size along the scene's x axis. A surface inside the box reflects what the probe sees.",
        "live": true
      },
      {
        "id": "height_px",
        "type": "float",
        "min": 1.0,
        "max": 100000.0,
        "step": 10.0,
        "unit": "px",
        "default": 2000.0,
        "label": "Height",
        "description": "The box's size along the scene's y axis. A surface inside the box reflects what the probe sees.",
        "live": true
      },
      {
        "id": "depth_px",
        "type": "float",
        "min": 1.0,
        "max": 100000.0,
        "step": 10.0,
        "unit": "px",
        "default": 2000.0,
        "label": "Depth",
        "description": "The box's size along the scene's z axis. A surface inside the box reflects what the probe sees.",
        "live": true
      },
      {
        "id": "fade_px",
        "type": "float",
        "min": 0.0,
        "max": 100000.0,
        "step": 10.0,
        "unit": "px",
        "default": 100.0,
        "label": "Edge fade",
        "description": "How far inside the box's faces its reflection fades in, so a surface moving out of the box loses it gradually; 0 cuts at the faces.",
        "live": true
      },
      {
        "id": "resolution",
        "type": "enum",
        "options": [
          {
            "value": "128",
            "label": "128 px"
          },
          {
            "value": "256",
            "label": "256 px"
          },
          {
            "value": "512",
            "label": "512 px"
          }
        ],
        "default": "256",
        "label": "Resolution",
        "description": "How many pixels a side each of the six views the probe captures is. Larger is sharper and costs more; the app's 3D rendering settings cap it.",
        "live": true
      },
      {
        "id": "refresh_frames",
        "type": "int",
        "min": 0,
        "max": 600,
        "unit": "frames",
        "default": 0,
        "label": "Refresh every",
        "description": "How often the probe captures its scene again, in frames; 0 captures once, when it is first drawn or a setting changes. Each capture draws the scene six times, so a probe that sees live video wants a rate, and a slow machine a long one.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "shape",
    "category": "source",
    "name": "Shape",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "shape",
        "type": "enum",
        "options": [
          {
            "value": "rectangle",
            "label": "Rectangle"
          },
          {
            "value": "ellipse",
            "label": "Ellipse"
          }
        ],
        "default": "rectangle",
        "label": "Shape",
        "description": "A rectangle (rounded by Corner radius, a pill when it is half the height) or an ellipse filling the size (a circle when square).",
        "live": true
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 400,
        "label": "Width",
        "description": "Draw it at the size of the box it is placed in, so it isn't scaled.",
        "live": true
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 120,
        "label": "Height",
        "description": "See Width.",
        "live": true
      },
      {
        "id": "radius",
        "type": "float",
        "min": 0.0,
        "max": 4096.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Corner radius",
        "description": "A rectangle's corner radius; at most half the shorter side, which makes the short ends round.",
        "live": true
      },
      {
        "id": "fill",
        "type": "enum",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "linear",
            "label": "Linear gradient"
          },
          {
            "value": "radial",
            "label": "Radial gradient"
          }
        ],
        "default": "solid",
        "label": "Fill",
        "description": "Solid Color, or a gradient from Color to End color.",
        "live": true
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "description": "The fill, or a gradient's start.",
        "live": true
      },
      {
        "id": "color2",
        "type": "color",
        "alpha": true,
        "default": "#000000ff",
        "label": "End color",
        "description": "A gradient's end: at the far side of a linear one, the edge of a radial one.",
        "live": true
      },
      {
        "id": "angle",
        "type": "float",
        "min": 0.0,
        "max": 360.0,
        "step": 1.0,
        "unit": "deg",
        "default": 90.0,
        "label": "Angle",
        "description": "The direction a linear gradient runs from Color to End color: 0 is left to right, 90 top to bottom.",
        "visible_if": {
          "param": "fill",
          "equals": "linear"
        },
        "live": true
      },
      {
        "id": "border_width",
        "type": "float",
        "min": 0.0,
        "max": 4096.0,
        "step": 1.0,
        "unit": "px",
        "default": 0.0,
        "label": "Border width",
        "description": "A border inside the edge; 0 is none.",
        "live": true
      },
      {
