    "name": "Audio spectrum",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "audio",
        "type": "bus",
        "default": null,
        "label": "Audio",
        "description": "What it draws. None draws the program mix: the master after its filters, as the outputs hear it. A bus draws that bus after its fader, before the master's filters. Either is silent while no output runs.",
        "live": false
      },
      {
        "id": "audio_source",
        "type": "source",
        "media": "audio",
        "default": null,
        "label": "Audio source",
        "description": "A source to draw instead of the audio above: that source after its own filters, fader, mute and follow, before any bus, as the audience hears it. Silent while that source isn't playing into the mixer, and while no output runs.",
        "live": false
      },
      {
        "id": "width",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 640,
        "label": "Width",
        "live": false
      },
      {
        "id": "height",
        "type": "int",
        "min": 1,
        "max": 16384,
        "step": 1,
        "unit": "px",
        "default": 240,
        "label": "Height",
        "live": false
      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#ffffffff",
        "label": "Color",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      },
      {
        "id": "bars",
        "type": "int",
        "min": 1,
        "max": 1024,
        "step": 1,
        "default": 64,
        "label": "Bars",
        "live": true
      },
      {
        "id": "smoothing",
        "type": "float",
        "min": 0.0,
        "max": 0.99,
        "step": 0.01,
        "default": 0.7,
        "label": "Smoothing",
        "description": "How slowly a bar falls back: 0 follows the audio exactly.",
        "live": true
      },
      {
        "id": "scale",
        "type": "enum",
        "options": [
          {
            "value": "log",
            "label": "Logarithmic"
          },
          {
            "value": "linear",
            "label": "Linear"
          }
        ],
        "default": "log",
        "label": "Scale",
        "description": "How frequencies spread across the bars: log gives each octave the same width from 20 Hz, as the ear hears them; linear gives each hertz the same width from 0 Hz.",
        "live": true
      }
    ]
  },
  {
    "kind_id": "text",
