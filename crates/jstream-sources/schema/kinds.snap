      },
      {
        "id": "color",
        "type": "color",
        "alpha": true,
        "default": "#7ee081ff",
        "label": "Bar",
        "live": true
      },
      {
        "id": "track",
        "type": "color",
        "alpha": true,
        "default": "#2a2a2aff",
        "label": "Track",
        "live": true
      },
      {
        "id": "background",
        "type": "color",
        "alpha": true,
        "default": "#00000000",
        "label": "Background",
        "live": true
      }
    ]
  },
  {
    "kind_id": "midi_keyboard",
    "category": "source",
    "name": "MIDI keyboard",
    "version": 1,
    "video": true,
    "audio": false,
    "params": [
      {
        "id": "input",
        "type": "string",
        "multiline": false,
        "max_len": 64,
        "default": "",
        "label": "MIDI input",
        "description": "The input it draws: a MIDI port's or JTunnel sender's name. Empty draws every input at once.",
        "live": false
      },
      {
        "id": "channel",
        "type": "int",
        "min": 0,
        "max": 16,
        "step": 1,
        "default": 0,
        "label": "Channel",
